# 大きなファイルは入れない（Google ドライブ marurobo_render に置く）
*.mp4
*.mov
*.mkv
*.wav
*.m4a
*.mp3
*.npy
*.npz
*.png
*.jpg
*.jpeg
*.exr
*.blend
*.blend1
*.zip
__pycache__/
*.pyc
# 鍵
.env
*.key
# 例外：作り直しに手間がかかる声と BGM の元（FLAC・小さい）は入れる
!episodes/*/media/**/*.flac
# 16本目の作業中の大きいファイル・声・BGM（作業フォルダに置く）
episodes/ep16_leak/voice/*.wav
episodes/ep16_leak/voice/heard*.json

# 字幕の中間ファイル（assemble が作り直す）
episodes/ep16_leak/anim/subs_events*.json
