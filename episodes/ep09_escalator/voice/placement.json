"no": 33,
"start": 142.46,
"end": 145.25,
"speed": 1.0,
"slot": [
142.46,
145.25
],
"text": "シールの段は、上へ運ばれていきます。"
},
{
"no": 34,
"start": 146.25,
"end": 148.92,
"speed": 1.0,
"slot": [
146.25,
148.92
],
"text": "やがて降り口で……消えました。"
},
{
"no": 35,
"start": 149.72,
"end": 155.46,
"speed": 1.0,
"slot": [
149.72,
155.46
],
"text": "それを見たまるロボは、横の階段を跳ねて、急いで下の乗り口へ。"
},
