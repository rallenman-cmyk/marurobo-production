{
"no": 2,
"start": 4.24,
"end": 9.79,
"speed": 1.0,
"slot": [
4.24,
9.79
],
"text": "白くて丸い体に、青緑の目が1つ。腕はありません。"
},
{
"no": 3,
"start": 10.19,
"end": 13.29,
"speed": 1.0,
"slot": [
10.19,
13.29
],
"text": "どうやら、エスカレーターに乗ってみたいようです。"
},
{
"no": 4,
"start": 13.69,
"end": 15.7,
"speed": 1.0,
"slot": [
13.69,
15.7
],
"text": "ぴょんと跳んで、乗り口へ。"
