"start": 404.033,
"end": 408.263,
"speed": 1.0,
"slot": [
404.033,
408.263
],
"text": "1本目は、前の車輪が走る、前のレール。"
},
{
"no": 86,
"start": 408.663,
"end": 412.653,
"speed": 1.0,
"slot": [
408.663,
412.653
],
"text": "2本目は、後ろの車輪が走る、後ろのレール。"
},
