"no": 12,
"start": 49.89,
"end": 52.0,
"speed": 1.0,
"slot": [
49.89,
52.0
],
"text": "1枚、また1枚……。"
},
{
"no": 13,
"start": 53.1,
"end": 56.95,
"speed": 1.0,
"slot": [
53.1,
56.95
],
"text": "あれ？　段は、どこへ行ってしまったのでしょう？"
