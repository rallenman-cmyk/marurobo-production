"start": 116.16,
"end": 120.54,
"speed": 1.0,
"slot": [
116.16,
120.54
],
"text": "こちらでは、床のすき間から、段が次々と出てきます。"
},
{
"no": 29,
"start": 120.94,
"end": 126.59,
"speed": 1.0,
"slot": [
120.94,
126.59
],
"text": "上では消えて、下では出てくる。いったい、どういう関係なのでしょう？"
},
{
"no": 30,
"start": 127.39,
"end": 131.24,
"speed": 1.0,
"slot": [
127.39,
131.24
],
"text": "そこで、1枚の段に、しるしを付けてみます。"
},
{
"no": 31,
"start": 131.64,
"end": 136.18,
"speed": 1.0,
"slot": [
131.64,
136.18
],
"text": "このしるしを目じるしにして、段の行き先を追いかけるのです。"
},
{
"no": 32,
"start": 136.58,
"end": 141.46,
"speed": 1.0,
"slot": [
136.58,
141.46
],
