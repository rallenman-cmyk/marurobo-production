"no": 37,
"start": 161.97,
"end": 166.7,
"speed": 1.0,
"slot": [
161.97,
166.7
],
"text": "出てきました！　まるロボの顔のシールです。"
},
{
"no": 38,
"start": 167.1,
"end": 171.92,
"speed": 1.0,
"slot": [
167.1,
171.92
],
"text": "つまり、上で消えた段が、下から戻ってきたのです。"
},
