"no": 7,
"start": 22.98,
"end": 29.13,
"speed": 1.0,
"slot": [
22.98,
29.13
],
"text": "見てください。足もとの段と、となりの段の高さが、少しずつずれていきます。"
},
{
"no": 8,
"start": 30.13,
"end": 32.56,
"speed": 1.0,
"slot": [
30.13,
32.56
],
"text": "まるロボも、足もとをきょろきょろ。"
},
