 },
 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 3.84,
   "text": "駅のエスカレーターの前に、まるロボがいます。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 4.24,
   "t1": 9.79,
   "text": "白くて丸い体に、青緑の目が1つ。腕はありません。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 10.19,
   "t1": 13.29,
   "text": "どうやら、エスカレーターに乗ってみたいようです。",
   "who": "ナレーション"
  },
  {
   "id": "01-04",
   "t0": 13.69,
   "t1": 15.7,
   "text": "ぴょんと跳んで、乗り口へ。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 16.9,
   "t1": 19.32,
   "text": "乗ったときは、平らな床でした。",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 19.72,
   "t1": 22.38,
   "text": "ところが、進んでいくと……。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 22.98,
   "t1": 29.13,
   "text": "見てください。足もとの段と、となりの段の高さが、少しずつずれていきます。",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 30.13,
   "t1": 32.56,
   "text": "まるロボも、足もとをきょろきょろ。",
   "who": "ナレーション"
  },
  {
   "id": "02-05",
   "t0": 33.46,
   "t1": 40.44,
   "text": "気がつけば、すっかり階段の形に。まるで、床から段が生えてきたみたいですね。",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 41.24,
   "t1": 44.76,
   "text": "やがて上に着くと、段はまた平らになりました。",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 45.16,
   "t1": 49.49,
   "text": "段は、降り口の床のすき間に、吸いこまれていきます。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 49.89,
   "t1": 52.0,
   "text": "1枚、また1枚……。",
   "who": "ナレーション"
  },
  {
   "id": "03-04",
   "t0": 53.1,
   "t1": 56.95,
   "text": "あれ？　段は、どこへ行ってしまったのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 57.75,
   "t1": 63.69,
   "text": "そこで、気になったまるロボ。段に乗ったまま、一緒に入ってみることにしました。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 64.09,
   "t1": 67.26,
   "text": "だんだん、すき間が目の前に迫ってきます。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 68.26,
   "t1": 70.24,
   "text": "その瞬間……ころん。",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 71.64,
   "t1": 75.36,
   "text": "なんと、まるロボだけ、床の上に残されてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "04-05",
   "t0": 75.76,
   "t1": 79.01,
   "text": "段は入っていけるのに、まるロボは入れません。",
   "who": "ナレーション"
  },
  {
   "id": "04-06",
   "t0": 79.61,
   "t1": 84.21,
   "text": "まるロボも、すき間と自分の体を見比べて、首をかしげています。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 85.01,
   "t1": 87.87,
   "text": "毎日なにげなく乗っている、エスカレーター。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 88.87,
   "t1": 91.9,
   "text": "段は、いったいどこへ消えているのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 92.5,
   "t1": 95.83,
   "text": "そして、まるロボがはじかれたのは、なぜなのか。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 96.23,
   "t1": 99.15,
   "text": "では、まるロボと一緒に、確かめていきましょう。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 99.95,
   "t1": 103.41,
   "text": "まずは、もう一度、降り口のすき間を見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 103.81,
   "t1": 106.94,
   "text": "段は休まずに、次々と消えていきます。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 107.34,
   "t1": 112.06,
   "text": "ふつうなら、消えた段は床の下にたまってしまいそうですよね。",
   "who": "ナレーション"
  },
  {
   "id": "06-04",
   "t0": 112.96,
   "t1": 115.76,
   "text": "一方、下の乗り口を見てください。",
   "who": "ナレーション"
  },
  {
   "id": "06-05",
   "t0": 116.16,
   "t1": 120.54,
   "text": "こちらでは、床のすき間から、段が次々と出てきます。",
   "who": "ナレーション"
  },
  {
   "id": "06-06",
   "t0": 120.94,
   "t1": 126.59,
   "text": "上では消えて、下では出てくる。いったい、どういう関係なのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 127.39,
   "t1": 131.24,
   "text": "そこで、1枚の段に、しるしを付けてみます。",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 131.64,
   "t1": 136.18,
   "text": "このしるしを目じるしにして、段の行き先を追いかけるのです。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 136.58,
   "t1": 141.46,
   "text": "まるロボが、自分の顔のシールを体で押しつけて……ぺたっ。",
   "who": "ナレーション"
  },
  {
   "id": "07-04",
   "t0": 142.46,
   "t1": 145.25,
   "text": "シールの段は、上へ運ばれていきます。",
   "who": "ナレーション"
  },
  {
   "id": "07-05",
   "t0": 146.25,
   "t1": 148.92,
   "text": "やがて降り口で……消えました。",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 149.72,
   "t1": 155.46,
   "text": "それを見たまるロボは、横の階段を跳ねて、急いで下の乗り口へ。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 156.86,
   "t1": 160.77,
   "text": "体をゆらしながら、じっと待っていると……。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 161.97,
   "t1": 166.7,
   "text": "出てきました！　まるロボの顔のシールです。",
   "who": "ナレーション"
  },
  {
   "id": "08-04",
   "t0": 167.1,
   "t1": 171.92,
   "text": "つまり、上で消えた段が、下から戻ってきたのです。",
   "who": "ナレーション"
  },
  {
   "id": "08-05",
   "t0": 172.32,
   "t1": 176.55,
   "text": "どうやら段は、ぐるっと輪になって回っているようですね。",
   "who": "ナレーション"
  },
  {
   "id": "08-06",
   "t0": 176.95,
   "t1": 181.54,
   "text": "でも、床の下で、どうやって戻ってくるのか。",
   "who": "ナレーション"
  },
  {
   "id": "08-07",
   "t0": 181.94,
   "t1": 187.36,
   "text": "それに、平らになったり階段になったりするのは、なぜでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "09-01",
   "t0": 188.16,
   "t1": 192.95,
   "text": "その日の夜。お客さんのいない、点検の時間です。",
   "who": "ナレーション"
  },
  {
   "id": "09-02",
   "t0": 193.35,
   "t1": 198.68,
   "text": "そこで、点検のおじさんにお願いして、床の下に入れてもらいます。",
   "who": "ナレーション"
  },
  {
   "id": "09-03",
   "t0": 199.08,
   "t1": 202.35,
   "text": "おじさんが、降り口の床のふたを外すと……。",
   "who": "ナレーション"
  },
  {
   "id": "09-04",
   "t0": 203.35,
   "t1": 207.15,
   "text": "下には、大きな機械の部屋が広がっていました。",
   "who": "ナレーション"
  },
  {
   "id": "09-05",
   "t0": 207.55,
   "t1": 213.16,
   "text": "エスカレーターは、点検のためのゆっくりした速さで動かしてもらいます。",
   "who": "ナレーション"
  },
  {
   "id": "10-01",
   "t0": 214.36,
   "t1": 218.56,
   "text": "まずは床の下から、降り口のすき間を見上げてみます。",
   "who": "ナレーション"
  },
  {
   "id": "10-02",
   "t0": 218.96,
   "t1": 223.77,
   "text": "ここは、冒頭でまるロボが見ていたすき間の、ちょうど裏側です。",
   "who": "ナレーション"
  },
  {
   "id": "10-03",
   "t0": 224.17,
   "t1": 229.47,
   "text": "見ていると、段は平らな姿のまま、1枚ずつ入ってきますね。",
   "who": "ナレーション"
  },
  {
   "id": "10-04",
   "t0": 229.87,
   "t1": 234.48,
   "text": "では、入ってきた段は、このあとどこへ行くのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "11-01",
   "t0": 235.28,
   "t1": 237.87,
   "text": "段の両側を、よく見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "11-02",
   "t0": 238.27,
   "t1": 241.37,
   "text": "長い鎖が、1本ずつ付いていますね。",
   "who": "ナレーション"
  },
  {
   "id": "11-03",
   "t0": 241.77,
   "t1": 247.95,
   "text": "つまり、段は1枚ずつばらばらではなく、全部この鎖でつながっていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "11-04",
   "t0": 248.35,
   "t1": 251.29,
   "text": "では、この鎖をたどっていくと……。",
   "who": "ナレーション"
  },
  {
   "id": "11-05",
   "t0": 252.49,
   "t1": 256.37,
   "text": "その先の上の端に、大きな歯車がありました。",
   "who": "ナレーション"
  },
  {
   "id": "11-06",
   "t0": 256.77,
   "t1": 260.57,
   "text": "この歯車が回ると、鎖が引っぱられます。",
   "who": "ナレーション"
  },
  {
   "id": "11-07",
   "t0": 260.97,
   "t1": 266.02,
   "text": "鎖が引っぱられると、つながっている段も、一緒に動くのですね。",
   "who": "ナレーション"
  },
  {
   "id": "11-08",
   "t0": 266.42,
   "t1": 271.18,
   "text": "さらに、その歯車を回しているのが、となりのモーター。",
   "who": "ナレーション"
  },
  {
   "id": "11-09",
   "t0": 271.58,
   "t1": 277.49,
   "text": "まとめると、モーターが歯車を回し、歯車が鎖を引っぱります。",
   "who": "ナレーション"
  },
  {
   "id": "11-10",
   "t0": 277.89,
   "t1": 282.59,
   "text": "そして、鎖が段を引っぱる。こういう順番です。",
   "who": "ナレーション"
  },
  {
   "id": "12-00",
   "t0": 283.39,
   "t1": 288.7,
   "text": "でも、歯車の先は、行き止まりです。段はどうするのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "12-01",
   "t0": 289.9,
   "t1": 295.88,
   "text": "見ていると、段は歯車のまわりを回って……くるっと、さかさまに。",
   "who": "ナレーション"
  },
  {
   "id": "12-02",
   "t0": 297.08,
   "t1": 300.92,
   "text": "そのまま斜めの通り道を、下へ戻っていきます。",
   "who": "ナレーション"
  },
  {
   "id": "12-03",
   "t0": 301.32,
   "t1": 306.81,
   "text": "じつは、ここは、私たちが上っていく階段のちょうど真下なのです。",
   "who": "ナレーション"
  },
  {
   "id": "12-04",
   "t0": 307.21,
   "t1": 309.19,
   "text": "中は、真っ暗ですね。",
   "who": "ナレーション"
  },
  {
   "id": "12-05",
   "t0": 309.59,
   "t1": 313.28,
   "text": "まるロボは、目のライトで照らしながら進みます。",
   "who": "ナレーション"
  },
  {
   "id": "12-06",
   "t0": 313.68,
   "t1": 318.54,
   "text": "おや？　さかさまの段の裏に、ちょこんと乗ってしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "12-07",
   "t0": 319.44,
   "t1": 322.73,
   "text": "どうやら、一緒に下っていくつもりのようです。",
   "who": "ナレーション"
  },
  {
   "id": "13-01",
   "t0": 323.93,
   "t1": 329.24,
   "text": "やがて、下の端に着くと、段はもう一度くるっと回ります。",
   "who": "ナレーション"
  },
  {
   "id": "13-02",
   "t0": 329.64,
   "t1": 331.87,
   "text": "今度は、表を向きました。",
   "who": "ナレーション"
  },
  {
   "id": "13-03",
   "t0": 332.77,
   "t1": 338.48,
   "text": "そして平らな姿のまま、乗り口のすき間から外へ出ていきます。",
   "who": "ナレーション"
  },
  {
   "id": "13-04",
   "t0": 338.88,
   "t1": 341.34,
   "text": "まるロボも、下の床のふたから外へ。",
   "who": "ナレーション"
  },
  {
   "id": "13-05",
   "t0": 342.34,
   "t1": 346.17,
   "text": "あれ？　出発した場所に、戻ってきてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "14-00",
   "t0": 346.97,
   "t1": 348.69,
   "text": "ここまでを、まとめてみます。",
   "who": "ナレーション"
  },
  {
   "id": "14-01",
   "t0": 349.59,
   "t1": 355.63,
   "text": "上で消えた段は、床の下をさかさまで戻り、下でまた出てくる。",
   "who": "ナレーション"
  },
  {
   "id": "14-02",
   "t0": 356.83,
   "t1": 361.75,
   "text": "段は大きな輪になって、ずっと回り続けているのです。",
   "who": "ナレーション"
  },
  {
   "id": "14-03",
   "t0": 362.15,
   "t1": 365.0,
   "text": "でも、まだ不思議が残っています。",
   "who": "ナレーション"
  },
  {
   "id": "14-04",
   "t0": 365.4,
   "t1": 370.4,
   "text": "では、平らだった段は、どうして階段の形になるのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "15-01",
   "t0": 371.4,
   "t1": 376.16,
   "text": "その答えを探るために、おじさんが、段を1枚外してくれました。",
   "who": "ナレーション"
  },
  {
   "id": "15-02",
   "t0": 377.16,
   "t1": 381.29,
   "text": "横から見ると、段の両端に、車輪が付いています。",
   "who": "ナレーション"
  },
  {
   "id": "15-03",
   "t0": 381.86,
   "t1": 388.57,
   "text": "前に1つ、後ろに1つ。左右合わせて、車輪が2組です。",
   "who": "ナレーション"
  },
  {
   "id": "15-04",
   "t0": 388.97,
   "t1": 394.09,
   "text": "でも、段1枚に、どうして車輪が2組もいるのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "15-05",
   "t0": 394.69,
   "t1": 398.64,
   "text": "その答えは、車輪が走るレールにありました。",
   "who": "ナレーション"
  },
  {
   "id": "16-01",
   "t0": 399.44,
   "t1": 403.63,
   "text": "よく見ると、車輪が走るレールも、2本あります。",
   "who": "ナレーション"
  },
  {
   "id": "16-02",
   "t0": 404.03,
   "t1": 408.26,
   "text": "1本目は、前の車輪が走る、前のレール。",
   "who": "ナレーション"
  },
  {
   "id": "16-03",
   "t0": 408.66,
   "t1": 412.65,
   "text": "2本目は、後ろの車輪が走る、後ろのレール。",
   "who": "ナレーション"
  },
  {
   "id": "16-04",
   "t0": 413.05,
   "t1": 419.16,
   "text": "このように、前の車輪と後ろの車輪は、それぞれ別のレールを走っているのです。",
   "who": "ナレーション"
  },
  {
   "id": "17-01",
   "t0": 419.96,
   "t1": 422.34,
   "text": "では、模型で確かめてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "17-02",
   "t0": 422.74,
   "t1": 428.21,
   "text": "まずは、前と後ろの車輪を、両方とも前のレールに乗せてみます。",
   "who": "ナレーション"
  },
  {
   "id": "17-03",
   "t0": 429.21,
   "t1": 433.31,
   "text": "すると、段は坂と同じ向きに傾いてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "17-04",
   "t0": 433.71,
   "t1": 437.33,
   "text": "試しに、まるロボが乗ってみると……つるっ。",
   "who": "ナレーション"
  },
  {
   "id": "17-05",
   "t0": 438.53,
   "t1": 442.3,
   "text": "これでは、階段ではなく、すべり台ですね。",
   "who": "ナレーション"
  },
  {
   "id": "17-06",
   "t0": 442.7,
   "t1": 449.78,
   "text": "次に、後ろの車輪だけを、少し離れた所を通る後ろのレールに乗せかえます。",
   "who": "ナレーション"
  },
  {
   "id": "17-07",
   "t0": 450.78,
   "t1": 455.11,
   "text": "すると、段の踏む所が、水平になりました。",
   "who": "ナレーション"
  },
  {
   "id": "17-08",
   "t0": 455.51,
   "t1": 459.6,
   "text": "水平な段が坂に並ぶと……階段の形です！",
   "who": "ナレーション"
  },
  {
   "id": "17-09",
   "t0": 460.5,
   "t1": 463.62,
   "text": "まるロボも、今度はすべらずに乗れています。",
   "who": "ナレーション"
  },
  {
   "id": "17-10",
   "t0": 464.02,
   "t1": 467.09,
   "text": "では、なぜ水平になったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "17-11",
   "t0": 467.69,
   "t1": 474.71,
   "text": "それは、後ろのレールが段の後ろ側を支えて、傾かないように保っているからです。",
   "who": "ナレーション"
  },
  {
   "id": "17-12",
   "t0": 475.11,
   "t1": 481.01,
   "text": "つまり、坂の途中では、この2本のレールが離れて通っているのです。",
   "who": "ナレーション"
  },
  {
   "id": "18-01",
   "t0": 481.81,
   "t1": 486.16,
   "text": "それでは、上と下の端では、どうなっているのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "18-02",
   "t0": 486.76,
   "t1": 490.41,
   "text": "ここでは、2本のレールが近づいていきます。",
   "who": "ナレーション"
  },
  {
   "id": "18-03",
   "t0": 491.21,
   "t1": 496.11,
   "text": "すると、前と後ろの車輪が、ほぼ一直線に並びます。",
   "who": "ナレーション"
  },
  {
   "id": "18-04",
   "t0": 496.91,
   "t1": 503.0,
   "text": "その結果、段どうしが同じ高さにそろって、平らな床になるのです。",
   "who": "ナレーション"
  },
  {
   "id": "18-05",
   "t0": 503.4,
   "t1": 508.49,
   "text": "つまり、段の形を決めていたのは、2本のレールの位置。",
   "who": "ナレーション"
  },
  {
   "id": "18-06",
   "t0": 508.89,
   "t1": 513.77,
   "text": "離れると階段に、近づくと平らになる、というわけです。",
   "who": "ナレーション"
  },
  {
   "id": "20-01",
   "t0": 514.57,
   "t1": 520.72,
   "text": "さて、段はどこへ消えるのか。ここまでで、答えが分かりました。",
   "who": "ナレーション"
  },
  {
   "id": "20-02",
   "t0": 521.12,
   "t1": 527.81,
   "text": "段は2本のレールの上で形を変えながら、床の下をさかさまで戻る。",
   "who": "ナレーション"
  },
  {
   "id": "20-03",
   "t0": 528.21,
   "t1": 531.49,
   "text": "そして、ぐるっと回り続けていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "21-01",
   "t0": 532.39,
   "t1": 534.89,
   "text": "ここからは、もう一つの不思議。",
   "who": "ナレーション"
  },
  {
   "id": "21-02",
   "t0": 535.29,
   "t1": 538.94,
   "text": "エスカレーターは、なぜ安全に乗れるのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "21-03",
   "t0": 539.54,
   "t1": 543.9,
   "text": "まずは、いつもつかまっている手すりに注目してみます。",
   "who": "ナレーション"
  },
  {
   "id": "22-01",
   "t0": 544.7,
   "t1": 550.85,
   "text": "まるロボも、手すりに頭をのせて上ってみます。腕がないので、頭で。",
   "who": "ナレーション"
  },
  {
   "id": "22-02",
   "t0": 552.25,
   "t1": 556.86,
   "text": "……あれ？　頭が、少しずつ前へずれていきますね。",
   "who": "ナレーション"
  },
  {
   "id": "22-03",
   "t0": 557.76,
   "t1": 560.2,
   "text": "のせ直してみても、また前へ。",
   "who": "ナレーション"
  },
  {
   "id": "22-04",
   "t0": 561.2,
   "t1": 564.89,
   "text": "結局、何度のせ直しても、ずれていってしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "23-01",
   "t0": 565.69,
   "t1": 570.51,
   "text": "いったい、なぜでしょう？　手すりのしくみを見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "23-02",
   "t0": 570.91,
   "t1": 578.37,
   "text": "手すりは、ゴムでできた長い輪。段と同じように、床の下を回っているのですね。",
   "who": "ナレーション"
  },
  {
   "id": "23-03",
   "t0": 578.77,
   "t1": 582.65,
   "text": "この輪を、車ではさんで、こすって動かしているのです。",
   "who": "ナレーション"
  },
  {
   "id": "23-04",
   "t0": 583.05,
   "t1": 588.51,
   "text": "ところが、こすって動かすので、どうしても少しすべってしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "24-01",
   "t0": 589.31,
   "t1": 594.59,
   "text": "では、もしすべって手すりが段より遅れたら、どうなるでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "24-02",
   "t0": 595.59,
   "t1": 599.75,
   "text": "すると、頭だけ後ろへ引っぱられて……ころん。",
   "who": "ナレーション"
  },
  {
   "id": "24-03",
   "t0": 600.75,
   "t1": 606.06,
   "text": "同じように、つかまっている人の体も、後ろへ引っぱられてしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "24-04",
   "t0": 606.46,
   "t1": 611.81,
   "text": "そこで、段より少しだけ先へ進むように作られている手すりがあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "24-05",
   "t0": 612.21,
   "t1": 616.68,
   "text": "そうすれば、少しすべっても、段より遅れずにすむのです。",
   "who": "ナレーション"
  },
  {
   "id": "24-06",
   "t0": 617.08,
   "t1": 622.75,
   "text": "つまり、まるロボの頭が前へずれていったのは、このためだったのですね。",
   "who": "ナレーション"
  },
  {
   "id": "24-07",
   "t0": 623.15,
   "t1": 627.77,
   "text": "次にエスカレーターに乗ったら、手の位置を見てみてください。",
   "who": "ナレーション"
  },
  {
   "id": "24-08",
   "t0": 628.17,
   "t1": 634.13,
   "text": "少しずつ前へずれていたら、それは、あなたを守る工夫かもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "25-01",
   "t0": 634.93,
   "t1": 639.11,
   "text": "では、冒頭でまるロボがはじかれた不思議に戻ります。",
   "who": "ナレーション"
  },
  {
   "id": "25-02",
   "t0": 640.51,
   "t1": 645.39,
   "text": "段は床に入れるのに、なぜ、まるロボは入れなかったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "26-01",
   "t0": 646.19,
   "t1": 649.27,
   "text": "まずは、降り口のふちを、よく見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "26-02",
   "t0": 649.67,
   "t1": 656.62,
   "text": "細い歯が、ずらりと並んでいますね。これは「くし」と呼ばれる板です。",
   "who": "ナレーション"
  },
  {
   "id": "26-03",
   "t0": 657.02,
   "t1": 661.14,
   "text": "そして段の表面には、細い溝がたくさん。",
   "who": "ナレーション"
  },
  {
   "id": "26-04",
   "t0": 661.54,
   "t1": 665.12,
   "text": "この溝に、くしの歯がぴったりかみ合っています。",
   "who": "ナレーション"
  },
  {
   "id": "26-05",
   "t0": 665.52,
   "t1": 669.44,
   "text": "では、なぜ段だけが入っていけるのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "26-06",
   "t0": 670.04,
   "t1": 673.64,
   "text": "そこで、真横から、ゆっくり見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "26-07",
   "t0": 674.64,
   "t1": 680.75,
   "text": "すると、段は溝にくしの歯を通しながら、歯の下へもぐっていきます。",
   "who": "ナレーション"
  },
  {
   "id": "26-08",
   "t0": 681.75,
   "t1": 687.37,
   "text": "でも上に乗った物は、歯の上に乗り上げて、床へ押し出されるのです。",
   "who": "ナレーション"
  },
  {
   "id": "26-09",
   "t0": 688.27,
   "t1": 692.76,
   "text": "つまり、まるロボも、このくしにすくい上げられていたのですね。",
   "who": "ナレーション"
  },
  {
   "id": "26-10",
   "t0": 692.98,
   "t1": 696.14,
   "text": "もし、物が強くはさまってしまったら？",
   "who": "ナレーション"
  },
  {
   "id": "26-11",
   "t0": 696.74,
   "t1": 701.09,
   "text": "じつは、くしの歯は、わざと折れやすい材料でできています。",
   "who": "ナレーション"
  },
  {
   "id": "26-12",
   "t0": 701.99,
   "t1": 705.59,
   "text": "歯の先が折れて、はさまった物を逃がすためです。",
   "who": "ナレーション"
  },
  {
   "id": "27-01",
   "t0": 706.39,
   "t1": 713.28,
   "text": "次に、段の横も見てみましょう。段と横の壁の間に、すき間があります。",
   "who": "ナレーション"
  },
  {
   "id": "27-02",
   "t0": 713.68,
   "t1": 718.26,
   "text": "もし、ここに靴のつま先がはさまったら大変ですよね。",
   "who": "ナレーション"
  },
  {
   "id": "27-03",
   "t0": 718.66,
   "t1": 722.32,
   "text": "そこで、このすき間は、5ミリ以下と決まっているのです。",
   "who": "ナレーション"
  },
  {
   "id": "27-04",
   "t0": 722.72,
   "t1": 725.75,
   "text": "1円玉を3枚重ねたくらいの厚さです。",
   "who": "ナレーション"
  },
  {
   "id": "27-05",
   "t0": 726.15,
   "t1": 730.09,
   "text": "これだけせまいと、靴のつま先も入りこめません。",
   "who": "ナレーション"
  },
  {
   "id": "28-01",
   "t0": 730.99,
   "t1": 733.17,
   "text": "ふたたび、夜の点検の時間。",
   "who": "ナレーション"
  },
  {
   "id": "28-02",
   "t0": 733.57,
   "t1": 738.13,
   "text": "今度は、まるロボが、エスカレーターの見張りに挑戦するようです。",
   "who": "ナレーション"
  },
  {
   "id": "28-03",
   "t0": 738.53,
   "t1": 743.34,
   "text": "見張りとは、何かがはさまったら、すぐに止めるしかけのことです。",
   "who": "ナレーション"
  },
  {
   "id": "28-04",
   "t0": 743.74,
   "t1": 747.39,
   "text": "点検のおじさんに見てもらいながら、試してみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "29-01",
   "t0": 748.19,
   "t1": 754.71,
   "text": "まず1つ目は、ここ。手すりが床の下へ入っていく入口です。",
   "who": "ナレーション"
  },
  {
   "id": "29-02",
   "t0": 755.11,
   "t1": 760.32,
   "text": "まるロボが、おもちゃのボールを転がして……入りこみそうになると……。",
   "who": "ナレーション"
  },
  {
   "id": "29-03",
   "t0": 761.72,
   "t1": 766.23,
   "text": "止まりました。入口の奥に、見張りがいたのです。",
   "who": "ナレーション"
  },
  {
   "id": "29-04",
   "t0": 767.13,
   "t1": 771.44,
   "text": "手すりと一緒に、指や服が引きこまれないようにしているのですね。",
   "who": "ナレーション"
  },
  {
   "id": "29-05",
   "t0": 771.84,
   "t1": 774.13,
   "text": "まるロボ、ちょっとくやしそうです。",
   "who": "ナレーション"
  },
  {
   "id": "30-01",
   "t0": 774.93,
   "t1": 779.54,
   "text": "続いて2つ目は、さきほどの段の横のすき間。",
   "who": "ナレーション"
  },
  {
   "id": "30-02",
   "t0": 780.44,
   "t1": 783.37,
   "text": "今度は、リボンをはさんでみると……。",
   "who": "ナレーション"
  },
  {
   "id": "30-03",
   "t0": 784.57,
   "t1": 787.25,
   "text": "ここでも、止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "30-04",
   "t0": 787.65,
   "t1": 792.61,
   "text": "つまり、強くはさまると、ここの見張りが気づいて止めるのです。",
   "who": "ナレーション"
  },
  {
   "id": "31-01",
   "t0": 793.41,
   "t1": 798.76,
   "text": "さらに3つ目は、冒頭でまるロボをすくい上げた、あのくしです。",
   "who": "ナレーション"
  },
  {
   "id": "31-02",
   "t0": 799.56,
   "t1": 802.59,
   "text": "くしの歯に、小石をはさんでみます。",
   "who": "ナレーション"
  },
  {
   "id": "31-03",
   "t0": 803.79,
   "t1": 807.31,
   "text": "くしが押されると……やっぱり、止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "31-04",
   "t0": 807.71,
   "t1": 811.84,
   "text": "ただ、くしの見張りは、付いていないエスカレーターもあります。",
   "who": "ナレーション"
  },
  {
   "id": "32-01",
   "t0": 812.64,
   "t1": 815.7,
   "text": "最後は、手すりそのものを止めてみます。",
   "who": "ナレーション"
  },
  {
   "id": "32-02",
   "t0": 816.1,
   "t1": 819.36,
   "text": "まるロボが、頭で手すりを押さえると……。",
   "who": "ナレーション"
  },
  {
   "id": "32-03",
   "t0": 820.76,
   "t1": 825.83,
   "text": "手すりが止まったことに気づいて、エスカレーター全体が止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "32-04",
   "t0": 826.23,
   "t1": 832.84,
   "text": "なぜなら、手すりだけが止まると、さきほどのように体が後ろへ引っぱられるからです。",
   "who": "ナレーション"
  },
  {
   "id": "32-05",
   "t0": 833.24,
   "t1": 838.89,
   "text": "ちなみに、この見張りは、2024年から付けることが決まったものです。",
   "who": "ナレーション"
  },
  {
   "id": "33-01",
   "t0": 839.69,
   "t1": 843.92,
   "text": "こうして、4つとも、全部止められてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "33-02",
   "t0": 844.32,
   "t1": 847.36,
   "text": "まるロボは、すっかりしょんぼりしています。",
   "who": "ナレーション"
  },
  {
   "id": "33-03",
   "t0": 847.76,
   "t1": 851.91,
   "text": "でも、止まるのは、人を守るためなのですね。",
   "who": "ナレーション"
  },
  {
   "id": "34-01",
   "t0": 852.71,
   "t1": 857.39,
   "text": "そして、おじさんの合図で、まるロボが非常停止ボタンを押してみます。",
   "who": "ナレーション"
  },
  {
   "id": "34-02",
   "t0": 857.79,
   "t1": 862.27,
   "text": "乗り口の近くにある、エスカレーターを止めるためのボタンです。",
   "who": "ナレーション"
  },
  {
   "id": "34-03",
   "t0": 863.17,
   "t1": 863.55,
   "text": "えいっ。",
   "who": "ナレーション"
  },
  {
   "id": "34-04",
   "t0": 864.45,
   "t1": 869.54,
   "text": "段は……すうっと少し進んでから、止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "35-01",
   "t0": 870.34,
   "t1": 874.86,
   "text": "あれ？　すぐに止まったほうが、安全な気がしますよね。",
   "who": "ナレーション"
  },
  {
   "id": "35-02",
   "t0": 875.26,
   "t1": 878.02,
   "text": "もし、ガクンと急に止まったら……。",
   "who": "ナレーション"
  },
  {
   "id": "35-03",
   "t0": 879.22,
   "t1": 883.16,
   "text": "そうなると、乗っている人が前へ転んでしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "35-04",
   "t0": 883.56,
   "t1": 888.59,
   "text": "だから止まるときは、少し進みながら、ゆっくり止まるのです。",
   "who": "ナレーション"
  },
  {
   "id": "36-01",
   "t0": 889.39,
   "t1": 893.79,
   "text": "では、ボタンを押してから、段はどれくらい進んだのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "36-02",
   "t0": 894.39,
   "t1": 898.75,
   "text": "じつは、止まるまでの長さには、決まりがあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "36-03",
   "t0": 899.15,
   "t1": 905.98,
   "text": "たとえば、よくあるエスカレーターは、1分間に30メートル進む速さ。",
   "who": "ナレーション"
  },
  {
   "id": "36-04",
   "t0": 906.38,
   "t1": 913.42,
   "text": "この速さなら、10センチより長く、60センチより短く止まる決まりになっています。",
   "who": "ナレーション"
  },
  {
   "id": "36-05",
   "t0": 914.42,
   "t1": 921.22,
   "text": "実際に、まるロボが転がって測ってみると……ちゃんと、この間に入っていました。",
   "who": "ナレーション"
  },
  {
   "id": "36-06",
   "t0": 922.62,
   "t1": 928.97,
   "text": "急すぎず止まらなすぎず。ちょうどよい止まり方が、決められているのですね。",
   "who": "ナレーション"
  },
  {
   "id": "38-01",
   "t0": 929.87,
   "t1": 935.33,
   "text": "ただし、本物のエスカレーターで、まねして試さないでくださいね。",
   "who": "ナレーション"
  },
  {
   "id": "38-02",
   "t0": 935.73,
   "t1": 939.77,
   "text": "非常停止ボタンは、本当に困ったときに押すボタンです。",
   "who": "ナレーション"
  },
  {
   "id": "39-01",
   "t0": 940.57,
   "t1": 946.65,
   "text": "それでは、まとめです。エスカレーターの段は、どこへ消えるのか。",
   "who": "ナレーション"
  },
  {
   "id": "39-02",
   "t0": 947.05,
   "t1": 953.23,
   "text": "それは、2本のレールの上で形を変えながら、床の下を戻っているからです。",
   "who": "ナレーション"
  },
  {
   "id": "39-03",
   "t0": 953.63,
   "t1": 958.6,
   "text": "段は大きな輪になって、ずっと回り続けていました。",
   "who": "ナレーション"
  },
  {
   "id": "39-04",
   "t0": 959.0,
   "t1": 961.75,
   "text": "そして、なぜ安全に乗れるのか。",
   "who": "ナレーション"
  },
  {
   "id": "39-05",
   "t0": 962.15,
   "t1": 968.86,
   "text": "それは、手すりやくし、見張りや止まり方に人を守る工夫があるからです。",
   "who": "ナレーション"
  },
  {
   "id": "39-06",
   "t0": 969.76,
   "t1": 977.78,
   "text": "毎日なにげなく乗っている階段の下では、たくさんの工夫が、だまって私たちを運んでいるのです。",
   "who": "ナレーション"
  },
  {
   "id": "40-01",
   "t0": 978.58,
   "t1": 981.29,
   "text": "さて、もう一度、乗ってみたまるロボ。",
   "who": "ナレーション"
  },
  {
   "id": "40-02",
   "t0": 982.29,
   "t1": 987.65,
   "text": "降り口が近づくと……今度は、くしの手前で、自分からぴょん！",
   "who": "ナレーション"
  },
  {
   "id": "40-03",
   "t0": 988.55,
   "t1": 990.7,
   "text": "どうやら、ちゃんと覚えたようです。",
   "who": "ナレーション"
  }
 ],
 "notes": "v2 のコメント 27 件を直しました。主な直し：①字幕の切り替わりを、句読点のあとの声の本当の間に合わせた（全部の 261 枚で、2 つの測り方と 1 枚ずつの聞き取りでずれ 0）②題は「段は…」を言う間だけ・長い間を 2 か所詰めた ③シールを大きく、見える所に ④冒頭の小窓・床の下の「いまここ」の地図・赤く光る鎖 ⑤目のライト・段の裏へは切りかえで（通りぬけない）・ふたから「ぴょん」 ⑥突き抜けを道具で全部の場面で数えて直した（コメントの 5 か所＋同じ種類 8 か所）⑦ボールは手すりの端の丸みを転がって入口ではさまる ⑧13:30 は上のくしで撮り直し ⑨ガクンは前へ倒れこむ ⑩40-03 で終わり（台本 v1.1）。点検表：episodes/ep09_escalator/点検_v3.md。冒頭 0:00／1章 しるしを付ける 1:39／2章 床の下へ 3:08／3章 車輪2組と2本のレール 6:11／4章 手すり 8:52／5章 はじかれたのは、なぜ？ 10:34／6章 見張りに挑戦 12:10／まとめ 15:40／オチ 16:18。",
