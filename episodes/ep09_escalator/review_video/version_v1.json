 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 3.84,
   "text": "駅のエスカレーターの前に、まるロボがいます。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 4.24,
   "t1": 9.79,
   "text": "白くて丸い体に、青緑の目が1つ。腕はありません。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 10.19,
   "t1": 13.29,
   "text": "どうやら、エスカレーターに乗ってみたいようです。",
   "who": "ナレーション"
  },
  {
   "id": "01-04",
   "t0": 13.69,
   "t1": 15.7,
   "text": "ぴょんと跳んで、乗り口へ。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 16.9,
   "t1": 19.32,
   "text": "乗ったときは、平らな床でした。",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 19.72,
   "t1": 22.38,
   "text": "ところが、進んでいくと……。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 22.98,
   "t1": 29.13,
   "text": "見てください。足もとの段と、となりの段の高さが、少しずつずれていきます。",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 30.13,
   "t1": 32.56,
   "text": "まるロボも、足もとをきょろきょろ。",
   "who": "ナレーション"
  },
  {
   "id": "02-05",
   "t0": 33.46,
   "t1": 40.44,
   "text": "気がつけば、すっかり階段の形に。まるで、床から段が生えてきたみたいですね。",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 41.24,
   "t1": 44.76,
   "text": "やがて上に着くと、段はまた平らになりました。",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 45.16,
   "t1": 49.49,
   "text": "段は、降り口の床のすき間に、吸いこまれていきます。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 49.89,
   "t1": 52.0,
   "text": "1枚、また1枚……。",
   "who": "ナレーション"
  },
  {
   "id": "03-04",
   "t0": 53.1,
   "t1": 56.95,
   "text": "あれ？　段は、どこへ行ってしまったのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 57.75,
   "t1": 63.69,
   "text": "そこで、気になったまるロボ。段に乗ったまま、一緒に入ってみることにしました。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 64.09,
   "t1": 67.26,
   "text": "だんだん、すき間が目の前に迫ってきます。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 68.26,
   "t1": 70.24,
   "text": "その瞬間……ころん。",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 71.64,
   "t1": 75.36,
   "text": "なんと、まるロボだけ、床の上に残されてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "04-05",
   "t0": 75.76,
   "t1": 79.01,
   "text": "段は入っていけるのに、まるロボは入れません。",
   "who": "ナレーション"
  },
  {
   "id": "04-06",
   "t0": 79.61,
   "t1": 84.21,
   "text": "まるロボも、すき間と自分の体を見比べて、首をかしげています。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 85.01,
   "t1": 87.87,
   "text": "毎日なにげなく乗っている、エスカレーター。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 90.67,
   "t1": 93.7,
   "text": "段は、いったいどこへ消えているのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 94.3,
   "t1": 97.63,
   "text": "そして、まるロボがはじかれたのは、なぜなのか。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 98.03,
   "t1": 100.95,
   "text": "では、まるロボと一緒に、確かめていきましょう。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 101.75,
   "t1": 105.21,
   "text": "まずは、もう一度、降り口のすき間を見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 105.61,
   "t1": 108.74,
   "text": "段は休まずに、次々と消えていきます。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 109.14,
   "t1": 113.86,
   "text": "ふつうなら、消えた段は床の下にたまってしまいそうですよね。",
   "who": "ナレーション"
  },
  {
   "id": "06-04",
   "t0": 114.76,
   "t1": 117.56,
   "text": "一方、下の乗り口を見てください。",
   "who": "ナレーション"
  },
  {
   "id": "06-05",
   "t0": 117.96,
   "t1": 122.34,
   "text": "こちらでは、床のすき間から、段が次々と出てきます。",
   "who": "ナレーション"
  },
  {
   "id": "06-06",
   "t0": 122.74,
   "t1": 128.39,
   "text": "上では消えて、下では出てくる。いったい、どういう関係なのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 129.19,
   "t1": 133.04,
   "text": "そこで、1枚の段に、しるしを付けてみます。",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 133.44,
   "t1": 137.98,
   "text": "このしるしを目じるしにして、段の行き先を追いかけるのです。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 138.38,
   "t1": 143.26,
   "text": "まるロボが、自分の顔のシールを体で押しつけて……ぺたっ。",
   "who": "ナレーション"
  },
  {
   "id": "07-04",
   "t0": 144.26,
   "t1": 147.05,
   "text": "シールの段は、上へ運ばれていきます。",
   "who": "ナレーション"
  },
  {
   "id": "07-05",
   "t0": 148.05,
   "t1": 150.72,
   "text": "やがて降り口で……消えました。",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 151.52,
   "t1": 157.26,
   "text": "それを見たまるロボは、横の階段を跳ねて、急いで下の乗り口へ。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 158.66,
   "t1": 162.57,
   "text": "体をゆらしながら、じっと待っていると……。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 163.77,
   "t1": 168.5,
   "text": "出てきました！　まるロボの顔のシールです。",
   "who": "ナレーション"
  },
  {
   "id": "08-04",
   "t0": 168.9,
   "t1": 173.72,
   "text": "つまり、上で消えた段が、下から戻ってきたのです。",
   "who": "ナレーション"
  },
  {
   "id": "08-05",
   "t0": 174.12,
   "t1": 178.35,
   "text": "どうやら段は、ぐるっと輪になって回っているようですね。",
   "who": "ナレーション"
  },
  {
   "id": "08-06",
   "t0": 178.75,
   "t1": 183.34,
   "text": "でも、床の下で、どうやって戻ってくるのか。",
   "who": "ナレーション"
  },
  {
   "id": "08-07",
   "t0": 183.74,
   "t1": 189.16,
   "text": "それに、平らになったり階段になったりするのは、なぜでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "09-01",
   "t0": 189.96,
   "t1": 194.75,
   "text": "その日の夜。お客さんのいない、点検の時間です。",
   "who": "ナレーション"
  },
  {
   "id": "09-02",
   "t0": 195.15,
   "t1": 200.48,
   "text": "そこで、点検のおじさんにお願いして、床の下に入れてもらいます。",
   "who": "ナレーション"
  },
  {
   "id": "09-03",
   "t0": 200.88,
   "t1": 204.15,
   "text": "おじさんが、降り口の床のふたを外すと……。",
   "who": "ナレーション"
  },
  {
   "id": "09-04",
   "t0": 205.15,
   "t1": 208.95,
   "text": "下には、大きな機械の部屋が広がっていました。",
   "who": "ナレーション"
  },
  {
   "id": "09-05",
   "t0": 209.35,
   "t1": 214.96,
   "text": "エスカレーターは、点検のためのゆっくりした速さで動かしてもらいます。",
   "who": "ナレーション"
  },
  {
   "id": "10-01",
   "t0": 216.16,
   "t1": 220.36,
   "text": "まずは床の下から、降り口のすき間を見上げてみます。",
   "who": "ナレーション"
  },
  {
   "id": "10-02",
   "t0": 220.76,
   "t1": 225.57,
   "text": "ここは、冒頭でまるロボが見ていたすき間の、ちょうど裏側です。",
   "who": "ナレーション"
  },
  {
   "id": "10-03",
   "t0": 225.97,
   "t1": 231.27,
   "text": "見ていると、段は平らな姿のまま、1枚ずつ入ってきますね。",
   "who": "ナレーション"
  },
  {
   "id": "10-04",
   "t0": 231.67,
   "t1": 236.28,
   "text": "では、入ってきた段は、このあとどこへ行くのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "11-01",
   "t0": 237.08,
   "t1": 239.67,
   "text": "段の両側を、よく見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "11-02",
   "t0": 240.07,
   "t1": 243.17,
   "text": "長い鎖が、1本ずつ付いていますね。",
   "who": "ナレーション"
  },
  {
   "id": "11-03",
   "t0": 243.57,
   "t1": 249.75,
   "text": "つまり、段は1枚ずつばらばらではなく、全部この鎖でつながっていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "11-04",
   "t0": 250.15,
   "t1": 253.09,
   "text": "では、この鎖をたどっていくと……。",
   "who": "ナレーション"
  },
  {
   "id": "11-05",
   "t0": 254.29,
   "t1": 258.17,
   "text": "その先の上の端に、大きな歯車がありました。",
   "who": "ナレーション"
  },
  {
   "id": "11-06",
   "t0": 258.57,
   "t1": 262.37,
   "text": "この歯車が回ると、鎖が引っぱられます。",
   "who": "ナレーション"
  },
  {
   "id": "11-07",
   "t0": 262.77,
   "t1": 267.82,
   "text": "鎖が引っぱられると、つながっている段も、一緒に動くのですね。",
   "who": "ナレーション"
  },
  {
   "id": "11-08",
   "t0": 268.22,
   "t1": 272.98,
   "text": "さらに、その歯車を回しているのが、となりのモーター。",
   "who": "ナレーション"
  },
  {
   "id": "11-09",
   "t0": 273.38,
   "t1": 279.29,
   "text": "まとめると、モーターが歯車を回し、歯車が鎖を引っぱります。",
   "who": "ナレーション"
  },
  {
   "id": "11-10",
   "t0": 279.69,
   "t1": 284.39,
   "text": "そして、鎖が段を引っぱる。こういう順番です。",
   "who": "ナレーション"
  },
  {
   "id": "12-00",
   "t0": 285.19,
   "t1": 292.53,
   "text": "でも、歯車の先は、行き止まりです。段はどうするのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "12-01",
   "t0": 293.53,
   "t1": 299.51,
   "text": "見ていると、段は歯車のまわりを回って……くるっと、さかさまに。",
   "who": "ナレーション"
  },
  {
   "id": "12-02",
   "t0": 300.71,
   "t1": 304.55,
   "text": "そのまま斜めの通り道を、下へ戻っていきます。",
   "who": "ナレーション"
  },
  {
   "id": "12-03",
   "t0": 304.95,
   "t1": 310.44,
   "text": "じつは、ここは、私たちが上っていく階段のちょうど真下なのです。",
   "who": "ナレーション"
  },
  {
   "id": "12-04",
   "t0": 310.84,
   "t1": 312.82,
   "text": "中は、真っ暗ですね。",
   "who": "ナレーション"
  },
  {
   "id": "12-05",
   "t0": 313.22,
   "t1": 316.91,
   "text": "まるロボは、目のライトで照らしながら進みます。",
   "who": "ナレーション"
  },
  {
   "id": "12-06",
   "t0": 317.31,
   "t1": 322.17,
   "text": "おや？　さかさまの段の裏に、ちょこんと乗ってしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "12-07",
   "t0": 323.07,
   "t1": 326.36,
   "text": "どうやら、一緒に下っていくつもりのようです。",
   "who": "ナレーション"
  },
  {
   "id": "13-01",
   "t0": 327.56,
   "t1": 332.87,
   "text": "やがて、下の端に着くと、段はもう一度くるっと回ります。",
   "who": "ナレーション"
  },
  {
   "id": "13-02",
   "t0": 333.27,
   "t1": 335.5,
   "text": "今度は、表を向きました。",
   "who": "ナレーション"
  },
  {
   "id": "13-03",
   "t0": 336.4,
   "t1": 342.11,
   "text": "そして平らな姿のまま、乗り口のすき間から外へ出ていきます。",
   "who": "ナレーション"
  },
  {
   "id": "13-04",
   "t0": 342.51,
   "t1": 344.97,
   "text": "まるロボも、下の床のふたから外へ。",
   "who": "ナレーション"
  },
  {
   "id": "13-05",
   "t0": 345.97,
   "t1": 349.8,
   "text": "あれ？　出発した場所に、戻ってきてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "14-00",
   "t0": 350.6,
   "t1": 352.32,
   "text": "ここまでを、まとめてみます。",
   "who": "ナレーション"
  },
  {
   "id": "14-01",
   "t0": 353.22,
   "t1": 359.26,
   "text": "上で消えた段は、床の下をさかさまで戻り、下でまた出てくる。",
   "who": "ナレーション"
  },
  {
   "id": "14-02",
   "t0": 360.46,
   "t1": 365.38,
   "text": "段は大きな輪になって、ずっと回り続けているのです。",
   "who": "ナレーション"
  },
  {
   "id": "14-03",
   "t0": 365.78,
   "t1": 368.63,
   "text": "でも、まだ不思議が残っています。",
   "who": "ナレーション"
  },
  {
   "id": "14-04",
   "t0": 369.03,
   "t1": 374.03,
   "text": "では、平らだった段は、どうして階段の形になるのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "15-01",
   "t0": 375.03,
   "t1": 379.79,
   "text": "その答えを探るために、おじさんが、段を1枚外してくれました。",
   "who": "ナレーション"
  },
  {
   "id": "15-02",
   "t0": 380.79,
   "t1": 385.09,
   "text": "横から見ると、段の両端に、車輪が付いています。",
   "who": "ナレーション"
  },
  {
   "id": "15-03",
   "t0": 385.49,
   "t1": 392.2,
   "text": "前に1つ、後ろに1つ。左右合わせて、車輪が2組です。",
   "who": "ナレーション"
  },
  {
   "id": "15-04",
   "t0": 392.6,
   "t1": 397.72,
   "text": "でも、段1枚に、どうして車輪が2組もいるのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "15-05",
   "t0": 398.32,
   "t1": 402.27,
   "text": "その答えは、車輪が走るレールにありました。",
   "who": "ナレーション"
  },
  {
   "id": "16-01",
   "t0": 403.07,
   "t1": 407.26,
   "text": "よく見ると、車輪が走るレールも、2本あります。",
   "who": "ナレーション"
  },
  {
   "id": "16-02",
   "t0": 407.66,
   "t1": 411.89,
   "text": "1本目は、前の車輪が走る、前のレール。",
   "who": "ナレーション"
  },
  {
   "id": "16-03",
   "t0": 412.29,
   "t1": 416.28,
   "text": "2本目は、後ろの車輪が走る、後ろのレール。",
   "who": "ナレーション"
  },
  {
   "id": "16-04",
   "t0": 416.68,
   "t1": 422.79,
   "text": "このように、前の車輪と後ろの車輪は、それぞれ別のレールを走っているのです。",
   "who": "ナレーション"
  },
  {
   "id": "17-01",
   "t0": 423.59,
   "t1": 425.97,
   "text": "では、模型で確かめてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "17-02",
   "t0": 426.37,
   "t1": 431.84,
   "text": "まずは、前と後ろの車輪を、両方とも前のレールに乗せてみます。",
   "who": "ナレーション"
  },
  {
   "id": "17-03",
   "t0": 432.84,
   "t1": 436.94,
   "text": "すると、段は坂と同じ向きに傾いてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "17-04",
   "t0": 437.34,
   "t1": 440.96,
   "text": "試しに、まるロボが乗ってみると……つるっ。",
   "who": "ナレーション"
  },
  {
   "id": "17-05",
   "t0": 442.16,
   "t1": 445.93,
   "text": "これでは、階段ではなく、すべり台ですね。",
   "who": "ナレーション"
  },
  {
   "id": "17-06",
   "t0": 446.33,
   "t1": 453.41,
   "text": "次に、後ろの車輪だけを、少し離れた所を通る後ろのレールに乗せかえます。",
   "who": "ナレーション"
  },
  {
   "id": "17-07",
   "t0": 454.41,
   "t1": 458.74,
   "text": "すると、段の踏む所が、水平になりました。",
   "who": "ナレーション"
  },
  {
   "id": "17-08",
   "t0": 459.14,
   "t1": 463.23,
   "text": "水平な段が坂に並ぶと……階段の形です！",
   "who": "ナレーション"
  },
  {
   "id": "17-09",
   "t0": 464.13,
   "t1": 467.25,
   "text": "まるロボも、今度はすべらずに乗れています。",
   "who": "ナレーション"
  },
  {
   "id": "17-10",
   "t0": 467.65,
   "t1": 470.72,
   "text": "では、なぜ水平になったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "17-11",
   "t0": 471.32,
   "t1": 478.34,
   "text": "それは、後ろのレールが段の後ろ側を支えて、傾かないように保っているからです。",
   "who": "ナレーション"
  },
  {
   "id": "17-12",
   "t0": 478.74,
   "t1": 484.64,
   "text": "つまり、坂の途中では、この2本のレールが離れて通っているのです。",
   "who": "ナレーション"
  },
  {
   "id": "18-01",
   "t0": 485.44,
   "t1": 489.79,
   "text": "それでは、上と下の端では、どうなっているのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "18-02",
   "t0": 490.39,
   "t1": 494.04,
   "text": "ここでは、2本のレールが近づいていきます。",
   "who": "ナレーション"
  },
  {
   "id": "18-03",
   "t0": 494.84,
   "t1": 499.74,
   "text": "すると、前と後ろの車輪が、ほぼ一直線に並びます。",
   "who": "ナレーション"
  },
  {
   "id": "18-04",
   "t0": 500.54,
   "t1": 506.63,
   "text": "その結果、段どうしが同じ高さにそろって、平らな床になるのです。",
   "who": "ナレーション"
  },
  {
   "id": "18-05",
   "t0": 507.03,
   "t1": 512.12,
   "text": "つまり、段の形を決めていたのは、2本のレールの位置。",
   "who": "ナレーション"
  },
  {
   "id": "18-06",
   "t0": 512.52,
   "t1": 517.4,
   "text": "離れると階段に、近づくと平らになる、というわけです。",
   "who": "ナレーション"
  },
  {
   "id": "20-01",
   "t0": 518.2,
   "t1": 524.35,
   "text": "さて、段はどこへ消えるのか。ここまでで、答えが分かりました。",
   "who": "ナレーション"
  },
  {
   "id": "20-02",
   "t0": 524.75,
   "t1": 531.44,
   "text": "段は2本のレールの上で形を変えながら、床の下をさかさまで戻る。",
   "who": "ナレーション"
  },
  {
   "id": "20-03",
   "t0": 531.84,
   "t1": 535.12,
   "text": "そして、ぐるっと回り続けていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "21-01",
   "t0": 536.02,
   "t1": 538.52,
   "text": "ここからは、もう一つの不思議。",
   "who": "ナレーション"
  },
  {
   "id": "21-02",
   "t0": 538.92,
   "t1": 542.57,
   "text": "エスカレーターは、なぜ安全に乗れるのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "21-03",
   "t0": 543.17,
   "t1": 547.53,
   "text": "まずは、いつもつかまっている手すりに注目してみます。",
   "who": "ナレーション"
  },
  {
   "id": "22-01",
   "t0": 548.33,
   "t1": 554.48,
   "text": "まるロボも、手すりに頭をのせて上ってみます。腕がないので、頭で。",
   "who": "ナレーション"
  },
  {
   "id": "22-02",
   "t0": 555.88,
   "t1": 560.49,
   "text": "……あれ？　頭が、少しずつ前へずれていきますね。",
   "who": "ナレーション"
  },
  {
   "id": "22-03",
   "t0": 561.39,
   "t1": 563.83,
   "text": "のせ直してみても、また前へ。",
   "who": "ナレーション"
  },
  {
   "id": "22-04",
   "t0": 564.83,
   "t1": 568.52,
   "text": "結局、何度のせ直しても、ずれていってしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "23-01",
   "t0": 569.32,
   "t1": 574.14,
   "text": "いったい、なぜでしょう？　手すりのしくみを見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "23-02",
   "t0": 574.54,
   "t1": 582.0,
   "text": "手すりは、ゴムでできた長い輪。段と同じように、床の下を回っているのですね。",
   "who": "ナレーション"
  },
  {
   "id": "23-03",
   "t0": 582.4,
   "t1": 586.28,
   "text": "この輪を、車ではさんで、こすって動かしているのです。",
   "who": "ナレーション"
  },
  {
   "id": "23-04",
   "t0": 586.68,
   "t1": 592.14,
   "text": "ところが、こすって動かすので、どうしても少しすべってしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "24-01",
   "t0": 592.94,
   "t1": 598.22,
   "text": "では、もしすべって手すりが段より遅れたら、どうなるでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "24-02",
   "t0": 599.22,
   "t1": 603.38,
   "text": "すると、頭だけ後ろへ引っぱられて……ころん。",
   "who": "ナレーション"
  },
  {
   "id": "24-03",
   "t0": 604.38,
   "t1": 609.69,
   "text": "同じように、つかまっている人の体も、後ろへ引っぱられてしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "24-04",
   "t0": 610.09,
   "t1": 615.44,
   "text": "そこで、段より少しだけ先へ進むように作られている手すりがあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "24-05",
   "t0": 615.84,
   "t1": 620.31,
   "text": "そうすれば、少しすべっても、段より遅れずにすむのです。",
   "who": "ナレーション"
  },
  {
   "id": "24-06",
   "t0": 620.71,
   "t1": 626.38,
   "text": "つまり、まるロボの頭が前へずれていったのは、このためだったのですね。",
   "who": "ナレーション"
  },
  {
   "id": "24-07",
   "t0": 626.78,
   "t1": 631.4,
   "text": "次にエスカレーターに乗ったら、手の位置を見てみてください。",
   "who": "ナレーション"
  },
  {
   "id": "24-08",
   "t0": 631.8,
   "t1": 637.76,
   "text": "少しずつ前へずれていたら、それは、あなたを守る工夫かもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "25-01",
   "t0": 638.56,
   "t1": 642.74,
   "text": "では、冒頭でまるロボがはじかれた不思議に戻ります。",
   "who": "ナレーション"
  },
  {
   "id": "25-02",
   "t0": 644.14,
   "t1": 649.02,
   "text": "段は床に入れるのに、なぜ、まるロボは入れなかったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "26-01",
   "t0": 649.82,
   "t1": 652.9,
   "text": "まずは、降り口のふちを、よく見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "26-02",
   "t0": 653.3,
   "t1": 660.25,
   "text": "細い歯が、ずらりと並んでいますね。これは「くし」と呼ばれる板です。",
   "who": "ナレーション"
  },
  {
   "id": "26-03",
   "t0": 660.65,
   "t1": 664.77,
   "text": "そして段の表面には、細い溝がたくさん。",
   "who": "ナレーション"
  },
  {
   "id": "26-04",
   "t0": 665.17,
   "t1": 668.75,
   "text": "この溝に、くしの歯がぴったりかみ合っています。",
   "who": "ナレーション"
  },
  {
   "id": "26-05",
   "t0": 669.15,
   "t1": 673.07,
   "text": "では、なぜ段だけが入っていけるのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "26-06",
   "t0": 673.67,
   "t1": 677.27,
   "text": "そこで、真横から、ゆっくり見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "26-07",
   "t0": 678.27,
   "t1": 684.38,
   "text": "すると、段は溝にくしの歯を通しながら、歯の下へもぐっていきます。",
   "who": "ナレーション"
  },
  {
   "id": "26-08",
   "t0": 685.38,
   "t1": 691.0,
   "text": "でも上に乗った物は、歯の上に乗り上げて、床へ押し出されるのです。",
   "who": "ナレーション"
  },
  {
   "id": "26-09",
   "t0": 691.9,
   "t1": 696.21,
   "text": "つまり、まるロボも、このくしにすくい上げられていたのですね。",
   "who": "ナレーション"
  },
  {
   "id": "26-10",
   "t0": 696.61,
   "t1": 699.77,
   "text": "もし、物が強くはさまってしまったら？",
   "who": "ナレーション"
  },
  {
   "id": "26-11",
   "t0": 700.37,
   "t1": 704.72,
   "text": "じつは、くしの歯は、わざと折れやすい材料でできています。",
   "who": "ナレーション"
  },
  {
   "id": "26-12",
   "t0": 705.62,
   "t1": 709.22,
   "text": "歯の先が折れて、はさまった物を逃がすためです。",
   "who": "ナレーション"
  },
  {
   "id": "27-01",
   "t0": 710.02,
   "t1": 716.91,
   "text": "次に、段の横も見てみましょう。段と横の壁の間に、すき間があります。",
   "who": "ナレーション"
  },
  {
   "id": "27-02",
   "t0": 717.31,
   "t1": 721.89,
   "text": "もし、ここに靴のつま先がはさまったら大変ですよね。",
   "who": "ナレーション"
  },
  {
   "id": "27-03",
   "t0": 722.29,
   "t1": 725.95,
   "text": "そこで、このすき間は、5ミリ以下と決まっているのです。",
   "who": "ナレーション"
  },
  {
   "id": "27-04",
   "t0": 726.35,
   "t1": 729.38,
   "text": "1円玉を3枚重ねたくらいの厚さです。",
   "who": "ナレーション"
  },
  {
   "id": "27-05",
   "t0": 729.78,
   "t1": 733.72,
   "text": "これだけせまいと、靴のつま先も入りこめません。",
   "who": "ナレーション"
  },
  {
   "id": "28-01",
   "t0": 734.62,
   "t1": 736.8,
   "text": "ふたたび、夜の点検の時間。",
   "who": "ナレーション"
  },
  {
   "id": "28-02",
   "t0": 737.2,
   "t1": 741.76,
   "text": "今度は、まるロボが、エスカレーターの見張りに挑戦するようです。",
   "who": "ナレーション"
  },
  {
   "id": "28-03",
   "t0": 742.16,
   "t1": 746.97,
   "text": "見張りとは、何かがはさまったら、すぐに止めるしかけのことです。",
   "who": "ナレーション"
  },
  {
   "id": "28-04",
   "t0": 747.37,
   "t1": 751.02,
   "text": "点検のおじさんに見てもらいながら、試してみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "29-01",
   "t0": 751.82,
   "t1": 758.34,
   "text": "まず1つ目は、ここ。手すりが床の下へ入っていく入口です。",
   "who": "ナレーション"
  },
  {
   "id": "29-02",
   "t0": 758.74,
   "t1": 763.95,
   "text": "まるロボが、おもちゃのボールを転がして……入りこみそうになると……。",
   "who": "ナレーション"
  },
  {
   "id": "29-03",
   "t0": 765.35,
   "t1": 769.86,
   "text": "止まりました。入口の奥に、見張りがいたのです。",
   "who": "ナレーション"
  },
  {
   "id": "29-04",
   "t0": 770.76,
   "t1": 775.07,
   "text": "手すりと一緒に、指や服が引きこまれないようにしているのですね。",
   "who": "ナレーション"
  },
  {
   "id": "29-05",
   "t0": 775.47,
   "t1": 777.76,
   "text": "まるロボ、ちょっとくやしそうです。",
   "who": "ナレーション"
  },
  {
   "id": "30-01",
   "t0": 778.56,
   "t1": 783.17,
   "text": "続いて2つ目は、さきほどの段の横のすき間。",
   "who": "ナレーション"
  },
  {
   "id": "30-02",
   "t0": 784.07,
   "t1": 787.0,
   "text": "今度は、リボンをはさんでみると……。",
   "who": "ナレーション"
  },
  {
   "id": "30-03",
   "t0": 788.2,
   "t1": 790.88,
   "text": "ここでも、止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "30-04",
   "t0": 791.28,
   "t1": 796.24,
   "text": "つまり、強くはさまると、ここの見張りが気づいて止めるのです。",
   "who": "ナレーション"
  },
  {
   "id": "31-01",
   "t0": 797.04,
   "t1": 802.39,
   "text": "さらに3つ目は、冒頭でまるロボをすくい上げた、あのくしです。",
   "who": "ナレーション"
  },
  {
   "id": "31-02",
   "t0": 803.19,
   "t1": 806.22,
   "text": "くしの歯に、小石をはさんでみます。",
   "who": "ナレーション"
  },
  {
   "id": "31-03",
   "t0": 807.42,
   "t1": 810.94,
   "text": "くしが押されると……やっぱり、止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "31-04",
   "t0": 811.34,
   "t1": 815.47,
   "text": "ただ、くしの見張りは、付いていないエスカレーターもあります。",
   "who": "ナレーション"
  },
  {
   "id": "32-01",
   "t0": 816.27,
   "t1": 819.33,
   "text": "最後は、手すりそのものを止めてみます。",
   "who": "ナレーション"
  },
  {
   "id": "32-02",
   "t0": 819.73,
   "t1": 822.99,
   "text": "まるロボが、頭で手すりを押さえると……。",
   "who": "ナレーション"
  },
  {
   "id": "32-03",
   "t0": 824.39,
   "t1": 829.46,
   "text": "手すりが止まったことに気づいて、エスカレーター全体が止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "32-04",
   "t0": 829.86,
   "t1": 836.47,
   "text": "なぜなら、手すりだけが止まると、さきほどのように体が後ろへ引っぱられるからです。",
   "who": "ナレーション"
  },
  {
   "id": "32-05",
   "t0": 836.87,
   "t1": 842.52,
   "text": "ちなみに、この見張りは、2024年から付けることが決まったものです。",
   "who": "ナレーション"
  },
  {
   "id": "33-01",
   "t0": 843.32,
   "t1": 847.55,
   "text": "こうして、4つとも、全部止められてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "33-02",
   "t0": 847.95,
   "t1": 850.99,
   "text": "まるロボは、すっかりしょんぼりしています。",
   "who": "ナレーション"
  },
  {
   "id": "33-03",
   "t0": 851.39,
   "t1": 855.54,
   "text": "でも、止まるのは、人を守るためなのですね。",
   "who": "ナレーション"
  },
  {
   "id": "34-01",
   "t0": 856.34,
   "t1": 861.02,
   "text": "そして、おじさんの合図で、まるロボが非常停止ボタンを押してみます。",
   "who": "ナレーション"
  },
  {
   "id": "34-02",
   "t0": 861.42,
   "t1": 865.9,
   "text": "乗り口の近くにある、エスカレーターを止めるためのボタンです。",
   "who": "ナレーション"
  },
  {
   "id": "34-03",
   "t0": 866.8,
   "t1": 867.18,
   "text": "えいっ。",
   "who": "ナレーション"
  },
  {
   "id": "34-04",
   "t0": 868.08,
   "t1": 873.17,
   "text": "段は……すうっと少し進んでから、止まりました。",
   "who": "ナレーション"
  },
  {
   "id": "35-01",
   "t0": 873.97,
   "t1": 878.49,
   "text": "あれ？　すぐに止まったほうが、安全な気がしますよね。",
   "who": "ナレーション"
  },
  {
   "id": "35-02",
   "t0": 878.89,
   "t1": 881.65,
   "text": "もし、ガクンと急に止まったら……。",
   "who": "ナレーション"
  },
  {
   "id": "35-03",
   "t0": 882.85,
   "t1": 886.79,
   "text": "そうなると、乗っている人が前へ転んでしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "35-04",
   "t0": 887.19,
   "t1": 892.22,
   "text": "だから止まるときは、少し進みながら、ゆっくり止まるのです。",
   "who": "ナレーション"
  },
  {
   "id": "36-01",
   "t0": 893.02,
   "t1": 897.42,
   "text": "では、ボタンを押してから、段はどれくらい進んだのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "36-02",
   "t0": 898.02,
   "t1": 902.38,
   "text": "じつは、止まるまでの長さには、決まりがあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "36-03",
   "t0": 902.78,
   "t1": 909.61,
   "text": "たとえば、よくあるエスカレーターは、1分間に30メートル進む速さ。",
   "who": "ナレーション"
  },
  {
   "id": "36-04",
   "t0": 910.01,
   "t1": 917.05,
   "text": "この速さなら、10センチより長く、60センチより短く止まる決まりになっています。",
   "who": "ナレーション"
  },
  {
   "id": "36-05",
   "t0": 918.05,
   "t1": 924.85,
   "text": "実際に、まるロボが転がって測ってみると……ちゃんと、この間に入っていました。",
   "who": "ナレーション"
  },
  {
   "id": "36-06",
   "t0": 926.25,
   "t1": 932.6,
   "text": "急すぎず止まらなすぎず。ちょうどよい止まり方が、決められているのですね。",
   "who": "ナレーション"
  },
  {
   "id": "38-01",
   "t0": 933.5,
   "t1": 938.96,
   "text": "ただし、本物のエスカレーターで、まねして試さないでくださいね。",
   "who": "ナレーション"
  },
  {
   "id": "38-02",
   "t0": 939.36,
   "t1": 943.4,
   "text": "非常停止ボタンは、本当に困ったときに押すボタンです。",
   "who": "ナレーション"
  },
  {
   "id": "39-01",
   "t0": 944.2,
   "t1": 950.28,
   "text": "それでは、まとめです。エスカレーターの段は、どこへ消えるのか。",
   "who": "ナレーション"
  },
  {
   "id": "39-02",
   "t0": 950.68,
   "t1": 956.86,
   "text": "それは、2本のレールの上で形を変えながら、床の下を戻っているからです。",
   "who": "ナレーション"
  },
  {
   "id": "39-03",
   "t0": 957.26,
   "t1": 962.23,
   "text": "段は大きな輪になって、ずっと回り続けていました。",
   "who": "ナレーション"
  },
  {
   "id": "39-04",
   "t0": 962.63,
   "t1": 965.38,
   "text": "そして、なぜ安全に乗れるのか。",
   "who": "ナレーション"
  },
  {
   "id": "39-05",
   "t0": 965.78,
   "t1": 972.49,
   "text": "それは、手すりやくし、見張りや止まり方に人を守る工夫があるからです。",
   "who": "ナレーション"
  },
  {
   "id": "39-06",
   "t0": 973.39,
   "t1": 981.41,
   "text": "毎日なにげなく乗っている階段の下では、たくさんの工夫が、だまって私たちを運んでいるのです。",
   "who": "ナレーション"
  },
  {
   "id": "40-01",
   "t0": 982.21,
   "t1": 984.92,
   "text": "さて、もう一度、乗ってみたまるロボ。",
   "who": "ナレーション"
  },
  {
   "id": "40-02",
   "t0": 985.92,
   "t1": 991.28,
   "text": "降り口が近づくと……今度は、くしの手前で、自分からぴょん！",
   "who": "ナレーション"
  },
  {
   "id": "40-03",
   "t0": 992.18,
   "t1": 996.18,
   "text": "どうやら、ちゃんと覚えたようです。",
   "who": "ナレーション"
  },
  {
   "id": "40-04",
   "t0": 997.08,
   "t1": 1002.76,
   "text": "……と思ったら、着地でよろけて、点検のおじさんの手の中へ。",
   "who": "ナレーション"
  },
  {
   "id": "40-05",
   "t0": 1003.96,
   "t1": 1009.33,
   "text": "エスカレーターの見張りが、もう1人増えてしまったようですね。",
   "who": "ナレーション"
  }
 ],
 "notes": "全部の場面を描いて、声・字幕・札・効果音・BGM をつないだ確認用の通しです（動きの確認 v2 で OK をもらった動きのまま、全 125 場面）。絵はクラウドの軽い描き方（小さい・粗い・3 コマおき）で、本番は PC で描き直します。出す前に確かめたこと：①全場面を時間の順に 5 コマずつ並べ、絵コンテ表の文の欄と 1 行ずつ見比べた（まるロボが手すりの壁や自分の背中に隠れる所・ボールやリボンが見えない所・ボタンが体に隠れる所・札が何もない所を指す所を直した）②通しの音を最初から最後まで聞かせて書き起こした（12-07「下っていく」が聞き取りにくかったので作り直し、38-01 は声が「くださいね」と読むので字幕を合わせた）③人物の動きの飛び（ワープ）を全場面の記録から機械で探し、切り替わりで置き直しが見える所を直した ④字幕と札を幅 390px で見た ⑤効果音を絵コンテの音の欄と見比べた。冒頭 0:00／1章 しるしを付ける 1:41／2章 床の下へ 3:09／3章 車輪2組と2本のレール 6:15／4章 手すり 8:56／5章 はじかれたのは、なぜ？ 10:38／6章 見張りに挑戦 12:14／まとめ 15:44／オチ 16:22。",
