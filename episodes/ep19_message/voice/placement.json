},
{
"no": 125,
"start": 631.991,
"end": 634.711,
"speed": 1.0,
"slot": [
631.991,
634.711
],
"text": "ここで、ふしぎなことがありますね。"
},
{
"no": 126,
"start": 635.311,
"end": 640.031,
"speed": 1.0,
"slot": [
635.311,
640.031
],
"text": "光の線の中は、1秒に地球5周の速さでした。"
},
{
"no": 127,
"start": 640.631,
"end": 646.611,
"speed": 1.0,
"slot": [
640.631,
646.611
],
"text": "東京から大阪まで走っても、およそ0.0025秒しかかかりません。"
},
{
"no": 128,
"start": 647.211,
"end": 652.161,
"speed": 1.0,
"slot": [
647.211,
652.161
],
"text": "それなのに、メッセージの旅には、0.2秒ほどかかります。"
