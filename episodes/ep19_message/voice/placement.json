"no": 122,
"start": 616.231,
"end": 620.751,
"speed": 1.0,
"slot": [
616.231,
620.751
],
"text": "機械は、包みを1つずつ、順番に送り出します。"
},
{
"no": 123,
"start": 621.351,
"end": 624.811,
"speed": 1.0,
"slot": [
621.351,
624.811
],
"text": "だから、混んでいると、ここで待つことになるのです。"
},
{
"no": 124,
"start": 625.411,
"end": 631.391,
"speed": 1.0,
"slot": [
625.411,
631.391
],
