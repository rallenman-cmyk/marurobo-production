"no": 97,
"start": 483.191,
"end": 485.451,
"speed": 1.0,
"slot": [
483.191,
485.451
],
"text": "ここまでの旅を、まとめてみます。"
},
{
"no": 98,
"start": 486.051,
"end": 489.711,
"speed": 1.0,
"slot": [
486.051,
489.711
],
"text": "スマホから、電波で、近くのアンテナへ。"
},
{
"no": 99,
"start": 490.311,
"end": 494.951,
"speed": 1.0,
"slot": [
490.311,
494.951
],
"text": "アンテナから光の線で、携帯の会社の建物へ。"
