"no": 156,
"start": 801.309,
"end": 806.079,
"speed": 1.0,
"slot": [
801.309,
806.079
],
"text": "そのときです。うしろから、ゴゴゴ……という音が。"
},
{
"no": 157,
"start": 806.679,
"end": 811.289,
"speed": 1.0,
"slot": [
806.679,
811.289
