 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 7.35,
   "text": "ある朝。まるロボは、遠くの町に住む友だちに、メッセージを送ることにしました。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 8.25,
   "t1": 12.71,
   "text": "送るのは、ネジのスタンプ。まるロボの、お気に入りです。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 13.31,
   "t1": 16.01,
   "text": "続けて、まるロボの写真も1枚。",
   "who": "ナレーション"
  },
  {
   "id": "01-04",
   "t0": 16.81,
   "t1": 22.56,
   "text": "スマホの画面の上を、ぴょん、ぴょん。送信のボタンへ……えいっ。",
   "who": "ナレーション"
  },
  {
   "id": "01-05",
   "t0": 23.56,
   "t1": 24.78,
   "text": "……もう、届いたようです。",
   "who": "ナレーション"
  },
  {
   "id": "01-06",
   "t0": 25.58,
   "t1": 28.98,
   "text": "相手が読んだという印まで、すぐに付きました。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 29.98,
   "t1": 36.54,
   "text": "送信を押してから、相手に届くまで。かかる時間は、例えば0.2秒ほどです。",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 37.14,
   "t1": 40.21,
   "text": "まばたき1回くらいの、ほんの一瞬ですね。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 40.81,
   "t1": 44.2,
   "text": "でも、友だちが住んでいるのは、遠くの町。",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 44.8,
   "t1": 49.19,
   "text": "そんなに遠くまで、言葉は、いったいどこを通っているのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "02-05",
   "t0": 49.99,
   "t1": 54.6,
   "text": "しかも、写真は、小さなかけらに分かれて運ばれます。",
   "who": "ナレーション"
  },
  {
   "id": "02-06",
   "t0": 55.2,
   "t1": 57.95,
   "text": "その数、2,000個ほどになることも。",
   "who": "ナレーション"
  },
  {
   "id": "02-07",
   "t0": 58.85,
   "t1": 63.16,
   "text": "ばらばらに運ばれるのに、着いたときには元どおりの写真。",
   "who": "ナレーション"
  },
  {
   "id": "02-08",
   "t0": 63.76,
   "t1": 66.05,
   "text": "いったい、どうやって元にもどるのか。",
   "who": "ナレーション"
  },
  {
   "id": "02-09",
   "t0": 66.85,
   "t1": 70.13,
   "text": "答えは、ふだんは見えない所にあります。",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 71.13,
   "t1": 73.59,
   "text": "もしも、送ったメッセージに乗れたら？",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 74.19,
   "t1": 77.89,
   "text": "まるロボと一緒に、0.2秒の旅に出てみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 78.79,
   "t1": 82.19,
   "text": "ここからは、時間を、うんとゆっくりにします。",
   "who": "ナレーション"
  },
  {
   "id": "03-04",
   "t0": 82.79,
   "t1": 88.17,
   "text": "右上の時計を見てください。いまは、0.000秒。",
   "who": "ナレーション"
  },
  {
   "id": "03-05",
   "t0": 88.77,
   "t1": 92.61,
   "text": "時計の数字は、0.2秒で届く場合の目安です。",
   "who": "ナレーション"
  },
  {
   "id": "03-06",
   "t0": 93.41,
   "t1": 96.76,
   "text": "では、もう一度、送信……えいっ。",
   "who": "ナレーション"
  },
  {
   "id": "03-07",
   "t0": 97.66,
   "t1": 101.28,
   "text": "まるロボの体が、ぐんぐん小さくなっていきます。",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 102.88,
   "t1": 108.94,
   "text": "ここは、スマホの中。まるロボは、部品よりも小さくなりました。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 109.84,
   "t1": 115.63,
   "text": "見てください。ネジのスタンプが、光る粒の列に、ほどけていきます。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 116.83,
   "t1": 119.39,
   "text": "いったい、何が起きているのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 119.99,
   "t1": 125.53,
   "text": "じつは、スマホの中で計算する部品は、数字しか扱えません。",
   "who": "ナレーション"
  },
  {
   "id": "04-05",
   "t0": 126.13,
   "t1": 130.04,
   "text": "そこで、文字も絵も、まず数字に置きかえるのです。",
   "who": "ナレーション"
  },
  {
   "id": "04-06",
   "t0": 130.94,
   "t1": 137.69,
   "text": "例えば、文字の「あ」。「あ」には、12354という番号が決まっています。",
   "who": "ナレーション"
  },
  {
   "id": "04-07",
   "t0": 138.29,
   "t1": 144.45,
   "text": "「い」は、12356。文字の1つ1つに、番号があるのです。",
   "who": "ナレーション"
  },
  {
   "id": "04-08",
   "t0": 145.55,
   "t1": 149.73,
   "text": "では、絵は？　絵は、とても細かい点に分けます。",
   "who": "ナレーション"
  },
  {
   "id": "04-09",
   "t0": 150.88,
   "t1": 155.61,
   "text": "そして、1つ1つの点の色を、数字で表しているのです。",
   "who": "ナレーション"
  },
  {
   "id": "04-10",
   "t0": 156.51,
   "t1": 164.11,
   "text": "この光る粒の1つ1つが、その数字。スタンプは、数字の長い列になりました。",
   "who": "ナレーション"
  },
  {
   "id": "04-11",
   "t0": 164.71,
   "t1": 169.72,
   "text": "数字にしておけば、電波にも光にも変えて、遠くまで運べます。",
   "who": "ナレーション"
  },
  {
   "id": "04-12",
   "t0": 170.32,
   "t1": 175.12,
   "text": "つまり、メッセージは、数字の並びになって旅をするのです。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 176.02,
   "t1": 180.35,
   "text": "でも、この数字の列を、そのまま流すわけではありません。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 181.25,
   "t1": 187.09,
   "text": "見てください。数字の列が、小さな箱に、すっと入りました。",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 188.69,
   "t1": 191.99,
   "text": "これが、メッセージを運ぶ「包み」です。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 192.59,
   "t1": 194.85,
   "text": "実際には、パケットと呼ばれています。",
   "who": "ナレーション"
  },
  {
   "id": "05-05",
   "t0": 195.45,
   "t1": 198.9,
   "text": "では、なぜ、わざわざ包みに入れるのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "05-06",
   "t0": 199.9,
   "t1": 204.32,
   "text": "その答えは、包みの外に付いた、この札にあります。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 205.22,
   "t1": 208.83,
   "text": "包みの外の札を、1枚ずつ見てみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 209.63,
   "t1": 215.51,
   "text": "1枚目は、あて先。この包みを、どこへ届けるかです。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 216.11,
   "t1": 220.15,
   "text": "手紙の封筒の表に書く、住所のようなものですね。",
   "who": "ナレーション"
  },
  {
   "id": "06-04",
   "t0": 220.75,
   "t1": 225.85,
   "text": "ただし、ここに書いてあるのは、友だちのスマホではありません。",
   "who": "ナレーション"
  },
  {
   "id": "06-05",
   "t0": 226.45,
   "t1": 230.46,
   "text": "まず向かうのは、遠くの大きな建物です。",
   "who": "ナレーション"
  },
  {
   "id": "06-06",
   "t0": 231.26,
   "t1": 235.57,
   "text": "2枚目は、送り主。だれが送ったか、です。",
   "who": "ナレーション"
  },
  {
   "id": "06-07",
   "t0": 236.17,
   "t1": 239.08,
   "text": "封筒のうらに書く、自分の住所と同じ。",
   "who": "ナレーション"
  },
  {
   "id": "06-08",
   "t0": 239.68,
   "t1": 244.27,
   "text": "届かなかったときの知らせは、この札を見て、送り主に返されます。",
   "who": "ナレーション"
  },
  {
   "id": "06-09",
   "t0": 245.07,
   "t1": 252.14,
   "text": "そして3枚目は、番号。この包みが、何番目の包みかを書いておきます。",
   "who": "ナレーション"
  },
  {
   "id": "06-10",
   "t0": 252.74,
   "t1": 254.68,
   "text": "なぜ、番号まで付けるのか。",
   "who": "ナレーション"
  },
  {
   "id": "06-11",
   "t0": 255.28,
   "t1": 261.19,
   "text": "この番号は、旅の最後で、とても大事な役目をします。覚えておいてくださいね。",
   "who": "ナレーション"
  },
  {
   "id": "06-12",
   "t0": 261.99,
   "t1": 269.73,
   "text": "このように札を付けておけば、途中の機械も、包みをどこへ送ればよいか分かるのです。",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 270.63,
   "t1": 275.72,
   "text": "ところで、1つの包みには、どれくらい入るのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 276.32,
   "t1": 280.49,
   "text": "日本語の文字なら、およそ480文字ほど。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 281.09,
   "t1": 284.98,
   "text": "原稿用紙なら、1枚とちょっとくらいの量です。",
   "who": "ナレーション"
  },
  {
   "id": "07-04",
   "t0": 285.58,
   "t1": 290.72,
   "text": "ネジのスタンプは小さいので、1つの包みに、すっぽり入りました。",
   "who": "ナレーション"
  },
  {
   "id": "07-05",
   "t0": 291.62,
   "t1": 295.63,
   "text": "まるロボも、この包みに、ぎゅっとしがみつきます。",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 296.63,
   "t1": 298.24,
   "text": "では、出発です。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 299.14,
   "t1": 303.41,
   "text": "包みは、スマホのアンテナから、電波になって飛び出しました。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 305.01,
   "t1": 310.4,
   "text": "町の上の空へ。まるロボ、わくわくしているようです。",
   "who": "ナレーション"
  },
  {
   "id": "08-04",
   "t0": 311.0,
   "t1": 313.29,
   "text": "さあ、空の長い旅が……",
   "who": "ナレーション"
  },
  {
   "id": "08-05",
   "t0": 314.09,
   "t1": 314.37,
   "text": "……あれ？",
   "who": "ナレーション"
  },
  {
   "id": "08-06",
   "t0": 315.27,
   "t1": 317.72,
   "text": "もう、近くのアンテナに着いてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "08-07",
   "t0": 318.32,
   "t1": 322.73,
   "text": "スマホから、近くのアンテナまでは、数百mから数kmほど。",
   "who": "ナレーション"
  },
  {
   "id": "08-08",
   "t0": 323.33,
   "t1": 326.22,
   "text": "時計は、まだ0.03秒です。",
   "who": "ナレーション"
  },
  {
   "id": "08-09",
   "t0": 327.12,
   "t1": 329.91,
   "text": "まるロボ、拍子ぬけして、ころん。",
   "who": "ナレーション"
  },
  {
   "id": "08-10",
   "t0": 331.11,
   "t1": 336.0,
   "text": "空の旅は、もう終わり？　では、この先はどこへ？",
   "who": "ナレーション"
  }
 ],
