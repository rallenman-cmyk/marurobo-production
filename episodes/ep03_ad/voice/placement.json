[
{
"no": 1,
"start": 0.5,
"end": 6.79,
"speed": 1.0,
"slot": [
0.5,
6.79
],
"text": "キャンプの話をしたのは、たった一度。今日の昼の、電車の中だけ。"
},
{
"no": 2,
"start": 7.59,
"end": 13.04,
"speed": 1.0,
"slot": [
7.59,
13.04
],
"text": "秋の電車の中。ハルさんとソラさんが、楽しそうに話しています。"
},
{
"no": 3,
"start": 13.44,
"end": 18.44,
"speed": 1.0,
"slot": [
13.44,
18.44
],
"text": "どうやら、今度の休みに、二人でキャンプへ行く話がまとまったみたいです。"
},
{
"no": 4,
"start": 18.84,
"end": 21.54,
"speed": 1.0,
"slot": [
18.84,
21.54
],
"text": "まるロボも、すっかり行く気まんまんです。"
},
{
"no": 5,
"start": 22.34,
"end": 27.0,
"speed": 1.0,
"slot": [
22.34,
27.0
],
"text": "そして、その夜。ハルさんが、スマホでニュースを見ていると……。"
},
{
"no": 6,
"start": 27.7,
"end": 29.85,
"speed": 1.0,
"slot": [
27.7,
29.85
],
"text": "……さきほどの、テントの広告！"
},
{
"no": 7,
"start": 30.25,
"end": 37.09,
"speed": 1.0,
"slot": [
30.25,
37.09
],
"text": "キャンプの話をしたのは、昼間の電車の中だけ。もちろん、テントを調べてもいません。"
},
{
"no": 8,
"start": 37.79,
"end": 41.27,
"speed": 1.0,
"slot": [
37.79,
41.27
],
"text": "……まさか、スマホに会話を聞かれていた？"
},
{
"no": 9,
"start": 41.97,
"end": 44.86,
"speed": 1.0,
"slot": [
41.97,
44.86
],
"text": "……まるロボが、タオルでマイクをふさいでいます。"
},
{
"no": 10,
"start": 45.26,
"end": 46.91,
"speed": 1.0,
"slot": [
45.26,
46.91
],
"text": "気持ちは、分かりますけどね。"
},
{
"no": 11,
"start": 47.71,
"end": 50.91,
"speed": 1.0,
"slot": [
47.71,
50.91
],
"text": "みなさんも、こんな経験はありませんか？"
},
{
"no": 12,
"start": 51.51,
"end": 55.77,
"speed": 1.0,
"slot": [
51.51,
55.77
],
"text": "話しただけの物が、あとでスマホの広告に出てくる。"
},
{
"no": 13,
"start": 56.17,
"end": 58.42,
"speed": 1.0,
"slot": [
56.17,
58.42
],
"text": "ちょっと、こわいですよね。"
},
{
"no": 14,
"start": 59.22,
"end": 63.78,
"speed": 1.0,
"slot": [
59.22,
63.78
],
"text": "スマホは本当に、私たちの会話を聞いているのでしょうか。"
},
{
"no": 15,
"start": 64.18,
"end": 68.29,
"speed": 1.0,
"slot": [
64.18,
68.29
],
"text": "おや？　まるロボが、ハルさんの帽子を……。"
},
{
"no": 16,
"start": 68.89,
"end": 73.24,
"speed": 1.0,
"slot": [
68.89,
73.24
],
"text": "うふふ。どうやら、探偵になって調べてくれるみたいです。"
},
{
"no": 17,
"start": 73.64,
"end": 78.25,
"speed": 1.0,
"slot": [
73.64,
78.25
],
"text": "一緒に、この「テント広告事件」の犯人をさがしてみましょう。"
},
{
"no": 18,
"start": 79.05,
"end": 80.78,
"speed": 1.0,
"slot": [
79.05,
80.78
],
"text": "容疑者は、3人。"
},
{
"no": 19,
"start": 81.18,
"end": 85.77,
"speed": 1.0,
"slot": [
81.18,
85.77
],
"text": "1人目は「マイク」。スマホについている、音を聞く耳です。"
},
{
"no": 20,
"start": 86.17,
"end": 94.73,
"speed": 1.0,
"slot": [
86.17,
94.73
],
"text": "2人目は「出ていく手がかり」。どこへ行ったか、何を見たか。スマホから外へ出ていく情報です。"
},
{
"no": 21,
"start": 95.13,
"end": 98.33,
"speed": 1.0,
"slot": [
95.13,
98.33
],
"text": "そして3人目は……鏡？"
},
{
"no": 22,
"start": 98.93,
"end": 105.25,
"speed": 1.0,
"slot": [
98.93,
105.25
],
"text": "映っているのは、私たち自身。3人目は「わたしたちの記憶」です。"
},
{
"no": 23,
"start": 105.65,
"end": 112.37,
"speed": 1.0,
"slot": [
105.65,
112.37
],
"text": "まるロボ、自分の姿にびっくり。まさか探偵が、自分を疑うことになるとは……。"
},
{
"no": 24,
"start": 112.97,
"end": 116.51,
"speed": 1.0,
"slot": [
112.97,
116.51
],
"text": "それでは、1人ずつ順番に調べていきましょう。"
},
{
"no": 25,
"start": 117.31,
"end": 119.99,
"speed": 1.0,
"slot": [
117.31,
119.99
],
"text": "まずは、1人目の容疑者、マイクから。"
},
{
"no": 26,
"start": 120.39,
"end": 126.95,
"speed": 1.0,
"slot": [
120.39,
126.95
],
"text": "スマホの下の、この小さな穴。これが、マイクの入り口です。"
},
{
"no": 27,
"start": 127.35,
"end": 134.24,
"speed": 1.0,
"slot": [
127.35,
134.24
],
"text": "マイクが、本当に会話を聞いているのか。確かめるには、スマホの中をのぞくのが一番です。"
},
{
"no": 28,
"start": 134.64,
"end": 139.2,
"speed": 1.0,
"slot": [
134.64,
139.2
],
"text": "それではここからは、ハルさんのスマホの中に入ってみましょう。"
},
{
"no": 29,
"start": 139.6,
"end": 150.33,
"speed": 1.0,
"slot": [
139.6,
150.33
],
"text": "ここが、スマホの中……。見渡すかぎり、部品の山！　光っている線は、部品と部品をつなぐ電気の道です。"
},
{
"no": 30,
"start": 151.13,
"end": 154.02,
"speed": 1.0,
"slot": [
151.13,
154.02
],
"text": "マイクは、どこから音を拾ってくるのか？"
},
{
"no": 31,
"start": 154.62,
"end": 163.4,
"speed": 1.0,
"slot": [
154.62,
163.4
],
"text": "外の音が入ってくるのは、この門。柱の穴は、さきほどの小さな穴と同じ並びです。"
},
{
"no": 32,
"start": 163.8,
"end": 167.35,
"speed": 1.0,
"slot": [
163.8,
167.35
],
"text": "そして門の横には、音の見張り番がいます。"
},
{
"no": 33,
"start": 167.75,
"end": 172.41,
"speed": 1.0,
"slot": [
167.75,
172.41
],
"text": "入ってきた音を聞いて、門を開けるかどうかを決める係です。"
},
{
"no": 34,
"start": 172.81,
"end": 177.08,
"speed": 1.0,
"slot": [
172.81,
177.08
],
"text": "この見張り番が待っているのは、たった一つの言葉だけ。"
},
{
"no": 35,
"start": 177.48,
"end": 182.54,
"speed": 1.0,
"slot": [
177.48,
182.54
],
"text": "iPhoneなら「ヘイ」で始まる、スマホを呼び出すあの合言葉です。"
},
{
"no": 36,
"start": 182.94,
"end": 188.03,
"speed": 1.0,
"slot": [
182.94,
188.03
],
"text": "この合言葉が聞こえたときだけ、門を開けて、音を中へ通します。"
},
{
"no": 37,
"start": 188.43,
"end": 197.96,
"speed": 1.0,
"slot": [
188.43,
197.96
],
"text": "ここでは、外の音をこの泡で表しています。話し声も車の音も、みんな泡になって門へ流れてきます。"
},
{
"no": 38,
"start": 198.36,
"end": 203.83,
"speed": 1.0,
"slot": [
198.36,
203.83
],
"text": "合言葉ではない音の泡は、見張り番の前で、すぐに消えてしまいます。"
},
{
"no": 39,
"start": 204.53,
"end": 208.96,
"speed": 1.0,
"slot": [
204.53,
208.96
],
"text": "……あっ、まるロボがつかもうとした音の泡も、消えた。"
},
{
"no": 40,
"start": 209.36,
"end": 216.28,
"speed": 1.0,
"slot": [
209.36,
216.28
],
"text": "合言葉かどうかを聞き分けているのは、この見張り番。つまり、スマホの中の部品です。"
},
{
"no": 41,
"start": 216.68,
"end": 221.95,
"speed": 1.0,
"slot": [
216.68,
221.95
],
"text": "合言葉が聞こえるまでは、音をスマホの外へ送ることはありません。"
},
{
"no": 42,
"start": 222.75,
"end": 225.62,
"speed": 1.0,
"slot": [
222.75,
225.62
],
"text": "本当にそうなのか、試してみましょう。"
},
{
"no": 43,
"start": 226.02,
"end": 232.05,
"speed": 1.0,
"slot": [
226.02,
232.05
],
"text": "外から、私が話しかけてみます。まるロボは、見張り番から目をはなさないで。"
},
{
"no": 44,
"start": 232.45,
"end": 237.52,
"speed": 1.0,
"slot": [
232.45,
237.52
],
"text": "まずは、昼間の電車で話していた言葉。……テント。"
},
{
"no": 45,
"start": 237.92,
"end": 242.24,
"speed": 1.0,
"slot": [
237.92,
242.24
],
"text": "見張り番は、知らん顔。だから、門も開きません。"
},
{
"no": 46,
"start": 242.64,
"end": 249.23,
"speed": 1.0,
"slot": [
242.64,
249.23
],
"text": "では、合言葉と同じ「ヘイ」をつけてみます。……ヘイ、テント！"
},
{
"no": 47,
"start": 249.93,
"end": 255.82,
"speed": 1.0,
"slot": [
249.93,
255.82
],
"text": "……完全に、無視。「ヘイ」がついているだけでは、門は開かないようです。"
},
{
"no": 48,
"start": 256.22,
"end": 261.27,
"speed": 1.0,
"slot": [
256.22,
261.27
],
"text": "それなら、合言葉と聞きまちがえそうな、よく似た言葉では？"
},
{
"no": 49,
"start": 261.87,
"end": 268.45,
"speed": 1.0,
"slot": [
261.87,
268.45
],
"text": "似た言葉でも、皆さんのスマホが反応すると困るので、音は消して字だけでお見せします。"
},
{
"no": 50,
"start": 270.05,
"end": 276.18,
"speed": 1.0,
"slot": [
270.05,
276.18
],
"text": "見張り番が、片目だけ開けた！　でも、すぐに閉じて、門は開きません。"
},
{
"no": 51,
"start": 276.58,
"end": 281.49,
"speed": 1.0,
"slot": [
276.58,
281.49
],
"text": "こんなふうに、似た言葉に、うっかり反応してしまうこともあるんです。"
},
{
"no": 52,
"start": 281.89,
"end": 284.57,
"speed": 1.0,
"slot": [
281.89,
284.57
],
"text": "最後は、いよいよ本物の合言葉。"
},
{
"no": 53,
"start": 284.97,
"end": 287.53,
"speed": 1.0,
"slot": [
284.97,
287.53
],
"text": "もちろん、こちらも音は消しておきますね。"
},
{
"no": 54,
"start": 289.13,
"end": 294.36,
"speed": 1.0,
"slot": [
289.13,
294.36
],
"text": "今度は、見張り番がぱっと目を開けて……門が開きました！"
},
{
"no": 55,
"start": 294.76,
"end": 298.26,
"speed": 1.0,
"slot": [
294.76,
298.26
],
"text": "柱の上のランプが、オレンジ色にともっています。"
},
{
"no": 56,
"start": 298.66,
"end": 301.21,
"speed": 1.0,
"slot": [
298.66,
301.21
],
"text": "外から、スマホの画面を見てみると……。"
},
{
"no": 57,
"start": 301.81,
"end": 305.18,
"speed": 1.0,
"slot": [
301.81,
305.18
],
"text": "画面の右上にも、同じ色の点が見えました。"
},
{
"no": 58,
"start": 305.58,
"end": 310.64,
"speed": 1.0,
"slot": [
305.58,
310.64
],
"text": "このように、マイクが音を聞いているときは、画面に印が出るんです。"
},
{
"no": 59,
"start": 311.44,
"end": 318.47,
"speed": 1.0,
"slot": [
311.44,
318.47
],
"text": "でも、もし合言葉を言わなくても、こっそり門を開けて音を拾うアプリがあったら？"
},
{
"no": 60,
"start": 319.07,
"end": 326.22,
"speed": 1.0,
"slot": [
319.07,
326.22
],
"text": "家での会話も、電話の声も、こっそり聞き放題。考えただけで、ぞっとしますよね。"
},
{
"no": 61,
"start": 326.62,
"end": 334.76,
"speed": 1.0,
"slot": [
326.62,
334.76
],
"text": "そこで2018年、アメリカの大学の研究チームが、1万7千本以上のアプリを調べました。"
},
{
"no": 62,
"start": 335.16,
"end": 341.06,
"speed": 1.0,
"slot": [
335.16,
341.06
],
"text": "調べたのは、アプリが勝手にマイクで音を録って、よそへ送っていないかです。"
},
{
"no": 63,
"start": 341.46,
"end": 345.2,
"speed": 1.0,
"slot": [
341.46,
345.2
],
"text": "結果は……そんなアプリは、一つも見つからなかった！"
},
{
"no": 64,
"start": 345.6,
"end": 354.28,
"speed": 1.0,
"slot": [
345.6,
354.28
],
"text": "ただし、別のものが見つかっています。スマホの画面を勝手に録画して、よその会社へ送るアプリです。"
},
{
"no": 65,
"start": 354.68,
"end": 358.92,
"speed": 1.0,
"slot": [
354.68,
358.92
],
"text": "音ではなくても、気をつける所はある、ということですね。"
},
{
"no": 66,
"start": 359.32,
"end": 364.95,
"speed": 1.0,
"slot": [
359.32,
364.95
],
"text": "では、「テント広告事件」の1人目の容疑者、マイクの調べをまとめると……。"
},
{
"no": 67,
"start": 365.55,
"end": 369.11,
"speed": 1.0,
"slot": [
365.55,
369.11
],
"text": "見張り番は、合言葉のときしか門を開けません。"
},
{
"no": 68,
"start": 369.23,
"end": 374.94,
"speed": 1.0,
"slot": [
369.23,
374.94
],
"text": "似た言葉で開きかけることはあっても、開けばランプと画面の点で分かります。"
},
{
"no": 69,
"start": 375.34,
"end": 381.8,
"speed": 1.0,
"slot": [
375.34,
381.8
],
"text": "そして1万7千本を調べても、こっそり音を送るアプリは見つかりませんでした。"
},
{
"no": 70,
"start": 382.2,
"end": 389.4,
"speed": 1.0,
"slot": [
382.2,
389.4
],
"text": "今わかっている調べでは、マイクが犯人だという証拠はなし。容疑は、ひとまず晴れました。"
},
{
"no": 71,
"start": 389.8,
"end": 396.09,
"speed": 1.0,
"slot": [
389.8,
396.09
],
"text": "では、調べてもいないテントの広告が、なぜハルさんのスマホに出てきたのでしょうか。"
},
{
"no": 72,
"start": 396.89,
"end": 400.75,
"speed": 1.0,
"slot": [
396.89,
400.75
],
"text": "次は、2人目の容疑者。「出ていく手がかり」。"
},
{
"no": 73,
"start": 401.15,
"end": 405.26,
"speed": 1.0,
"slot": [
401.15,
405.26
],
"text": "スマホから外へ出ていく、私たちの情報のことでした。"
},
{
"no": 74,
"start": 405.66,
"end": 413.53,
"speed": 1.0,
"slot": [
405.66,
413.53
],
"text": "ここは、さきほどと同じハルさんのスマホの中。見てください。箱が次々に、外へ出ていく！"
},
{
"no": 75,
"start": 413.93,
"end": 417.98,
"speed": 1.0,
"slot": [
413.93,
417.98
],
"text": "どれも、ハルさんがどんな人なのかを表す手がかりです。"
},
{
"no": 76,
"start": 418.38,
"end": 422.9,
"speed": 1.0,
"slot": [
418.38,
422.9
],
"text": "いったい、何が入った箱なのか。一つずつ、見ていきましょう。"
},
{
"no": 77,
"start": 423.3,
"end": 430.75,
"speed": 1.0,
"slot": [
423.3,
430.75
],
"text": "しずくの印の箱は、「いた場所」。ハルさんのスマホが、いつ、どこにあったかです。"
},
{
"no": 78,
"start": 431.15,
"end": 437.67,
"speed": 1.0,
"slot": [
431.15,
437.67
],
"text": "四角の印の箱は、「見たページ」。ハルさんが、どんなページを見たかです。"
},
{
"no": 79,
"start": 438.07,
"end": 446.61,
"speed": 1.0,
"slot": [
438.07,
446.61
],
"text": "丸が2つの印の箱は、「一緒にいた人」。ハルさんと、同じ時間に同じ場所にいた人です。"
},
{
"no": 80,
"start": 447.01,
"end": 453.33,
"speed": 1.0,
"slot": [
447.01,
453.33
],
"text": "たとえば、同じWi-Fiにつないでいれば、同じ家やお店にいると分かることがあります。"
},
{
"no": 81,
"start": 453.73,
"end": 459.94,
"speed": 1.0,
"slot": [
453.73,
459.94
],
"text": "こうした手がかりは、アプリやサイトを通じて、広告の会社に届くことがあります。"
},
{
"no": 82,
"start": 460.34,
"end": 464.58,
"speed": 1.0,
"slot": [
460.34,
464.58
],
"text": "中には、アプリを入れたときに、私たちが「許可」したものも……。"
},
{
"no": 83,
"start": 465.38,
"end": 469.11,
"speed": 1.0,
"slot": [
465.38,
469.11
],
"text": "では、この箱がどこへ行くのか、追いかけてみましょう。"
},
{
"no": 84,
"start": 469.51,
"end": 475.26,
"speed": 1.0,
"slot": [
469.51,
475.26
],
"text": "箱はスマホを飛び出し、電波に乗って、町をこえ、山をこえて……。"
},
{
"no": 85,
"start": 475.86,
"end": 478.57,
"speed": 1.0,
"slot": [
475.86,
478.57
],
"text": "その先には……大きな会場！"
},
{
"no": 86,
"start": 479.37,
"end": 483.05,
"speed": 1.0,
"slot": [
479.37,
483.05
],
"text": "着いたのは、広告の「競り」の会場でした。"
},
{
"no": 87,
"start": 483.45,
"end": 489.74,
"speed": 1.0,
"slot": [
483.45,
489.74
],
"text": "競りとは、一番高い値段をつけた人が品物を買える、というしくみです。"
},
{
"no": 88,
"start": 490.14,
"end": 496.29,
"speed": 1.0,
"slot": [
490.14,
496.29
],
"text": "ここで売られているのは、あの枠。ハルさんの画面に、広告を出す場所です。"
},
{
"no": 89,
"start": 496.69,
"end": 503.03,
"speed": 1.0,
"slot": [
496.69,
503.03
],
"text": "たとえば、ハルさんがニュースのページを開くと、その瞬間に競りが始まります。"
},
{
"no": 90,
"start": 503.43,
"end": 507.78,
"speed": 1.0,
"slot": [
503.43,
507.78
],
"text": "会社の人たちは、ハルさんの手がかりの札を見て、考えます。"
},
{
"no": 91,
"start": 508.18,
"end": 514.31,
"speed": 1.0,
"slot": [
508.18,
514.31
],
"text": "「ニュースを読んでいる、この人。手がかりを見ると……うちのテントが合いそうだ！」"
},
{
"no": 92,
"start": 514.71,
"end": 521.43,
"speed": 1.0,
"slot": [
514.71,
521.43
],
"text": "そして、一番高い値段をつけたテントの会社の広告が、ニュースのページに出るのです。"
},
{
"no": 93,
"start": 521.83,
"end": 528.51,
"speed": 1.0,
"slot": [
521.83,
528.51
],
"text": "今のは、分かりやすいように、ゆっくり再生したもの。では、本当の速さで見てみましょう。"
},
{
"no": 94,
"start": 529.21,
"end": 530.03,
"speed": 1.0,
"slot": [
529.21,
530.03
],
"text": "……一瞬！"
},
{
"no": 95,
"start": 530.46,
"end": 536.76,
"speed": 1.0,
"slot": [
530.46,
536.76
],
"text": "ページを開いた、ほんの一瞬のうちに、裏ではこんな競りが行われていたのです。"
},
{
"no": 96,
"start": 537.16,
"end": 539.68,
"speed": 1.0,
"slot": [
537.16,
539.68
],
"text": "まるロボ、目で追えなかったみたいです。"
},
{
"no": 97,
"start": 540.48,
"end": 548.1,
"speed": 1.0,
"slot": [
540.48,
548.1
],
"text": "でも、ハルさんはテントを調べていません。テントの会社は、何を手がかりにハルさんを選んだのでしょう。"
},
{
"no": 98,
"start": 548.5,
"end": 552.74,
"speed": 1.0,
"slot": [
548.5,
552.74
],
"text": "ここで、冒頭の電車の場面を、もう一度ふり返ってみると……。"
},
{
"no": 99,
"start": 553.34,
"end": 556.99,
"speed": 1.0,
"slot": [
553.34,
556.99
],
"text": "ソラさんのスマホに……テントの写真がありました！"
},
{
"no": 100,
"start": 557.39,
"end": 562.14,
"speed": 1.0,
"slot": [
557.39,
562.14
],
"text": "そう。どうやらソラさんは、前の日からテントを調べていたようです。"
},
{
"no": 101,
"start": 562.54,
"end": 568.0,
"speed": 1.0,
"slot": [
562.54,
568.0
],
"text": "そして二人のスマホは、同じ電車の無料Wi-Fiにつないでいました。"
},
{
"no": 102,
"start": 568.4,
"end": 573.2,
"speed": 1.0,
"slot": [
568.4,
573.2
],
"text": "つまり、広告の会社から見ると、二人は「一緒にいた人」。"
},
{
"no": 103,
"start": 573.6,
"end": 579.8,
"speed": 1.0,
"slot": [
573.6,
579.8
],
"text": "このように、同じWi-Fiにいた人が調べた物の広告が、出てくることもあるのです。"
},
{
"no": 104,
"start": 580.6,
"end": 583.68,
"speed": 1.0,
"slot": [
580.6,
583.68
],
"text": "あれ？　まるロボが、何かを言いたそうです。"
},
{
"no": 105,
"start": 584.08,
"end": 589.77,
"speed": 1.0,
"slot": [
584.08,
589.77
],
"text": "窓の外を、じっと見つめて……。そこには、紅葉。"
},
{
"no": 106,
"start": 590.17,
"end": 596.62,
"speed": 1.0,
"slot": [
590.17,
596.62
],
"text": "ロボットなのに、季節の移り変わりに気づくとは。なかなかの名探偵です。"
},
{
"no": 107,
"start": 597.02,
"end": 604.98,
"speed": 1.0,
"slot": [
597.02,
604.98
],
"text": "秋は、キャンプに出かける人が多い季節です。キャンプ用品の会社も、ここぞと広告を出します。"
},
{
"no": 108,
"start": 605.38,
"end": 606.63,
"speed": 1.0,
"slot": [
605.38,
606.63
],
"text": "ということは……。"
},
{
"no": 109,
"start": 607.23,
"end": 615.03,
"speed": 1.0,
"slot": [
607.23,
615.03
],
"text": "キャンプの話をしたのも、テントの広告が出たのも、同じ「秋」が理由だったのかもしれません。"
},
{
"no": 110,
"start": 615.43,
"end": 620.37,
"speed": 1.0,
"slot": [
615.43,
620.37
],
"text": "では、2人目の容疑者、出ていく手がかりの調べをまとめると……。"
},
{
"no": 111,
"start": 620.97,
"end": 626.05,
"speed": 1.0,
"slot": [
620.97,
626.05
],
"text": "スマホから出た手がかりは、広告の会社の競りで使われていました。"
},
{
"no": 112,
"start": 626.45,
"end": 632.37,
"speed": 1.0,
"slot": [
626.45,
632.37
],
"text": "ハルさんが調べていなくても、一緒にいた人や季節から、テントが選ばれたのです。"
},
{
"no": 113,
"start": 632.77,
"end": 639.88,
"speed": 1.0,
"slot": [
632.77,
639.88
],
"text": "耳で聞かなくても、手がかりから当ててくる。2人目の容疑者は……かなり怪しいですね。"
},
{
"no": 114,
"start": 640.68,
"end": 644.91,
"speed": 1.0,
"slot": [
640.68,
644.91
],
"text": "最後は、3人目の容疑者。「わたしたちの記憶」。"
},
{
"no": 115,
"start": 645.31,
"end": 652.38,
"speed": 1.0,
"slot": [
645.31,
652.38
],
"text": "あの鏡に映っていた、私たち自身。つまり、私たちの頭の中のことでした。"
},
{
"no": 116,
"start": 652.78,
"end": 655.2,
"speed": 1.0,
"slot": [
652.78,
655.2
],
"text": "ここで、みなさんに問題です。"
},
{
"no": 117,
"start": 655.6,
"end": 662.05,
"speed": 1.0,
"slot": [
655.6,
662.05
],
"text": "昼間の電車のつり広告。テントの絵は、何枚あったでしょう？"
},
{
"no": 118,
"start": 662.65,
"end": 663.48,
"speed": 1.0,
"slot": [
662.65,
663.48
],
"text": "正解は……。"
},
{
"no": 119,
"start": 664.28,
"end": 669.04,
"speed": 1.0,
"slot": [
664.28,
669.04
],
"text": "1枚、2枚、3枚。全部で3枚です！"
},
{
"no": 120,
"start": 669.44,
"end": 670.89,
"speed": 1.0,
"slot": [
669.44,
670.89
],
"text": "気づいていましたか？"
},
{
"no": 121,
"start": 671.49,
"end": 677.5,
"speed": 1.0,
"slot": [
671.49,
677.5
],
"text": "ほとんどの方は、まるロボのかわいらしさに気を取られて、見落としていたかもしれませんね。"
},
{
"no": 122,
"start": 677.9,
"end": 683.84,
"speed": 1.0,
"slot": [
677.9,
683.84
],
"text": "このように、目には入っていたのに、気にしていない物は、ほとんど覚えていないのです。"
},
{
"no": 123,
"start": 684.24,
"end": 692.15,
"speed": 1.0,
"slot": [
684.24,
692.15
],
"text": "もしかすると、二人がキャンプの話を始めたのも、知らないうちに目に入っていた、このつり広告のせい……？"
},
{
"no": 124,
"start": 692.95,
"end": 696.31,
"speed": 1.0,
"slot": [
692.95,
696.31
],
"text": "私たちは、毎日たくさんの広告を見ています。"
},
{
"no": 125,
"start": 696.71,
"end": 700.27,
"speed": 1.0,
"slot": [
696.71,
700.27
],
"text": "でも、そのほとんどは、気にもとめずに忘れていきます。"
},
{
"no": 126,
"start": 700.67,
"end": 705.94,
"speed": 1.0,
"slot": [
700.67,
705.94
],
"text": "ところが、話したばかりの物の広告だけは、「あっ」と目にとまる。"
},
{
"no": 127,
"start": 706.34,
"end": 711.12,
"speed": 1.0,
"slot": [
706.34,
711.12
],
"text": "そして、「話を聞かれていた！」と、強く記憶に残ります。"
},
{
"no": 128,
"start": 711.52,
"end": 716.51,
"speed": 1.0,
"slot": [
711.52,
716.51
],
"text": "反対に、話したのに広告が出なかったことは、誰も覚えていません。"
},
{
"no": 129,
"start": 716.91,
"end": 724.12,
"speed": 1.0,
"slot": [
716.91,
724.12
],
"text": "外れはたくさんあるのに、当たりだけを数えている。だから、よく当たるように感じるのです。"
},
{
"no": 130,
"start": 724.52,
"end": 731.45,
"speed": 1.0,
"slot": [
724.52,
731.45
],
"text": "一度気になった物は、急に目に入るようになる。これも、私たちの頭のくせです。"
},
{
"no": 131,
"start": 731.85,
"end": 740.0,
"speed": 1.0,
"slot": [
731.85,
740.0
],
"text": "3人目の容疑者、わたしたちの記憶。当たったときだけを覚えて、「よく当たる」と感じさせていました。"
},
{
"no": 132,
"start": 740.8,
"end": 746.58,
"speed": 1.0,
"slot": [
740.8,
746.58
],
"text": "3人の容疑者を調べ終えて、これで一件落着……と、思ったそのとき。"
},
{
"no": 133,
"start": 746.98,
"end": 750.65,
"speed": 1.0,
"slot": [
746.98,
750.65
],
"text": "探偵まるロボの前に、新たな容疑者が現れました。"
},
{
"no": 134,
"start": 751.05,
"end": 757.66,
"speed": 1.0,
"slot": [
751.05,
757.66
],
"text": "数年前、アメリカに、「会話を聞いて、広告を出せます」と売り込んでいた会社があったのです。"
},
{
"no": 135,
"start": 758.06,
"end": 759.91,
"speed": 1.0,
"slot": [
758.06,
759.91
],
"text": "やっぱり、聞いていた……？"
},
{
"no": 136,
"start": 760.71,
"end": 767.85,
"speed": 1.0,
"slot": [
760.71,
767.85
],
"text": "もし本当に会話を聞いていたら、大問題。役所が調べに入るのも、当然ですよね。"
},
{
"no": 137,
"start": 768.25,
"end": 773.24,
"speed": 1.0,
"slot": [
768.25,
773.24
],
"text": "アメリカで、商売の不正を取り締まる役所が、この会社を調べました。"
},
{
"no": 138,
"start": 773.64,
"end": 778.29,
"speed": 1.0,
"slot": [
773.64,
778.29
],
"text": "すると……この会社は、会話を何も聞いていなかった。"
},
{
"no": 139,
"start": 778.69,
"end": 785.18,
"speed": 1.0,
"slot": [
778.69,
785.18
],
"text": "なんと、お客さんに渡していたのは、よそから買ってきた、メールアドレスの名簿だったのです。"
},
{
"no": 140,
"start": 785.58,
"end": 791.26,
"speed": 1.0,
"slot": [
785.58,
791.26
],
"text": "会社は、うその宣伝をしたとして、2026年に処分を受けました。"
},
{
"no": 141,
"start": 791.66,
"end": 798.45,
"speed": 1.0,
"slot": [
791.66,
798.45
],
"text": "「聞いている」と言った会社でさえ、聞いていなかった。いや、聞くことができなかったのです。"
},
{
"no": 142,
"start": 799.25,
"end": 801.5,
"speed": 1.0,
"slot": [
799.25,
801.5
],
"text": "それでは、事件をまとめましょう。"
},
{
"no": 143,
"start": 801.9,
"end": 805.67,
"speed": 1.0,
"slot": [
801.9,
805.67
],
"text": "ハルさんのスマホに、なぜテントの広告が出たのか。"
},
{
"no": 144,
"start": 806.07,
"end": 810.87,
"speed": 1.0,
"slot": [
806.07,
810.87
],
"text": "1人目のマイクは、今わかっている調べでは、犯人ではありませんでした。"
},
{
"no": 145,
"start": 811.27,
"end": 814.78,
"speed": 1.0,
"slot": [
811.27,
814.78
],
"text": "2人目の手がかりは……犯人の一人でした。"
},
{
"no": 146,
"start": 815.18,
"end": 821.2,
"speed": 1.0,
"slot": [
815.18,
821.2
],
"text": "いた場所や、一緒にいた人、季節から、好きそうな物を当てていたからです。"
},
{
"no": 147,
"start": 821.6,
"end": 830.48,
"speed": 1.0,
"slot": [
821.6,
830.48
],
"text": "そして3人目、わたしたちの記憶も、犯人の一人でした。当たったときだけを、覚えていたからです。"
},
{
"no": 148,
"start": 830.88,
"end": 836.46,
"speed": 1.0,
"slot": [
830.88,
836.46
],
"text": "そう。この「テント広告事件」の犯人は、一人ではなかったのです。"
},
{
"no": 149,
"start": 836.67,
"end": 839.69,
"speed": 1.0,
"slot": [
836.67,
839.69
],
"text": "スマホの耳は、会話を聞いていない。"
},
{
"no": 150,
"start": 840.09,
"end": 847.0,
"speed": 1.0,
"slot": [
840.09,
847.0
],
"text": "スマホから出ていく、いた場所や一緒にいた人の手がかりから、好きそうな物を予想している。"
},
{
"no": 151,
"start": 847.4,
"end": 852.88,
"speed": 1.0,
"slot": [
847.4,
852.88
],
"text": "そして私たちは、その予想が当たったときだけを覚えている。"
},
{
"no": 152,
"start": 853.35,
"end": 859.2,
"speed": 1.0,
"slot": [
853.35,
859.2
],
"text": "「やっぱり、ちょっと怖い」と感じた方は、設定を見直してみるのも一つの手です。"
},
{
"no": 153,
"start": 859.6,
"end": 865.98,
"speed": 1.0,
"slot": [
859.6,
865.98
],
"text": "広告に使われる手がかりは、スマホやアプリの設定で、見直したり、止めたりできます。"
},
{
"no": 154,
"start": 866.38,
"end": 869.19,
"speed": 1.0,
"slot": [
866.38,
869.19
],
"text": "気になる人は、一度のぞいてみてください。"
},
{
"no": 155,
"start": 869.99,
"end": 877.65,
"speed": 1.0,
"slot": [
869.99,
877.65
],
"text": "事件が解決した、その夜。……おや？　まるロボが、何かこそこそしています。"
},
{
"no": 156,
"start": 878.05,
"end": 883.85,
"speed": 1.0,
"slot": [
878.05,
883.85
],
"text": "どうやら念のため、スマホのマイクに、もう一度だけ話しかけてみるようです。"
},
{
"no": 157,
"start": 884.25,
"end": 890.72,
"speed": 1.0,
"slot": [
884.25,
890.72
],
"text": "ピポ、ピポ……。テントの絵を浮かべて、「テント」と言っているつもりみたいです。"
},
{
"no": 158,
"start": 891.12,
"end": 895.01,
"speed": 1.0,
"slot": [
891.12,
895.01
],
"text": "まるロボ、それではスマホには伝わりませんよ。"
},
{
"no": 159,
"start": 895.71,
"end": 901.53,
"speed": 1.0,
"slot": [
895.71,
901.53
],
"text": "……シーン。何も起きない。まるロボ、ひと安心。"
},
{
"no": 160,
"start": 902.33,
"end": 903.21,
"speed": 1.0,
"slot": [
902.33,
903.21
],
"text": "次の朝。"
},
{
"no": 161,
"start": 904.01,
"end": 907.42,
"speed": 1.0,
"slot": [
904.01,
907.42
],
"text": "……あれ？　まるロボが、ひっくり返っています。"
},
{
"no": 162,
"start": 907.82,
"end": 909.52,
"speed": 1.0,
"slot": [
907.82,
909.52
],
"text": "おばけでも出たのでしょうか？"
},
{
"no": 163,
"start": 910.22,
"end": 911.86,
"speed": 1.0,
"slot": [
910.22,
911.86
],
"text": "……テントの広告です！"
},
{
"no": 164,
"start": 912.26,
"end": 918.25,
"speed": 1.0,
"slot": [
912.26,
918.25
],
"text": "実は昨日の夜、まるロボがこのスマホで、キャンプの動画をずっと見ていたのです。"
},
{
"no": 165,
"start": 918.65,
"end": 923.34,
"speed": 1.0,
"slot": [
918.65,
923.34
],
"text": "自分で見ていたことを忘れて、テントの広告に驚くなんて。"
},
{
"no": 166,
"start": 923.74,
"end": 926.71,
"speed": 1.0,
"slot": [
923.74,
926.71
],
"text": "今回の犯人は……探偵でした。"
}
]