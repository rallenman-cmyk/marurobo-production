[
 {
  "no": 1,
  "start": 0.5,
  "end": 6.79,
  "speed": 1.0,
  "slot": [
   0.5,
   6.79
  ],
  "text": "キャンプの話をしたのは、たった一度。今日の昼の、電車の中だけ。"
 },
 {
  "no": 2,
  "start": 7.59,
  "end": 13.04,
  "speed": 1.0,
  "slot": [
   7.59,
   13.04
  ],
  "text": "秋の電車の中。ハルさんとソラさんが、楽しそうに話しています。"
 },
 {
  "no": 3,
  "start": 13.44,
  "end": 18.44,
  "speed": 1.0,
  "slot": [
   13.44,
   18.44
  ],
  "text": "どうやら、今度の休みに、二人でキャンプへ行く話がまとまったみたいです。"
 },
 {
  "no": 4,
  "start": 18.84,
  "end": 21.54,
  "speed": 1.0,
  "slot": [
   18.84,
   21.54
  ],
  "text": "まるロボも、すっかり行く気まんまんです。"
 },
 {
  "no": 5,
  "start": 22.34,
  "end": 27.0,
  "speed": 1.0,
  "slot": [
   22.34,
   27.0
  ],
  "text": "そして、その夜。ハルさんが、スマホでニュースを見ていると……。"
 },
 {
  "no": 6,
  "start": 27.7,
  "end": 29.85,
  "speed": 1.0,
  "slot": [
   27.7,
   29.85
  ],
  "text": "……さきほどの、テントの広告！"
 },
 {
  "no": 7,
  "start": 30.25,
  "end": 37.09,
  "speed": 1.0,
  "slot": [
   30.25,
   37.09
  ],
  "text": "キャンプの話をしたのは、昼間の電車の中だけ。もちろん、テントを調べてもいません。"
 },
 {
  "no": 8,
  "start": 37.79,
  "end": 41.27,
  "speed": 1.0,
  "slot": [
   37.79,
   41.27
  ],
  "text": "……まさか、スマホに会話を聞かれていた？"
 },
 {
  "no": 9,
  "start": 41.97,
  "end": 44.86,
  "speed": 1.0,
  "slot": [
   41.97,
   44.86
  ],
  "text": "……まるロボが、タオルでマイクをふさいでいます。"
 },
 {
  "no": 10,
  "start": 45.26,
  "end": 46.91,
  "speed": 1.0,
  "slot": [
   45.26,
   46.91
  ],
  "text": "気持ちは、分かりますけどね。"
 },
 {
  "no": 11,
  "start": 47.71,
  "end": 50.91,
  "speed": 1.0,
  "slot": [
   47.71,
   50.91
  ],
  "text": "みなさんも、こんな経験はありませんか？"
 },
 {
  "no": 12,
  "start": 51.51,
  "end": 55.77,
  "speed": 1.0,
  "slot": [
   51.51,
   55.77
  ],
  "text": "話しただけの物が、あとでスマホの広告に出てくる。"
 },
 {
  "no": 13,
  "start": 56.17,
  "end": 58.42,
  "speed": 1.0,
  "slot": [
   56.17,
   58.42
  ],
  "text": "ちょっと、こわいですよね。"
 },
 {
  "no": 14,
  "start": 59.22,
  "end": 63.78,
  "speed": 1.0,
  "slot": [
   59.22,
   63.78
  ],
  "text": "スマホは本当に、私たちの会話を聞いているのでしょうか。"
 },
 {
  "no": 15,
  "start": 64.18,
  "end": 68.29,
  "speed": 1.0,
  "slot": [
   64.18,
   68.29
  ],
  "text": "おや？　まるロボが、ハルさんの帽子を……。"
 },
 {
  "no": 16,
  "start": 68.89,
  "end": 73.24,
  "speed": 1.0,
  "slot": [
   68.89,
   73.24
  ],
  "text": "うふふ。どうやら、探偵になって調べてくれるみたいです。"
 },
 {
  "no": 17,
  "start": 73.64,
  "end": 78.25,
  "speed": 1.0,
  "slot": [
   73.64,
   78.25
  ],
  "text": "一緒に、この「テント広告事件」の犯人をさがしてみましょう。"
 },
 {
  "no": 18,
  "start": 79.05,
  "end": 80.78,
  "speed": 1.0,
  "slot": [
   79.05,
   80.78
  ],
  "text": "容疑者は、3人。"
 },
 {
  "no": 19,
  "start": 81.18,
  "end": 85.77,
  "speed": 1.0,
  "slot": [
   81.18,
   85.77
  ],
  "text": "1人目は「マイク」。スマホについている、音を聞く耳です。"
 },
 {
  "no": 20,
  "start": 86.17,
  "end": 94.73,
  "speed": 1.0,
  "slot": [
   86.17,
   94.73
  ],
  "text": "2人目は「出ていく手がかり」。どこへ行ったか、何を見たか。スマホから外へ出ていく情報です。"
 },
 {
  "no": 21,
  "start": 95.13,
  "end": 98.33,
  "speed": 1.0,
  "slot": [
   95.13,
   98.33
  ],
  "text": "そして3人目は……鏡？"
 },
 {
  "no": 22,
  "start": 98.93,
  "end": 105.25,
  "speed": 1.0,
  "slot": [
   98.93,
   105.25
  ],
  "text": "映っているのは、私たち自身。3人目は「わたしたちの記憶」です。"
 },
 {
  "no": 23,
  "start": 105.65,
  "end": 112.37,
  "speed": 1.0,
  "slot": [
   105.65,
   112.37
  ],
  "text": "まるロボ、自分の姿にびっくり。まさか探偵が、自分を疑うことになるとは……。"
 },
 {
  "no": 24,
  "start": 112.97,
  "end": 116.51,
  "speed": 1.0,
  "slot": [
   112.97,
   116.51
  ],
  "text": "それでは、1人ずつ順番に調べていきましょう。"
 },
 {
  "no": 25,
  "start": 117.31,
  "end": 119.99,
  "speed": 1.0,
  "slot": [
   117.31,
   119.99
  ],
  "text": "まずは、1人目の容疑者、マイクから。"
 },
 {
  "no": 26,
  "start": 120.39,
  "end": 126.95,
  "speed": 1.0,
  "slot": [
   120.39,
   126.95
  ],
  "text": "スマホの下の、この小さな穴。これが、マイクの入り口です。"
 },
 {
  "no": 27,
  "start": 127.35,
  "end": 134.24,
  "speed": 1.0,
  "slot": [
   127.35,
   134.24
  ],
  "text": "マイクが、本当に会話を聞いているのか。確かめるには、スマホの中をのぞくのが一番です。"
 },
 {
  "no": 28,
  "start": 134.64,
  "end": 139.2,
  "speed": 1.0,
  "slot": [
   134.64,
   139.2
  ],
  "text": "それではここからは、ハルさんのスマホの中に入ってみましょう。"
 },
 {
  "no": 29,
  "start": 141.1,
  "end": 151.83,
  "speed": 1.0,
  "slot": [
   141.1,
   151.83
  ],
  "text": "ここが、スマホの中……。見渡すかぎり、部品の山！　光っている線は、部品と部品をつなぐ電気の道です。"
 },
 {
  "no": 30,
  "start": 152.63,
  "end": 155.52,
  "speed": 1.0,
  "slot": [
   152.63,
   155.52
  ],
  "text": "マイクは、どこから音を拾ってくるのか？"
 },
 {
  "no": 31,
  "start": 156.12,
  "end": 164.9,
  "speed": 1.0,
  "slot": [
   156.12,
   164.9
  ],
  "text": "外の音が入ってくるのは、この門。柱の穴は、さきほどの小さな穴と同じ並びです。"
 },
 {
  "no": 32,
  "start": 165.3,
  "end": 168.85,
  "speed": 1.0,
  "slot": [
   165.3,
   168.85
  ],
  "text": "そして門の横には、音の見張り番がいます。"
 },
 {
  "no": 33,
  "start": 169.25,
  "end": 173.91,
  "speed": 1.0,
  "slot": [
   169.25,
   173.91
  ],
  "text": "入ってきた音を聞いて、門を開けるかどうかを決める係です。"
 },
 {
  "no": 34,
  "start": 174.31,
  "end": 178.58,
  "speed": 1.0,
  "slot": [
   174.31,
   178.58
  ],
  "text": "この見張り番が待っているのは、たった一つの言葉だけ。"
 },
 {
  "no": 35,
  "start": 178.98,
  "end": 184.04,
  "speed": 1.0,
  "slot": [
   178.98,
   184.04
  ],
  "text": "iPhoneなら「ヘイ」で始まる、スマホを呼び出すあの合言葉です。"
 },
 {
  "no": 36,
  "start": 184.44,
  "end": 189.53,
  "speed": 1.0,
  "slot": [
   184.44,
   189.53
  ],
  "text": "この合言葉が聞こえたときだけ、門を開けて、音を中へ通します。"
 },
 {
  "no": 37,
  "start": 189.93,
  "end": 199.46,
  "speed": 1.0,
  "slot": [
   189.93,
   199.46
  ],
  "text": "ここでは、外の音をこの泡で表しています。話し声も車の音も、みんな泡になって門へ流れてきます。"
 },
 {
  "no": 38,
  "start": 199.86,
  "end": 205.33,
  "speed": 1.0,
  "slot": [
   199.86,
   205.33
  ],
  "text": "合言葉ではない音の泡は、見張り番の前で、すぐに消えてしまいます。"
 },
 {
  "no": 39,
  "start": 206.03,
  "end": 210.46,
  "speed": 1.0,
  "slot": [
   206.03,
   210.46
  ],
  "text": "……あっ、まるロボがつかもうとした音の泡も、消えた。"
 },
 {
  "no": 40,
  "start": 210.86,
  "end": 217.78,
  "speed": 1.0,
  "slot": [
   210.86,
   217.78
  ],
  "text": "合言葉かどうかを聞き分けているのは、この見張り番。つまり、スマホの中の部品です。"
 },
 {
  "no": 41,
  "start": 218.18,
  "end": 223.45,
  "speed": 1.0,
  "slot": [
   218.18,
   223.45
  ],
  "text": "合言葉が聞こえるまでは、音をスマホの外へ送ることはありません。"
 },
 {
  "no": 42,
  "start": 224.25,
  "end": 227.12,
  "speed": 1.0,
  "slot": [
   224.25,
   227.12
  ],
  "text": "本当にそうなのか、試してみましょう。"
 },
 {
  "no": 43,
  "start": 227.52,
  "end": 233.55,
  "speed": 1.0,
  "slot": [
   227.52,
   233.55
  ],
  "text": "外から、私が話しかけてみます。まるロボは、見張り番から目をはなさないで。"
 },
 {
  "no": 44,
  "start": 235.15,
  "end": 240.22,
  "speed": 1.0,
  "slot": [
   235.15,
   240.22
  ],
  "text": "まずは、昼間の電車で話していた言葉。……テント。"
 },
 {
  "no": 45,
  "start": 242.62,
  "end": 246.94,
  "speed": 1.0,
  "slot": [
   242.62,
   246.94
  ],
  "text": "見張り番は、知らん顔。だから、門も開きません。"
 },
 {
  "no": 46,
  "start": 247.34,
  "end": 253.93,
  "speed": 1.0,
  "slot": [
   247.34,
   253.93
  ],
  "text": "では、合言葉と同じ「ヘイ」をつけてみます。……ヘイ、テント！"
 },
 {
  "no": 47,
  "start": 256.63,
  "end": 262.52,
  "speed": 1.0,
  "slot": [
   256.63,
   262.52
  ],
  "text": "……完全に、無視。「ヘイ」がついているだけでは、門は開かないようです。"
 },
 {
  "no": 48,
  "start": 262.92,
  "end": 267.97,
  "speed": 1.0,
  "slot": [
   262.92,
   267.97
  ],
  "text": "それなら、合言葉と聞きまちがえそうな、よく似た言葉では？"
 },
 {
  "no": 49,
  "start": 268.57,
  "end": 275.15,
  "speed": 1.0,
  "slot": [
   268.57,
   275.15
  ],
  "text": "似た言葉でも、皆さんのスマホが反応すると困るので、音は消して字だけでお見せします。"
 },
 {
  "no": 50,
  "start": 276.75,
  "end": 282.88,
  "speed": 1.0,
  "slot": [
   276.75,
   282.88
  ],
  "text": "見張り番が、片目だけ開けた！　でも、すぐに閉じて、門は開きません。"
 },
 {
  "no": 51,
  "start": 283.28,
  "end": 288.19,
  "speed": 1.0,
  "slot": [
   283.28,
   288.19
  ],
  "text": "こんなふうに、似た言葉に、うっかり反応してしまうこともあるんです。"
 },
 {
  "no": 52,
  "start": 288.59,
  "end": 291.27,
  "speed": 1.0,
  "slot": [
   288.59,
   291.27
  ],
  "text": "最後は、いよいよ本物の合言葉。"
 },
 {
  "no": 53,
  "start": 291.67,
  "end": 294.23,
  "speed": 1.0,
  "slot": [
   291.67,
   294.23
  ],
  "text": "もちろん、こちらも音は消しておきますね。"
 },
 {
  "no": 54,
  "start": 295.83,
  "end": 301.06,
  "speed": 1.0,
  "slot": [
   295.83,
   301.06
  ],
  "text": "今度は、見張り番がぱっと目を開けて……門が開きました！"
 },
 {
  "no": 55,
  "start": 301.46,
  "end": 304.96,
  "speed": 1.0,
  "slot": [
   301.46,
   304.96
  ],
  "text": "柱の上のランプが、オレンジ色にともっています。"
 },
 {
  "no": 56,
  "start": 305.36,
  "end": 307.91,
  "speed": 1.0,
  "slot": [
   305.36,
   307.91
  ],
  "text": "外から、スマホの画面を見てみると……。"
 },
 {
  "no": 57,
  "start": 308.51,
  "end": 311.88,
  "speed": 1.0,
  "slot": [
   308.51,
   311.88
  ],
  "text": "画面の右上にも、同じ色の点が見えました。"
 },
 {
  "no": 58,
  "start": 312.28,
  "end": 317.34,
  "speed": 1.0,
  "slot": [
   312.28,
   317.34
  ],
  "text": "このように、マイクが音を聞いているときは、画面に印が出るんです。"
 },
 {
  "no": 59,
  "start": 318.14,
  "end": 325.17,
  "speed": 1.0,
  "slot": [
   318.14,
   325.17
  ],
  "text": "でも、もし合言葉を言わなくても、こっそり門を開けて音を拾うアプリがあったら？"
 },
 {
  "no": 60,
  "start": 325.77,
  "end": 332.92,
  "speed": 1.0,
  "slot": [
   325.77,
   332.92
  ],
  "text": "家での会話も、電話の声も、こっそり聞き放題。考えただけで、ぞっとしますよね。"
 },
 {
  "no": 61,
  "start": 333.32,
  "end": 341.46,
  "speed": 1.0,
  "slot": [
   333.32,
   341.46
  ],
  "text": "そこで2018年、アメリカの大学の研究チームが、1万7千本以上のアプリを調べました。"
 },
 {
  "no": 62,
  "start": 341.86,
  "end": 347.76,
  "speed": 1.0,
  "slot": [
   341.86,
   347.76
  ],
  "text": "調べたのは、アプリが勝手にマイクで音を録って、よそへ送っていないかです。"
 },
 {
  "no": 63,
  "start": 348.16,
  "end": 351.9,
  "speed": 1.0,
  "slot": [
   348.16,
   351.9
  ],
  "text": "結果は……そんなアプリは、一つも見つからなかった！"
 },
 {
  "no": 64,
  "start": 352.3,
  "end": 360.98,
  "speed": 1.0,
  "slot": [
   352.3,
   360.98
  ],
  "text": "ただし、別のものが見つかっています。スマホの画面を勝手に録画して、よその会社へ送るアプリです。"
 },
 {
  "no": 65,
  "start": 361.38,
  "end": 365.62,
  "speed": 1.0,
  "slot": [
   361.38,
   365.62
  ],
  "text": "音ではなくても、気をつける所はある、ということですね。"
 },
 {
  "no": 66,
  "start": 366.02,
  "end": 371.65,
  "speed": 1.0,
  "slot": [
   366.02,
   371.65
  ],
  "text": "では、「テント広告事件」の1人目の容疑者、マイクの調べをまとめると……。"
 },
 {
  "no": 67,
  "start": 372.25,
  "end": 375.81,
  "speed": 1.0,
  "slot": [
   372.25,
   375.81
  ],
  "text": "見張り番は、合言葉のときしか門を開けません。"
 },
 {
  "no": 68,
  "start": 375.93,
  "end": 381.64,
  "speed": 1.0,
  "slot": [
   375.93,
   381.64
  ],
  "text": "似た言葉で開きかけることはあっても、開けばランプと画面の点で分かります。"
 },
 {
  "no": 69,
  "start": 382.04,
  "end": 388.5,
  "speed": 1.0,
  "slot": [
   382.04,
   388.5
  ],
  "text": "そして1万7千本を調べても、こっそり音を送るアプリは見つかりませんでした。"
 },
 {
  "no": 70,
  "start": 388.9,
  "end": 396.1,
  "speed": 1.0,
  "slot": [
   388.9,
   396.1
  ],
  "text": "今わかっている調べでは、マイクが犯人だという証拠はなし。容疑は、ひとまず晴れました。"
 },
 {
  "no": 71,
  "start": 396.5,
  "end": 402.79,
  "speed": 1.0,
  "slot": [
   396.5,
   402.79
  ],
  "text": "では、調べてもいないテントの広告が、なぜハルさんのスマホに出てきたのでしょうか。"
 },
 {
  "no": 72,
  "start": 403.59,
  "end": 407.45,
  "speed": 1.0,
  "slot": [
   403.59,
   407.45
  ],
  "text": "次は、2人目の容疑者。「出ていく手がかり」。"
 },
 {
  "no": 73,
  "start": 407.85,
  "end": 411.96,
  "speed": 1.0,
  "slot": [
   407.85,
   411.96
  ],
  "text": "スマホから外へ出ていく、私たちの情報のことでした。"
 },
 {
  "no": 74,
  "start": 412.36,
  "end": 420.23,
  "speed": 1.0,
  "slot": [
   412.36,
   420.23
  ],
  "text": "ここは、さきほどと同じハルさんのスマホの中。見てください。箱が次々に、外へ出ていく！"
 },
 {
  "no": 75,
  "start": 420.63,
  "end": 424.68,
  "speed": 1.0,
  "slot": [
   420.63,
   424.68
  ],
  "text": "どれも、ハルさんがどんな人なのかを表す手がかりです。"
 },
 {
  "no": 76,
  "start": 425.08,
  "end": 429.6,
  "speed": 1.0,
  "slot": [
   425.08,
   429.6
  ],
  "text": "いったい、何が入った箱なのか。一つずつ、見ていきましょう。"
 },
 {
  "no": 77,
  "start": 430.0,
  "end": 437.45,
  "speed": 1.0,
  "slot": [
   430.0,
   437.45
  ],
  "text": "しずくの印の箱は、「いた場所」。ハルさんのスマホが、いつ、どこにあったかです。"
 },
 {
  "no": 78,
  "start": 437.85,
  "end": 444.37,
  "speed": 1.0,
  "slot": [
   437.85,
   444.37
  ],
  "text": "四角の印の箱は、「見たページ」。ハルさんが、どんなページを見たかです。"
 },
 {
  "no": 79,
  "start": 444.77,
  "end": 453.31,
  "speed": 1.0,
  "slot": [
   444.77,
   453.31
  ],
  "text": "丸が2つの印の箱は、「一緒にいた人」。ハルさんと、同じ時間に同じ場所にいた人です。"
 },
 {
  "no": 80,
  "start": 453.71,
  "end": 460.03,
  "speed": 1.0,
  "slot": [
   453.71,
   460.03
  ],
  "text": "たとえば、同じWi-Fiにつないでいれば、同じ家やお店にいると分かることがあります。"
 },
 {
  "no": 81,
  "start": 460.43,
  "end": 466.64,
  "speed": 1.0,
  "slot": [
   460.43,
   466.64
  ],
  "text": "こうした手がかりは、アプリやサイトを通じて、広告の会社に届くことがあります。"
 },
 {
  "no": 82,
  "start": 467.04,
  "end": 471.28,
  "speed": 1.0,
  "slot": [
   467.04,
   471.28
  ],
  "text": "中には、アプリを入れたときに、私たちが「許可」したものも……。"
 },
 {
  "no": 83,
  "start": 472.08,
  "end": 475.81,
  "speed": 1.0,
  "slot": [
   472.08,
   475.81
  ],
  "text": "では、この箱がどこへ行くのか、追いかけてみましょう。"
 },
 {
  "no": 84,
  "start": 476.21,
  "end": 481.96,
  "speed": 1.0,
  "slot": [
   476.21,
   481.96
  ],
  "text": "箱はスマホを飛び出し、電波に乗って、町をこえ、山をこえて……。"
 },
 {
  "no": 85,
  "start": 482.56,
  "end": 485.27,
  "speed": 1.0,
  "slot": [
   482.56,
   485.27
  ],
  "text": "その先には……大きな会場！"
 },
 {
  "no": 86,
  "start": 486.07,
  "end": 489.75,
  "speed": 1.0,
  "slot": [
   486.07,
   489.75
  ],
  "text": "着いたのは、広告の「競り」の会場でした。"
 },
 {
  "no": 87,
  "start": 490.15,
  "end": 496.44,
  "speed": 1.0,
  "slot": [
   490.15,
   496.44
  ],
  "text": "競りとは、一番高い値段をつけた人が品物を買える、というしくみです。"
 },
 {
  "no": 88,
  "start": 496.84,
  "end": 502.99,
  "speed": 1.0,
  "slot": [
   496.84,
   502.99
  ],
  "text": "ここで売られているのは、あの枠。ハルさんの画面に、広告を出す場所です。"
 },
 {
  "no": 89,
  "start": 503.39,
  "end": 509.73,
  "speed": 1.0,
  "slot": [
   503.39,
   509.73
  ],
  "text": "たとえば、ハルさんがニュースのページを開くと、その瞬間に競りが始まります。"
 },
 {
  "no": 90,
  "start": 510.13,
  "end": 514.48,
  "speed": 1.0,
  "slot": [
   510.13,
   514.48
  ],
  "text": "会社の人たちは、ハルさんの手がかりの札を見て、考えます。"
 },
 {
  "no": 91,
  "start": 514.88,
  "end": 521.01,
  "speed": 1.0,
  "slot": [
   514.88,
   521.01
  ],
  "text": "「ニュースを読んでいる、この人。手がかりを見ると……うちのテントが合いそうだ！」"
 },
 {
  "no": 92,
  "start": 521.41,
  "end": 528.13,
  "speed": 1.0,
  "slot": [
   521.41,
   528.13
  ],
  "text": "そして、一番高い値段をつけたテントの会社の広告が、ニュースのページに出るのです。"
 },
 {
  "no": 93,
  "start": 528.53,
  "end": 535.21,
  "speed": 1.0,
  "slot": [
   528.53,
   535.21
  ],
  "text": "今のは、分かりやすいように、ゆっくり再生したもの。では、本当の速さで見てみましょう。"
 },
 {
  "no": 94,
  "start": 535.91,
  "end": 536.73,
  "speed": 1.0,
  "slot": [
   535.91,
   536.73
  ],
  "text": "……一瞬！"
 },
 {
  "no": 95,
  "start": 537.16,
  "end": 543.46,
  "speed": 1.0,
  "slot": [
   537.16,
   543.46
  ],
  "text": "ページを開いた、ほんの一瞬のうちに、裏ではこんな競りが行われていたのです。"
 },
 {
  "no": 96,
  "start": 543.86,
  "end": 546.38,
  "speed": 1.0,
  "slot": [
   543.86,
   546.38
  ],
  "text": "まるロボ、目で追えなかったみたいです。"
 },
 {
  "no": 97,
  "start": 547.18,
  "end": 554.8,
  "speed": 1.0,
  "slot": [
   547.18,
   554.8
  ],
  "text": "でも、ハルさんはテントを調べていません。テントの会社は、何を手がかりにハルさんを選んだのでしょう。"
 },
 {
  "no": 98,
  "start": 555.2,
  "end": 559.44,
  "speed": 1.0,
  "slot": [
   555.2,
   559.44
  ],
  "text": "ここで、冒頭の電車の場面を、もう一度ふり返ってみると……。"
 },
 {
  "no": 99,
  "start": 560.04,
  "end": 563.69,
  "speed": 1.0,
  "slot": [
   560.04,
   563.69
  ],
  "text": "ソラさんのスマホに……テントの写真がありました！"
 },
 {
  "no": 100,
  "start": 564.09,
  "end": 568.84,
  "speed": 1.0,
  "slot": [
   564.09,
   568.84
  ],
  "text": "そう。どうやらソラさんは、前の日からテントを調べていたようです。"
 },
 {
  "no": 101,
  "start": 569.24,
  "end": 574.7,
  "speed": 1.0,
  "slot": [
   569.24,
   574.7
  ],
  "text": "そして二人のスマホは、同じ電車の無料Wi-Fiにつないでいました。"
 },
 {
  "no": 102,
  "start": 575.1,
  "end": 579.9,
  "speed": 1.0,
  "slot": [
   575.1,
   579.9
  ],
  "text": "つまり、広告の会社から見ると、二人は「一緒にいた人」。"
 },
 {
  "no": 103,
  "start": 580.3,
  "end": 586.5,
  "speed": 1.0,
  "slot": [
   580.3,
   586.5
  ],
  "text": "このように、同じWi-Fiにいた人が調べた物の広告が、出てくることもあるのです。"
 },
 {
  "no": 104,
  "start": 587.3,
  "end": 590.38,
  "speed": 1.0,
  "slot": [
   587.3,
   590.38
  ],
  "text": "あれ？　まるロボが、何かを言いたそうです。"
 },
 {
  "no": 105,
  "start": 590.78,
  "end": 596.47,
  "speed": 1.0,
  "slot": [
   590.78,
   596.47
  ],
  "text": "窓の外を、じっと見つめて……。そこには、紅葉。"
 },
 {
  "no": 106,
  "start": 596.87,
  "end": 603.32,
  "speed": 1.0,
  "slot": [
   596.87,
   603.32
  ],
  "text": "ロボットなのに、季節の移り変わりに気づくとは。なかなかの名探偵です。"
 },
 {
  "no": 107,
  "start": 603.72,
  "end": 611.68,
  "speed": 1.0,
  "slot": [
   603.72,
   611.68
  ],
  "text": "秋は、キャンプに出かける人が多い季節です。キャンプ用品の会社も、ここぞと広告を出します。"
 },
 {
  "no": 108,
  "start": 612.08,
  "end": 613.33,
  "speed": 1.0,
  "slot": [
   612.08,
   613.33
  ],
  "text": "ということは……。"
 },
 {
  "no": 109,
  "start": 613.93,
  "end": 621.73,
  "speed": 1.0,
  "slot": [
   613.93,
   621.73
  ],
  "text": "キャンプの話をしたのも、テントの広告が出たのも、同じ「秋」が理由だったのかもしれません。"
 },
 {
  "no": 110,
  "start": 622.13,
  "end": 627.07,
  "speed": 1.0,
  "slot": [
   622.13,
   627.07
  ],
  "text": "では、2人目の容疑者、出ていく手がかりの調べをまとめると……。"
 },
 {
  "no": 111,
  "start": 627.67,
  "end": 632.75,
  "speed": 1.0,
  "slot": [
   627.67,
   632.75
  ],
  "text": "スマホから出た手がかりは、広告の会社の競りで使われていました。"
 },
 {
  "no": 112,
  "start": 633.15,
  "end": 639.07,
  "speed": 1.0,
  "slot": [
   633.15,
   639.07
  ],
  "text": "ハルさんが調べていなくても、一緒にいた人や季節から、テントが選ばれたのです。"
 },
 {
  "no": 113,
  "start": 639.47,
  "end": 646.58,
  "speed": 1.0,
  "slot": [
   639.47,
   646.58
  ],
  "text": "耳で聞かなくても、手がかりから当ててくる。2人目の容疑者は……かなり怪しいですね。"
 },
 {
  "no": 114,
  "start": 647.38,
  "end": 651.61,
  "speed": 1.0,
  "slot": [
   647.38,
   651.61
  ],
  "text": "最後は、3人目の容疑者。「わたしたちの記憶」。"
 },
 {
  "no": 115,
  "start": 652.01,
  "end": 659.08,
  "speed": 1.0,
  "slot": [
   652.01,
   659.08
  ],
  "text": "あの鏡に映っていた、私たち自身。つまり、私たちの頭の中のことでした。"
 },
 {
  "no": 116,
  "start": 659.48,
  "end": 661.9,
  "speed": 1.0,
  "slot": [
   659.48,
   661.9
  ],
  "text": "ここで、みなさんに問題です。"
 },
 {
  "no": 117,
  "start": 662.3,
  "end": 668.75,
  "speed": 1.0,
  "slot": [
   662.3,
   668.75
  ],
  "text": "昼間の電車のつり広告。テントの絵は、何枚あったでしょう？"
 },
 {
  "no": 118,
  "start": 669.35,
  "end": 670.18,
  "speed": 1.0,
  "slot": [
   669.35,
   670.18
  ],
  "text": "正解は……。"
 },
 {
  "no": 119,
  "start": 670.98,
  "end": 675.74,
  "speed": 1.0,
  "slot": [
   670.98,
   675.74
  ],
  "text": "1枚、2枚、3枚。全部で3枚です！"
 },
 {
  "no": 120,
  "start": 676.14,
  "end": 677.59,
  "speed": 1.0,
  "slot": [
   676.14,
   677.59
  ],
  "text": "気づいていましたか？"
 },
 {
  "no": 121,
  "start": 678.19,
  "end": 684.2,
  "speed": 1.0,
  "slot": [
   678.19,
   684.2
  ],
  "text": "ほとんどの方は、まるロボのかわいらしさに気を取られて、見落としていたかもしれませんね。"
 },
 {
  "no": 122,
  "start": 684.6,
  "end": 690.54,
  "speed": 1.0,
  "slot": [
   684.6,
   690.54
  ],
  "text": "このように、目には入っていたのに、気にしていない物は、ほとんど覚えていないのです。"
 },
 {
  "no": 123,
  "start": 690.94,
  "end": 698.85,
  "speed": 1.0,
  "slot": [
   690.94,
   698.85
  ],
  "text": "もしかすると、二人がキャンプの話を始めたのも、知らないうちに目に入っていた、このつり広告のせい……？"
 },
 {
  "no": 124,
  "start": 699.65,
  "end": 703.01,
  "speed": 1.0,
  "slot": [
   699.65,
   703.01
  ],
  "text": "私たちは、毎日たくさんの広告を見ています。"
 },
 {
  "no": 125,
  "start": 703.41,
  "end": 706.97,
  "speed": 1.0,
  "slot": [
   703.41,
   706.97
  ],
  "text": "でも、そのほとんどは、気にもとめずに忘れていきます。"
 },
 {
  "no": 126,
  "start": 707.37,
  "end": 712.64,
  "speed": 1.0,
  "slot": [
   707.37,
   712.64
  ],
  "text": "ところが、話したばかりの物の広告だけは、「あっ」と目にとまる。"
 },
 {
  "no": 127,
  "start": 713.04,
  "end": 717.82,
  "speed": 1.0,
  "slot": [
   713.04,
   717.82
  ],
  "text": "そして、「話を聞かれていた！」と、強く記憶に残ります。"
 },
 {
  "no": 128,
  "start": 718.22,
  "end": 723.21,
  "speed": 1.0,
  "slot": [
   718.22,
   723.21
  ],
  "text": "反対に、話したのに広告が出なかったことは、誰も覚えていません。"
 },
 {
  "no": 129,
  "start": 723.61,
  "end": 730.82,
  "speed": 1.0,
  "slot": [
   723.61,
   730.82
  ],
  "text": "外れはたくさんあるのに、当たりだけを数えている。だから、よく当たるように感じるのです。"
 },
 {
  "no": 130,
  "start": 731.22,
  "end": 738.15,
  "speed": 1.0,
  "slot": [
   731.22,
   738.15
  ],
  "text": "一度気になった物は、急に目に入るようになる。これも、私たちの頭のくせです。"
 },
 {
  "no": 131,
  "start": 738.55,
  "end": 746.7,
  "speed": 1.0,
  "slot": [
   738.55,
   746.7
  ],
  "text": "3人目の容疑者、わたしたちの記憶。当たったときだけを覚えて、「よく当たる」と感じさせていました。"
 },
 {
  "no": 132,
  "start": 747.5,
  "end": 753.28,
  "speed": 1.0,
  "slot": [
   747.5,
   753.28
  ],
  "text": "3人の容疑者を調べ終えて、これで一件落着……と、思ったそのとき。"
 },
 {
  "no": 133,
  "start": 753.68,
  "end": 757.35,
  "speed": 1.0,
  "slot": [
   753.68,
   757.35
  ],
  "text": "探偵まるロボの前に、新たな容疑者が現れました。"
 },
 {
  "no": 134,
  "start": 757.75,
  "end": 764.36,
  "speed": 1.0,
  "slot": [
   757.75,
   764.36
  ],
  "text": "数年前、アメリカに、「会話を聞いて、広告を出せます」と売り込んでいた会社があったのです。"
 },
 {
  "no": 135,
  "start": 764.76,
  "end": 766.61,
  "speed": 1.0,
  "slot": [
   764.76,
   766.61
  ],
  "text": "やっぱり、聞いていた……？"
 },
 {
  "no": 136,
  "start": 767.41,
  "end": 774.55,
  "speed": 1.0,
  "slot": [
   767.41,
   774.55
  ],
  "text": "もし本当に会話を聞いていたら、大問題。役所が調べに入るのも、当然ですよね。"
 },
 {
  "no": 137,
  "start": 774.95,
  "end": 779.94,
  "speed": 1.0,
  "slot": [
   774.95,
   779.94
  ],
  "text": "アメリカで、商売の不正を取り締まる役所が、この会社を調べました。"
 },
 {
  "no": 138,
  "start": 780.34,
  "end": 784.99,
  "speed": 1.0,
  "slot": [
   780.34,
   784.99
  ],
  "text": "すると……この会社は、会話を何も聞いていなかった。"
 },
 {
  "no": 139,
  "start": 785.39,
  "end": 791.88,
  "speed": 1.0,
  "slot": [
   785.39,
   791.88
  ],
  "text": "なんと、お客さんに渡していたのは、よそから買ってきた、メールアドレスの名簿だったのです。"
 },
 {
  "no": 140,
  "start": 792.28,
  "end": 797.96,
  "speed": 1.0,
  "slot": [
   792.28,
   797.96
  ],
  "text": "会社は、うその宣伝をしたとして、2026年に処分を受けました。"
 },
 {
  "no": 141,
  "start": 798.36,
  "end": 805.15,
  "speed": 1.0,
  "slot": [
   798.36,
   805.15
  ],
  "text": "「聞いている」と言った会社でさえ、聞いていなかった。いや、聞くことができなかったのです。"
 },
 {
  "no": 142,
  "start": 805.95,
  "end": 808.2,
  "speed": 1.0,
  "slot": [
   805.95,
   808.2
  ],
  "text": "それでは、事件をまとめましょう。"
 },
 {
  "no": 143,
  "start": 808.6,
  "end": 812.37,
  "speed": 1.0,
  "slot": [
   808.6,
   812.37
  ],
  "text": "ハルさんのスマホに、なぜテントの広告が出たのか。"
 },
 {
  "no": 144,
  "start": 812.77,
  "end": 817.57,
  "speed": 1.0,
  "slot": [
   812.77,
   817.57
  ],
  "text": "1人目のマイクは、今わかっている調べでは、犯人ではありませんでした。"
 },
 {
  "no": 145,
  "start": 817.97,
  "end": 821.48,
  "speed": 1.0,
  "slot": [
   817.97,
   821.48
  ],
  "text": "2人目の手がかりは……犯人の一人でした。"
 },
 {
  "no": 146,
  "start": 821.88,
  "end": 827.9,
  "speed": 1.0,
  "slot": [
   821.88,
   827.9
  ],
  "text": "いた場所や、一緒にいた人、季節から、好きそうな物を当てていたからです。"
 },
 {
  "no": 147,
  "start": 828.3,
  "end": 837.18,
  "speed": 1.0,
  "slot": [
   828.3,
   837.18
  ],
  "text": "そして3人目、わたしたちの記憶も、犯人の一人でした。当たったときだけを、覚えていたからです。"
 },
 {
  "no": 148,
  "start": 837.58,
  "end": 843.16,
  "speed": 1.0,
  "slot": [
   837.58,
   843.16
  ],
  "text": "そう。この「テント広告事件」の犯人は、一人ではなかったのです。"
 },
 {
  "no": 149,
  "start": 843.37,
  "end": 846.39,
  "speed": 1.0,
  "slot": [
   843.37,
   846.39
  ],
  "text": "スマホの耳は、会話を聞いていない。"
 },
 {
  "no": 150,
  "start": 846.79,
  "end": 853.7,
  "speed": 1.0,
  "slot": [
   846.79,
   853.7
  ],
  "text": "スマホから出ていく、いた場所や一緒にいた人の手がかりから、好きそうな物を予想している。"
 },
 {
  "no": 151,
  "start": 854.1,
  "end": 859.58,
  "speed": 1.0,
  "slot": [
   854.1,
   859.58
  ],
  "text": "そして私たちは、その予想が当たったときだけを覚えている。"
 },
 {
  "no": 152,
  "start": 860.05,
  "end": 865.9,
  "speed": 1.0,
  "slot": [
   860.05,
   865.9
  ],
  "text": "「やっぱり、ちょっと怖い」と感じた方は、設定を見直してみるのも一つの手です。"
 },
 {
  "no": 153,
  "start": 866.3,
  "end": 872.68,
  "speed": 1.0,
  "slot": [
   866.3,
   872.68
  ],
  "text": "広告に使われる手がかりは、スマホやアプリの設定で、見直したり、止めたりできます。"
 },
 {
  "no": 154,
  "start": 873.08,
