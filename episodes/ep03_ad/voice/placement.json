[
{
"no": 1,
"start": 0.5,
"end": 6.79,
"speed": 1.0,
"slot": [
0.5,
6.79
],
"text": "キャンプの話をしたのは、たった一度。今日の昼の、電車の中だけ。"
},
{
"no": 2,
"start": 7.59,
"end": 13.04,
"speed": 1.0,
"slot": [
7.59,
13.04
],
"text": "秋の電車の中。ハルさんとソラさんが、楽しそうに話しています。"
},
{
"no": 3,
"start": 13.44,
"end": 18.44,
"speed": 1.0,
"slot": [
13.44,
18.44
],
"text": "どうやら、今度の休みに、二人でキャンプへ行く話がまとまったみたいです。"
},
{
"no": 4,
"start": 18.84,
"end": 21.54,
"speed": 1.0,
"slot": [
18.84,
21.54
],
"text": "まるロボも、すっかり行く気まんまんです。"
},
{
"no": 5,
"start": 22.34,
"end": 27.0,
"speed": 1.0,
"slot": [
22.34,
27.0
],
"text": "そして、その夜。ハルさんが、スマホでニュースを見ていると……。"
},
{
"no": 6,
"start": 27.7,
"end": 29.85,
"speed": 1.0,
"slot": [
27.7,
29.85
],
"text": "……さきほどの、テントの広告！"
},
{
"no": 7,
"start": 30.25,
"end": 37.09,
"speed": 1.0,
"slot": [
30.25,
37.09
],
"text": "キャンプの話をしたのは、昼間の電車の中だけ。もちろん、テントを調べてもいません。"
},
{
"no": 8,
"start": 37.79,
"end": 41.27,
"speed": 1.0,
"slot": [
37.79,
41.27
],
"text": "……まさか、スマホに会話を聞かれていた？"
},
{
"no": 9,
"start": 41.97,
"end": 44.86,
"speed": 1.0,
"slot": [
41.97,
44.86
],
"text": "……まるロボが、タオルでマイクをふさいでいます。"
},
{
"no": 10,
"start": 45.26,
"end": 46.91,
"speed": 1.0,
"slot": [
45.26,
46.91
],
"text": "気持ちは、分かりますけどね。"
},
{
"no": 11,
"start": 47.71,
"end": 50.91,
"speed": 1.0,
"slot": [
47.71,
50.91
],
"text": "みなさんも、こんな経験はありませんか？"
},
{
"no": 12,
"start": 51.51,
"end": 55.77,
"speed": 1.0,
"slot": [
51.51,
55.77
],
"text": "話しただけの物が、あとでスマホの広告に出てくる。"
},
{
"no": 13,
"start": 56.17,
"end": 58.42,
"speed": 1.0,
"slot": [
56.17,
58.42
],
"text": "ちょっと、こわいですよね。"
},
{
"no": 14,
"start": 59.22,
"end": 63.78,
"speed": 1.0,
"slot": [
59.22,
63.78
],
"text": "スマホは本当に、私たちの会話を聞いているのでしょうか。"
},
{
"no": 15,
"start": 64.18,
"end": 68.29,
"speed": 1.0,
"slot": [
64.18,
68.29
],
"text": "おや？　まるロボが、ハルさんの帽子を……。"
},
{
"no": 16,
"start": 68.89,
"end": 73.24,
"speed": 1.0,
"slot": [
68.89,
73.24
],
"text": "うふふ。どうやら、探偵になって調べてくれるみたいです。"
},
{
"no": 17,
"start": 73.64,
"end": 78.25,
"speed": 1.0,
"slot": [
73.64,
78.25
],
"text": "一緒に、この「テント広告事件」の犯人をさがしてみましょう。"
},
{
"no": 18,
"start": 79.05,
"end": 80.78,
"speed": 1.0,
"slot": [
79.05,
80.78
],
"text": "容疑者は、3人。"
},
{
"no": 19,
"start": 81.18,
"end": 85.77,
"speed": 1.0,
"slot": [
81.18,
85.77
],
"text": "1人目は「マイク」。スマホについている、音を聞く耳です。"
},
{
"no": 20,
"start": 86.17,
"end": 94.73,
"speed": 1.0,
"slot": [
86.17,
94.73
],
"text": "2人目は「出ていく手がかり」。どこへ行ったか、何を見たか。スマホから外へ出ていく情報です。"
},
{
"no": 21,
"start": 95.13,
"end": 98.33,
"speed": 1.0,
"slot": [
95.13,
98.33
],
"text": "そして3人目は……鏡？"
},
{
"no": 22,
"start": 98.93,
"end": 105.25,
"speed": 1.0,
"slot": [
98.93,
105.25
],
"text": "映っているのは、私たち自身。3人目は「わたしたちの記憶」です。"
},
{
"no": 23,
"start": 105.65,
"end": 112.37,
"speed": 1.0,
"slot": [
105.65,
112.37
],
"text": "まるロボ、自分の姿にびっくり。まさか探偵が、自分を疑うことになるとは……。"
},
{
"no": 24,
"start": 112.97,
"end": 116.51,
"speed": 1.0,
"slot": [
112.97,
116.51
],
"text": "それでは、1人ずつ順番に調べていきましょう。"
},
{
"no": 25,
"start": 117.31,
"end": 119.99,
"speed": 1.0,
"slot": [
117.31,
119.99
],
"text": "まずは、1人目の容疑者、マイクから。"
},
{
"no": 26,
"start": 120.39,
"end": 126.95,
"speed": 1.0,
"slot": [
120.39,
126.95
],
"text": "スマホの下の、この小さな穴。これが、マイクの入り口です。"
},
{
"no": 27,
"start": 127.35,
"end": 134.24,
"speed": 1.0,
"slot": [
127.35,
134.24
],
"text": "マイクが、本当に会話を聞いているのか。確かめるには、スマホの中をのぞくのが一番です。"
},
{
"no": 28,
"start": 134.64,
"end": 139.2,
"speed": 1.0,
"slot": [
134.64,
139.2
],
"text": "それではここからは、ハルさんのスマホの中に入ってみましょう。"
},
{
"no": 29,
"start": 139.6,
"end": 150.33,
"speed": 1.0,
"slot": [
139.6,
150.33
],
"text": "ここが、スマホの中……。見渡すかぎり、部品の山！　光っている線は、部品と部品をつなぐ電気の道です。"
},
{
"no": 30,
"start": 151.13,
"end": 154.02,
"speed": 1.0,
"slot": [
151.13,
154.02
],
"text": "マイクは、どこから音を拾ってくるのか？"
},
{
"no": 31,
"start": 154.62,
"end": 163.4,
"speed": 1.0,
"slot": [
154.62,
163.4
],
"text": "外の音が入ってくるのは、この門。柱の穴は、さきほどの小さな穴と同じ並びです。"
},
{
"no": 32,
"start": 163.8,
"end": 167.35,
"speed": 1.0,
"slot": [
163.8,
167.35
],
"text": "そして門の横には、音の見張り番がいます。"
},
{
"no": 33,
"start": 167.75,
"end": 172.41,
"speed": 1.0,
"slot": [
167.75,
172.41
],
"text": "入ってきた音を聞いて、門を開けるかどうかを決める係です。"
},
{
"no": 34,
"start": 172.81,
"end": 177.08,
"speed": 1.0,
"slot": [
172.81,
177.08
],
"text": "この見張り番が待っているのは、たった一つの言葉だけ。"
},
{
"no": 35,
"start": 177.48,
"end": 182.54,
"speed": 1.0,
"slot": [
177.48,
182.54
],
"text": "iPhoneなら「ヘイ」で始まる、スマホを呼び出すあの合言葉です。"
},
{
"no": 36,
"start": 182.94,
"end": 188.03,
"speed": 1.0,
"slot": [
182.94,
188.03
],
"text": "この合言葉が聞こえたときだけ、門を開けて、音を中へ通します。"
},
{
"no": 37,
"start": 188.43,
"end": 197.96,
"speed": 1.0,
"slot": [
188.43,
197.96
],
"text": "ここでは、外の音をこの泡で表しています。話し声も車の音も、みんな泡になって門へ流れてきます。"
},
{
"no": 38,
"start": 198.36,
"end": 203.83,
"speed": 1.0,
"slot": [
198.36,
203.83
],
"text": "合言葉ではない音の泡は、見張り番の前で、すぐに消えてしまいます。"
},
{
"no": 39,
"start": 204.53,
"end": 208.96,
"speed": 1.0,
"slot": [
204.53,
208.96
],
"text": "……あっ、まるロボがつかもうとした音の泡も、消えた。"
},
{
"no": 40,
"start": 209.36,
"end": 216.28,
"speed": 1.0,
"slot": [
209.36,
216.28
],
"text": "合言葉かどうかを聞き分けているのは、この見張り番。つまり、スマホの中の部品です。"
},
{
"no": 41,
"start": 216.68,
"end": 221.95,
"speed": 1.0,
"slot": [
216.68,
221.95
],
"text": "合言葉が聞こえるまでは、音をスマホの外へ送ることはありません。"
},
{
"no": 42,
"start": 222.75,
"end": 225.62,
"speed": 1.0,
"slot": [
222.75,
225.62
],
"text": "本当にそうなのか、試してみましょう。"
},
{
"no": 43,
"start": 226.02,
"end": 232.05,
"speed": 1.0,
"slot": [
226.02,
232.05
],
"text": "外から、私が話しかけてみます。まるロボは、見張り番から目をはなさないで。"
},
{
"no": 44,
"start": 232.45,
"end": 237.52,
"speed": 1.0,
"slot": [
232.45,
237.52
],
"text": "まずは、昼間の電車で話していた言葉。……テント。"
},
{
"no": 45,
"start": 237.92,
"end": 242.24,
"speed": 1.0,
"slot": [
237.92,
242.24
],
"text": "見張り番は、知らん顔。だから、門も開きません。"
},
{
"no": 46,
"start": 242.64,
"end": 249.23,
"speed": 1.0,
"slot": [
242.64,
249.23
],
"text": "では、合言葉と同じ「ヘイ」をつけてみます。……ヘイ、テント！"
},
{
"no": 47,
"start": 249.93,
"end": 255.82,
"speed": 1.0,
"slot": [
249.93,
255.82
],
"text": "……完全に、無視。「ヘイ」がついているだけでは、門は開かないようです。"
},
{
"no": 48,
"start": 256.22,
"end": 261.27,
"speed": 1.0,
"slot": [
256.22,
261.27
],
"text": "それなら、合言葉と聞きまちがえそうな、よく似た言葉では？"
},
{
"no": 49,
"start": 261.87,
"end": 268.45,
"speed": 1.0,
"slot": [
261.87,
268.45
],
"text": "似た言葉でも、皆さんのスマホが反応すると困るので、音は消して字だけでお見せします。"
},
{
"no": 50,
"start": 268.85,
"end": 274.98,
"speed": 1.0,
"slot": [
268.85,
274.98
],
"text": "見張り番が、片目だけ開けた！　でも、すぐに閉じて、門は開きません。"
},
{
"no": 51,
"start": 275.38,
"end": 280.29,
"speed": 1.0,
"slot": [
275.38,
280.29
],
"text": "こんなふうに、似た言葉に、うっかり反応してしまうこともあるんです。"
},
{
"no": 52,
"start": 280.69,
"end": 283.37,
"speed": 1.0,
"slot": [
280.69,
283.37
],
"text": "最後は、いよいよ本物の合言葉。"
},
{
"no": 53,
"start": 283.77,
"end": 286.33,
"speed": 1.0,
"slot": [
283.77,
286.33
],
"text": "もちろん、こちらも音は消しておきますね。"
},
{
"no": 54,
"start": 286.73,
"end": 291.96,
"speed": 1.0,
"slot": [
286.73,
291.96
],
"text": "今度は、見張り番がぱっと目を開けて……門が開きました！"
},
{
"no": 55,
"start": 292.36,
"end": 295.86,
"speed": 1.0,
"slot": [
292.36,
295.86
],
"text": "柱の上のランプが、オレンジ色にともっています。"
},
{
"no": 56,
"start": 296.26,
"end": 298.81,
"speed": 1.0,
"slot": [
296.26,
298.81
],
"text": "外から、スマホの画面を見てみると……。"
},
{
"no": 57,
"start": 299.41,
"end": 302.78,
"speed": 1.0,
"slot": [
299.41,
302.78
],
"text": "画面の右上にも、同じ色の点が見えました。"
},
{
"no": 58,
"start": 303.18,
"end": 308.24,
"speed": 1.0,
"slot": [
303.18,
308.24
],
"text": "このように、マイクが音を聞いているときは、画面に印が出るんです。"
},
{
"no": 59,
"start": 309.04,
"end": 316.07,
"speed": 1.0,
"slot": [
309.04,
316.07
],
"text": "でも、もし合言葉を言わなくても、こっそり門を開けて音を拾うアプリがあったら？"
},
{
"no": 60,
"start": 316.67,
"end": 323.82,
"speed": 1.0,
"slot": [
316.67,
323.82
],
"text": "家での会話も、電話の声も、こっそり聞き放題。考えただけで、ぞっとしますよね。"
},
{
"no": 61,
"start": 324.22,
"end": 332.36,
"speed": 1.0,
"slot": [
324.22,
332.36
],
"text": "そこで2018年、アメリカの大学の研究チームが、1万7千本以上のアプリを調べました。"
},
{
"no": 62,
"start": 332.76,
"end": 338.66,
"speed": 1.0,
"slot": [
332.76,
338.66
],
"text": "調べたのは、アプリが勝手にマイクで音を録って、よそへ送っていないかです。"
},
{
"no": 63,
"start": 339.06,
"end": 342.8,
"speed": 1.0,
"slot": [
339.06,
342.8
],
"text": "結果は……そんなアプリは、一つも見つからなかった！"
},
{
"no": 64,
"start": 343.2,
"end": 351.88,
"speed": 1.0,
"slot": [
343.2,
351.88
],
"text": "ただし、別のものが見つかっています。スマホの画面を勝手に録画して、よその会社へ送るアプリです。"
},
{
"no": 65,
"start": 352.28,
"end": 356.52,
"speed": 1.0,
"slot": [
352.28,
356.52
],
"text": "音ではなくても、気をつける所はある、ということですね。"
},
{
"no": 66,
"start": 356.92,
"end": 362.55,
"speed": 1.0,
"slot": [
356.92,
362.55
],
"text": "では、「テント広告事件」の1人目の容疑者、マイクの調べをまとめると……。"
},
{
"no": 67,
"start": 363.15,
"end": 366.43,
"speed": 1.0,
"slot": [
363.15,
366.43
],
"text": "見張り番は、合言葉のときしか門を開けません。"
},
{
"no": 68,
"start": 366.83,
"end": 372.54,
"speed": 1.0,
"slot": [
366.83,
372.54
],
"text": "似た言葉で開きかけることはあっても、開けばランプと画面の点で分かります。"
},
{
"no": 69,
"start": 372.94,
"end": 379.4,
"speed": 1.0,
"slot": [
372.94,
379.4
],
"text": "そして1万7千本を調べても、こっそり音を送るアプリは見つかりませんでした。"
},
{
"no": 70,
"start": 379.8,
"end": 387.0,
"speed": 1.0,
"slot": [
379.8,
387.0
],
"text": "今わかっている調べでは、マイクが犯人だという証拠はなし。容疑は、ひとまず晴れました。"
},
{
"no": 71,
"start": 387.4,
"end": 393.69,
"speed": 1.0,
"slot": [
387.4,
393.69
],
"text": "では、調べてもいないテントの広告が、なぜハルさんのスマホに出てきたのでしょうか。"
},
{
"no": 72,
"start": 394.49,
"end": 398.35,
"speed": 1.0,
"slot": [
394.49,
398.35
],
"text": "次は、2人目の容疑者。「出ていく手がかり」。"
},
{
"no": 73,
"start": 398.75,
"end": 402.86,
"speed": 1.0,
"slot": [
398.75,
402.86
],
"text": "スマホから外へ出ていく、私たちの情報のことでした。"
},
{
"no": 74,
"start": 403.26,
"end": 411.13,
"speed": 1.0,
"slot": [
403.26,
411.13
],
"text": "ここは、さきほどと同じハルさんのスマホの中。見てください。箱が次々に、外へ出ていく！"
},
{
"no": 75,
"start": 411.53,
"end": 415.58,
"speed": 1.0,
"slot": [
411.53,
415.58
],
"text": "どれも、ハルさんがどんな人なのかを表す手がかりです。"
},
{
"no": 76,
"start": 415.98,
"end": 420.5,
"speed": 1.0,
"slot": [
415.98,
420.5
],
"text": "いったい、何が入った箱なのか。一つずつ、見ていきましょう。"
},
{
"no": 77,
"start": 420.9,
"end": 428.35,
"speed": 1.0,
"slot": [
420.9,
428.35
],
"text": "しずくの印の箱は、「いた場所」。ハルさんのスマホが、いつ、どこにあったかです。"
},
{
"no": 78,
"start": 428.75,
"end": 435.27,
"speed": 1.0,
"slot": [
428.75,
435.27
],
"text": "四角の印の箱は、「見たページ」。ハルさんが、どんなページを見たかです。"
},
{
"no": 79,
"start": 435.67,
"end": 444.21,
"speed": 1.0,
"slot": [
435.67,
444.21
],
"text": "丸が2つの印の箱は、「一緒にいた人」。ハルさんと、同じ時間に同じ場所にいた人です。"
},
{
"no": 80,
"start": 444.61,
"end": 450.93,
"speed": 1.0,
"slot": [
444.61,
450.93
],
"text": "たとえば、同じWi-Fiにつないでいれば、同じ家やお店にいると分かることがあります。"
},
{
"no": 81,
"start": 451.33,
"end": 457.54,
"speed": 1.0,
"slot": [
451.33,
457.54
],
"text": "こうした手がかりは、アプリやサイトを通じて、広告の会社に届くことがあります。"
},
{
"no": 82,
"start": 457.94,
"end": 462.18,
"speed": 1.0,
"slot": [
457.94,
462.18
],
"text": "中には、アプリを入れたときに、私たちが「許可」したものも……。"
},
{
"no": 83,
"start": 462.98,
"end": 466.71,
"speed": 1.0,
"slot": [
462.98,
466.71
],
"text": "では、この箱がどこへ行くのか、追いかけてみましょう。"
},
{
"no": 84,
"start": 467.11,
"end": 472.86,
"speed": 1.0,
"slot": [
467.11,
472.86
],
"text": "箱はスマホを飛び出し、電波に乗って、町をこえ、山をこえて……。"
},
{
"no": 85,
"start": 473.46,
"end": 476.17,
"speed": 1.0,
"slot": [
473.46,
476.17
],
"text": "その先には……大きな会場！"
},
{
"no": 86,
"start": 476.97,
"end": 480.65,
"speed": 1.0,
"slot": [
476.97,
480.65
],
"text": "着いたのは、広告の「競り」の会場でした。"
},
{
"no": 87,
"start": 481.05,
"end": 487.34,
"speed": 1.0,
"slot": [
481.05,
487.34
],
"text": "競りとは、一番高い値段をつけた人が品物を買える、というしくみです。"
},
{
"no": 88,
"start": 487.74,
"end": 493.89,
"speed": 1.0,
"slot": [
487.74,
493.89
],
"text": "ここで売られているのは、あの枠。ハルさんの画面に、広告を出す場所です。"
},
{
"no": 89,
"start": 494.29,
"end": 500.63,
"speed": 1.0,
"slot": [
494.29,
500.63
],
"text": "たとえば、ハルさんがニュースのページを開くと、その瞬間に競りが始まります。"
},
{
"no": 90,
"start": 501.03,
"end": 505.38,
"speed": 1.0,
"slot": [
501.03,
505.38
],
"text": "会社の人たちは、ハルさんの手がかりの札を見て、考えます。"
},
{
"no": 91,
"start": 505.78,
"end": 511.91,
"speed": 1.0,
"slot": [
505.78,
511.91
],
"text": "「ニュースを読んでいる、この人。手がかりを見ると……うちのテントが合いそうだ！」"
},
{
"no": 92,
"start": 512.31,
"end": 519.03,
"speed": 1.0,
"slot": [
512.31,
519.03
],
"text": "そして、一番高い値段をつけたテントの会社の広告が、ニュースのページに出るのです。"
},
{
"no": 93,
"start": 519.43,
"end": 526.11,
"speed": 1.0,
"slot": [
519.43,
526.11
],
"text": "今のは、分かりやすいように、ゆっくり再生したもの。では、本当の速さで見てみましょう。"
},
{
"no": 94,
"start": 526.81,
"end": 527.26,
"speed": 1.0,
"slot": [
526.81,
527.26
],
"text": "……一瞬！"
},
{
"no": 95,
"start": 527.66,
"end": 533.96,
"speed": 1.0,
"slot": [
527.66,
533.96
],
"text": "ページを開いた、ほんの一瞬のうちに、裏ではこんな競りが行われていたのです。"
},
{
"no": 96,
"start": 534.36,
"end": 536.88,
"speed": 1.0,
"slot": [
534.36,
536.88
],
"text": "まるロボ、目で追えなかったみたいです。"
},
{
"no": 97,
"start": 537.68,
"end": 545.3,
"speed": 1.0,
"slot": [
537.68,
545.3
],
"text": "でも、ハルさんはテントを調べていません。テントの会社は、何を手がかりにハルさんを選んだのでしょう。"
},
{
"no": 98,
"start": 545.7,
"end": 549.94,
"speed": 1.0,
"slot": [
545.7,
549.94
],
"text": "ここで、冒頭の電車の場面を、もう一度ふり返ってみると……。"
},
{
"no": 99,
"start": 550.54,
"end": 554.19,
"speed": 1.0,
"slot": [
550.54,
554.19
],
"text": "ソラさんのスマホに……テントの写真がありました！"
},
{
"no": 100,
"start": 554.59,
"end": 559.34,
"speed": 1.0,
"slot": [
554.59,
559.34
],
"text": "そう。どうやらソラさんは、前の日からテントを調べていたようです。"
},
{
"no": 101,
"start": 559.74,
"end": 565.2,
"speed": 1.0,
"slot": [
559.74,
565.2
],
"text": "そして二人のスマホは、同じ電車の無料Wi-Fiにつないでいました。"
},
{
"no": 102,
"start": 565.6,
"end": 570.4,
"speed": 1.0,
"slot": [
565.6,
570.4
],
"text": "つまり、広告の会社から見ると、二人は「一緒にいた人」。"
},
{
"no": 103,
"start": 570.8,
"end": 577.0,
"speed": 1.0,
"slot": [
570.8,
577.0
],
"text": "このように、同じWi-Fiにいた人が調べた物の広告が、出てくることもあるのです。"
},
{
"no": 104,
"start": 577.8,
"end": 580.88,
"speed": 1.0,
"slot": [
577.8,
580.88
],
"text": "あれ？　まるロボが、何かを言いたそうです。"
},
{
"no": 105,
"start": 581.28,
"end": 586.97,
"speed": 1.0,
"slot": [
581.28,
586.97
],
"text": "窓の外を、じっと見つめて……。そこには、紅葉。"
},
{
"no": 106,
"start": 587.37,
"end": 593.82,
"speed": 1.0,
"slot": [
587.37,
593.82
],
"text": "ロボットなのに、季節の移り変わりに気づくとは。なかなかの名探偵です。"
},
{
"no": 107,
"start": 594.22,
"end": 602.18,
"speed": 1.0,
"slot": [
594.22,
602.18
],
"text": "秋は、キャンプに出かける人が多い季節です。キャンプ用品の会社も、ここぞと広告を出します。"
},
{
"no": 108,
"start": 602.58,
"end": 603.83,
"speed": 1.0,
"slot": [
602.58,
603.83
],
"text": "ということは……。"
},
{
"no": 109,
"start": 604.43,
"end": 612.23,
"speed": 1.0,
"slot": [
604.43,
612.23
],
"text": "キャンプの話をしたのも、テントの広告が出たのも、同じ「秋」が理由だったのかもしれません。"
},
{
"no": 110,
"start": 612.63,
"end": 617.57,
"speed": 1.0,
"slot": [
612.63,
617.57
],
"text": "では、2人目の容疑者、出ていく手がかりの調べをまとめると……。"
},
{
"no": 111,
"start": 618.17,
"end": 623.25,
"speed": 1.0,
"slot": [
618.17,
623.25
],
"text": "スマホから出た手がかりは、広告の会社の競りで使われていました。"
},
{
"no": 112,
"start": 623.65,
"end": 629.57,
"speed": 1.0,
"slot": [
623.65,
629.57
],
"text": "ハルさんが調べていなくても、一緒にいた人や季節から、テントが選ばれたのです。"
},
{
"no": 113,
"start": 629.97,
"end": 637.08,
"speed": 1.0,
"slot": [
629.97,
637.08
],
"text": "耳で聞かなくても、手がかりから当ててくる。2人目の容疑者は……かなり怪しいですね。"
},
{
"no": 114,
"start": 637.88,
"end": 642.11,
"speed": 1.0,
"slot": [
637.88,
642.11
],
"text": "最後は、3人目の容疑者。「わたしたちの記憶」。"
},
{
"no": 115,
"start": 642.51,
"end": 649.58,
"speed": 1.0,
"slot": [
642.51,
649.58
],
"text": "あの鏡に映っていた、私たち自身。つまり、私たちの頭の中のことでした。"
},
{
"no": 116,
"start": 649.98,
"end": 652.4,
"speed": 1.0,
"slot": [
649.98,
652.4
],
"text": "ここで、みなさんに問題です。"
},
{
"no": 117,
"start": 652.8,
"end": 659.25,
"speed": 1.0,
"slot": [
652.8,
659.25
],
"text": "昼間の電車のつり広告。テントの絵は、何枚あったでしょう？"
},
{
"no": 118,
"start": 659.85,
"end": 660.68,
"speed": 1.0,
"slot": [
659.85,
660.68
],
"text": "正解は……。"
},
{
"no": 119,
"start": 661.28,
"end": 666.04,
"speed": 1.0,
"slot": [
661.28,
666.04
],
"text": "1枚、2枚、3枚。全部で3枚です！"
},
{
"no": 120,
"start": 666.44,
"end": 667.89,
"speed": 1.0,
"slot": [
666.44,
667.89
],
"text": "気づいていましたか？"
},
{
"no": 121,
"start": 668.49,
"end": 674.5,
"speed": 1.0,
"slot": [
668.49,
674.5
],
"text": "ほとんどの方は、まるロボのかわいらしさに気を取られて、見落としていたかもしれませんね。"
},
{
"no": 122,
"start": 674.9,
"end": 680.84,
"speed": 1.0,
"slot": [
674.9,
680.84
],
"text": "このように、目には入っていたのに、気にしていない物は、ほとんど覚えていないのです。"
},
{
"no": 123,
"start": 681.24,
"end": 689.15,
"speed": 1.0,
"slot": [
681.24,
689.15
],
"text": "もしかすると、二人がキャンプの話を始めたのも、知らないうちに目に入っていた、このつり広告のせい……？"
},
{
"no": 124,
"start": 689.95,
"end": 693.31,
"speed": 1.0,
"slot": [
689.95,
693.31
],
"text": "私たちは、毎日たくさんの広告を見ています。"
},
{
"no": 125,
"start": 693.71,
"end": 697.27,
"speed": 1.0,
"slot": [
693.71,
697.27
],
"text": "でも、そのほとんどは、気にもとめずに忘れていきます。"
},
{
"no": 126,
"start": 697.67,
"end": 702.94,
"speed": 1.0,
"slot": [
697.67,
702.94
],
"text": "ところが、話したばかりの物の広告だけは、「あっ」と目にとまる。"
},
{
"no": 127,
"start": 703.34,
"end": 708.12,
"speed": 1.0,
"slot": [
703.34,
708.12
],
"text": "そして、「話を聞かれていた！」と、強く記憶に残ります。"
},
{
"no": 128,
"start": 708.52,
"end": 713.51,
"speed": 1.0,
"slot": [
708.52,
713.51
],
"text": "反対に、話したのに広告が出なかったことは、誰も覚えていません。"
},
{
"no": 129,
"start": 713.91,
"end": 721.12,
"speed": 1.0,
"slot": [
713.91,
721.12
],
"text": "外れはたくさんあるのに、当たりだけを数えている。だから、よく当たるように感じるのです。"
},
{
"no": 130,
"start": 721.52,
"end": 728.45,
"speed": 1.0,
"slot": [
721.52,
728.45
],
"text": "一度気になった物は、急に目に入るようになる。これも、私たちの頭のくせです。"
},
{
"no": 131,
"start": 728.85,
"end": 737.0,
"speed": 1.0,
"slot": [
728.85,
737.0
],
"text": "3人目の容疑者、わたしたちの記憶。当たったときだけを覚えて、「よく当たる」と感じさせていました。"
},
{
"no": 132,
"start": 737.8,
"end": 743.58,
"speed": 1.0,
"slot": [
737.8,
743.58
],
"text": "3人の容疑者を調べ終えて、これで一件落着……と、思ったそのとき。"
},
{
"no": 133,
"start": 743.98,
"end": 747.65,
"speed": 1.0,
"slot": [
743.98,
747.65
],
"text": "探偵まるロボの前に、新たな容疑者が現れました。"
},
{
"no": 134,
"start": 748.05,
"end": 754.66,
"speed": 1.0,
"slot": [
748.05,
754.66
],
"text": "数年前、アメリカに、「会話を聞いて、広告を出せます」と売り込んでいた会社があったのです。"
},
{
"no": 135,
"start": 755.06,
"end": 756.91,
"speed": 1.0,
"slot": [
755.06,
756.91
],
"text": "やっぱり、聞いていた……？"
},
{
"no": 136,
"start": 757.71,
"end": 764.85,
"speed": 1.0,
"slot": [
757.71,
764.85
],
"text": "もし本当に会話を聞いていたら、大問題。役所が調べに入るのも、当然ですよね。"
},
{
"no": 137,
"start": 765.25,
"end": 770.24,
"speed": 1.0,
"slot": [
765.25,
770.24
],
"text": "アメリカで、商売の不正を取り締まる役所が、この会社を調べました。"
},
{
"no": 138,
"start": 770.64,
"end": 775.29,
"speed": 1.0,
"slot": [
770.64,
775.29
],
"text": "すると……この会社は、会話を何も聞いていなかった。"
},
{
"no": 139,
"start": 775.69,
"end": 782.18,
"speed": 1.0,
"slot": [
775.69,
782.18
],
"text": "なんと、お客さんに渡していたのは、よそから買ってきた、メールアドレスの名簿だったのです。"
},
{
"no": 140,
"start": 782.58,
"end": 788.26,
"speed": 1.0,
"slot": [
782.58,
788.26
],
"text": "会社は、うその宣伝をしたとして、2026年に処分を受けました。"
},
{
"no": 141,
"start": 788.66,
"end": 795.45,
"speed": 1.0,
"slot": [
788.66,
795.45
],
"text": "「聞いている」と言った会社でさえ、聞いていなかった。いや、聞くことができなかったのです。"
},
{
"no": 142,
"start": 796.25,
"end": 798.5,
"speed": 1.0,
"slot": [
796.25,
798.5
],
"text": "それでは、事件をまとめましょう。"
},
{
"no": 143,
"start": 798.9,
"end": 802.67,
"speed": 1.0,
"slot": [
798.9,
802.67
],
"text": "ハルさんのスマホに、なぜテントの広告が出たのか。"
},
{
"no": 144,
"start": 803.07,
"end": 807.87,
"speed": 1.0,
"slot": [
803.07,
807.87
],
"text": "1人目のマイクは、今わかっている調べでは、犯人ではありませんでした。"
},
{
"no": 145,
"start": 808.27,
"end": 811.78,
"speed": 1.0,
"slot": [
808.27,
811.78
],
"text": "2人目の手がかりは……犯人の一人でした。"
},
{
"no": 146,
"start": 812.18,
"end": 818.2,
"speed": 1.0,
"slot": [
812.18,
818.2
],
"text": "いた場所や、一緒にいた人、季節から、好きそうな物を当てていたからです。"
},
{
"no": 147,
"start": 818.6,
"end": 827.48,
"speed": 1.0,
"slot": [
818.6,
827.48
],
"text": "そして3人目、わたしたちの記憶も、犯人の一人でした。当たったときだけを、覚えていたからです。"
},
{
"no": 148,
"start": 827.88,
"end": 833.27,
"speed": 1.0,
"slot": [
827.88,
833.27
],
"text": "そう。この「テント広告事件」の犯人は、一人ではなかったのです。"
},
{
"no": 149,
"start": 833.67,
"end": 836.69,
"speed": 1.0,
"slot": [
833.67,
836.69
],
"text": "スマホの耳は、会話を聞いていない。"
},
{
"no": 150,
"start": 837.09,
"end": 844.0,
"speed": 1.0,
"slot": [
837.09,
844.0
],
"text": "スマホから出ていく、いた場所や一緒にいた人の手がかりから、好きそうな物を予想している。"
},
{
"no": 151,
"start": 844.4,
"end": 849.55,
"speed": 1.0,
"slot": [
844.4,
849.55
],
"text": "そして私たちは、その予想が当たったときだけを覚えている。"
},
{
"no": 152,
"start": 850.35,
"end": 856.2,
"speed": 1.0,
"slot": [
850.35,
856.2
],
"text": "「やっぱり、ちょっと怖い」と感じた方は、設定を見直してみるのも一つの手です。"
},
{
"no": 153,
"start": 856.6,
"end": 862.98,
"speed": 1.0,
"slot": [
856.6,
862.98
],
"text": "広告に使われる手がかりは、スマホやアプリの設定で、見直したり、止めたりできます。"
},
{
"no": 154,
"start": 863.38,
"end": 866.19,
"speed": 1.0,
"slot": [
863.38,
866.19
],
"text": "気になる人は、一度のぞいてみてください。"
},
{
"no": 155,
"start": 866.99,
"end": 874.65,
"speed": 1.0,
"slot": [
866.99,
874.65
],
"text": "事件が解決した、その夜。……おや？　まるロボが、何かこそこそしています。"
},
{
"no": 156,
"start": 875.05,
"end": 880.85,
"speed": 1.0,
"slot": [
875.05,
880.85
],
"text": "どうやら念のため、スマホのマイクに、もう一度だけ話しかけてみるようです。"
},
{
"no": 157,
"start": 881.25,
"end": 887.72,
"speed": 1.0,
"slot": [
881.25,
887.72
],
"text": "ピポ、ピポ……。テントの絵を浮かべて、「テント」と言っているつもりみたいです。"
},
{
"no": 158,
"start": 888.12,
"end": 892.01,
"speed": 1.0,
"slot": [
888.12,
892.01
],
"text": "まるロボ、それではスマホには伝わりませんよ。"
},
{
"no": 159,
"start": 892.71,
"end": 898.53,
"speed": 1.0,
"slot": [
892.71,
898.53
],
"text": "……シーン。何も起きない。まるロボ、ひと安心。"
},
{
"no": 160,
"start": 899.33,
"end": 900.21,
"speed": 1.0,
"slot": [
899.33,
900.21
],
"text": "次の朝。"
},
{
"no": 161,
"start": 900.91,
"end": 904.32,
"speed": 1.0,
"slot": [
900.91,
904.32
],
"text": "……あれ？　まるロボが、ひっくり返っています。"
},
{
"no": 162,
"start": 904.72,
"end": 906.42,
"speed": 1.0,
"slot": [
904.72,
906.42
],
"text": "おばけでも出たのでしょうか？"
},
{
"no": 163,
"start": 907.12,
"end": 908.76,
"speed": 1.0,
"slot": [
907.12,
908.76
],
"text": "……テントの広告です！"
},
{
"no": 164,
"start": 909.16,
"end": 915.15,
"speed": 1.0,
"slot": [
909.16,
915.15
],
"text": "実は昨日の夜、まるロボがこのスマホで、キャンプの動画をずっと見ていたのです。"
},
{
"no": 165,
"start": 915.55,
"end": 920.24,
"speed": 1.0,
"slot": [
915.55,
920.24
],
"text": "自分で見ていたことを忘れて、テントの広告に驚くなんて。"
},
{
"no": 166,
"start": 920.64,
"end": 923.61,
"speed": 1.0,
"slot": [
920.64,
923.61
],
"text": "今回の犯人は……探偵でした。"
}
]