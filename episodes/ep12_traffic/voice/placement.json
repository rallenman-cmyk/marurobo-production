[
{
"no": 1,
"start": 0.5,
"end": 6.02,
"speed": 1.0,
"slot": [
0.5,
6.02
],
"text": "休みの日の夕方。まるロボは、車の助手席に乗っています。"
},
{
"no": 2,
"start": 6.92,
"end": 13.6,
"speed": 1.0,
"slot": [
6.92,
13.6
],
"text": "運転しているのは、近所のおじさん。海の見える公園まで、送ってくれるのです。"
},
{
"no": 3,
"start": 14.2,
"end": 17.73,
"speed": 1.0,
"slot": [
14.2,
17.73
],
"text": "前の台には、道案内の地図が映っています。"
},
{
"no": 4,
"start": 18.63,
"end": 22.21,
"speed": 1.0,
"slot": [
18.63,
22.21
],
"text": "まるロボは、さっきから、この地図に夢中のようです。"
},
{
"no": 5,
"start": 23.11,
"end": 28.05,
"speed": 1.0,
"slot": [
23.11,
28.05
],
"text": "見てください。地図の上で、この先の道が赤くなっています。"
},
{
"no": 6,
"start": 28.65,
"end": 33.04,
"speed": 1.0,
"slot": [
28.65,
33.04
],
"text": "どうやら「この先、渋滞」という合図のようです。"
},
{
"no": 7,
"start": 33.84,
"end": 38.0,
"speed": 1.0,
"slot": [
33.84,
38.0
],
"text": "でも、窓の外は……車がすいすい走っています。"
},
{
"no": 8,
"start": 38.9,
"end": 41.06,
"speed": 1.0,
"slot": [
38.9,
41.06
],
"text": "まるロボも、首をかしげていますね。"
},
{
"no": 9,
"start": 42.06,
"end": 44.38,
"speed": 1.0,
"slot": [
42.06,
44.38
],
"text": "ところが、角を曲がると……。"
},
{
"no": 10,
"start": 45.68,
"end": 49.62,
"speed": 1.0,
"slot": [
45.68,
49.62
],
"text": "ずらり。本当に、車が並んでいました。"
},
{
"no": 11,
"start": 50.62,
"end": 53.93,
"speed": 1.0,
"slot": [
50.62,
53.93
],
"text": "止まった車の中で、まるロボは、しょんぼり。"
},
{
"no": 12,
"start": 54.53,
"end": 59.45,
"speed": 1.0,
"slot": [
54.53,
59.45
],
"text": "地図は、角の向こうで見えなかった渋滞を、ちゃんと当てていたのです。"
},
{
"no": 13,
"start": 60.35,
"end": 62.17,
"speed": 1.0,
"slot": [
60.35,
62.17
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 14,
"start": 62.77,
"end": 66.64,
"speed": 1.0,
"slot": [
62.77,
66.64
],
"text": "道の上には、車を数えている人なんて、どこにもいません。"
},
{
"no": 15,
"start": 67.24,
"end": 70.86,
"speed": 1.0,
"slot": [
67.24,
70.86
],
"text": "いったい誰が、道のこみ具合を測っているのでしょうか？"
},
{
"no": 16,
"start": 71.76,
"end": 74.83,
"speed": 1.0,
"slot": [
71.76,
74.83
],
"text": "しかも、気になることは、それだけではありません。"
},
{
"no": 17,
"start": 75.63,
"end": 78.03,
"speed": 1.0,
"slot": [
75.63,
78.03
],
"text": "地図を、ぐっと広げてみると……。"
},
{
"no": 18,
"start": 78.93,
"end": 83.59,
"speed": 1.0,
"slot": [
78.93,
83.59
],
"text": "行ったこともない遠くの町の、細い道にまで、色が付いています。"
},
{
"no": 19,
"start": 84.49,
"end": 92.02,
"speed": 1.0,
"slot": [
84.49,
92.02
],
"text": "日本の道は、全部つなげると120万キロ以上。地球をおよそ30周する長さです。"
},
{
"no": 20,
"start": 92.62,
"end": 96.33,
"speed": 1.0,
"slot": [
92.62,
96.33
],
"text": "さらに、画面には、公園に着く時刻まで出ています。"
},
{
"no": 21,
"start": 96.93,
"end": 102.09,
"speed": 1.0,
"slot": [
96.93,
102.09
],
"text": "30分も先の道の様子なんて、まだ誰も見ていないはずなのに……。"
},
{
"no": 22,
"start": 103.09,
"end": 108.11,
"speed": 1.0,
"slot": [
103.09,
108.11
],
"text": "誰が測っているのか。どうして、まだ来ていない先のことまで分かるのか。"
},
{
"no": 23,
"start": 109.01,
"end": 113.53,
"speed": 1.0,
"slot": [
109.01,
113.53
],
"text": "その正体は、意外にも、まるロボのすぐそばにありました。"
},
{
"no": 24,
"start": 114.53,
"end": 119.58,
"speed": 1.0,
"slot": [
114.53,
119.58
],
"text": "これから、まるロボと一緒に、赤い線の正体を見に行きます。"
},
{
"no": 25,
"start": 120.78,
"end": 126.73,
"speed": 1.0,
"slot": [
120.78,
126.73
],
"text": "次の日。まるロボは、大きな道にかかる歩道橋の上にやってきました。"
},
{
"no": 26,
"start": 127.63,
"end": 131.36,
"speed": 1.0,
"slot": [
127.63,
131.36
],
"text": "まずは、自分で車を数えてみることにしたようです。"
},
{
"no": 27,
"start": 132.16,
"end": 137.12,
"speed": 1.0,
"slot": [
132.16,
137.12
],
"text": "目の光で下を通る車を、1台ずつ……ピッ、ピッ。"
},
{
"no": 28,
"start": 138.12,
"end": 141.5,
"speed": 1.0,
"slot": [
138.12,
141.5
],
"text": "ところが、車は次から次へとやってきます。"
},
{
"no": 29,
"start": 142.3,
"end": 145.76,
"speed": 1.0,
"slot": [
142.3,
145.76
],
"text": "右の車線も、左の車線も……ピピピピッ。"
},
{
"no": 30,
"start": 146.96,
"end": 150.29,
"speed": 1.0,
"slot": [
146.96,
150.29
],
"text": "……くるくる。まるロボ、目を回してしまいました。"
},
{
"no": 31,
"start": 152.09,
"end": 155.21,
"speed": 1.0,
"slot": [
152.09,
155.21
],
"text": "たった1本の道でも、これだけ大変です。"
},
{
"no": 32,
"start": 155.81,
"end": 160.0,
"speed": 1.0,
"slot": [
155.81,
160.0
],
"text": "見てください。町には、数えきれないほどの道があります。"
},
{
"no": 33,
"start": 160.8,
"end": 165.23,
"speed": 1.0,
"slot": [
160.8,
165.23
],
"text": "全部の道に人が立って数えるなんて、とても間に合いませんね。"
},
{
"no": 34,
"start": 166.23,
"end": 170.52,
"speed": 1.0,
"slot": [
166.23,
170.52
],
"text": "では、道のこみ具合は、いったい何が測っているのでしょう？"
},
{
"no": 35,
"start": 171.72,
"end": 175.41,
"speed": 1.0,
"slot": [
171.72,
175.41
],
"text": "ふらふらのまるロボが、ふと上を見上げると……。"
},
{
"no": 36,
"start": 176.31,
"end": 180.7,
"speed": 1.0,
"slot": [
176.31,
180.7
],
"text": "道の上に張り出した柱に、四角い機械が付いています。"
},
{
"no": 37,
"start": 181.3,
"end": 186.72,
"speed": 1.0,
"slot": [
181.3,
186.72
],
"text": "これは、道を通る車をとらえる機械。感知器と呼ばれています。"
},
{
"no": 38,
"start": 187.52,
"end": 191.23,
"speed": 1.0,
"slot": [
187.52,
191.23
],
"text": "では、この感知器は、何をしているのでしょうか？"
},
{
"no": 39,
"start": 192.13,
"end": 197.0,
"speed": 1.0,
"slot": [
192.13,
197.0
],
"text": "感知器は、真下の道に向けて、目に見えない音を出しています。"
},
{
"no": 40,
"start": 197.6,
"end": 201.08,
"speed": 1.0,
"slot": [
197.6,
201.08
],
"text": "音は道ではね返って、感知器に戻ってきます。"
},
{
"no": 41,
"start": 201.98,
"end": 207.88,
"speed": 1.0,
"slot": [
201.98,
207.88
],
"text": "車が下を通ると……はね返ってくるまでの時間が、短くなりました。"
},
{
"no": 42,
"start": 208.88,
"end": 213.67,
"speed": 1.0,
"slot": [
208.88,
213.67
],
"text": "この変わり方で、通った車の数や、こみ具合が分かるのです。"
},
{
"no": 43,
"start": 214.27,
"end": 219.45,
"speed": 1.0,
"slot": [
214.27,
219.45
],
"text": "まるロボが目で数えていたことを、この機械は休まず続けていたわけです。"
},
{
"no": 44,
"start": 220.35,
"end": 223.578,
"speed": 1.0,
"slot": [
220.35,
223.578
],
"text": "では、測った内容は、どこへ行くのでしょう？"
},
{
"no": 45,
"start": 224.378,
"end": 230.038,
"speed": 1.0,
"slot": [
224.378,
230.038
],
"text": "日本では、警察や道路を管理する会社が、こうした情報を集めています。"
},
{
"no": 46,
"start": 230.938,
"end": 236.958,
"speed": 1.0,
"slot": [
230.938,
236.958
],
"text": "集めた情報は、まとめる所を通って、電波で車のナビに届きます。"
},
{
"no": 47,
"start": 237.858,
"end": 242.068,
"speed": 1.0,
"slot": [
237.858,
242.068
],
"text": "だから、車のナビでも、この先の渋滞が分かるのです。"
},
{
"no": 48,
"start": 242.968,
"end": 246.878,
"speed": 1.0,
"slot": [
242.968,
246.878
],
"text": "ところが、この感知器には、苦手なことがあります。"
},
{
"no": 49,
"start": 247.878,
"end": 250.738,
"speed": 1.0,
"slot": [
247.878,
250.738
],
"text": "まるロボが、町はずれの道へ行ってみると……。"
},
{
"no": 50,
"start": 252.138,
"end": 254.818,
"speed": 1.0,
"slot": [
252.138,
254.818
],
"text": "見上げても、機械はどこにもありません。"
},
{
"no": 51,
"start": 255.718,
"end": 260.558,
"speed": 1.0,
"slot": [
255.718,
260.558
],
"text": "感知器が多いのは、大きな道や、町なかの交差点のまわり。"
},
{
"no": 52,
"start": 261.158,
"end": 265.978,
"speed": 1.0,
"slot": [
261.158,
265.978
],
"text": "町はずれや、橋やトンネルのように、置きにくい所もあるのです。"
},
{
"no": 53,
"start": 266.578,
"end": 270.858,
"speed": 1.0,
"slot": [
266.578,
270.858
],
"text": "だから、感知器だけでは、この道のこみ具合は分かりません。"
},
{
"no": 54,
"start": 271.458,
"end": 277.358,
"speed": 1.0,
"slot": [
271.458,
277.358
],
"text": "それなのに、冒頭の道案内の地図は、細い道にまで色が付いていました。"
},
{
"no": 55,
"start": 277.958,
"end": 279.368,
"speed": 1.0,
"slot": [
277.958,
279.368
],
"text": "機械がないのに、なぜ……？"
},
{
"no": 56,
"start": 280.268,
"end": 285.758,
"speed": 1.0,
"slot": [
280.268,
285.758
],
"text": "冒頭で言った「すぐそば」。答えは、ここにありました。"
},
{
"no": 57,
"start": 286.358,
"end": 293.388,
"speed": 1.0,
"slot": [
286.358,
293.388
],
"text": "冒頭と同じ、夕方の渋滞の中。おじさんの車を、もう一度見てください。"
},
{
"no": 58,
"start": 293.988,
"end": 298.598,
"speed": 1.0,
"slot": [
293.988,
298.598
],
"text": "前の台に付いていた道案内。これは、スマホです。"
},
{
"no": 59,
"start": 299.198,
"end": 305.028,
"speed": 1.0,
"slot": [
299.198,
305.028
],
"text": "見てください。スマホから、小さな光の点が、ぽうっと上がっていきます。"
},
{
"no": 60,
"start": 305.628,
"end": 312.528,
"speed": 1.0,
"slot": [
305.628,
312.528
],
"text": "ここでは、スマホから届く「いまどこにいるか」の手がかりを、光る点で表しています。"
},
{
"no": 61,
"start": 313.428,
"end": 316.238,
"speed": 1.0,
"slot": [
313.428,
316.238
],
"text": "まるロボが、窓から顔を出してみると……。"
},
{
"no": 62,
"start": 316.838,
"end": 322.468,
"speed": 1.0,
"slot": [
316.838,
322.468
],
"text": "前の車からも、後ろの車からも、点が次々に上がっていきます。"
},
{
"no": 63,
"start": 323.068,
"end": 327.458,
"speed": 1.0,
"slot": [
323.068,
327.458
],
"text": "点は空へのぼって、大きな地図の上に集まっていきました。"
},
{
"no": 64,
"start": 328.058,
"end": 332.868,
"speed": 1.0,
"slot": [
328.058,
332.868
],
"text": "道案内を使っているスマホは、自分がいまどこにいるかを知っています。"
},
{
"no": 65,
"start": 333.468,
"end": 337.458,
"speed": 1.0,
"slot": [
333.468,
337.458
],
"text": "その位置の手がかりが、こうして、たくさん集まっていくのです。"
},
{
"no": 66,
"start": 338.358,
"end": 341.948,
"speed": 1.0,
"slot": [
338.358,
341.948
],
"text": "では、集まった点を、よく見てみましょう。"
},
{
"no": 67,
"start": 342.548,
"end": 345.668,
"speed": 1.0,
"slot": [
342.548,
345.668
],
"text": "すいている道の点は……すいすい進みます。"
},
{
"no": 68,
"start": 346.268,
"end": 349.488,
"speed": 1.0,
"slot": [
346.268,
349.488
],
"text": "一方、こんでいる道の点は……のろのろ。"
},
{
"no": 69,
"start": 350.088,
"end": 355.128,
"speed": 1.0,
"slot": [
350.088,
355.128
],
"text": "たとえば、同じ100メートルを、すいた道なら10秒ほどで進みます。"
},
{
"no": 70,
"start": 355.728,
"end": 360.528,
"speed": 1.0,
"slot": [
355.728,
360.528
],
"text": "でも、こんだ道では1分たっても、まだ半分ということも。"
},
{
"no": 71,
"start": 361.128,
"end": 365.698,
"speed": 1.0,
"slot": [
361.128,
365.698
],
"text": "同じ道の上の点が、みんなゆっくりしか進まなければ……。"
},
{
"no": 72,
"start": 366.298,
"end": 369.398,
"speed": 1.0,
"slot": [
366.298,
369.398
],
"text": "そこは、こんでいる、と分かるのです。"
},
{
"no": 73,
"start": 370.298,
"end": 374.468,
"speed": 1.0,
"slot": [
370.298,
374.468
],
"text": "すると、空の地図の道の色が、変わっていきます。"
},
{
"no": 74,
"start": 375.068,
"end": 380.458,
"speed": 1.0,
"slot": [
375.068,
380.458
],
"text": "点が速い所は、緑。少しゆっくりの所は、黄色。"
},
{
"no": 75,
"start": 381.058,
"end": 383.628,
"speed": 1.0,
"slot": [
381.058,
383.628
],
"text": "そして、のろのろの所は……赤。"
},
{
"no": 76,
"start": 384.228,
"end": 389.308,
"speed": 1.0,
"slot": [
384.228,
389.308
],
"text": "見てください。冒頭で見た赤い線と、同じ形になりました。"
},
{
"no": 77,
"start": 390.208,
"end": 394.918,
"speed": 1.0,
"slot": [
390.208,
394.918
],
"text": "……あれ？　まるロボの車の上にも、点が1つ光っています。"
},
{
"no": 78,
"start": 395.518,
"end": 400.068,
"speed": 1.0,
"slot": [
395.518,
400.068
],
"text": "そう。あの点の1つは、まるロボの乗った車でした。"
},
{
"no": 79,
"start": 400.668,
"end": 403.778,
"speed": 1.0,
"slot": [
400.668,
403.778
],
"text": "まるロボ、びっくり。ぴょんぴょん跳ねてみますが……。"
},
{
"no": 80,
"start": 404.378,
"end": 407.828,
"speed": 1.0,
"slot": [
404.378,
407.828
],
"text": "点は、車と一緒に、ゆっくり進むだけ。"
},
{
"no": 81,
"start": 408.428,
"end": 413.788,
"speed": 1.0,
"slot": [
408.428,
413.788
],
"text": "地図を見ていたつもりが、実は、地図を描く側でもあったのです。"
},
{
"no": 82,
"start": 414.688,
"end": 420.388,
"speed": 1.0,
"slot": [
414.688,
420.388
],
"text": "つまり、赤い線を測っていたのは、道を走っている車のスマホ。"
},
{
"no": 83,
"start": 420.988,
"end": 424.658,
"speed": 1.0,
"slot": [
420.988,
424.658
],
"text": "みんなのスマホが、少しずつ、道を測っていたのです。"
},
{
"no": 84,
"start": 425.258,
"end": 429.528,
"speed": 1.0,
"slot": [
425.258,
429.528
],
"text": "だから、感知器のない細い道にも、色が付くわけです。"
},
{
"no": 85,
"start": 430.128,
"end": 434.098,
"speed": 1.0,
"slot": [
430.128,
434.098
],
"text": "その道を走るスマホがあれば、点が上がるのですから。"
},
{
"no": 86,
"start": 434.998,
"end": 438.188,
"speed": 1.0,
"slot": [
434.998,
438.188
],
"text": "でも、ちょっと心配になりませんか？"
},
{
"no": 87,
"start": 438.788,
"end": 442.988,
"speed": 1.0,
"slot": [
438.788,
442.988
],
"text": "自分のいる場所が、誰かに知られてしまうのでは……？"
},
{
"no": 88,
"start": 443.588,
"end": 447.568,
"speed": 1.0,
"slot": [
443.588,
447.568
],
"text": "まるロボも、自分の点をじっと見上げていますね。"
},
{
"no": 89,
"start": 448.468,
"end": 455.168,
"speed": 1.0,
"slot": [
448.468,
455.168
],
"text": "見てください。点が上がるとき、持ち主の印が外れて、ただの点になります。"
},
{
"no": 90,
