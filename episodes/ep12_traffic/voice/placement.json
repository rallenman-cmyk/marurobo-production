[
{
"no": 1,
"start": 0.5,
"end": 6.61,
"speed": 1.0,
"slot": [
0.5,
6.61
],
"text": "休みの日の夕方。まるロボは、車の助手席に乗っています。"
},
{
"no": 2,
"start": 7.51,
"end": 14.24,
"speed": 1.0,
"slot": [
7.51,
14.24
],
"text": "運転しているのは、近所のおじさん。海の見える公園まで、送ってくれるのです。"
},
{
"no": 3,
"start": 14.84,
"end": 18.41,
"speed": 1.0,
"slot": [
14.84,
18.41
],
"text": "前の台には、道案内の地図が映っています。"
},
{
"no": 4,
"start": 19.31,
"end": 22.95,
"speed": 1.0,
"slot": [
19.31,
22.95
],
"text": "まるロボは、さっきから、この地図に夢中のようです。"
},
{
"no": 5,
"start": 23.85,
"end": 28.85,
"speed": 1.0,
"slot": [
23.85,
28.85
],
"text": "見てください。地図の上で、この先の道が赤くなっています。"
},
{
"no": 6,
"start": 29.45,
"end": 33.87,
"speed": 1.0,
"slot": [
29.45,
33.87
],
"text": "どうやら「この先、渋滞」という合図のようです。"
},
{
"no": 7,
"start": 34.67,
"end": 38.9,
"speed": 1.0,
"slot": [
34.67,
38.9
],
"text": "でも、窓の外は……車がすいすい走っています。"
},
{
"no": 8,
"start": 39.8,
"end": 42.02,
"speed": 1.0,
"slot": [
39.8,
42.02
],
"text": "まるロボも、首をかしげていますね。"
},
{
"no": 9,
"start": 43.02,
"end": 45.37,
"speed": 1.0,
"slot": [
43.02,
45.37
],
"text": "ところが、角を曲がると……。"
},
{
"no": 10,
"start": 46.67,
"end": 50.66,
"speed": 1.0,
"slot": [
46.67,
50.66
],
"text": "ずらり。本当に、車が並んでいました。"
},
{
"no": 11,
"start": 51.66,
"end": 55.1,
"speed": 1.0,
"slot": [
51.66,
55.1
],
"text": "止まった車の中で、まるロボは、しょんぼり。"
},
{
"no": 12,
"start": 55.7,
"end": 60.69,
"speed": 1.0,
"slot": [
55.7,
60.69
],
"text": "地図は、角の向こうで見えなかった渋滞を、ちゃんと当てていたのです。"
},
{
"no": 13,
"start": 61.59,
"end": 63.46,
"speed": 1.0,
"slot": [
61.59,
63.46
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 14,
"start": 64.06,
"end": 68.32,
"speed": 1.0,
"slot": [
64.06,
68.32
],
"text": "道の上には、車を数えている人なんて、どこにもいません。"
},
{
"no": 15,
"start": 68.92,
"end": 72.59,
"speed": 1.0,
"slot": [
68.92,
72.59
],
"text": "いったい誰が、道のこみ具合を測っているのでしょうか？"
},
{
"no": 16,
"start": 73.49,
"end": 76.93,
"speed": 1.0,
"slot": [
73.49,
76.93
],
"text": "しかも、気になることは、それだけではありません。"
},
{
"no": 17,
"start": 77.73,
"end": 80.59,
"speed": 1.0,
"slot": [
77.73,
80.59
],
"text": "地図を、ぐっと広げてみると……。"
},
{
"no": 18,
"start": 81.49,
"end": 86.21,
"speed": 1.0,
"slot": [
81.49,
86.21
],
"text": "行ったこともない遠くの町の、細い道にまで、色が付いています。"
},
{
"no": 19,
"start": 87.11,
"end": 94.71,
"speed": 1.0,
"slot": [
87.11,
94.71
],
"text": "日本の道は、全部つなげると120万キロ以上。地球をおよそ30周する長さです。"
},
{
"no": 20,
"start": 95.31,
"end": 99.06,
"speed": 1.0,
"slot": [
95.31,
99.06
],
"text": "さらに、画面には、公園に着く時刻まで出ています。"
},
{
"no": 21,
"start": 99.66,
"end": 104.84,
"speed": 1.0,
"slot": [
99.66,
104.84
],
"text": "30分も先の道の様子なんて、まだ誰も見ていないはずなのに……。"
},
{
"no": 22,
"start": 105.84,
"end": 111.12,
"speed": 1.0,
"slot": [
105.84,
111.12
],
"text": "誰が測っているのか。どうして、まだ来ていない先のことまで分かるのか。"
},
{
"no": 23,
"start": 112.02,
"end": 116.6,
"speed": 1.0,
"slot": [
112.02,
116.6
],
"text": "その正体は、意外にも、まるロボのすぐそばにありました。"
},
{
"no": 24,
"start": 117.6,
"end": 122.78,
"speed": 1.0,
"slot": [
117.6,
122.78
],
"text": "これから、まるロボと一緒に、赤い線の正体を見に行きます。"
},
{
"no": 25,
"start": 123.98,
"end": 130.04,
"speed": 1.0,
"slot": [
123.98,
130.04
],
"text": "次の日。まるロボは、大きな道にかかる歩道橋の上にやってきました。"
},
{
"no": 26,
"start": 130.94,
"end": 134.7,
"speed": 1.0,
"slot": [
130.94,
134.7
],
"text": "まずは、自分で車を数えてみることにしたようです。"
},
{
"no": 27,
"start": 135.5,
"end": 140.2,
"speed": 1.0,
"slot": [
135.5,
140.2
],
"text": "目の光で下を通る車を、1台ずつ……ピッ、ピッ。"
},
{
"no": 28,
"start": 141.2,
"end": 144.64,
"speed": 1.0,
"slot": [
141.2,
144.64
],
"text": "ところが、車は次から次へとやってきます。"
},
{
"no": 29,
"start": 145.44,
"end": 148.97,
"speed": 1.0,
"slot": [
145.44,
148.97
],
"text": "右の車線も、左の車線も……ピピピピッ。"
},
{
"no": 30,
"start": 150.17,
"end": 153.56,
"speed": 1.0,
"slot": [
150.17,
153.56
],
"text": "……くるくる。まるロボ、目を回してしまいました。"
},
{
"no": 31,
"start": 155.36,
"end": 158.51,
"speed": 1.0,
"slot": [
155.36,
158.51
],
"text": "たった1本の道でも、これだけ大変です。"
},
{
"no": 32,
"start": 159.11,
"end": 163.37,
"speed": 1.0,
"slot": [
159.11,
163.37
],
"text": "見てください。町には、数えきれないほどの道があります。"
},
{
"no": 33,
"start": 164.17,
"end": 168.67,
"speed": 1.0,
"slot": [
164.17,
168.67
],
"text": "全部の道に人が立って数えるなんて、とても間に合いませんね。"
},
{
"no": 34,
"start": 169.67,
"end": 174.1,
"speed": 1.0,
"slot": [
169.67,
174.1
],
"text": "では、道のこみ具合は、いったい何が測っているのでしょう？"
},
{
"no": 35,
"start": 175.3,
"end": 178.48,
"speed": 1.0,
"slot": [
175.3,
178.48
],
"text": "ふらふらのまるロボが、ふと上を見上げると……。"
},
{
"no": 36,
"start": 179.38,
"end": 183.78,
"speed": 1.0,
"slot": [
179.38,
183.78
],
"text": "道の上に張り出した柱に、四角い機械が付いています。"
},
{
"no": 37,
"start": 184.38,
"end": 189.85,
"speed": 1.0,
"slot": [
184.38,
189.85
],
"text": "これは、道を通る車をとらえる機械。感知器と呼ばれています。"
},
{
"no": 38,
"start": 190.65,
"end": 194.41,
"speed": 1.0,
"slot": [
190.65,
194.41
],
"text": "では、この感知器は、何をしているのでしょうか？"
},
{
"no": 39,
"start": 195.31,
"end": 200.25,
"speed": 1.0,
"slot": [
195.31,
200.25
],
"text": "感知器は、真下の道に向けて、目に見えない音を出しています。"
},
{
"no": 40,
"start": 200.85,
"end": 204.37,
"speed": 1.0,
"slot": [
200.85,
204.37
],
"text": "音は道ではね返って、感知器に戻ってきます。"
},
{
"no": 41,
"start": 205.27,
"end": 211.19,
"speed": 1.0,
"slot": [
205.27,
211.19
],
"text": "車が下を通ると……はね返ってくるまでの時間が、短くなりました。"
},
{
"no": 42,
"start": 212.19,
"end": 217.03,
"speed": 1.0,
"slot": [
212.19,
217.03
],
"text": "この変わり方で、通った車の数や、こみ具合が分かるのです。"
},
{
"no": 43,
"start": 217.63,
"end": 222.87,
"speed": 1.0,
"slot": [
217.63,
222.87
],
"text": "まるロボが目で数えていたことを、この機械は休まず続けていたわけです。"
},
{
"no": 44,
"start": 223.77,
"end": 226.7,
"speed": 1.0,
"slot": [
223.77,
226.7
],
"text": "では、測ったことは、どこへ行くのでしょう？"
},
{
"no": 45,
"start": 227.5,
"end": 233.21,
"speed": 1.0,
"slot": [
227.5,
233.21
],
"text": "日本では、警察や道路を管理する会社が、こうした情報を集めています。"
},
{
"no": 46,
"start": 234.11,
"end": 240.15,
"speed": 1.0,
"slot": [
234.11,
240.15
],
"text": "集めた情報は、まとめる所を通って、電波で車のナビに届きます。"
},
{
"no": 47,
"start": 241.05,
"end": 245.33,
"speed": 1.0,
"slot": [
241.05,
245.33
],
"text": "だから、車のナビでも、この先の渋滞が分かるのです。"
},
{
"no": 48,
"start": 246.23,
"end": 249.87,
"speed": 1.0,
"slot": [
246.23,
249.87
],
"text": "ところが、この感知器には、苦手なことがあります。"
},
{
"no": 49,
"start": 250.87,
"end": 253.8,
"speed": 1.0,
"slot": [
250.87,
253.8
],
"text": "まるロボが、町はずれの道へ行ってみると……。"
},
{
"no": 50,
"start": 255.2,
"end": 257.94,
"speed": 1.0,
"slot": [
255.2,
257.94
],
"text": "見上げても、機械はどこにもありません。"
},
{
"no": 51,
"start": 258.84,
"end": 263.71,
"speed": 1.0,
"slot": [
258.84,
263.71
],
"text": "感知器が多いのは、大きな道や、町なかの交差点のまわり。"
},
{
"no": 52,
"start": 264.31,
"end": 269.2,
"speed": 1.0,
"slot": [
264.31,
269.2
],
"text": "町はずれや、橋やトンネルのように、置きにくい所もあるのです。"
},
{
"no": 53,
"start": 269.8,
"end": 274.13,
"speed": 1.0,
"slot": [
269.8,
274.13
],
"text": "だから、感知器だけでは、この道のこみ具合は分かりません。"
},
{
"no": 54,
"start": 274.73,
"end": 280.65,
"speed": 1.0,
"slot": [
274.73,
280.65
],
"text": "それなのに、冒頭の道案内の地図は、細い道にまで色が付いていました。"
},
{
"no": 55,
"start": 281.25,
"end": 282.72,
"speed": 1.0,
"slot": [
281.25,
282.72
],
"text": "機械がないのに、なぜ……？"
},
{
"no": 56,
"start": 283.62,
"end": 289.15,
"speed": 1.0,
"slot": [
283.62,
289.15
],
"text": "冒頭で言った「すぐそば」。答えは、ここにありました。"
},
{
"no": 57,
"start": 289.75,
"end": 296.84,
"speed": 1.0,
"slot": [
289.75,
296.84
],
"text": "冒頭と同じ、夕方の渋滞の中。おじさんの車を、もう一度見てください。"
},
{
"no": 58,
"start": 297.44,
"end": 302.12,
"speed": 1.0,
"slot": [
297.44,
302.12
],
"text": "前の台に付いていた道案内。これは、スマホです。"
},
{
"no": 59,
"start": 302.72,
"end": 309.54,
"speed": 1.0,
"slot": [
302.72,
309.54
],
"text": "見てください。スマホから、小さな光の点が、ぽうっと上がっていきます。"
},
{
"no": 60,
"start": 310.14,
"end": 317.1,
"speed": 1.0,
"slot": [
310.14,
317.1
],
"text": "ここでは、スマホから届く「いまどこにいるか」の手がかりを、光る点で表しています。"
},
{
"no": 61,
"start": 318.0,
"end": 320.84,
"speed": 1.0,
"slot": [
318.0,
320.84
],
"text": "まるロボが、窓から顔を出してみると……。"
},
{
"no": 62,
"start": 321.44,
"end": 327.13,
"speed": 1.0,
"slot": [
321.44,
327.13
],
"text": "前の車からも、後ろの車からも、点が次々に上がっていきます。"
},
{
"no": 63,
"start": 327.73,
"end": 332.0,
"speed": 1.0,
"slot": [
327.73,
332.0
],
"text": "点は空へのぼって、大きな地図の上に集まっていきました。"
},
{
"no": 64,
"start": 332.6,
"end": 337.47,
"speed": 1.0,
"slot": [
332.6,
337.47
],
"text": "道案内を使っているスマホは、自分がいまどこにいるかを知っています。"
},
{
"no": 65,
"start": 338.07,
"end": 342.11,
"speed": 1.0,
"slot": [
338.07,
342.11
],
"text": "その位置の手がかりが、こうして、たくさん集まっていくのです。"
},
{
"no": 66,
"start": 343.01,
"end": 346.62,
"speed": 1.0,
"slot": [
343.01,
346.62
],
"text": "では、集まった点を、よく見てみましょう。"
},
{
"no": 67,
"start": 347.22,
"end": 350.39,
"speed": 1.0,
"slot": [
347.22,
350.39
],
"text": "すいている道の点は……すいすい進みます。"
},
{
"no": 68,
"start": 350.99,
"end": 354.27,
"speed": 1.0,
"slot": [
350.99,
354.27
],
"text": "一方、こんでいる道の点は……のろのろ。"
},
{
"no": 69,
"start": 354.87,
"end": 359.97,
"speed": 1.0,
"slot": [
354.87,
359.97
],
"text": "たとえば、同じ100メートルを、すいた道なら10秒ほどで進みます。"
},
{
"no": 70,
"start": 360.57,
"end": 365.44,
"speed": 1.0,
"slot": [
360.57,
365.44
],
"text": "でも、こんだ道では1分たっても、まだ半分ということも。"
},
{
"no": 71,
"start": 366.04,
"end": 370.63,
"speed": 1.0,
"slot": [
366.04,
370.63
],
"text": "同じ道の上の点が、みんなゆっくりしか進まなければ……。"
},
{
"no": 72,
"start": 371.23,
"end": 374.38,
"speed": 1.0,
"slot": [
371.23,
374.38
],
"text": "そこは、こんでいる、と分かるのです。"
},
{
"no": 73,
"start": 375.28,
"end": 379.5,
"speed": 1.0,
"slot": [
375.28,
379.5
],
"text": "すると、空の地図の道の色が、変わっていきます。"
},
{
"no": 74,
"start": 380.1,
"end": 385.56,
"speed": 1.0,
"slot": [
380.1,
385.56
],
"text": "点が速い所は、緑。少しゆっくりの所は、黄色。"
},
{
"no": 75,
"start": 386.16,
"end": 389.2,
"speed": 1.0,
"slot": [
386.16,
389.2
],
"text": "そして、のろのろの所は……赤。"
},
{
"no": 76,
"start": 389.8,
"end": 394.91,
"speed": 1.0,
"slot": [
389.8,
394.91
],
"text": "見てください。冒頭で見た赤い線と、同じ形になりました。"
},
{
"no": 77,
"start": 395.81,
"end": 400.59,
"speed": 1.0,
"slot": [
395.81,
400.59
],
"text": "……あれ？　まるロボの車の上にも、点が1つ光っています。"
},
{
"no": 78,
"start": 401.19,
"end": 405.8,
"speed": 1.0,
"slot": [
401.19,
405.8
],
"text": "そう。あの点の1つは、まるロボの乗った車でした。"
},
{
"no": 79,
"start": 406.4,
"end": 409.58,
"speed": 1.0,
"slot": [
406.4,
409.58
],
"text": "まるロボ、びっくり。ぴょんぴょん跳ねてみますが……。"
},
{
"no": 80,
"start": 410.18,
"end": 413.7,
"speed": 1.0,
"slot": [
410.18,
413.7
],
"text": "点は、車と一緒に、ゆっくり進むだけ。"
},
{
"no": 81,
"start": 414.3,
"end": 419.69,
"speed": 1.0,
"slot": [
414.3,
419.69
],
"text": "地図を見ていたつもりが、実は、地図を描く側でもあったのです。"
},
{
"no": 82,
"start": 420.59,
"end": 426.35,
"speed": 1.0,
"slot": [
420.59,
426.35
],
"text": "つまり、赤い線を測っていたのは、道を走っている車のスマホ。"
},
{
"no": 83,
"start": 426.95,
"end": 430.67,
"speed": 1.0,
"slot": [
426.95,
430.67
],
"text": "みんなのスマホが、少しずつ、道を測っていたのです。"
},
{
"no": 84,
"start": 431.27,
"end": 435.6,
"speed": 1.0,
"slot": [
431.27,
435.6
],
"text": "だから、感知器のない細い道にも、色が付くわけです。"
},
{
"no": 85,
"start": 436.2,
"end": 440.22,
"speed": 1.0,
"slot": [
436.2,
440.22
],
"text": "その道を走るスマホがあれば、点が上がるのですから。"
},
{
"no": 86,
"start": 441.12,
"end": 444.34,
"speed": 1.0,
"slot": [
441.12,
444.34
],
"text": "でも、ちょっと心配になりませんか？"
},
{
"no": 87,
"start": 444.94,
"end": 449.21,
"speed": 1.0,
"slot": [
444.94,
449.21
],
"text": "自分のいる場所が、誰かに知られてしまうのでは……？"
},
{
"no": 88,
"start": 449.81,
"end": 453.85,
"speed": 1.0,
"slot": [
449.81,
453.85
],
"text": "まるロボも、自分の点をじっと見上げていますね。"
},
{
"no": 89,
"start": 454.75,
"end": 461.52,
"speed": 1.0,
"slot": [
454.75,
461.52
],
"text": "見てください。点が上がるとき、持ち主の印が外れて、ただの点になります。"
},
{
"no": 90,
"start": 462.12,
"end": 468.49,
