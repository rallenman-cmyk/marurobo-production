[
{
"no": 1,
"start": 0.5,
"end": 6.02,
"speed": 1.0,
"slot": [
0.5,
6.02
],
"text": "休みの日の夕方。まるロボは、車の助手席に乗っています。"
},
{
"no": 2,
"start": 6.92,
"end": 13.6,
"speed": 1.0,
"slot": [
6.92,
13.6
],
"text": "運転しているのは、近所のおじさん。海の見える公園まで、送ってくれるのです。"
},
{
"no": 3,
"start": 14.2,
"end": 17.73,
"speed": 1.0,
"slot": [
14.2,
17.73
],
"text": "前の台には、道案内の地図が映っています。"
},
{
"no": 4,
"start": 18.63,
"end": 22.21,
"speed": 1.0,
"slot": [
18.63,
22.21
],
"text": "まるロボは、さっきから、この地図に夢中のようです。"
},
{
"no": 5,
"start": 23.11,
"end": 28.05,
"speed": 1.0,
"slot": [
23.11,
28.05
],
"text": "見てください。地図の上で、この先の道が赤くなっています。"
},
{
"no": 6,
"start": 28.65,
"end": 33.04,
"speed": 1.0,
"slot": [
28.65,
33.04
],
"text": "どうやら「この先、渋滞」という合図のようです。"
},
{
"no": 7,
"start": 33.84,
"end": 38.0,
"speed": 1.0,
"slot": [
33.84,
38.0
],
"text": "でも、窓の外は……車がすいすい走っています。"
},
{
"no": 8,
"start": 38.9,
"end": 41.06,
"speed": 1.0,
"slot": [
38.9,
41.06
],
"text": "まるロボも、首をかしげていますね。"
},
{
"no": 9,
"start": 42.06,
"end": 44.38,
"speed": 1.0,
"slot": [
42.06,
44.38
],
"text": "ところが、角を曲がると……。"
},
{
"no": 10,
"start": 45.68,
"end": 49.62,
"speed": 1.0,
"slot": [
45.68,
49.62
],
"text": "ずらり。本当に、車が並んでいました。"
},
{
"no": 11,
"start": 50.62,
"end": 53.93,
"speed": 1.0,
"slot": [
50.62,
53.93
],
"text": "止まった車の中で、まるロボは、しょんぼり。"
},
{
"no": 12,
"start": 54.53,
"end": 59.45,
"speed": 1.0,
"slot": [
54.53,
59.45
],
"text": "地図は、角の向こうで見えなかった渋滞を、ちゃんと当てていたのです。"
},
{
"no": 13,
"start": 60.35,
"end": 62.17,
"speed": 1.0,
"slot": [
60.35,
62.17
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 14,
"start": 62.77,
"end": 66.64,
"speed": 1.0,
"slot": [
62.77,
66.64
],
"text": "道の上には、車を数えている人なんて、どこにもいません。"
},
{
"no": 15,
"start": 67.24,
"end": 70.86,
"speed": 1.0,
"slot": [
67.24,
70.86
],
"text": "いったい誰が、道のこみ具合を測っているのでしょうか？"
},
{
"no": 16,
"start": 71.76,
"end": 74.83,
"speed": 1.0,
"slot": [
71.76,
74.83
],
"text": "しかも、気になることは、それだけではありません。"
},
{
"no": 17,
"start": 75.63,
"end": 78.03,
"speed": 1.0,
"slot": [
75.63,
78.03
],
"text": "地図を、ぐっと広げてみると……。"
},
{
"no": 18,
"start": 78.93,
"end": 83.59,
"speed": 1.0,
"slot": [
78.93,
83.59
],
"text": "行ったこともない遠くの町の、細い道にまで、色が付いています。"
},
{
"no": 19,
"start": 84.49,
"end": 92.02,
"speed": 1.0,
"slot": [
84.49,
92.02
],
"text": "日本の道は、全部つなげると120万キロ以上。地球をおよそ30周する長さです。"
},
{
"no": 20,
"start": 92.62,
"end": 96.33,
"speed": 1.0,
"slot": [
92.62,
96.33
],
"text": "さらに、画面には、公園に着く時刻まで出ています。"
},
{
"no": 21,
"start": 96.93,
"end": 102.09,
"speed": 1.0,
"slot": [
96.93,
102.09
],
"text": "30分も先の道の様子なんて、まだ誰も見ていないはずなのに……。"
},
{
"no": 22,
"start": 103.09,
"end": 108.11,
"speed": 1.0,
"slot": [
103.09,
108.11
],
"text": "誰が測っているのか。どうして、まだ来ていない先のことまで分かるのか。"
},
{
"no": 23,
"start": 109.01,
"end": 113.53,
"speed": 1.0,
"slot": [
109.01,
113.53
],
"text": "その正体は、意外にも、まるロボのすぐそばにありました。"
},
{
"no": 24,
"start": 114.53,
"end": 119.58,
"speed": 1.0,
"slot": [
114.53,
119.58
],
"text": "これから、まるロボと一緒に、赤い線の正体を見に行きます。"
},
{
"no": 25,
"start": 120.78,
"end": 126.73,
"speed": 1.0,
"slot": [
120.78,
126.73
],
"text": "次の日。まるロボは、大きな道にかかる歩道橋の上にやってきました。"
},
{
"no": 26,
"start": 127.63,
"end": 131.36,
"speed": 1.0,
"slot": [
127.63,
131.36
],
"text": "まずは、自分で車を数えてみることにしたようです。"
},
{
"no": 27,
"start": 132.16,
"end": 137.12,
"speed": 1.0,
"slot": [
132.16,
137.12
],
"text": "目の光で下を通る車を、1台ずつ……ピッ、ピッ。"
},
{
"no": 28,
"start": 138.12,
"end": 141.5,
"speed": 1.0,
"slot": [
138.12,
141.5
],
"text": "ところが、車は次から次へとやってきます。"
},
{
"no": 29,
"start": 142.3,
"end": 145.76,
"speed": 1.0,
"slot": [
142.3,
145.76
],
"text": "右の車線も、左の車線も……ピピピピッ。"
},
{
"no": 30,
"start": 146.96,
"end": 150.29,
"speed": 1.0,
"slot": [
146.96,
150.29
],
"text": "……くるくる。まるロボ、目を回してしまいました。"
},
{
"no": 31,
"start": 152.09,
"end": 155.21,
"speed": 1.0,
"slot": [
152.09,
155.21
],
"text": "たった1本の道でも、これだけ大変です。"
},
{
"no": 32,
"start": 155.81,
"end": 160.0,
"speed": 1.0,
"slot": [
155.81,
160.0
],
"text": "見てください。町には、数えきれないほどの道があります。"
},
{
"no": 33,
"start": 160.8,
"end": 165.23,
"speed": 1.0,
"slot": [
160.8,
165.23
],
"text": "全部の道に人が立って数えるなんて、とても間に合いませんね。"
},
{
"no": 34,
"start": 166.23,
"end": 170.52,
"speed": 1.0,
"slot": [
166.23,
170.52
],
"text": "では、道のこみ具合は、いったい何が測っているのでしょう？"
},
{
"no": 35,
"start": 171.72,
"end": 175.41,
"speed": 1.0,
"slot": [
171.72,
175.41
],
"text": "ふらふらのまるロボが、ふと上を見上げると……。"
},
{
"no": 36,
"start": 176.31,
"end": 180.7,
"speed": 1.0,
"slot": [
176.31,
180.7
],
"text": "道の上に張り出した柱に、四角い機械が付いています。"
},
{
"no": 37,
"start": 181.3,
"end": 186.72,
"speed": 1.0,
"slot": [
181.3,
186.72
],
"text": "これは、道を通る車をとらえる機械。感知器と呼ばれています。"
},
{
"no": 38,
"start": 187.52,
"end": 191.23,
"speed": 1.0,
"slot": [
187.52,
191.23
],
"text": "では、この感知器は、何をしているのでしょうか？"
},
{
"no": 39,
"start": 192.13,
"end": 197.0,
"speed": 1.0,
"slot": [
192.13,
197.0
],
"text": "感知器は、真下の道に向けて、目に見えない音を出しています。"
},
{
"no": 40,
"start": 197.6,
"end": 201.08,
"speed": 1.0,
"slot": [
197.6,
201.08
],
"text": "音は道ではね返って、感知器に戻ってきます。"
},
{
"no": 41,
"start": 201.98,
"end": 207.88,
"speed": 1.0,
"slot": [
201.98,
207.88
],
"text": "車が下を通ると……はね返ってくるまでの時間が、短くなりました。"
},
{
"no": 42,
"start": 208.88,
"end": 213.67,
"speed": 1.0,
"slot": [
208.88,
213.67
],
"text": "この変わり方で、通った車の数や、こみ具合が分かるのです。"
},
{
"no": 43,
"start": 214.27,
"end": 219.45,
"speed": 1.0,
"slot": [
214.27,
219.45
],
"text": "まるロボが目で数えていたことを、この機械は休まず続けていたわけです。"
},
{
"no": 44,
"start": 220.35,
"end": 223.22,
"speed": 1.0,
"slot": [
220.35,
223.22
],
"text": "では、測ったことは、どこへ行くのでしょう？"
},
{
"no": 45,
"start": 224.02,
"end": 229.68,
"speed": 1.0,
"slot": [
224.02,
229.68
],
"text": "日本では、警察や道路を管理する会社が、こうした情報を集めています。"
},
{
"no": 46,
"start": 230.58,
"end": 236.6,
"speed": 1.0,
"slot": [
230.58,
236.6
],
"text": "集めた情報は、まとめる所を通って、電波で車のナビに届きます。"
},
{
"no": 47,
"start": 237.5,
"end": 241.71,
"speed": 1.0,
"slot": [
237.5,
241.71
],
"text": "だから、車のナビでも、この先の渋滞が分かるのです。"
},
{
"no": 48,
"start": 242.61,
"end": 246.52,
"speed": 1.0,
"slot": [
242.61,
246.52
],
"text": "ところが、この感知器には、苦手なことがあります。"
},
{
"no": 49,
"start": 247.52,
"end": 250.38,
"speed": 1.0,
"slot": [
247.52,
250.38
],
"text": "まるロボが、町はずれの道へ行ってみると……。"
},
{
"no": 50,
"start": 251.78,
"end": 254.46,
"speed": 1.0,
"slot": [
251.78,
254.46
],
"text": "見上げても、機械はどこにもありません。"
},
{
"no": 51,
"start": 255.36,
"end": 260.2,
"speed": 1.0,
"slot": [
255.36,
260.2
],
"text": "感知器が多いのは、大きな道や、町なかの交差点のまわり。"
},
{
"no": 52,
"start": 260.8,
"end": 265.62,
"speed": 1.0,
"slot": [
260.8,
265.62
],
"text": "町はずれや、橋やトンネルのように、置きにくい所もあるのです。"
},
{
"no": 53,
"start": 266.22,
"end": 270.5,
"speed": 1.0,
"slot": [
266.22,
270.5
],
"text": "だから、感知器だけでは、この道のこみ具合は分かりません。"
},
{
"no": 54,
"start": 271.1,
"end": 277.0,
"speed": 1.0,
"slot": [
271.1,
277.0
],
"text": "それなのに、冒頭の道案内の地図は、細い道にまで色が付いていました。"
},
{
"no": 55,
"start": 277.6,
"end": 279.01,
"speed": 1.0,
"slot": [
277.6,
279.01
],
"text": "機械がないのに、なぜ……？"
},
{
"no": 56,
"start": 279.91,
"end": 285.4,
"speed": 1.0,
"slot": [
279.91,
285.4
],
"text": "冒頭で言った「すぐそば」。答えは、ここにありました。"
},
{
"no": 57,
"start": 286.0,
"end": 293.03,
"speed": 1.0,
"slot": [
286.0,
293.03
],
"text": "冒頭と同じ、夕方の渋滞の中。おじさんの車を、もう一度見てください。"
},
{
"no": 58,
"start": 293.63,
"end": 298.24,
"speed": 1.0,
"slot": [
293.63,
298.24
],
"text": "前の台に付いていた道案内。これは、スマホです。"
},
{
"no": 59,
"start": 298.84,
"end": 304.67,
"speed": 1.0,
"slot": [
298.84,
304.67
],
"text": "見てください。スマホから、小さな光の点が、ぽうっと上がっていきます。"
},
{
"no": 60,
"start": 305.27,
"end": 312.17,
"speed": 1.0,
"slot": [
305.27,
312.17
],
"text": "ここでは、スマホから届く「いまどこにいるか」の手がかりを、光る点で表しています。"
},
{
"no": 61,
"start": 313.07,
"end": 315.88,
"speed": 1.0,
"slot": [
313.07,
315.88
],
"text": "まるロボが、窓から顔を出してみると……。"
},
{
"no": 62,
"start": 316.48,
"end": 322.11,
"speed": 1.0,
"slot": [
316.48,
322.11
],
"text": "前の車からも、後ろの車からも、点が次々に上がっていきます。"
},
{
"no": 63,
"start": 322.71,
"end": 327.1,
"speed": 1.0,
"slot": [
322.71,
327.1
],
"text": "点は空へのぼって、大きな地図の上に集まっていきました。"
},
{
"no": 64,
"start": 327.7,
"end": 332.51,
"speed": 1.0,
"slot": [
327.7,
332.51
],
"text": "道案内を使っているスマホは、自分がいまどこにいるかを知っています。"
},
{
"no": 65,
"start": 333.11,
"end": 337.1,
"speed": 1.0,
"slot": [
333.11,
337.1
],
"text": "その位置の手がかりが、こうして、たくさん集まっていくのです。"
},
{
"no": 66,
"start": 338.0,
"end": 341.59,
"speed": 1.0,
"slot": [
338.0,
341.59
],
"text": "では、集まった点を、よく見てみましょう。"
},
{
"no": 67,
"start": 342.19,
"end": 345.31,
"speed": 1.0,
"slot": [
342.19,
345.31
],
"text": "すいている道の点は……すいすい進みます。"
},
{
"no": 68,
"start": 345.91,
"end": 349.13,
"speed": 1.0,
"slot": [
345.91,
349.13
],
"text": "一方、こんでいる道の点は……のろのろ。"
},
{
"no": 69,
"start": 349.73,
"end": 354.77,
"speed": 1.0,
"slot": [
349.73,
354.77
],
"text": "たとえば、同じ100メートルを、すいた道なら10秒ほどで進みます。"
},
{
"no": 70,
"start": 355.37,
"end": 360.17,
"speed": 1.0,
"slot": [
355.37,
360.17
],
"text": "でも、こんだ道では1分たっても、まだ半分ということも。"
},
{
"no": 71,
"start": 360.77,
"end": 365.34,
"speed": 1.0,
"slot": [
360.77,
365.34
],
"text": "同じ道の上の点が、みんなゆっくりしか進まなければ……。"
},
{
"no": 72,
"start": 365.94,
"end": 369.04,
"speed": 1.0,
"slot": [
365.94,
369.04
],
"text": "そこは、こんでいる、と分かるのです。"
},
{
"no": 73,
"start": 369.94,
"end": 374.11,
"speed": 1.0,
"slot": [
369.94,
374.11
],
"text": "すると、空の地図の道の色が、変わっていきます。"
},
{
"no": 74,
"start": 374.71,
"end": 380.1,
"speed": 1.0,
"slot": [
374.71,
380.1
],
"text": "点が速い所は、緑。少しゆっくりの所は、黄色。"
},
{
"no": 75,
"start": 380.7,
"end": 383.27,
"speed": 1.0,
"slot": [
380.7,
383.27
],
"text": "そして、のろのろの所は……赤。"
},
{
"no": 76,
"start": 383.87,
"end": 388.95,
"speed": 1.0,
"slot": [
383.87,
388.95
],
"text": "見てください。冒頭で見た赤い線と、同じ形になりました。"
},
{
"no": 77,
"start": 389.85,
"end": 394.56,
"speed": 1.0,
"slot": [
389.85,
394.56
],
"text": "……あれ？　まるロボの車の上にも、点が1つ光っています。"
},
{
"no": 78,
"start": 395.16,
"end": 399.71,
"speed": 1.0,
"slot": [
395.16,
399.71
],
"text": "そう。あの点の1つは、まるロボの乗った車でした。"
},
{
"no": 79,
"start": 400.31,
"end": 403.42,
"speed": 1.0,
"slot": [
400.31,
403.42
],
"text": "まるロボ、びっくり。ぴょんぴょん跳ねてみますが……。"
},
{
"no": 80,
"start": 404.02,
"end": 407.47,
"speed": 1.0,
"slot": [
404.02,
407.47
],
"text": "点は、車と一緒に、ゆっくり進むだけ。"
},
{
"no": 81,
"start": 408.07,
"end": 413.43,
"speed": 1.0,
"slot": [
408.07,
413.43
],
"text": "地図を見ていたつもりが、実は、地図を描く側でもあったのです。"
},
{
"no": 82,
"start": 414.33,
"end": 420.03,
"speed": 1.0,
"slot": [
414.33,
420.03
],
"text": "つまり、赤い線を測っていたのは、道を走っている車のスマホ。"
},
{
"no": 83,
"start": 420.63,
"end": 424.3,
"speed": 1.0,
"slot": [
420.63,
424.3
],
"text": "みんなのスマホが、少しずつ、道を測っていたのです。"
},
{
"no": 84,
"start": 424.9,
"end": 429.17,
"speed": 1.0,
"slot": [
424.9,
429.17
],
"text": "だから、感知器のない細い道にも、色が付くわけです。"
},
{
"no": 85,
"start": 429.77,
"end": 433.74,
"speed": 1.0,
"slot": [
429.77,
433.74
],
"text": "その道を走るスマホがあれば、点が上がるのですから。"
},
{
"no": 86,
"start": 434.64,
"end": 437.83,
"speed": 1.0,
"slot": [
434.64,
437.83
],
"text": "でも、ちょっと心配になりませんか？"
},
{
"no": 87,
"start": 438.43,
"end": 442.63,
"speed": 1.0,
"slot": [
438.43,
442.63
],
"text": "自分のいる場所が、誰かに知られてしまうのでは……？"
},
{
"no": 88,
"start": 443.23,
"end": 447.21,
"speed": 1.0,
"slot": [
443.23,
447.21
],
"text": "まるロボも、自分の点をじっと見上げていますね。"
},
{
"no": 89,
"start": 448.11,
"end": 454.81,
"speed": 1.0,
"slot": [
448.11,
454.81
],
"text": "見てください。点が上がるとき、持ち主の印が外れて、ただの点になります。"
},
{
"no": 90,
"start": 455.41,
"end": 461.72,
