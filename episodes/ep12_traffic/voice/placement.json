[
{
"no": 1,
"start": 0.5,
"end": 6.02,
"speed": 1.0,
"slot": [
0.5,
6.02
],
"text": "休みの日の夕方。まるロボは、車の助手席に乗っています。"
},
{
"no": 2,
"start": 6.92,
"end": 13.6,
"speed": 1.0,
"slot": [
6.92,
13.6
],
"text": "運転しているのは、近所のおじさん。海の見える公園まで、送ってくれるのです。"
},
{
"no": 3,
"start": 14.2,
"end": 17.73,
"speed": 1.0,
"slot": [
14.2,
17.73
],
"text": "前の台には、道案内の地図が映っています。"
},
{
"no": 4,
"start": 18.63,
"end": 22.21,
"speed": 1.0,
"slot": [
18.63,
22.21
],
"text": "まるロボは、さっきから、この地図に夢中のようです。"
},
{
"no": 5,
"start": 23.11,
"end": 28.05,
"speed": 1.0,
"slot": [
23.11,
28.05
],
"text": "見てください。地図の上で、この先の道が赤くなっています。"
},
{
"no": 6,
"start": 28.65,
"end": 33.04,
"speed": 1.0,
"slot": [
28.65,
33.04
],
"text": "どうやら「この先、渋滞」という合図のようです。"
},
{
"no": 7,
"start": 33.84,
"end": 38.0,
"speed": 1.0,
"slot": [
33.84,
38.0
],
"text": "でも、窓の外は……車がすいすい走っています。"
},
{
"no": 8,
"start": 38.9,
"end": 41.06,
"speed": 1.0,
"slot": [
38.9,
41.06
],
"text": "まるロボも、首をかしげていますね。"
},
{
"no": 9,
"start": 42.06,
"end": 44.38,
"speed": 1.0,
"slot": [
42.06,
44.38
],
"text": "ところが、角を曲がると……。"
},
{
"no": 10,
"start": 45.68,
"end": 49.62,
"speed": 1.0,
"slot": [
45.68,
49.62
],
"text": "ずらり。本当に、車が並んでいました。"
},
{
"no": 11,
"start": 50.62,
"end": 53.93,
"speed": 1.0,
"slot": [
50.62,
53.93
],
"text": "止まった車の中で、まるロボは、しょんぼり。"
},
{
"no": 12,
"start": 54.53,
"end": 59.45,
"speed": 1.0,
"slot": [
54.53,
59.45
],
"text": "地図は、角の向こうで見えなかった渋滞を、ちゃんと当てていたのです。"
},
{
"no": 13,
"start": 60.35,
"end": 62.17,
"speed": 1.0,
"slot": [
60.35,
62.17
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 14,
"start": 62.77,
"end": 66.64,
"speed": 1.0,
"slot": [
62.77,
66.64
],
"text": "道の上には、車を数えている人なんて、どこにもいません。"
},
{
"no": 15,
"start": 67.24,
"end": 70.86,
"speed": 1.0,
"slot": [
67.24,
70.86
],
"text": "いったい誰が、道のこみ具合を測っているのでしょうか？"
},
{
"no": 16,
"start": 71.76,
"end": 74.83,
"speed": 1.0,
"slot": [
71.76,
74.83
],
"text": "しかも、気になることは、それだけではありません。"
},
{
"no": 17,
"start": 75.63,
"end": 78.03,
"speed": 1.0,
"slot": [
75.63,
78.03
],
"text": "地図を、ぐっと広げてみると……。"
},
{
"no": 18,
"start": 78.93,
"end": 83.59,
"speed": 1.0,
"slot": [
78.93,
83.59
],
"text": "行ったこともない遠くの町の、細い道にまで、色が付いています。"
},
{
"no": 19,
"start": 84.49,
"end": 92.02,
"speed": 1.0,
"slot": [
84.49,
92.02
],
"text": "日本の道は、全部つなげると120万キロ以上。地球をおよそ30周する長さです。"
},
{
"no": 20,
"start": 92.62,
"end": 96.33,
"speed": 1.0,
"slot": [
92.62,
96.33
],
"text": "さらに、画面には、公園に着く時刻まで出ています。"
},
{
"no": 21,
"start": 96.93,
"end": 102.09,
"speed": 1.0,
"slot": [
96.93,
102.09
],
"text": "30分も先の道の様子なんて、まだ誰も見ていないはずなのに……。"
},
{
"no": 22,
"start": 103.09,
"end": 108.11,
"speed": 1.0,
"slot": [
103.09,
108.11
],
"text": "誰が測っているのか。どうして、まだ来ていない先のことまで分かるのか。"
},
{
"no": 23,
"start": 110.61,
"end": 115.13,
"speed": 1.0,
"slot": [
110.61,
115.13
],
"text": "その正体は、意外にも、まるロボのすぐそばにありました。"
},
{
"no": 24,
"start": 116.13,
"end": 121.18,
"speed": 1.0,
"slot": [
116.13,
121.18
],
"text": "これから、まるロボと一緒に、赤い線の正体を見に行きます。"
},
{
"no": 25,
"start": 122.38,
"end": 128.33,
"speed": 1.0,
"slot": [
122.38,
128.33
],
"text": "次の日。まるロボは、大きな道にかかる歩道橋の上にやってきました。"
},
{
"no": 26,
"start": 129.23,
"end": 132.96,
"speed": 1.0,
"slot": [
129.23,
132.96
],
"text": "まずは、自分で車を数えてみることにしたようです。"
},
{
"no": 27,
"start": 133.76,
"end": 138.72,
"speed": 1.0,
"slot": [
133.76,
138.72
],
"text": "目の光で下を通る車を、1台ずつ……ピッ、ピッ。"
},
{
"no": 28,
"start": 139.72,
"end": 143.1,
"speed": 1.0,
"slot": [
139.72,
143.1
],
"text": "ところが、車は次から次へとやってきます。"
},
{
"no": 29,
"start": 143.9,
"end": 147.36,
"speed": 1.0,
"slot": [
143.9,
147.36
],
"text": "右の車線も、左の車線も……ピピピピッ。"
},
{
"no": 30,
"start": 148.56,
"end": 151.89,
"speed": 1.0,
"slot": [
148.56,
151.89
],
"text": "……くるくる。まるロボ、目を回してしまいました。"
},
{
"no": 31,
"start": 153.69,
"end": 156.81,
"speed": 1.0,
"slot": [
153.69,
156.81
],
"text": "たった1本の道でも、これだけ大変です。"
},
{
"no": 32,
"start": 157.41,
"end": 161.6,
"speed": 1.0,
"slot": [
157.41,
161.6
],
"text": "見てください。町には、数えきれないほどの道があります。"
},
{
"no": 33,
"start": 162.4,
"end": 166.83,
"speed": 1.0,
"slot": [
162.4,
166.83
],
"text": "全部の道に人が立って数えるなんて、とても間に合いませんね。"
},
{
"no": 34,
"start": 167.83,
"end": 172.12,
"speed": 1.0,
"slot": [
167.83,
172.12
],
"text": "では、道のこみ具合は、いったい何が測っているのでしょう？"
},
{
"no": 35,
"start": 173.32,
"end": 177.01,
"speed": 1.0,
"slot": [
173.32,
177.01
],
"text": "ふらふらのまるロボが、ふと上を見上げると……。"
},
{
"no": 36,
"start": 177.91,
"end": 182.3,
"speed": 1.0,
"slot": [
177.91,
182.3
],
"text": "道の上に張り出した柱に、四角い機械が付いています。"
},
{
"no": 37,
"start": 182.9,
"end": 188.32,
"speed": 1.0,
"slot": [
182.9,
188.32
],
"text": "これは、道を通る車をとらえる機械。感知器と呼ばれています。"
},
{
"no": 38,
"start": 189.12,
"end": 192.83,
"speed": 1.0,
"slot": [
189.12,
192.83
],
"text": "では、この感知器は、何をしているのでしょうか？"
},
{
"no": 39,
"start": 193.73,
"end": 198.6,
"speed": 1.0,
"slot": [
193.73,
198.6
],
"text": "感知器は、真下の道に向けて、目に見えない音を出しています。"
},
{
"no": 40,
"start": 199.2,
"end": 202.68,
"speed": 1.0,
"slot": [
199.2,
202.68
],
"text": "音は道ではね返って、感知器に戻ってきます。"
},
{
"no": 41,
"start": 203.58,
"end": 209.48,
"speed": 1.0,
"slot": [
203.58,
209.48
],
"text": "車が下を通ると……はね返ってくるまでの時間が、短くなりました。"
},
{
"no": 42,
"start": 210.48,
"end": 215.27,
"speed": 1.0,
"slot": [
210.48,
215.27
],
"text": "この変わり方で、通った車の数や、こみ具合が分かるのです。"
},
{
"no": 43,
"start": 215.87,
"end": 221.05,
"speed": 1.0,
"slot": [
215.87,
221.05
],
"text": "まるロボが目で数えていたことを、この機械は休まず続けていたわけです。"
},
{
"no": 44,
"start": 221.95,
"end": 224.82,
"speed": 1.0,
"slot": [
221.95,
224.82
],
"text": "では、測ったことは、どこへ行くのでしょう？"
},
{
"no": 45,
"start": 225.62,
"end": 231.28,
"speed": 1.0,
"slot": [
225.62,
231.28
],
"text": "日本では、警察や道路を管理する会社が、こうした情報を集めています。"
},
{
"no": 46,
"start": 232.18,
"end": 238.2,
"speed": 1.0,
"slot": [
232.18,
238.2
],
"text": "集めた情報は、まとめる所を通って、電波で車のナビに届きます。"
},
{
"no": 47,
"start": 239.1,
"end": 243.31,
"speed": 1.0,
"slot": [
239.1,
243.31
],
"text": "だから、車のナビでも、この先の渋滞が分かるのです。"
},
{
"no": 48,
"start": 244.21,
"end": 248.12,
"speed": 1.0,
"slot": [
244.21,
248.12
],
"text": "ところが、この感知器には、苦手なことがあります。"
},
{
"no": 49,
"start": 249.12,
"end": 251.98,
"speed": 1.0,
"slot": [
249.12,
251.98
],
"text": "まるロボが、町はずれの道へ行ってみると……。"
},
{
"no": 50,
"start": 253.38,
"end": 256.06,
"speed": 1.0,
"slot": [
253.38,
256.06
],
"text": "見上げても、機械はどこにもありません。"
},
{
"no": 51,
"start": 256.96,
"end": 261.8,
"speed": 1.0,
"slot": [
256.96,
261.8
],
"text": "感知器が多いのは、大きな道や、町なかの交差点のまわり。"
},
{
"no": 52,
"start": 262.4,
"end": 267.22,
"speed": 1.0,
"slot": [
262.4,
267.22
],
"text": "町はずれや、橋やトンネルのように、置きにくい所もあるのです。"
},
{
"no": 53,
"start": 267.82,
"end": 272.1,
"speed": 1.0,
"slot": [
267.82,
272.1
],
"text": "だから、感知器だけでは、この道のこみ具合は分かりません。"
},
{
"no": 54,
"start": 272.7,
"end": 278.6,
"speed": 1.0,
"slot": [
272.7,
278.6
],
"text": "それなのに、冒頭の道案内の地図は、細い道にまで色が付いていました。"
},
{
"no": 55,
"start": 279.2,
"end": 280.61,
"speed": 1.0,
"slot": [
279.2,
280.61
],
"text": "機械がないのに、なぜ……？"
},
{
"no": 56,
"start": 281.51,
"end": 287.0,
"speed": 1.0,
"slot": [
281.51,
287.0
],
"text": "冒頭で言った「すぐそば」。答えは、ここにありました。"
},
{
"no": 57,
"start": 287.6,
"end": 294.63,
"speed": 1.0,
"slot": [
287.6,
294.63
],
"text": "冒頭と同じ、夕方の渋滞の中。おじさんの車を、もう一度見てください。"
},
{
"no": 58,
"start": 295.23,
"end": 299.84,
"speed": 1.0,
"slot": [
295.23,
299.84
],
"text": "前の台に付いていた道案内。これは、スマホです。"
},
{
"no": 59,
"start": 300.44,
"end": 306.27,
"speed": 1.0,
"slot": [
300.44,
306.27
],
"text": "見てください。スマホから、小さな光の点が、ぽうっと上がっていきます。"
},
{
"no": 60,
"start": 306.87,
"end": 313.77,
"speed": 1.0,
"slot": [
306.87,
313.77
],
"text": "ここでは、スマホから届く「いまどこにいるか」の手がかりを、光る点で表しています。"
},
{
"no": 61,
"start": 314.67,
"end": 317.48,
"speed": 1.0,
"slot": [
314.67,
317.48
],
"text": "まるロボが、窓から顔を出してみると……。"
},
{
"no": 62,
"start": 318.08,
"end": 323.71,
"speed": 1.0,
"slot": [
318.08,
323.71
],
"text": "前の車からも、後ろの車からも、点が次々に上がっていきます。"
},
{
"no": 63,
"start": 324.31,
"end": 328.7,
"speed": 1.0,
"slot": [
324.31,
328.7
],
"text": "点は空へのぼって、大きな地図の上に集まっていきました。"
},
{
"no": 64,
"start": 329.3,
"end": 334.11,
"speed": 1.0,
"slot": [
329.3,
334.11
],
"text": "道案内を使っているスマホは、自分がいまどこにいるかを知っています。"
},
{
"no": 65,
"start": 334.71,
"end": 338.7,
"speed": 1.0,
"slot": [
334.71,
338.7
],
"text": "その位置の手がかりが、こうして、たくさん集まっていくのです。"
},
{
"no": 66,
"start": 339.6,
"end": 343.19,
"speed": 1.0,
"slot": [
339.6,
343.19
],
"text": "では、集まった点を、よく見てみましょう。"
},
{
"no": 67,
"start": 343.79,
"end": 346.91,
"speed": 1.0,
"slot": [
343.79,
346.91
],
"text": "すいている道の点は……すいすい進みます。"
},
{
"no": 68,
"start": 347.51,
"end": 350.73,
"speed": 1.0,
"slot": [
347.51,
350.73
],
"text": "一方、こんでいる道の点は……のろのろ。"
},
{
"no": 69,
"start": 351.33,
"end": 356.37,
"speed": 1.0,
"slot": [
351.33,
356.37
],
"text": "たとえば、同じ100メートルを、すいた道なら10秒ほどで進みます。"
},
{
"no": 70,
"start": 356.97,
"end": 361.77,
"speed": 1.0,
"slot": [
356.97,
361.77
],
"text": "でも、こんだ道では1分たっても、まだ半分ということも。"
},
{
"no": 71,
"start": 362.37,
"end": 366.94,
"speed": 1.0,
"slot": [
362.37,
366.94
],
"text": "同じ道の上の点が、みんなゆっくりしか進まなければ……。"
},
{
"no": 72,
"start": 367.54,
"end": 370.64,
"speed": 1.0,
"slot": [
367.54,
370.64
],
"text": "そこは、こんでいる、と分かるのです。"
},
{
"no": 73,
"start": 371.54,
"end": 375.71,
"speed": 1.0,
"slot": [
371.54,
375.71
],
"text": "すると、空の地図の道の色が、変わっていきます。"
},
{
"no": 74,
"start": 376.31,
"end": 381.7,
"speed": 1.0,
"slot": [
376.31,
381.7
],
"text": "点が速い所は、緑。少しゆっくりの所は、黄色。"
},
{
"no": 75,
"start": 382.3,
"end": 384.87,
"speed": 1.0,
"slot": [
382.3,
384.87
],
"text": "そして、のろのろの所は……赤。"
},
{
"no": 76,
"start": 385.47,
"end": 390.55,
"speed": 1.0,
"slot": [
385.47,
390.55
],
"text": "見てください。冒頭で見た赤い線と、同じ形になりました。"
},
{
"no": 77,
"start": 391.45,
"end": 396.16,
"speed": 1.0,
"slot": [
391.45,
396.16
],
"text": "……あれ？　まるロボの車の上にも、点が1つ光っています。"
},
{
"no": 78,
"start": 396.76,
"end": 401.31,
"speed": 1.0,
"slot": [
396.76,
401.31
],
"text": "そう。あの点の1つは、まるロボの乗った車でした。"
},
{
"no": 79,
"start": 401.91,
"end": 405.02,
"speed": 1.0,
"slot": [
401.91,
405.02
],
"text": "まるロボ、びっくり。ぴょんぴょん跳ねてみますが……。"
},
{
"no": 80,
"start": 405.62,
"end": 409.07,
"speed": 1.0,
"slot": [
405.62,
409.07
],
"text": "点は、車と一緒に、ゆっくり進むだけ。"
},
{
"no": 81,
"start": 409.67,
"end": 415.03,
"speed": 1.0,
"slot": [
409.67,
415.03
],
"text": "地図を見ていたつもりが、実は、地図を描く側でもあったのです。"
},
{
"no": 82,
"start": 415.93,
"end": 421.63,
"speed": 1.0,
"slot": [
415.93,
421.63
],
"text": "つまり、赤い線を測っていたのは、道を走っている車のスマホ。"
},
{
"no": 83,
"start": 422.23,
"end": 425.9,
"speed": 1.0,
"slot": [
422.23,
425.9
],
"text": "みんなのスマホが、少しずつ、道を測っていたのです。"
},
{
"no": 84,
"start": 426.5,
"end": 430.77,
"speed": 1.0,
"slot": [
426.5,
430.77
],
"text": "だから、感知器のない細い道にも、色が付くわけです。"
},
{
"no": 85,
"start": 431.37,
"end": 435.34,
"speed": 1.0,
"slot": [
431.37,
435.34
],
"text": "その道を走るスマホがあれば、点が上がるのですから。"
},
{
"no": 86,
"start": 436.24,
"end": 439.43,
"speed": 1.0,
"slot": [
436.24,
439.43
],
"text": "でも、ちょっと心配になりませんか？"
},
{
"no": 87,
"start": 440.03,
"end": 444.23,
"speed": 1.0,
"slot": [
440.03,
444.23
],
"text": "自分のいる場所が、誰かに知られてしまうのでは……？"
},
{
"no": 88,
"start": 444.83,
"end": 448.81,
"speed": 1.0,
"slot": [
444.83,
448.81
],
"text": "まるロボも、自分の点をじっと見上げていますね。"
},
{
"no": 89,
"start": 449.71,
"end": 456.41,
"speed": 1.0,
"slot": [
449.71,
456.41
],
"text": "見てください。点が上がるとき、持ち主の印が外れて、ただの点になります。"
},
{
"no": 90,
"start": 457.01,
"end": 463.32,
