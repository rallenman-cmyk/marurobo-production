 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 6.02,
   "text": "休みの日の夕方。まるロボは、車の助手席に乗っています。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 6.92,
   "t1": 13.6,
   "text": "運転しているのは、近所のおじさん。海の見える公園まで、送ってくれるのです。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 14.2,
   "t1": 17.73,
   "text": "前の台には、道案内の地図が映っています。",
   "who": "ナレーション"
  },
  {
   "id": "01-04",
   "t0": 18.63,
   "t1": 22.21,
   "text": "まるロボは、さっきから、この地図に夢中のようです。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 23.11,
   "t1": 28.05,
   "text": "見てください。地図の上で、この先の道が赤くなっています。",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 28.65,
   "t1": 33.04,
   "text": "どうやら「この先、渋滞」という合図のようです。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 33.84,
   "t1": 38.0,
   "text": "でも、窓の外は……車がすいすい走っています。",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 38.9,
   "t1": 41.06,
   "text": "まるロボも、首をかしげていますね。",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 42.06,
   "t1": 44.38,
   "text": "ところが、角を曲がると……。",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 45.68,
   "t1": 49.62,
   "text": "ずらり。本当に、車が並んでいました。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 50.62,
   "t1": 53.93,
   "text": "止まった車の中で、まるロボは、しょんぼり。",
   "who": "ナレーション"
  },
  {
   "id": "03-04",
   "t0": 54.53,
   "t1": 59.45,
   "text": "地図は、角の向こうで見えなかった渋滞を、ちゃんと当てていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 60.35,
   "t1": 62.17,
   "text": "でも、ちょっと待ってください。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 62.77,
   "t1": 66.64,
   "text": "道の上には、車を数えている人なんて、どこにもいません。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 67.24,
   "t1": 70.86,
   "text": "いったい誰が、道のこみ具合を測っているのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 71.76,
   "t1": 74.83,
   "text": "しかも、気になることは、それだけではありません。",
   "who": "ナレーション"
  },
  {
   "id": "04-05",
   "t0": 75.63,
   "t1": 78.03,
   "text": "地図を、ぐっと広げてみると……。",
   "who": "ナレーション"
  },
  {
   "id": "04-06",
   "t0": 78.93,
   "t1": 83.59,
   "text": "行ったこともない遠くの町の、細い道にまで、色が付いています。",
   "who": "ナレーション"
  },
  {
   "id": "04-07",
   "t0": 84.49,
   "t1": 92.02,
   "text": "日本の道は、全部つなげると120万キロ以上。地球をおよそ30周する長さです。",
   "who": "ナレーション"
  },
  {
   "id": "04-08",
   "t0": 92.62,
   "t1": 96.33,
   "text": "さらに、画面には、公園に着く時刻まで出ています。",
   "who": "ナレーション"
  },
  {
   "id": "04-09",
   "t0": 96.93,
   "t1": 102.09,
   "text": "30分も先の道の様子なんて、まだ誰も見ていないはずなのに……。",
   "who": "ナレーション"
  },
  {
   "id": "04-10",
   "t0": 103.09,
   "t1": 108.11,
   "text": "誰が測っているのか。どうして、まだ来ていない先のことまで分かるのか。",
   "who": "ナレーション"
  },
  {
   "id": "04-11",
   "t0": 110.61,
   "t1": 115.13,
   "text": "その正体は、意外にも、まるロボのすぐそばにありました。",
   "who": "ナレーション"
  },
  {
   "id": "04-12",
   "t0": 116.13,
   "t1": 121.18,
   "text": "これから、まるロボと一緒に、赤い線の正体を見に行きます。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 122.38,
   "t1": 128.33,
   "text": "次の日。まるロボは、大きな道にかかる歩道橋の上にやってきました。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 129.23,
   "t1": 132.96,
   "text": "まずは、自分で車を数えてみることにしたようです。",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 133.76,
   "t1": 138.72,
   "text": "目の光で下を通る車を、1台ずつ……ピッ、ピッ。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 139.72,
   "t1": 143.1,
   "text": "ところが、車は次から次へとやってきます。",
   "who": "ナレーション"
  },
  {
   "id": "05-05",
   "t0": 143.9,
   "t1": 147.36,
   "text": "右の車線も、左の車線も……ピピピピッ。",
   "who": "ナレーション"
  },
  {
   "id": "05-06",
   "t0": 148.56,
   "t1": 151.89,
   "text": "……くるくる。まるロボ、目を回してしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 153.69,
   "t1": 156.81,
   "text": "たった1本の道でも、これだけ大変です。",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 157.41,
   "t1": 161.6,
   "text": "見てください。町には、数えきれないほどの道があります。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 162.4,
   "t1": 166.83,
   "text": "全部の道に人が立って数えるなんて、とても間に合いませんね。",
   "who": "ナレーション"
  },
  {
   "id": "06-04",
   "t0": 167.83,
   "t1": 172.12,
   "text": "では、道のこみ具合は、いったい何が測っているのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 173.32,
   "t1": 177.01,
   "text": "ふらふらのまるロボが、ふと上を見上げると……。",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 177.91,
   "t1": 182.3,
   "text": "道の上に張り出した柱に、四角い機械が付いています。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 182.9,
   "t1": 188.32,
   "text": "これは、道を通る車をとらえる機械。感知器と呼ばれています。",
   "who": "ナレーション"
  },
  {
   "id": "07-04",
   "t0": 189.12,
   "t1": 192.83,
   "text": "では、この感知器は、何をしているのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 193.73,
   "t1": 198.6,
   "text": "感知器は、真下の道に向けて、目に見えない音を出しています。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 199.2,
   "t1": 202.68,
   "text": "音は道ではね返って、感知器に戻ってきます。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 203.58,
   "t1": 209.48,
   "text": "車が下を通ると……はね返ってくるまでの時間が、短くなりました。",
   "who": "ナレーション"
  },
  {
   "id": "08-04",
   "t0": 210.48,
   "t1": 215.27,
   "text": "この変わり方で、通った車の数や、こみ具合が分かるのです。",
   "who": "ナレーション"
  },
  {
   "id": "08-05",
   "t0": 215.87,
   "t1": 221.05,
   "text": "まるロボが目で数えていたことを、この機械は休まず続けていたわけです。",
   "who": "ナレーション"
  },
  {
   "id": "09-01",
   "t0": 221.95,
   "t1": 224.82,
   "text": "では、測ったことは、どこへ行くのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "09-02",
   "t0": 225.62,
   "t1": 231.28,
   "text": "日本では、警察や道路を管理する会社が、こうした情報を集めています。",
   "who": "ナレーション"
  },
  {
   "id": "09-03",
   "t0": 232.18,
   "t1": 238.2,
   "text": "集めた情報は、まとめる所を通って、電波で車のナビに届きます。",
   "who": "ナレーション"
  },
  {
   "id": "09-04",
   "t0": 239.1,
   "t1": 243.31,
   "text": "だから、車のナビでも、この先の渋滞が分かるのです。",
   "who": "ナレーション"
  },
  {
   "id": "10-01",
   "t0": 244.21,
   "t1": 248.12,
   "text": "ところが、この感知器には、苦手なことがあります。",
   "who": "ナレーション"
  },
  {
   "id": "10-02",
   "t0": 249.12,
   "t1": 251.98,
   "text": "まるロボが、町はずれの道へ行ってみると……。",
   "who": "ナレーション"
  },
  {
   "id": "10-03",
   "t0": 253.38,
   "t1": 256.06,
   "text": "見上げても、機械はどこにもありません。",
   "who": "ナレーション"
  },
  {
   "id": "10-04",
   "t0": 256.96,
   "t1": 261.8,
   "text": "感知器が多いのは、大きな道や、町なかの交差点のまわり。",
   "who": "ナレーション"
  },
  {
   "id": "10-05",
   "t0": 262.4,
   "t1": 267.22,
   "text": "町はずれや、橋やトンネルのように、置きにくい所もあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "10-06",
   "t0": 267.82,
   "t1": 272.1,
   "text": "だから、感知器だけでは、この道のこみ具合は分かりません。",
   "who": "ナレーション"
  },
  {
   "id": "10-07",
   "t0": 272.7,
   "t1": 278.6,
   "text": "それなのに、冒頭の道案内の地図は、細い道にまで色が付いていました。",
   "who": "ナレーション"
  },
  {
   "id": "10-08",
   "t0": 279.2,
   "t1": 280.61,
   "text": "機械がないのに、なぜ……？",
   "who": "ナレーション"
  }
 ],
