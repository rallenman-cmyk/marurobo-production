 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 5.51,
   "text": "ある夜、まるロボのもとに、1枚のクレジットカードが届きました。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 6.11,
   "t1": 8.58,
   "text": "まるロボにとって、はじめてのカードです。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 9.58,
   "t1": 13.94,
   "text": "なくしたら大変。まるロボは、カードを金庫へ運びます。",
   "who": "ナレーション"
  },
  {
   "id": "01-04",
   "t0": 14.84,
   "t1": 19.73,
   "text": "とびらを閉めて、ダイヤルをくるくる。これで、ひと安心のようです。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 20.83,
   "t1": 25.2,
   "text": "次の朝。まるロボのスマホが、ブルッと震えました。",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 25.8,
   "t1": 28.37,
   "text": "カードの会社からの、お知らせです。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 28.97,
   "t1": 31.02,
   "text": "「カードのご利用がありました」",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 32.43,
   "t1": 36.99,
   "text": "……え？　まるロボは、まだ一度もカードを使っていません。",
   "who": "ナレーション"
  },
  {
   "id": "02-05",
   "t0": 37.79,
   "t1": 39.63,
   "text": "あわてて金庫を開けると……",
   "who": "ナレーション"
  },
  {
   "id": "02-06",
   "t0": 40.63,
   "t1": 42.85,
   "text": "カードは、ちゃんと中にありました。",
   "who": "ナレーション"
  },
  {
   "id": "02-07",
   "t0": 43.45,
   "t1": 48.04,
   "text": "お店で出したことも、ネットで番号を打ったこともありません。",
   "who": "ナレーション"
  },
  {
   "id": "02-08",
   "t0": 48.64,
   "t1": 53.2,
   "text": "それなのに、だれかが、このカードで買い物をしたのです。",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 54.1,
   "t1": 57.62,
   "text": "使っていないカードが、なぜか使われていた。",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 58.22,
   "t1": 63.34,
   "text": "じつは、こうした出来事は、ニュースでも何度も取り上げられてきました。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 63.94,
   "t1": 67.95,
   "text": "金庫に入れていたのに、いったい、なぜでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "03-04",
   "t0": 68.85,
   "t1": 71.67,
   "text": "カードの番号は、どこから漏れたのか？",
   "who": "ナレーション"
  },
  {
   "id": "03-05",
   "t0": 72.27,
   "t1": 74.37,
   "text": "まるロボと一緒に、調べてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 75.37,
   "t1": 78.37,
   "text": "まるロボが、なにやら帽子をかぶりました。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 79.17,
   "t1": 85.52,
   "text": "虫めがねの付いた、探偵の帽子です。自分で、犯人を探すつもりのようです。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 86.12,
   "t1": 89.9,
   "text": "カードが使われたのなら、だれかが番号を知ったはず。",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 90.7,
   "t1": 95.37,
   "text": "では、番号が漏れそうな所を、1つずつ調べてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 96.27,
   "t1": 101.13,
   "text": "まず、1つ目。だれかに、のぞき見されたのかもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 101.93,
   "t1": 105.92,
   "text": "まるロボは、窓のまわりや、とびらのすき間を調べます。",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 106.82,
   "t1": 109.23,
   "text": "……足あとは、ありません。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 109.83,
   "t1": 113.56,
   "text": "そもそもカードは、一度も金庫から出ていないのです。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 114.46,
   "t1": 119.55,
   "text": "2つ目。番号を書いた紙を、うっかり捨ててしまったのでは？",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 120.45,
   "t1": 125.29,
   "text": "ゴミ箱をひっくり返して、カードが入っていた封筒も、のぞきこみます。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 126.19,
   "t1": 130.38,
   "text": "でも、番号を書いた紙は、どこにもありません。",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 131.28,
   "t1": 136.09,
   "text": "3つ目。お店やネットで使ったときに、見られたのでは？",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 136.99,
   "t1": 139.34,
   "text": "……まるロボは、首を横に振りました。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 141.14,
   "t1": 145.38,
   "text": "そうでした。このカードは、一度も使っていないのですね。",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 146.28,
   "t1": 150.19,
   "text": "のぞき見でも、捨てた紙でもなく、お店でもありません。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 151.09,
   "t1": 155.4,
   "text": "まるロボは、とうとう床に、ころんと転がってしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 156.0,
   "t1": 160.54,
   "text": "そうです。だれも、まるロボのカードを見ていないのです。",
   "who": "ナレーション"
  },
  {
   "id": "08-04",
   "t0": 161.14,
   "t1": 163.67,
   "text": "番号は、どこからも漏れていません。",
   "who": "ナレーション"
  },
  {
   "id": "08-05",
   "t0": 164.27,
   "t1": 169.35,
   "text": "それなのに、使われた。……いったい、どういうことでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "09-01",
   "t0": 170.35,
   "t1": 174.86,
   "text": "まるロボは起き上がって、もう一度、金庫からカードを取り出しました。",
   "who": "ナレーション"
  },
  {
   "id": "09-02",
   "t0": 175.46,
   "t1": 178.46,
   "text": "残っている手がかりは、このカードだけ。",
   "who": "ナレーション"
  },
  {
   "id": "09-03",
   "t0": 179.06,
   "t1": 182.53,
   "text": "カードの表に書いてある、あの長い番号です。",
   "who": "ナレーション"
  },
  {
   "id": "10-01",
   "t0": 183.43,
   "t1": 185.88,
   "text": "虫めがねで、番号をのぞいてみると……",
   "who": "ナレーション"
  },
  {
   "id": "10-02",
   "t0": 186.88,
   "t1": 190.68,
   "text": "数字が、カードからふわりと浮かび上がりました。",
   "who": "ナレーション"
  },
  {
   "id": "10-03",
   "t0": 191.28,
   "t1": 195.41,
   "text": "本物のカードの番号は、14けたから16けた。",
   "who": "ナレーション"
  },
  {
   "id": "10-04",
   "t0": 196.01,
   "t1": 199.51,
   "text": "ここでは見やすいように、短くして表しています。",
   "who": "ナレーション"
  },
  {
   "id": "10-05",
   "t0": 200.31,
   "t1": 203.35,
   "text": "一見、でたらめに並んだ数字に見えます。",
   "who": "ナレーション"
  },
  {
   "id": "10-06",
   "t0": 203.95,
   "t1": 208.66,
   "text": "ところが、この並び方には、じつは決まりがあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "10-07",
   "t0": 209.26,
   "t1": 211.18,
   "text": "1つずつ、見ていきましょう。",
   "who": "ナレーション"
  },
  {
   "id": "11-01",
   "t0": 212.08,
   "t1": 214.22,
   "text": "まずは、はじめの数字です。",
   "who": "ナレーション"
  },
  {
   "id": "11-02",
   "t0": 214.82,
   "t1": 220.21,
   "text": "本物では、はじめの6けたが、どの会社が出したカードかを表しています。",
   "who": "ナレーション"
  },
  {
   "id": "11-03",
   "t0": 220.81,
   "t1": 224.13,
   "text": "いわば、番号に付いた、会社の印。",
   "who": "ナレーション"
  },
  {
   "id": "11-04",
   "t0": 225.03,
   "t1": 229.41,
   "text": "ここでは、カードを出した会社を、塔の形で表しましょう。",
   "who": "ナレーション"
  },
  {
   "id": "11-05",
   "t0": 230.21,
   "t1": 235.74,
   "text": "会社の印が同じ番号は、同じ塔から出たカードというわけです。",
   "who": "ナレーション"
  },
  {
   "id": "11-06",
   "t0": 236.64,
   "t1": 241.04,
   "text": "別の会社のカードなら、はじめの数字も、別の印になります。",
   "who": "ナレーション"
  },
  {
   "id": "12-01",
   "t0": 241.94,
   "t1": 244.68,
   "text": "次は、いちばん最後の1けた。",
   "who": "ナレーション"
  },
  {
   "id": "12-02",
   "t0": 245.28,
   "t1": 249.29,
   "text": "この数字は、ほかの数字とは、ちょっと役目がちがいます。",
   "who": "ナレーション"
  },
  {
   "id": "12-03",
   "t0": 250.19,
   "t1": 255.13,
   "text": "じつは、前に並んだ数字から、計算で決まる数字なのです。",
   "who": "ナレーション"
  },
  {
   "id": "12-04",
   "t0": 255.73,
   "t1": 260.81,
   "text": "計算の答えが合っているかを見直す、検算のようなもの。",
   "who": "ナレーション"
  },
  {
   "id": "12-05",
   "t0": 261.41,
   "t1": 264.58,
   "text": "ここでは、検算の数字と呼ぶことにします。",
   "who": "ナレーション"
  },
  {
   "id": "12-06",
   "t0": 265.18,
   "t1": 268.56,
   "text": "でも、何のための数字なのか？　ためしてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "13-01",
   "t0": 269.76,
   "t1": 274.32,
   "text": "ここでは、ネットのお店を、門とレジの形で表します。",
   "who": "ナレーション"
  },
  {
   "id": "13-02",
   "t0": 274.91,
   "t1": 279.3,
   "text": "レジは、本物では、カードの番号を打ちこむ支払いの画面です。",
   "who": "ナレーション"
  },
  {
   "id": "13-03",
   "t0": 280.2,
   "t1": 285.1,
   "text": "まるロボが、自分のカードの番号を、1けたずつ打っていきます。",
   "who": "ナレーション"
  },
  {
   "id": "13-04",
   "t0": 285.9,
   "t1": 291.17,
   "text": "ところが、うっかり1けただけ、となりの数字を押してしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "13-05",
   "t0": 291.77,
   "t1": 292.36,
   "text": "すると……",
   "who": "ナレーション"
  },
  {
   "id": "13-06",
   "t0": 293.26,
   "t1": 294.61,
   "text": "「番号がちがいます」",
   "who": "ナレーション"
  },
  {
   "id": "13-07",
   "t0": 295.41,
   "t1": 299.74,
   "text": "カードの会社に聞くまでもなく、その場ではじかれてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "13-08",
   "t0": 300.34,
   "t1": 303.05,
   "text": "まるロボは、ちょっと、むっとしています。",
   "who": "ナレーション"
  },
  {
   "id": "13-09",
   "t0": 303.65,
   "t1": 308.94,
   "text": "1けたでもまちがえると、計算の答えが、検算の数字と合わなくなるのです。",
   "who": "ナレーション"
  },
  {
