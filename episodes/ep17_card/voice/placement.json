"no": 163,
"start": 759.123,
"end": 764.773,
"speed": 1.0,
"slot": [
759.123,
764.773
],
"text": "人か、機械か。それを見分けるテストも、ここで働いているのです。"
},
{
"no": 164,
"start": 765.673,
"end": 768.043,
"speed": 1.0,
"slot": [
765.673,
768.043
],
"text": "ところが、影はあきらめません。"
},
