"speed": 1.0,
"slot": [
794.343,
796.493
],
"text": "「このお買い物は、あなたですか？」"
},
{
"no": 172,
"start": 797.393,
"end": 800.013,
"speed": 1.0,
"slot": [
797.393,
800.013
],
"text": "まるロボは、首をぶんぶんと横に振ります。"
},
{
"no": 173,
"start": 800.913,
"end": 801.533,
"speed": 1.0,
"slot": [
800.913,
801.533
],
"text": "すると……"
},
{
"no": 174,
"start": 802.433,
"end": 805.613,
"speed": 1.0,
"slot": [
802.433,
805.613
],
"text": "パチン！　影の札が、はじかれました。"
},
