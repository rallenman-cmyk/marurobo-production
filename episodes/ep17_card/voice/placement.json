"text": "レジに札を入れると……"
},
{
"no": 167,
"start": 776.563,
"end": 782.033,
"speed": 1.0,
"slot": [
776.563,
782.033
],
"text": "番号は本物。だから、塔からの返事も通ってしまいます。"
},
{
"no": 168,
"start": 782.933,
"end": 784.797,
"speed": 1.0,
"slot": [
782.933,
784.797
],
"text": "これは、もうだめかも……？"
},
