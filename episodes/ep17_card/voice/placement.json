"no": 176,
"start": 813.483,
"end": 820.173,
"speed": 1.0,
"slot": [
813.483,
820.173
],
"text": "スマホに届く数字を打ちこむなど、持ち主にしかできない方法で、本人だと答えるのです。"
},
