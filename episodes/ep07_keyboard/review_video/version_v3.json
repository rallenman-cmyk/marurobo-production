015.mp4", "url": "/_blob/137f527746a1eadfd43cbb61cd52ed70", "id": "137f527746a1eadfd43cbb61cd52ed70", "start": 451.874998, "dur": 31.25, "size": 1157158, "sha256": "5cc3856f498a4b726eab4e3df82f863bb9097480fade2f4b85151820714504b0"}, {"i": 16, "file": "seg016.mp4", "url": "/_blob/de56f9ba4cf413271016f5e987f1dedc", "id": "de56f9ba4cf413271016f5e987f1dedc", "start": 483.124998, "dur": 29.5, "size": 862863, "sha256": "7b50d67fef3c95a1fd0ed38cea6b7d79f884fe750bca9dc4afac6dd143a9a270"}, {"i": 17, "file": "seg017.mp4", "url": "/_blob/854e5b3cc70c8141f57f3b38c8dfb98b", "id": "854e5b3cc70c8141f57f3b38c8dfb98b", "start": 512.624998, "dur": 29.375, "size": 761419, "sha256": "5b3aed7fbccc53164e053f133c9813b2ee1b0f00e2ea576b0c8e5da5e4590fd6"}, {"i": 18, "file": "seg018.mp4", "url": "/_blob/3c40ba6d4565e0ae25c69838bed7ba9b", "id": "3c40ba6d4565e0ae25c69838bed7ba9b", "start": 541.999998, "dur": 29.416667, "size": 952325, "sha256": "a7c8d736b952d0ca2af20c1cedd66f7add7a26fe1a61282895d51fda0a522d5b"}, {"i": 19, "file": "seg019.mp4", "url": "/_blob/4beac2ccec1dc7916782d4d73f481aa4", "id": "4beac2ccec1dc7916782d4d73f481aa4", "start": 571.416665, "dur": 34.333333, "size": 874742, "sha256": "45a4862568055edc956bcd25afc911b168bebfe876c66735cce4c2118a6bf00c"}, {"i": 20, "file": "seg020.mp4", "url": "/_blob/1e6a0f7347a153ad2312e9652b4943d1", "id": "1e6a0f7347a153ad2312e9652b4943d1", "start": 605.749998, "dur": 28.0, "size": 966634, "sha256": "5538af8cffb673d070d7d20a73e16c7eca90378b8f0a3665c9b10c0379903e0e"}, {"i": 21, "file": "seg021.mp4", "url": "/_blob/5567d1839d69621cc3b04b2923f9c79b", "id": "5567d1839d69621cc3b04b2923f9c79b", "start": 633.749998, "dur": 29.791667, "size": 927283, "sha256": "b937553da73d0393fff91ab199f91d3f00f3ad52b2b7d9fa4fc436d6876488b2"}, {"i": 22, "file": "seg022.mp4", "url": "/_blob/5d9612c67b72d5ec5d25a7b8f65b00a5", "id": "5d9612c67b72d5ec5d25a7b8f65b00a5", "start": 663.541665, "dur": 31.375, "size": 1001538, "sha256": "c482795b0d5808eeedef17d430fc8cc235589f9d496e2f7ef79a32f9ad559f85"}, {"i": 23, "file": "seg023.mp4", "url": "/_blob/8b7cb4c5d09f986a77956d2b1a51de7c", "id": "8b7cb4c5d09f986a77956d2b1a51de7c", "start": 694.916665, "dur": 28.541667, "size": 1098278, "sha256": "061a8cb1593a80c03d484a640e4b01be3249edd52830bbd400d8c2d97c873e28"}, {"i": 24, "file": "seg024.mp4", "url": "/_blob/9d6a8022d5afcb03e3b8afece598af27", "id": "9d6a8022d5afcb03e3b8afece598af27", "start": 723.458332, "dur": 31.25, "size": 1098419, "sha256": "d6c21d7a9b8203dc3ce7000fd99bff4d74eac7b23d58709437dd6cca8ba8a36e"}, {"i": 25, "file": "seg025.mp4", "url": "/_blob/f250c666a1fe6f0a3644b2f79c96a73b", "id": "f250c666a1fe6f0a3644b2f79c96a73b", "start": 754.708332, "dur": 28.666667, "size": 834931, "sha256": "d71ef8deb556f78ff23c6d692d968140aecb54cbd7ed4cda8c62223fd7fa4e33"}, {"i": 26, "file": "seg026.mp4", "url": "/_blob/f46b42b4781097bf1fe3892d94bfaa35", "id": "f46b42b4781097bf1fe3892d94bfaa35", "start": 783.374999, "dur": 32.583333, "size": 1100026, "sha256": "6b14261ff24bdcecabb068d0bc201a44e35b0bbf745412fa7bb6c8264b7ae876"}, {"i": 27, "file": "seg027.mp4", "url": "/_blob/1e6062dbfb955967f9869e4e15070a22", "id": "1e6062dbfb955967f9869e4e15070a22", "start": 815.958332, "dur": 27.75, "size": 1044201, "sha256": "0a120256e3d15a8a95bb812d5d006580a9006a6f6081a4dab1395dbb50a84caa"}, {"i": 28, "file": "seg028.mp4", "url": "/_blob/461754897c19dbdbf965f37164bd9605", "id": "461754897c19dbdbf965f37164bd9605", "start": 843.708332, "dur": 28.5, "size": 1059221, "sha256": "06724627ee500bca351986d0e4c4bb048409d74b0f40780113e24cab51798eb1"}], "init": {"url": "/_blob/08f3e1a725359c82c538eab7d97664d8", "id": "08f3e1a725359c82c538eab7d97664d8", "sha256": "b0a6ccfac065f6067933bc4ceaeff747083ccea9ca313f2683ad0d34bbebd2b3"}, "source": {"filename": "通し_v3.mp4", "sha256": "0883ea3dfaffcab24543ec244db49f1d58f3f0b7a2dde0197da79e44d8885ec2", "size": 27697677, "duration": 872.208}, "subs": [{"id": "01-01", "t0": 0.5, "t1": 6.72, "text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。", "who": "ナレーション"}, {"id": "01-02", "t0": 7.12, "t1": 9.71, "text": "でも、まるロボには腕がありません。", "who": "ナレーション"}, {"id": "01-03", "t0": 10.11, "t1": 13.24, "text": "なので、キーボードは跳ねて乗って打つのです。", "who": "ナレーション"}, {"id": "01-04", "t0": 13.64, "t1": 17.84, "text": "ぴょん、カタッ。これで「A」の出来上がり。", "who": "ナレーション"}, {"id": "02-01", "t0": 18.64, "t1": 22.92, "text": "次は「B」。A の次ですから、すぐとなりに……。", "who": "ナレーション"}, {"id": "02-02", "t0": 23.52, "t1": 27.07, "text": "あれ？　となりにあるのは「S」です。", "who": "ナレーション"}, {"id": "02-03", "t0": 27.47, "t1": 30.04, "text": "反対側には、何もありません。", "who": "ナレーション"}, {"id": "02-04", "t0": 30.44, "t1": 35.22, "text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。", "who": "ナレーション"}, {"id": "03-01", "t0": 36.12, "t1": 43.97, "text": "上から見ると、左上は Q W E R T Y。", "who": "ナレーション"}, {"id": "03-02", "t0": 44.37, "t1": 50.08, "text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。", "who": "ナレーション"}, {"id": "03-03", "t0": 50.48, "t1": 54.8, "text": "毎日さわるキーボードは、ABC 順に並んでいません。", "who": "ナレーション"}, {"id": "03-04", "t0": 55.2, "t1": 60.1, "text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？", "who": "ナレーション"}, {"id": "03-05", "t0": 60.7, "t1": 65.19, "text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。", "who": "ナレーション"}, {"id": "04-01", "t0": 67.99, "t1": 71.07, "text": "まるロボにとって大事なのは、跳ねる距離です。", "who": "ナレーション"}, {"id": "04-02", "t0": 71.47, "t1": 75.87, "text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。", "who": "ナレーション"}, {"id": "04-03", "t0": 76.16, "t1": 82.55, "text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。", "who": "ナレーション"}, {"id": "04-04", "t0": 82.95, "t1": 87.96, "text": "キーの数も形も同じで、並びだけが ABC 順です。", "who": "ナレーション"}, {"id": "05-01", "t0": 88.76, "t1": 93.48, "text": "では、同じ言葉を、2つのキーボードで打ってみましょう。", "who": "ナレーション"}, {"id": "05-02", "t0": 93.88, "t1": 97.27, "text": "打つのは、自分の名前の「マルロボ」。", "who": "ナレーション"}, {"id": "05-03", "t0": 97.67, "t1": 104.81, "text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。", "who": "ナレーション"}, {"id": "05-04", "t0": 105.21, "t1": 112.0, "text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。", "who": "ナレーション"}, {"id": "05-05", "t0": 113.0, "t1": 119.87, "text": "次は、ABC 順の並びです。こちらは橙の線で残しました。", "who": "ナレーション"}, {"id": "06-01", "t0": 120.97, "t1": 124.62, "text": "跳ねた距離を、キーの数で測ってみると……。", "who": "ナレーション"}, {"id": "06-02", "t0": 125.22, "t1": 128.17, "text": "クワーティが、キー28個分。", "who": "ナレーション"}, {"id": "06-03", "t0": 128.57, "t1": 131.98, "text": "ABC 順が、キー31個分。", "who": "ナレーション"}, {"id": "06-04", "t0": 132.38, "t1": 135.27, "text": "あれ？　ほとんど、変わりません。", "who": "ナレーション"}, {"id": "07-01", "t0": 136.07, "t1": 141.17, "text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。", "who": "ナレーション"}, {"id": "07-02", "t0": 141.57, "t1": 145.24, "text": "打つのは、「いろはにほへと」で始まる、いろは歌。", "who": "ナレーション"}, {"id": "07-03", "t0": 145.64, "t1": 151.34, "text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。", "who": "ナレーション"}, {"id": "07-04", "t0": 152.24, "t1": 160.68, "text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。", "who": "ナレーション"}, {"id": "07-05", "t0": 161.08, "t1": 166.49, "text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。", "who": "ナレーション"}, {"id": "07-06", "t0": 166.89, "t1": 174.66, "text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。", "who": "ナレーション"}, {"id": "07-07", "t0": 175.06, "t1": 181.24, "text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。", "who": "ナレーション"}, {"id": "07-08", "t0": 181.64, "t1": 187.35, "text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。", "who": "ナレーション"}, {"id": "07-09", "t0": 187.75, "t1": 191.83, "text": "では、いったい何のために、この順番になったのか……。", "who": "ナレーション"}, {"id": "07-10", "t0": 192.43, "t1": 197.46, "text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。", "who": "ナレーション"}, {"id": "08-01", "t0": 198.36, "t1": 205.54, "text": "時は、1868年。今から150年ほど前の、アメリカです。", "who": "ナレーション"}, {"id": "08-02", "t0": 205.94, "t1": 212.46, "text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。", "who": "ナレーション"}, {"id": "08-03", "t0": 212.86, "t1": 218.58, "text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。", "who": "ナレーション"}, {"id": "09-01", "t0": 219.58, "t1": 222.51, "text": "おや？　このキー、よく見ると……。", "who": "ナレーション"}, {"id": "09-02", "t0": 223.11, "t1": 226.18, "text": "まるで、ピアノの鍵盤のような形をしています。", "who": "ナレーション"}, {"id": "09-03", "t0": 226.58, "t1": 230.82, "text": "そして並びは……なんと、ABC 順だったのです。", "who": "ナレーション"}, {"id": "09-04", "t0": 231.22, "t1": 235.35, "text": "手前の列は、A から N まで、左から右へ。", "who": "ナレーション"}, {"id": "09-05", "t0": 235.75, "t1": 241.18, "text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。", "who": "ナレーション"}, {"id": "10-01", "t0": 241.98, "t1": 246.34, "text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。", "who": "ナレーション"}, {"id": "10-02", "t0": 246.74, "t1": 251.56, "text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。", "who": "ナレーション"}, {"id": "10-03", "t0": 251.96, "t1": 256.66, "text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。", "who": "ナレーション"}, {"id": "10-04", "t0": 257.06, "t1": 264.62, "text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。", "who": "ナレーション"}, {"id": "10-05", "t0": 265.22, "t1": 274.13, "text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。", "who": "ナレーション"}, {"id": "10-06", "t0": 274.53, "t1": 281.02, "text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。", "who": "ナレーション"}, {"id": "10-07", "t0": 281.82, "t1": 290.47, "text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。", "who": "ナレーション"}, {"id": "10-08", "t0": 291.47, "t1": 296.62, "text": "その会社でピリオドが外され、そこに R が入りました。", "who": "ナレーション"}, {"id": "10-09", "t0": 297.02, "t1": 301.32, "text": "こうして、冒頭で見たクワーティの並びが、そろったのです。", "who": "ナレーション"}, {"id": "11-01", "t0": 302.12, "t1": 306.31, "text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？", "who": "ナレーション"}, {"id": "11-02", "t0": 306.91, "t1": 311.44, "text": "実は、作った人たちは、その理由を書き残していません。", "who": "ナレーション"}, {"id": "11-03", "t0": 311.84, "t1": 315.98, "text": "そこで、昔からよく言われてきた説があります。", "who": "ナレーション"}, {"id": "12-01", "t0": 316.98, "t1": 323.16, "text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。", "who": "ナレーション"}, {"id": "12-02", "t0": 323.56, "t1": 328.66, "text": "キーの奥には、細い棒がずらりと、円く並んでいます。", "who": "ナレーション"}, {"id": "12-03", "t0": 329.06, "t1": 334.05, "text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。", "who": "ナレーション"}, {"id": "13-01", "t0": 334.85, "t1": 339.14, "text": "もし、となり合う2本の棒が、続けて上がると……。", "who": "ナレーション"}, {"id": "13-02", "t0": 339.94, "t1": 343.14, "text": "途中でぶつかって、からまってしまいました。", "who": "ナレーション"}, {"id": "13-03", "t0": 343.54, "t1": 345.96, "text": "よく言われるのは、こんな説です。", "who": "ナレーション"}, {"id": "13-04", "t0": 346.76, "t1": 352.85, "text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。", "who": "ナレーション"}, {"id": "13-05", "t0": 353.25, "t1": 356.92, "text": "なるほど、と思いますよね。ところが……。", "who": "ナレーション"}, {"id": "14-01", "t0": 357.72, "t1": 360.9, "text": "この説には、はっきりした証拠がありません。", "who": "ナレーション"}, {"id": "14-02", "t0": 361.3, "t1": 366.19, "text": "まず、理由を書いた記録が、どこにも残っていないのです。", "who": "ナレーション"}, {"id": "14-03", "t0": 366.59, "t1": 371.0, "text": "それに、英語でとてもよく続く「E」と「R」。", "who": "ナレーション"}, {"id": "14-04", "t0": 371.4, "t1": 377.45, "text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。", "who": "ナレーション"}, {"id": "14-05", "t0": 377.85, "t1": 380.88, "text": "からまないように離したのなら、おかしいですね。", "who": "ナレーション"}, {"id": "15-01", "t0": 381.68, "t1": 384.13, "text": "また、こんな話もよく聞きます。", "who": "ナレーション"}, {"id": "15-02", "t0": 384.53, "t1": 390.92, "text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。", "who": "ナレーション"}, {"id": "15-03", "t0": 391.32, "t1": 397.04, "text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。", "who": "ナレーション"}, {"id": "15-04", "t0": 398.04, "t1": 403.8, "text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。", "who": "ナレーション"}, {"id": "15-05", "t0": 404.2, "t1": 409.17, "text": "この機械は、手で書くより速く打つために作られたはずですよね。", "who": "ナレーション"}, {"id": "15-06", "t0": 409.57, "t1": 414.42, "text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。", "who": "ナレーション"}, {"id": "15-07", "t0": 414.82, "t1": 420.02, "text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。", "who": "ナレーション"}, {"id": "15-08", "t0": 420.42, "t1": 425.62, "text": "この「わざと遅く」の話は、今では研究者に否定されています。", "who": "ナレーション"}, {"id": "15-09", "t0": 426.02, "t1": 429.49, "text": "からまない工夫が、少しはあったのかもしれません。", "who": "ナレーション"}, {"id": "15-10", "t0": 429.89, "t1": 434.0, "text": "でも、それだけでクワーティの並びになったとは、言えないのです。", "who": "ナレーション"}, {"id": "16-01", "t0": 434.8, "t1": 437.95, "text": "では、本当の理由は何だったのでしょうか？", "who": "ナレーション"}, {"id": "16-02", "t0": 438.55, "t1": 445.96, "text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。", "who": "ナレーション"}, {"id": "16-03", "t0": 446.36, "t1": 450.87, "text": "手がかりは、最初にこの機械を買った、お客さんです。", "who": "ナレーション"}, {"id": "17-01", "t0": 451.87, "t1": 455.67, "text": "それは、電信という仕事をしている人たちでした。", "who": "ナレーション"}, {"id": "17-02", "t0": 456.07, "t1": 461.64, "text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。", "who": "ナレーション"}, {"id": "17-03", "t0": 462.44, "t1": 468.63, "text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。", "who": "ナレーション"}, {"id": "17-04", "t0": 469.03, "t1": 475.74, "text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。", "who": "ナレーション"}, {"id": "17-05", "t0": 476.14, "t1": 482.18, "text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。", "who": "ナレーション"}, {"id": "17-06", "t0": 482.58, "t1": 489.64, "text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。", "who": "ナレーション"}, {"id": "17-07", "t0": 490.04, "t1": 496.72, "text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。", "who": "ナレーション"}, {"id": "17-08", "t0": 497.12, "t1": 500.79, "text": "先生は、なんと「もっと速く！」と声をかけたそうです。", "who": "ナレーション"}, {"id": "17-09", "t0": 501.19, "t1": 507.14, "text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。", "who": "ナレーション"}, {"id": "18-01", "t0": 507.94, "t1": 511.79, "text": "では、当時のアメリカのモールス信号を聞いてみましょう。", "who": "ナレーション"}, {"id": "18-02", "t0": 512.59, "t1": 518.52, "text": "まずは「Z」。トントントン、少しあけて、トン。", "who": "ナレーション"}, {"id": "18-03", "t0": 518.92, "t1": 522.73, "text": "そして次に、「S」と「E」を続けた音。", "who": "ナレーション"}, {"id": "18-04", "t0": 523.53, "t1": 531.17, "text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。", "who": "ナレーション"}, {"id": "18-05", "t0": 531.57, "t1": 536.75, "text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。", "who": "ナレーション"}, {"id": "19-01", "t0": 537.55, "t1": 544.34, "text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。", "who": "ナレーション"}, {"id": "19-02", "t0": 544.74, "t1": 551.72, "text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。", "who": "ナレーション"}, {"id": "19-03", "t0": 552.12, "t1": 555.63, "text": "今のキーボードで、この3つを光らせてみると……。", "who": "ナレーション"}, {"id": "19-04", "t0": 556.23, "t1": 563.4, "text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。", "who": "ナレーション"}, {"id": "19-05", "t0": 563.8, "t1": 570.6, "text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。", "who": "ナレーション"}, {"id": "20-01", "t0": 571.4, "t1": 576.6, "text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。", "who": "ナレーション"}, {"id": "20-02", "t0": 577.0, "t1": 583.84, "text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。", "who": "ナレーション"}, {"id": "20-03", "t0": 584.24, "t1": 587.36, "text": "しかも、ふしぎなことが、もう1つあります。", "who": "ナレーション"}, {"id": "20-04", "t0": 587.76, "t1": 595.35, "text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。", "who": "ナレーション"}, {"id": "20-05", "t0": 595.75, "t1": 605.32, "text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。", "who": "ナレーション"}, {"id": "20-06", "t0": 605.72, "t1": 610.86, "text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。", "who": "ナレーション"}, {"id": "20-07", "t0": 611.26, "t1": 618.62, "text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。", "who": "ナレーション"}, {"id": "21-01", "t0": 619.42, "t1": 620.95, "text": "でも、ちょっと待ってください。", "who": "ナレーション"}, {"id": "21-02", "t0": 621.35, "t1": 626.61, "text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？", "who": "ナレーション"}, {"id": "21-03", "t0": 627.21, "t1": 632.92, "text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。", "who": "ナレーション"}, {"id": "22-01", "t0": 633.72, "t1": 640.15, "text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。", "who": "ナレーション"}, {"id": "22-02", "t0": 640.55, "t1": 647.49, "text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。", "who": "ナレーション"}, {"id": "22-03", "t0": 647.89, "t1": 655.2, "text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。", "who": "ナレーション"}, {"id": "22-04", "t0": 655.6, "t1": 663.13, "text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。", "who": "ナレーション"}, {"id": "22-05", "t0": 663.53, "t1": 671.54, "text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。", "who": "ナレーション"}, {"id": "22-06", "t0": 671.94, "t1": 681.02, "text": "そして1893年、アメリカの大きなタイプライターの会社が5つ、1つにまとまりました。", "who": "ナレーション"}, {"id": "22-07", "t0": 682.42, "t1": 687.8, "text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。", "who": "ナレーション"}, {"id": "22-08", "t0": 688.2, "t1": 694.08, "text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。", "who": "ナレーション"}, {"id": "23-01", "t0": 694.88, "t1": 698.94, "text": "では、もっと良い並びは、作られなかったのでしょうか？", "who": "ナレーション"}, {"id": "23-02", "t0": 699.54, "t1": 707.97, "text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。", "who": "ナレーション"}, {"id": "23-03", "t0": 708.37, "t1": 712.61, "text": "よく使う字を、指を置く真ん中の列に集めた並びです。", "who": "ナレーション"}, {"id": "23-04", "t0": 713.01, "t1": 717.8, "text": "「クワーティより、ずっと速く打てる」。そう言われていました。", "who": "ナレーション"}, {"id": "23-05", "t0": 718.2, "t1": 724.08, "text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。", "who": "ナレーション"}, {"id": "23-06", "t0": 724.48, "t1": 731.59, "text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。", "who": "ナレーション"}, {"id": "23-07", "t0": 731.99, "t1": 737.43, "text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。", "who": "ナレーション"}, {"id": "24-01", "t0": 738.23, "t1": 743.04, "text": "それに、もし本当に速かったとしても、問題があります。", "who": "ナレーション"}, {"id": "24-02", "t0": 743.44, "t1": 749.21, "text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。", "who": "ナレーション"}, {"id": "24-03", "t0": 749.61, "t1": 754.43, "text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。", "who": "ナレーション"}, {"id": "24-04", "t0": 754.83, "t1": 759.55, "text": "もし明日、全部の並びが変わったら、どうなるでしょう？", "who": "ナレーション"}, {"id": "24-05", "t0": 760.55, "t1": 764.8, "text": "打つたびにキーを探して、指が止まってしまいますね。", "who": "ナレーション"}, {"id": "24-06", "t0": 765.2, "t1": 771.72, "text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。", "who": "ナレーション"}, {"id": "24-07", "t0": 772.12, "t1": 777.39, "text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。", "who": "ナレーション"}, {"id": "24-08", "t0": 777.79, "t1": 782.97, "text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。", "who": "ナレーション"}, {"id": "24-09", "t0": 783.37, "t1": 788.61, "text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。", "who": "ナレーション"}, {"id": "27-01", "t0": 789.41, "t1": 792.03, "text": "では、最初の問いに戻ります。", "who": "ナレーション"}, {"id": "27-02", "t0": 792.43, "t1": 796.43, "text": "キーボードは、なぜ ABC 順に並んでいないのか。", "who": "ナレーション"}, {"id": "27-03", "t0": 796.83, "t1": 805.12, "text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。", "who": "ナレーション"}, {"id": "27-04", "t0": 805.52, "t1": 810.18, "text": "ただ、どんな都合だったのかは、今もはっきりしていません。", "who": "ナレーション"}, {"id": "27-05", "t0": 810.58, "t1": 817.1, "text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。", "who": "ナレーション"}, {"id": "27-06", "t0": 817.5, "t1": 824.72, "text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。", "who": "ナレーション"}, {"id": "28-01", "t0": 825.52, "t1": 827.94, "text": "そこで、まるロボは考えました。", "who": "ナレーション"}, {"id": "28-02", "t0": 828.34, "t1": 833.53, "text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。", "who": "ナレーション"}, {"id": "28-03", "t0": 833.93, "t1": 840.15, "text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！", "who": "ナレーション"}, {"id": "28-04", "t0": 840.55, "t1": 843.14, "text": "さっそく、いろは歌を打ってみると……。", "who": "ナレーション"}, {"id": "28-05", "t0": 845.74, "t1": 849.55, "text": "跳ねる距離は、クワーティの7分の1になりました。", "who": "ナレーション"}, {"id": "28-06", "t0": 849.95, "t1": 857.78, "text": "でも、カメラを引いてみると……横にとても長いキーボードで、キーは「い ろ は」の順に1列。", "who": "ナレーション"}, {"id": "28-07", "t0": 858.98, "t1": 864.92, "text": "これは、いろは歌を打つときだけ速い、いろは歌専用のキーボードだったのです。", "who": "ナレーション"}, {"id": "28-08", "t0": 865.82, "t1": 869.72, "text": "……まるロボの並びも、誰にも使ってもらえなかったようです。", "who": "ナレーション"}], "notes": "v2 で「まだ」にしていた所を直した版です。5:31〜5:43 タイプライターの中の棒が、上ではなく床の下へ回っていたのを直しました（棒が跳ね上がる・となりの 2 本がぶつかるのが見えます）。3:28 ショールズさんたちを前から映すように。14:13〜14:25 腕がまるロボを隠さない向きから映すように。2:32 いろは歌の札のあとに板の名前が一瞬戻るのを直しました。一瞬だけ映る絵の機械の点検もかけ直し、残りは場面のつなぎとカメラの速い動きだけでした。まだの所：9:02「このキー」の声は、8 回作っても「この き」と聞こえるものしか出ませんでした。冒頭 0:00／実験 1:07／最初は ABC 順 3:18／からまない説 5:16／モールス信号 7:14／それでも変わらなかった 10:19／まとめ 13:09／オチ 13:45。", "created_at": "2026-11-16T09:03:57Z", "created_by": "ai", "validated_at": "2026-11-16T09:03:57Z", "validation": "区切り29個と init の大きさがアップロードの結果と一致。区切りの合計 872.208 秒＝原本と一致"}