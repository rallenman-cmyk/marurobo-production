{"project_id": "MARU-EP07", "number": 3, "label": "v3（確認用・残りも直した版）", "status": "ready", "duration": 872.208, "segment_count": 29, "segments": [{"i": 0, "file": "seg000.mp4", "url": "/_blob/9d61258180f295cbebdab14b8f28b2c9", "id": "9d61258180f295cbebdab14b8f28b2c9", "start": 0.0, "dur": 38.375, "size": 1208605, "sha256": "103bac7a69ffc3bb0ba177e02d5a817c6ba1cdba8ab3eefd0789ff6716ec33e3"}, {"i": 1, "file": "seg001.mp4", "url": "/_blob/c3a485fe350110de91b52943bded84d1", "id": "c3a485fe350110de91b52943bded84d1", "start": 38.375, "dur": 26.833333, "size": 949171, "sha256": "b90f28cb7e8595685bfbf92cc34b73014e73587c33c65ad01b9b45280bf53100"}, {"i": 2, "file": "seg002.mp4", "url": "/_blob/e01a1344d45a7207eee7163a9764b0a2", "id": "e01a1344d45a7207eee7163a9764b0a2", "start": 65.208333, "dur": 28.708333, "size": 804825, "sha256": "16871cec6e1601cceb44e92b4e1e8fe076cc65b5a86156bbdee6959cf9f3140e"}, {"i": 3, "file": "seg003.mp4", "url": "/_blob/fbdd99730a1a8440d5e1466cbc49c8bf", "id": "fbdd99730a1a8440d5e1466cbc49c8bf", "start": 93.916666, "dur": 28.875, "size": 1130741, "sha256": "85cd36c1e6ae617e4eedafbde60eeeb3e16eea027da30ae70476319065c165cd"}, {"i": 4, "file": "seg004.mp4", "url": "/_blob/111abac4ff491d52e9b9e506353a26f2", "id": "111abac4ff491d52e9b9e506353a26f2", "start": 122.791666, "dur": 34.125, "size": 1022732, "sha256": "14e206a1db0332460e30c3795134c04cee53e87240a4281670af4c234036300b"}, {"i": 5, "file": "seg005.mp4", "url": "/_blob/466fb09c057ca279eb33402b9f0f79fe", "id": "466fb09c057ca279eb33402b9f0f79fe", "start": 156.916666, "dur": 30.833333, "size": 889493, "sha256": "65e2fdcc1e9788e6578af80fe0fb2d163af1f7329b812e2397e336d1f2f29d91"}, {"i": 6, "file": "seg006.mp4", "url": "/_blob/e70ba896dcb6f0968ee1bff84cf263e3", "id": "e70ba896dcb6f0968ee1bff84cf263e3", "start": 187.749999, "dur": 30.916667, "size": 990340, "sha256": "85ee2f5df723e47a0c2a366cead699cb614d6ff251e4093f700e86dfb6e893aa"}, {"i": 7, "file": "seg007.mp4", "url": "/_blob/5d4b64afaffce6073a03c02fb6ce0de