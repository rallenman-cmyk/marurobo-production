  "duration": 889.625
 },
 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 6.72,
   "text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 7.12,
   "t1": 9.71,
   "text": "でも、まるロボには腕がありません。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 10.11,
   "t1": 13.24,
   "text": "なので、キーボードは跳ねて乗って打つのです。",
   "who": "ナレーション"
  },
  {
   "id": "01-04",
   "t0": 13.64,
   "t1": 17.84,
   "text": "ぴょん、カタッ。これで「A」の出来上がり。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 18.64,
   "t1": 22.92,
   "text": "次は「B」。A の次ですから、すぐとなりに……。",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 23.52,
   "t1": 27.07,
   "text": "あれ？　となりにあるのは「S」です。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 27.47,
   "t1": 30.04,
   "text": "反対側には、何もありません。",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 30.44,
   "t1": 35.22,
   "text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 36.42,
   "t1": 44.27,
   "text": "上から見ると、左上は Q W E R T Y。",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 44.67,
   "t1": 50.38,
   "text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 50.85,
   "t1": 55.17,
   "text": "毎日さわるキーボードは、ABC 順に並んでいません。",
   "who": "ナレーション"
  },
  {
   "id": "03-04",
   "t0": 55.57,
   "t1": 60.47,
   "text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？",
   "who": "ナレーション"
  },
  {
   "id": "03-05",
   "t0": 61.69,
   "t1": 66.18,
   "text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 68.98,
   "t1": 72.06,
   "text": "まるロボにとって大事なのは、跳ねる距離です。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 72.46,
   "t1": 76.86,
   "text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 77.33,
   "t1": 82.76,
   "text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 83.5,
   "t1": 88.51,
   "text": "キーの数も形も同じで、並びだけが ABC 順です。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 89.31,
   "t1": 94.03,
   "text": "では、同じ言葉を、2つのキーボードで打ってみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 94.43,
   "t1": 97.82,
   "text": "打つのは、自分の名前の「マルロボ」。",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 98.22,
   "t1": 105.74,
   "text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 106.14,
   "t1": 112.93,
   "text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。",
   "who": "ナレーション"
  },
  {
   "id": "05-05",
   "t0": 113.93,
   "t1": 120.8,
   "text": "次は、ABC 順の並びです。こちらは橙の線で残しました。",
   "who": "ナレーション"
  },
  {
   "id": "05-06",
   "t0": 121.2,
   "t1": 131.97,
   "text": "M、A、R、U、R、O、B……最後の O まで、ぴょん。打てました。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 133.07,
   "t1": 136.72,
   "text": "跳ねた距離を、キーの数で測ってみると……。",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 137.32,
   "t1": 140.27,
   "text": "クワーティが、キー28個分。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 140.67,
   "t1": 144.08,
   "text": "ABC 順が、キー31個分。",
   "who": "ナレーション"
  },
  {
   "id": "06-04",
   "t0": 144.48,
   "t1": 147.37,
   "text": "あれ？　ほとんど、変わりません。",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 148.17,
   "t1": 153.2,
   "text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 153.6,
   "t1": 157.27,
   "text": "打つのは、「いろはにほへと」で始まる、いろは歌。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 157.67,
   "t1": 163.38,
   "text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。",
   "who": "ナレーション"
  },
  {
   "id": "07-04",
   "t0": 164.28,
   "t1": 172.72,
   "text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。",
   "who": "ナレーション"
  },
  {
   "id": "07-05",
   "t0": 173.12,
   "t1": 178.01,
   "text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "07-06",
   "t0": 178.41,
   "t1": 186.02,
   "text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。",
   "who": "ナレーション"
  },
  {
   "id": "07-07",
   "t0": 186.42,
   "t1": 192.6,
   "text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。",
   "who": "ナレーション"
  },
  {
   "id": "07-08",
   "t0": 193.0,
   "t1": 198.45,
   "text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。",
   "who": "ナレーション"
  },
  {
   "id": "07-09",
   "t0": 198.85,
   "t1": 202.93,
   "text": "では、いったい何のために、この順番になったのか……。",
   "who": "ナレーション"
  },
  {
   "id": "07-10",
   "t0": 203.53,
   "t1": 208.23,
   "text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 209.13,
   "t1": 216.31,
   "text": "時は、1868年。今から150年ほど前の、アメリカです。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 217.55,
   "t1": 224.07,
   "text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 224.47,
   "t1": 230.19,
   "text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。",
   "who": "ナレーション"
  },
  {
   "id": "09-01",
   "t0": 231.19,
   "t1": 234.77,
   "text": "おや？　このキーボード、よく見ると……。",
   "who": "ナレーション"
  },
  {
   "id": "09-02",
   "t0": 235.37,
   "t1": 238.44,
   "text": "まるで、ピアノの鍵盤のような形をしています。",
   "who": "ナレーション"
  },
  {
   "id": "09-03",
   "t0": 238.84,
   "t1": 243.56,
   "text": "そして並びは……なんと、ABC 順だったのです。",
   "who": "ナレーション"
  },
  {
   "id": "09-04",
   "t0": 243.96,
   "t1": 248.09,
   "text": "手前の列は、A から N まで、左から右へ。",
   "who": "ナレーション"
  },
  {
   "id": "09-05",
   "t0": 248.49,
   "t1": 253.92,
   "text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。",
   "who": "ナレーション"
  },
  {
   "id": "10-01",
   "t0": 254.72,
   "t1": 258.99,
   "text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "10-02",
   "t0": 259.39,
   "t1": 264.75,
   "text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。",
   "who": "ナレーション"
  },
  {
   "id": "10-03",
   "t0": 265.15,
   "t1": 269.97,
   "text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。",
   "who": "ナレーション"
  },
  {
   "id": "10-04",
   "t0": 270.37,
   "t1": 277.93,
   "text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。",
   "who": "ナレーション"
  },
  {
   "id": "10-05",
   "t0": 278.53,
   "t1": 287.44,
   "text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。",
   "who": "ナレーション"
  },
  {
   "id": "10-06",
   "t0": 287.84,
   "t1": 294.25,
   "text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。",
   "who": "ナレーション"
  },
  {
   "id": "10-07",
   "t0": 295.05,
   "t1": 303.7,
   "text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。",
   "who": "ナレーション"
  },
  {
   "id": "10-08",
   "t0": 304.7,
   "t1": 309.85,
   "text": "その会社でピリオドが外され、そこに R が入りました。",
   "who": "ナレーション"
  },
  {
   "id": "10-09",
   "t0": 310.25,
   "t1": 314.55,
   "text": "こうして、冒頭で見たクワーティの並びが、そろったのです。",
   "who": "ナレーション"
  },
  {
   "id": "11-01",
   "t0": 315.82,
   "t1": 320.01,
   "text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "11-02",
   "t0": 320.81,
   "t1": 325.34,
   "text": "実は、作った人たちは、その理由を書き残していません。",
   "who": "ナレーション"
  },
  {
   "id": "11-03",
   "t0": 325.74,
   "t1": 329.88,
   "text": "そこで、昔からよく言われてきた説があります。",
   "who": "ナレーション"
  },
  {
   "id": "12-01",
   "t0": 330.88,
   "t1": 337.06,
   "text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "12-02",
   "t0": 337.46,
   "t1": 342.56,
   "text": "キーの奥には、細い棒がずらりと、円く並んでいます。",
   "who": "ナレーション"
  },
  {
   "id": "12-03",
   "t0": 342.96,
   "t1": 347.95,
   "text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。",
   "who": "ナレーション"
  },
  {
   "id": "13-01",
   "t0": 348.75,
   "t1": 353.05,
   "text": "もし、となり合う2本の棒が、続けて上がると……。",
   "who": "ナレーション"
  },
  {
   "id": "13-02",
   "t0": 353.85,
   "t1": 357.05,
   "text": "途中でぶつかって、からまってしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "13-03",
   "t0": 357.44,
   "t1": 359.87,
   "text": "よく言われるのは、こんな説です。",
   "who": "ナレーション"
  },
  {
   "id": "13-04",
   "t0": 360.67,
   "t1": 365.69,
   "text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。",
   "who": "ナレーション"
  },
  {
   "id": "13-05",
   "t0": 366.24,
   "t1": 369.91,
   "text": "なるほど、と思いますよね。ところが……。",
   "who": "ナレーション"
  },
  {
   "id": "14-01",
   "t0": 371.21,
   "t1": 374.3,
   "text": "この説には、はっきりした証拠がありません。",
   "who": "ナレーション"
  },
  {
   "id": "14-02",
   "t0": 374.7,
   "t1": 379.59,
   "text": "まず、理由を書いた記録が、どこにも残っていないのです。",
   "who": "ナレーション"
  },
  {
   "id": "14-03",
   "t0": 379.99,
   "t1": 384.4,
   "text": "それに、英語でとてもよく続く「E」と「R」。",
   "who": "ナレーション"
  },
  {
   "id": "14-04",
   "t0": 384.8,
   "t1": 390.77,
   "text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。",
   "who": "ナレーション"
  },
  {
   "id": "14-05",
   "t0": 391.17,
   "t1": 394.2,
   "text": "からまないように離したのなら、おかしいですね。",
   "who": "ナレーション"
  },
  {
   "id": "15-01",
   "t0": 395.0,
   "t1": 397.45,
   "text": "また、こんな話もよく聞きます。",
   "who": "ナレーション"
  },
  {
   "id": "15-02",
   "t0": 397.85,
   "t1": 404.24,
   "text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。",
   "who": "ナレーション"
  },
  {
   "id": "15-03",
   "t0": 404.64,
   "t1": 410.36,
   "text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。",
   "who": "ナレーション"
  },
  {
   "id": "15-04",
   "t0": 411.36,
   "t1": 417.12,
   "text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。",
   "who": "ナレーション"
  },
  {
   "id": "15-05",
   "t0": 417.52,
   "t1": 423.2,
   "text": "この機械は、手で書くより速く打つために作られたはずですよね。",
   "who": "ナレーション"
  },
  {
   "id": "15-06",
   "t0": 423.6,
   "t1": 428.3,
   "text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "15-07",
   "t0": 428.89,
   "t1": 434.09,
   "text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。",
   "who": "ナレーション"
  },
  {
   "id": "15-08",
   "t0": 434.49,
   "t1": 439.69,
   "text": "この「わざと遅く」の話は、今では研究者に否定されています。",
   "who": "ナレーション"
  },
  {
   "id": "15-09",
   "t0": 440.09,
   "t1": 443.56,
   "text": "からまない工夫が、少しはあったのかもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "15-10",
   "t0": 443.96,
   "t1": 448.07,
   "text": "でも、それだけでクワーティの並びになったとは、言えないのです。",
   "who": "ナレーション"
  },
  {
   "id": "16-01",
   "t0": 449.26,
   "t1": 452.41,
   "text": "では、本当の理由は何だったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "16-02",
   "t0": 453.01,
   "t1": 460.42,
   "text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。",
   "who": "ナレーション"
  },
  {
   "id": "16-03",
   "t0": 460.82,
   "t1": 465.33,
   "text": "手がかりは、最初にこの機械を買った、お客さんです。",
   "who": "ナレーション"
  },
  {
   "id": "17-01",
   "t0": 466.33,
   "t1": 470.13,
   "text": "それは、電信という仕事をしている人たちでした。",
   "who": "ナレーション"
  },
  {
   "id": "17-02",
   "t0": 470.53,
   "t1": 476.1,
   "text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。",
   "who": "ナレーション"
  },
  {
   "id": "17-03",
   "t0": 477.33,
   "t1": 483.52,
   "text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。",
   "who": "ナレーション"
  },
  {
   "id": "17-04",
   "t0": 483.92,
   "t1": 490.55,
   "text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。",
   "who": "ナレーション"
  },
  {
   "id": "17-05",
   "t0": 490.94,
   "t1": 496.98,
   "text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。",
   "who": "ナレーション"
  },
  {
   "id": "17-06",
   "t0": 497.38,
   "t1": 504.44,
   "text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。",
   "who": "ナレーション"
  },
  {
   "id": "17-07",
   "t0": 504.84,
   "t1": 511.52,
   "text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。",
   "who": "ナレーション"
  },
  {
   "id": "17-08",
   "t0": 512.16,
   "t1": 516.33,
   "text": "先生は、なんと「もっと速く！」と声をかけたそうです。",
   "who": "ナレーション"
  },
  {
   "id": "17-09",
   "t0": 517.11,
   "t1": 523.71,
   "text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。",
   "who": "ナレーション"
  },
  {
   "id": "18-01",
   "t0": 524.51,
   "t1": 528.73,
   "text": "では、当時のアメリカのモールス信号を聞いてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "18-02",
   "t0": 529.63,
   "t1": 535.56,
   "text": "まずは「Z」。トントントン、少しあけて、トン。",
   "who": "ナレーション"
  },
  {
   "id": "18-03",
   "t0": 535.96,
   "t1": 539.77,
   "text": "そして次に、「S」と「E」を続けた音。",
   "who": "ナレーション"
  },
  {
   "id": "18-04",
   "t0": 540.57,
   "t1": 548.21,
   "text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。",
   "who": "ナレーション"
  },
  {
   "id": "18-05",
   "t0": 548.61,
   "t1": 553.79,
   "text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。",
   "who": "ナレーション"
  },
  {
   "id": "19-01",
   "t0": 554.59,
   "t1": 561.39,
   "text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。",
   "who": "ナレーション"
  },
  {
   "id": "19-02",
   "t0": 562.06,
   "t1": 569.04,
   "text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。",
   "who": "ナレーション"
  },
  {
   "id": "19-03",
   "t0": 569.44,
   "t1": 572.95,
   "text": "今のキーボードで、この3つを光らせてみると……。",
   "who": "ナレーション"
  },
  {
   "id": "19-04",
   "t0": 573.55,
   "t1": 580.72,
   "text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。",
   "who": "ナレーション"
  },
  {
   "id": "19-05",
   "t0": 581.12,
   "t1": 587.75,
   "text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。",
   "who": "ナレーション"
  },
  {
   "id": "20-01",
   "t0": 588.55,
   "t1": 593.75,
   "text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。",
   "who": "ナレーション"
  },
  {
   "id": "20-02",
   "t0": 594.42,
   "t1": 601.26,
   "text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。",
   "who": "ナレーション"
  },
  {
   "id": "20-03",
   "t0": 601.73,
   "t1": 604.85,
   "text": "しかも、ふしぎなことが、もう1つあります。",
   "who": "ナレーション"
  },
  {
   "id": "20-04",
   "t0": 605.25,
   "t1": 612.84,
   "text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。",
   "who": "ナレーション"
  },
  {
   "id": "20-05",
   "t0": 613.44,
   "t1": 623.01,
   "text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。",
   "who": "ナレーション"
  },
  {
   "id": "20-06",
   "t0": 623.41,
   "t1": 628.55,
   "text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "20-07",
   "t0": 628.95,
   "t1": 636.21,
   "text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。",
   "who": "ナレーション"
  },
  {
   "id": "21-01",
   "t0": 637.01,
   "t1": 638.54,
   "text": "でも、ちょっと待ってください。",
   "who": "ナレーション"
  },
  {
   "id": "21-02",
   "t0": 639.09,
   "t1": 644.35,
   "text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？",
   "who": "ナレーション"
  },
  {
   "id": "21-03",
   "t0": 644.95,
   "t1": 650.53,
   "text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。",
   "who": "ナレーション"
  },
  {
   "id": "22-01",
   "t0": 651.33,
   "t1": 658.0,
   "text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。",
   "who": "ナレーション"
  },
  {
   "id": "22-02",
   "t0": 658.4,
   "t1": 665.28,
   "text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。",
   "who": "ナレーション"
  },
  {
   "id": "22-03",
   "t0": 665.68,
   "t1": 672.99,
   "text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。",
   "who": "ナレーション"
  },
  {
   "id": "22-04",
   "t0": 673.39,
   "t1": 680.92,
   "text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。",
   "who": "ナレーション"
  },
  {
   "id": "22-05",
   "t0": 681.45,
   "t1": 689.46,
   "text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。",
   "who": "ナレーション"
  },
  {
   "id": "22-06",
   "t0": 689.86,
   "t1": 698.45,
   "text": "そして1893年、アメリカの大きなタイプライターの5つの会社が、1つにまとまりました。",
   "who": "ナレーション"
  },
  {
   "id": "22-07",
   "t0": 699.85,
   "t1": 705.17,
   "text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。",
   "who": "ナレーション"
  },
  {
   "id": "22-08",
   "t0": 705.57,
   "t1": 711.45,
   "text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。",
   "who": "ナレーション"
  },
  {
   "id": "23-01",
   "t0": 712.44,
   "t1": 716.5,
   "text": "では、もっと良い並びは、作られなかったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "23-02",
   "t0": 717.1,
   "t1": 725.53,
   "text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。",
   "who": "ナレーション"
  },
  {
   "id": "23-03",
   "t0": 725.93,
   "t1": 730.17,
   "text": "よく使う字を、指を置く真ん中の列に集めた並びです。",
   "who": "ナレーション"
  },
  {
   "id": "23-04",
   "t0": 730.57,
   "t1": 734.28,
   "text": "「クワーティより、ずっと速く打てる」。そう言われていました。",
   "who": "ナレーション"
  },
  {
   "id": "23-05",
   "t0": 735.08,
   "t1": 740.88,
   "text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "23-06",
   "t0": 741.28,
   "t1": 748.39,
   "text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。",
   "who": "ナレーション"
  },
  {
   "id": "23-07",
   "t0": 748.79,
   "t1": 754.23,
   "text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。",
   "who": "ナレーション"
  },
  {
   "id": "24-01",
   "t0": 755.1,
   "t1": 759.91,
   "text": "それに、もし本当に速かったとしても、問題があります。",
   "who": "ナレーション"
  },
  {
   "id": "24-02",
   "t0": 760.31,
   "t1": 766.08,
   "text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。",
   "who": "ナレーション"
  },
  {
   "id": "24-03",
   "t0": 766.48,
   "t1": 771.3,
   "text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。",
   "who": "ナレーション"
  },
  {
   "id": "24-04",
   "t0": 771.96,
   "t1": 776.68,
   "text": "もし明日、全部の並びが変わったら、どうなるでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "24-05",
   "t0": 777.68,
   "t1": 781.93,
   "text": "打つたびにキーを探して、指が止まってしまいますね。",
   "who": "ナレーション"
  },
  {
   "id": "24-06",
   "t0": 782.33,
   "t1": 788.85,
   "text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。",
   "who": "ナレーション"
  },
  {
   "id": "24-07",
   "t0": 789.34,
   "t1": 794.61,
   "text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。",
   "who": "ナレーション"
  },
  {
   "id": "24-08",
   "t0": 795.01,
   "t1": 800.19,
   "text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "24-09",
   "t0": 800.59,
   "t1": 805.92,
   "text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。",
   "who": "ナレーション"
  },
  {
   "id": "27-01",
   "t0": 806.72,
   "t1": 809.34,
   "text": "では、最初の問いに戻ります。",
   "who": "ナレーション"
  },
  {
   "id": "27-02",
   "t0": 809.74,
   "t1": 813.74,
   "text": "キーボードは、なぜ ABC 順に並んでいないのか。",
   "who": "ナレーション"
  },
  {
   "id": "27-03",
   "t0": 814.14,
   "t1": 822.43,
   "text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。",
   "who": "ナレーション"
  },
  {
   "id": "27-04",
   "t0": 822.83,
   "t1": 827.39,
   "text": "ただ、どんな都合だったのかは、今もはっきりしていません。",
   "who": "ナレーション"
  },
  {
   "id": "27-05",
   "t0": 827.79,
   "t1": 834.31,
   "text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。",
   "who": "ナレーション"
  },
  {
   "id": "27-06",
   "t0": 834.71,
   "t1": 841.93,
   "text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。",
   "who": "ナレーション"
  },
  {
   "id": "28-01",
   "t0": 842.73,
   "t1": 845.15,
   "text": "そこで、まるロボは考えました。",
   "who": "ナレーション"
  },
  {
   "id": "28-02",
   "t0": 845.55,
   "t1": 850.74,
   "text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。",
   "who": "ナレーション"
  },
  {
   "id": "28-03",
   "t0": 851.14,
   "t1": 857.36,
   "text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！",
   "who": "ナレーション"
  },
  {
   "id": "28-04",
   "t0": 857.76,
   "t1": 860.35,
   "text": "さっそく、いろは歌を打ってみると……。",
   "who": "ナレーション"
  },
  {
   "id": "28-05",
   "t0": 862.95,
   "t1": 866.57,
   "text": "跳ねる距離は、クワーティの7分の1になりました。",
   "who": "ナレーション"
  },
  {
   "id": "28-06",
   "t0": 866.97,
   "t1": 874.8,
   "text": "でも、カメラを引いてみると……横にとても長いキーボードで、キーは「い ろ は」の順に1列。",
   "who": "ナレーション"
  },
  {
   "id": "28-07",
   "t0": 876.0,
   "t1": 881.94,
   "text": "これは、いろは歌を打つときだけ速い、いろは歌専用のキーボードだったのです。",
   "who": "ナレーション"
  },
  {
   "id": "28-08",
   "t0": 882.84,
   "t1": 887.13,
   "text": "……まるロボの並びも、誰にも使ってもらえなかったようです。",
   "who": "ナレーション"
  }
