{"project_id": "MARU-EP07", "number": 5, "label": "v5（確認用・キーボードを作り直した版）", "status": "ready", "duration": 872.208, "segment_count": 29, "segments": [{"i": 0, "file": "seg000.mp4", "url": "/_blob/c8e1a915b472f132de6d78ce05f2ed89", "id": "c8e1a915b472f132de6d78ce05f2ed89", "start": 0.0, "dur": 38.375, "size": 1296884, "sha256": "afb666fca02b4b7dcfc9338f67e504199babbc6095d70a5daadf0feb81c051e0"}, {"i": 1, "file": "seg001.mp4", "url": "/_blob/8da4e1aa51d7b912e96f213a77e1021e", "id": "8da4e1aa51d7b912e96f213a77e1021e", "start": 38.375, "dur": 26.833333, "size": 967232, "sha256": "0d5eef76ec9ae59a2ff07a8ee3381236d2d9331a4a86f15293292cc65cd2f978"}, {"i": 2, "file": "seg002.mp4", "url": "/_blob/7a54cde556950bf32ad66adfd465d1b1", "id": "7a54cde556950bf32ad66adfd465d1b1", "start": 65.208333, "dur": 28.708333, "size": 808732, "sha256": "fd3c35e0d7bac88ff676ea7387fb7e72b8cb104f9e734c6c7c867b598d954cec"}, {"i": 3, "file": "seg003.mp4", "url": "/_blob/13c7ee921fb7cea06729150b1a5a31c1", "id": "13c7ee921fb7cea06729150b1a5a31c1", "start": 93.916666, "dur": 28.875, "size": 1103496, "sha256": "a7851e58983a32398d1885204a536446b653e4a7200dd0af6dd83ef9c0cb8dff"}, {"i": 4, "file": "seg004.mp4", "url": "/_blob/ffe42161a8b20cf9991fb9efb7300b5e", "id": "ffe42161a8b20cf9991fb9efb7300b5e", "start": 122.791666, "dur": 29.458333, "size": 861979, "sha256": "b8d89ddc5d40c94c3fc80adf348a2c0e90c35af501b7eb44b698b44d2cf91265"}, {"i": 5, "file": "seg005.mp4", "url": "/_blob/5356d055a4343d5fa9e6a2e249c2c185", "id": "5356d055a4343d5fa9e6a2e249c2c185", "start": 152.249999, "dur": 31.25, "size": 911458, "sha256": "ecc9734ab8ff28616e13d7a618ea6b4fa93235df35376d9411d40e051a0f7e61"}, {"i": 6, "file": "seg006.mp4", "url": "/_blob/14f6bace03426a87614b627fd5e128a2", "id": "14f6bace03426a87614b627fd5e128a2", "start": 183.499999, "dur": 35.291667, "size": 1172568, "sha256": "2bbda9927762a89770ef3ba442a66e6202a497313c3f5e6359b52e32cf2694a9"}, {"i": 7, "file": "seg007.mp4", "url": "/_blob/7071b57b6244e67a772cd2b0cd2