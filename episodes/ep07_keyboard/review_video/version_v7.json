 "source": {
  "filename": "通し_v7.mp4",
  "sha256": "d86b0ab14d4c184393137f7f6c770c69250dcb442642ee6a109f9e80e0e8b8f8",
  "size": 29520377,
  "duration": 868.292
 },
 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 6.72,
   "text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 7.12,
   "t1": 9.71,
   "text": "でも、まるロボには腕がありません。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 10.11,
   "t1": 13.24,
   "text": "なので、キーボードは跳ねて乗って打つのです。",
   "who": "ナレーション"
  },
  {
   "id": "01-04",
   "t0": 13.64,
   "t1": 17.84,
   "text": "ぴょん、カタッ。これで「A」の出来上がり。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 18.64,
   "t1": 22.92,
   "text": "次は「B」。A の次ですから、すぐとなりに……。",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 23.52,
   "t1": 27.07,
   "text": "あれ？　となりにあるのは「S」です。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 27.47,
   "t1": 30.04,
   "text": "反対側には、何もありません。",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 30.44,
   "t1": 35.22,
   "text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 36.12,
   "t1": 43.97,
   "text": "上から見ると、左上は Q W E R T Y。",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 44.37,
   "t1": 50.08,
   "text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 50.48,
   "t1": 54.8,
   "text": "毎日さわるキーボードは、ABC 順に並んでいません。",
   "who": "ナレーション"
  },
  {
   "id": "03-04",
   "t0": 55.2,
   "t1": 60.1,
   "text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？",
   "who": "ナレーション"
  },
  {
   "id": "03-05",
   "t0": 60.7,
   "t1": 65.19,
   "text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 67.99,
   "t1": 71.07,
   "text": "まるロボにとって大事なのは、跳ねる距離です。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 71.47,
   "t1": 76.2,
   "text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 76.6,
   "t1": 82.02,
   "text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 82.42,
   "t1": 87.43,
   "text": "キーの数も形も同じで、並びだけが ABC 順です。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 88.23,
   "t1": 92.95,
   "text": "では、同じ言葉を、2つのキーボードで打ってみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 93.35,
   "t1": 96.74,
   "text": "打つのは、自分の名前の「マルロボ」。",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 97.14,
   "t1": 104.66,
   "text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 105.06,
   "t1": 111.85,
   "text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。",
   "who": "ナレーション"
  },
  {
   "id": "05-05",
   "t0": 112.85,
   "t1": 119.72,
   "text": "次は、ABC 順の並びです。こちらは橙の線で残しました。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 120.82,
   "t1": 124.47,
   "text": "跳ねた距離を、キーの数で測ってみると……。",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 125.07,
   "t1": 128.02,
   "text": "クワーティが、キー28個分。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 128.42,
   "t1": 131.83,
   "text": "ABC 順が、キー31個分。",
   "who": "ナレーション"
  },
  {
   "id": "06-04",
   "t0": 132.23,
   "t1": 135.12,
   "text": "あれ？　ほとんど、変わりません。",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 135.92,
   "t1": 141.02,
   "text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 141.42,
   "t1": 145.09,
   "text": "打つのは、「いろはにほへと」で始まる、いろは歌。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 145.49,
   "t1": 151.2,
   "text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。",
   "who": "ナレーション"
  },
  {
   "id": "07-04",
   "t0": 152.1,
   "t1": 160.54,
   "text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。",
   "who": "ナレーション"
  },
  {
   "id": "07-05",
   "t0": 160.94,
   "t1": 165.83,
   "text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "07-06",
   "t0": 166.23,
   "t1": 174.0,
   "text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。",
   "who": "ナレーション"
  },
  {
   "id": "07-07",
   "t0": 174.4,
   "t1": 180.58,
   "text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。",
   "who": "ナレーション"
  },
  {
   "id": "07-08",
   "t0": 180.98,
   "t1": 186.69,
   "text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。",
   "who": "ナレーション"
  },
  {
   "id": "07-09",
   "t0": 187.09,
   "t1": 191.17,
   "text": "では、いったい何のために、この順番になったのか……。",
   "who": "ナレーション"
  },
  {
   "id": "07-10",
   "t0": 191.77,
   "t1": 196.47,
   "text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 197.37,
   "t1": 204.55,
   "text": "時は、1868年。今から150年ほど前の、アメリカです。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 204.95,
   "t1": 211.47,
   "text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 211.87,
   "t1": 217.59,
   "text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。",
   "who": "ナレーション"
  },
  {
   "id": "09-01",
   "t0": 218.59,
   "t1": 221.97,
   "text": "おや？　このキーボード、よく見ると……。",
   "who": "ナレーション"
  },
  {
   "id": "09-02",
   "t0": 222.57,
   "t1": 225.64,
   "text": "まるで、ピアノの鍵盤のような形をしています。",
   "who": "ナレーション"
  },
  {
   "id": "09-03",
   "t0": 226.04,
   "t1": 230.75,
   "text": "そして並びは……なんと、ABC 順だったのです。",
   "who": "ナレーション"
  },
  {
   "id": "09-04",
   "t0": 231.16,
   "t1": 235.28,
   "text": "手前の列は、A から N まで、左から右へ。",
   "who": "ナレーション"
  },
  {
   "id": "09-05",
   "t0": 235.69,
   "t1": 241.12,
   "text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。",
   "who": "ナレーション"
  },
  {
   "id": "10-01",
   "t0": 241.91,
   "t1": 246.28,
   "text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "10-02",
   "t0": 246.68,
   "t1": 251.5,
   "text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。",
   "who": "ナレーション"
  },
  {
   "id": "10-03",
   "t0": 251.9,
   "t1": 256.12,
   "text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。",
   "who": "ナレーション"
  },
  {
   "id": "10-04",
   "t0": 256.52,
   "t1": 264.08,
   "text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。",
   "who": "ナレーション"
  },
  {
   "id": "10-05",
   "t0": 264.68,
   "t1": 273.59,
   "text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。",
   "who": "ナレーション"
  },
  {
   "id": "10-06",
   "t0": 273.99,
   "t1": 280.47,
   "text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。",
   "who": "ナレーション"
  },
  {
   "id": "10-07",
   "t0": 281.27,
   "t1": 289.92,
   "text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。",
   "who": "ナレーション"
  },
  {
   "id": "10-08",
   "t0": 290.92,
   "t1": 296.07,
   "text": "その会社でピリオドが外され、そこに R が入りました。",
   "who": "ナレーション"
  },
  {
   "id": "10-09",
   "t0": 296.47,
   "t1": 300.77,
   "text": "こうして、冒頭で見たクワーティの並びが、そろったのです。",
   "who": "ナレーション"
  },
  {
   "id": "11-01",
   "t0": 301.57,
   "t1": 305.76,
   "text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "11-02",
   "t0": 306.36,
   "t1": 310.89,
   "text": "実は、作った人たちは、その理由を書き残していません。",
   "who": "ナレーション"
  },
  {
   "id": "11-03",
   "t0": 311.29,
   "t1": 315.43,
   "text": "そこで、昔からよく言われてきた説があります。",
   "who": "ナレーション"
  },
  {
   "id": "12-01",
   "t0": 316.43,
   "t1": 322.61,
   "text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "12-02",
   "t0": 323.01,
   "t1": 328.11,
   "text": "キーの奥には、細い棒がずらりと、円く並んでいます。",
   "who": "ナレーション"
  },
  {
   "id": "12-03",
   "t0": 328.51,
   "t1": 333.5,
   "text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。",
   "who": "ナレーション"
  },
  {
   "id": "13-01",
   "t0": 334.3,
   "t1": 338.59,
   "text": "もし、となり合う2本の棒が、続けて上がると……。",
   "who": "ナレーション"
  },
  {
   "id": "13-02",
   "t0": 339.39,
   "t1": 342.59,
   "text": "途中でぶつかって、からまってしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "13-03",
   "t0": 342.99,
   "t1": 345.41,
   "text": "よく言われるのは、こんな説です。",
   "who": "ナレーション"
  },
  {
   "id": "13-04",
   "t0": 346.21,
   "t1": 351.24,
   "text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。",
   "who": "ナレーション"
  },
  {
   "id": "13-05",
   "t0": 351.64,
   "t1": 355.31,
   "text": "なるほど、と思いますよね。ところが……。",
   "who": "ナレーション"
  },
  {
   "id": "14-01",
   "t0": 356.11,
   "t1": 359.29,
   "text": "この説には、はっきりした証拠がありません。",
   "who": "ナレーション"
  },
  {
   "id": "14-02",
   "t0": 359.69,
   "t1": 364.58,
   "text": "まず、理由を書いた記録が、どこにも残っていないのです。",
   "who": "ナレーション"
  },
  {
   "id": "14-03",
   "t0": 364.98,
   "t1": 369.39,
   "text": "それに、英語でとてもよく続く「E」と「R」。",
   "who": "ナレーション"
  },
  {
   "id": "14-04",
   "t0": 369.79,
   "t1": 375.84,
   "text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。",
   "who": "ナレーション"
  },
  {
   "id": "14-05",
   "t0": 376.24,
   "t1": 379.27,
   "text": "からまないように離したのなら、おかしいですね。",
   "who": "ナレーション"
  },
  {
   "id": "15-01",
   "t0": 380.07,
   "t1": 382.52,
   "text": "また、こんな話もよく聞きます。",
   "who": "ナレーション"
  },
  {
   "id": "15-02",
   "t0": 382.92,
   "t1": 389.31,
   "text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。",
   "who": "ナレーション"
  },
  {
   "id": "15-03",
   "t0": 389.71,
   "t1": 395.43,
   "text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。",
   "who": "ナレーション"
  },
  {
   "id": "15-04",
   "t0": 396.43,
   "t1": 402.19,
   "text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。",
   "who": "ナレーション"
  },
  {
   "id": "15-05",
   "t0": 402.59,
   "t1": 407.56,
   "text": "この機械は、手で書くより速く打つために作られたはずですよね。",
   "who": "ナレーション"
  },
  {
   "id": "15-06",
   "t0": 407.96,
   "t1": 412.66,
   "text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。",
   "who": "ナレーション"
  },
  {
   "id": "15-07",
   "t0": 413.06,
   "t1": 418.26,
   "text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。",
   "who": "ナレーション"
  },
  {
   "id": "15-08",
   "t0": 418.66,
   "t1": 423.86,
   "text": "この「わざと遅く」の話は、今では研究者に否定されています。",
   "who": "ナレーション"
  },
  {
   "id": "15-09",
   "t0": 424.26,
   "t1": 427.73,
   "text": "からまない工夫が、少しはあったのかもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "15-10",
   "t0": 428.13,
   "t1": 432.24,
   "text": "でも、それだけでクワーティの並びになったとは、言えないのです。",
   "who": "ナレーション"
  },
  {
   "id": "16-01",
   "t0": 433.04,
   "t1": 436.19,
   "text": "では、本当の理由は何だったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "16-02",
   "t0": 436.79,
   "t1": 444.2,
   "text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。",
   "who": "ナレーション"
  },
  {
   "id": "16-03",
   "t0": 444.6,
   "t1": 449.11,
   "text": "手がかりは、最初にこの機械を買った、お客さんです。",
   "who": "ナレーション"
  },
  {
   "id": "17-01",
   "t0": 450.11,
   "t1": 453.91,
   "text": "それは、電信という仕事をしている人たちでした。",
   "who": "ナレーション"
  },
  {
   "id": "17-02",
   "t0": 454.31,
   "t1": 459.88,
   "text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。",
   "who": "ナレーション"
  },
  {
   "id": "17-03",
   "t0": 460.68,
   "t1": 466.87,
   "text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。",
   "who": "ナレーション"
  },
  {
   "id": "17-04",
   "t0": 467.27,
   "t1": 473.98,
   "text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。",
   "who": "ナレーション"
  },
  {
   "id": "17-05",
   "t0": 474.38,
   "t1": 480.42,
   "text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。",
   "who": "ナレーション"
  },
  {
   "id": "17-06",
   "t0": 480.82,
   "t1": 487.88,
   "text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。",
   "who": "ナレーション"
  },
  {
   "id": "17-07",
   "t0": 488.28,
   "t1": 494.96,
   "text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。",
   "who": "ナレーション"
  },
  {
   "id": "17-08",
   "t0": 495.36,
   "t1": 499.03,
   "text": "先生は、なんと「もっと速く！」と声をかけたそうです。",
   "who": "ナレーション"
  },
  {
   "id": "17-09",
   "t0": 499.43,
   "t1": 505.38,
   "text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。",
   "who": "ナレーション"
  },
  {
   "id": "18-01",
   "t0": 506.18,
   "t1": 510.03,
   "text": "では、当時のアメリカのモールス信号を聞いてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "18-02",
   "t0": 510.83,
   "t1": 516.76,
   "text": "まずは「Z」。トントントン、少しあけて、トン。",
   "who": "ナレーション"
  },
  {
   "id": "18-03",
   "t0": 517.16,
   "t1": 520.97,
   "text": "そして次に、「S」と「E」を続けた音。",
   "who": "ナレーション"
  },
  {
   "id": "18-04",
   "t0": 521.77,
   "t1": 529.41,
   "text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。",
   "who": "ナレーション"
  },
  {
   "id": "18-05",
   "t0": 529.81,
   "t1": 534.99,
   "text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。",
   "who": "ナレーション"
  },
  {
   "id": "19-01",
   "t0": 535.79,
   "t1": 542.59,
   "text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。",
   "who": "ナレーション"
  },
  {
   "id": "19-02",
   "t0": 542.99,
   "t1": 549.97,
   "text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。",
   "who": "ナレーション"
  },
  {
   "id": "19-03",
   "t0": 550.37,
   "t1": 553.88,
   "text": "今のキーボードで、この3つを光らせてみると……。",
   "who": "ナレーション"
  },
  {
   "id": "19-04",
   "t0": 554.48,
   "t1": 561.65,
   "text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。",
   "who": "ナレーション"
  },
  {
   "id": "19-05",
   "t0": 562.05,
   "t1": 568.32,
   "text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。",
   "who": "ナレーション"
  },
  {
   "id": "20-01",
   "t0": 569.12,
   "t1": 574.32,
   "text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。",
   "who": "ナレーション"
  },
  {
   "id": "20-02",
   "t0": 574.72,
   "t1": 581.56,
   "text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。",
   "who": "ナレーション"
  },
  {
   "id": "20-03",
   "t0": 581.96,
   "t1": 585.08,
   "text": "しかも、ふしぎなことが、もう1つあります。",
   "who": "ナレーション"
  },
  {
   "id": "20-04",
   "t0": 585.48,
   "t1": 593.07,
   "text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。",
   "who": "ナレーション"
  },
  {
   "id": "20-05",
   "t0": 593.47,
   "t1": 603.04,
   "text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。",
   "who": "ナレーション"
  },
  {
   "id": "20-06",
   "t0": 603.44,
   "t1": 608.58,
   "text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "20-07",
   "t0": 608.98,
   "t1": 616.34,
   "text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。",
   "who": "ナレーション"
  },
  {
   "id": "21-01",
   "t0": 617.14,
   "t1": 618.67,
   "text": "でも、ちょっと待ってください。",
   "who": "ナレーション"
  },
  {
   "id": "21-02",
   "t0": 619.07,
   "t1": 624.33,
   "text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？",
   "who": "ナレーション"
  },
  {
   "id": "21-03",
   "t0": 624.93,
   "t1": 630.51,
   "text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。",
   "who": "ナレーション"
  },
  {
   "id": "22-01",
   "t0": 631.31,
   "t1": 637.98,
   "text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。",
   "who": "ナレーション"
  },
  {
   "id": "22-02",
   "t0": 638.38,
   "t1": 645.32,
   "text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。",
   "who": "ナレーション"
  },
  {
   "id": "22-03",
   "t0": 645.72,
   "t1": 653.03,
   "text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。",
   "who": "ナレーション"
  },
  {
   "id": "22-04",
   "t0": 653.43,
   "t1": 660.96,
   "text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。",
   "who": "ナレーション"
  },
  {
   "id": "22-05",
   "t0": 661.36,
   "t1": 669.37,
   "text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。",
   "who": "ナレーション"
  },
  {
   "id": "22-06",
   "t0": 669.77,
   "t1": 678.36,
   "text": "そして1893年、アメリカの大きなタイプライターの5つの会社が、1つにまとまりました。",
   "who": "ナレーション"
  },
  {
   "id": "22-07",
   "t0": 679.76,
   "t1": 685.14,
   "text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。",
   "who": "ナレーション"
  },
  {
   "id": "22-08",
   "t0": 685.54,
   "t1": 691.42,
   "text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。",
   "who": "ナレーション"
  },
  {
   "id": "23-01",
   "t0": 692.22,
   "t1": 696.28,
   "text": "では、もっと良い並びは、作られなかったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "23-02",
   "t0": 696.88,
   "t1": 705.31,
   "text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。",
   "who": "ナレーション"
  },
  {
   "id": "23-03",
   "t0": 705.71,
   "t1": 709.95,
   "text": "よく使う字を、指を置く真ん中の列に集めた並びです。",
   "who": "ナレーション"
  },
  {
   "id": "23-04",
   "t0": 710.35,
   "t1": 714.06,
   "text": "「クワーティより、ずっと速く打てる」。そう言われていました。",
   "who": "ナレーション"
  },
  {
   "id": "23-05",
   "t0": 714.46,
   "t1": 720.34,
   "text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "23-06",
   "t0": 720.74,
   "t1": 727.85,
   "text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。",
   "who": "ナレーション"
  },
  {
   "id": "23-07",
   "t0": 728.25,
   "t1": 733.69,
   "text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。",
   "who": "ナレーション"
  },
  {
   "id": "24-01",
   "t0": 734.49,
   "t1": 739.3,
   "text": "それに、もし本当に速かったとしても、問題があります。",
   "who": "ナレーション"
  },
  {
   "id": "24-02",
   "t0": 739.7,
   "t1": 745.47,
   "text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。",
   "who": "ナレーション"
  },
  {
   "id": "24-03",
   "t0": 745.87,
   "t1": 750.69,
   "text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。",
   "who": "ナレーション"
  },
  {
   "id": "24-04",
   "t0": 751.09,
   "t1": 755.81,
   "text": "もし明日、全部の並びが変わったら、どうなるでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "24-05",
   "t0": 756.81,
   "t1": 761.06,
   "text": "打つたびにキーを探して、指が止まってしまいますね。",
   "who": "ナレーション"
  },
  {
   "id": "24-06",
   "t0": 761.46,
   "t1": 767.98,
   "text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。",
   "who": "ナレーション"
  },
  {
   "id": "24-07",
   "t0": 768.38,
   "t1": 773.65,
   "text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。",
   "who": "ナレーション"
  },
  {
   "id": "24-08",
   "t0": 774.05,
   "t1": 779.23,
   "text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。",
   "who": "ナレーション"
  },
  {
   "id": "24-09",
   "t0": 779.63,
   "t1": 784.87,
   "text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。",
   "who": "ナレーション"
  },
  {
   "id": "27-01",
   "t0": 785.67,
   "t1": 788.29,
   "text": "では、最初の問いに戻ります。",
   "who": "ナレーション"
  },
  {
   "id": "27-02",
   "t0": 788.69,
   "t1": 792.69,
   "text": "キーボードは、なぜ ABC 順に並んでいないのか。",
   "who": "ナレーション"
  },
  {
   "id": "27-03",
   "t0": 793.09,
   "t1": 801.38,
   "text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。",
   "who": "ナレーション"
  },
  {
   "id": "27-04",
   "t0": 801.78,
   "t1": 806.44,
   "text": "ただ、どんな都合だったのかは、今もはっきりしていません。",
   "who": "ナレーション"
  },
  {
   "id": "27-05",
   "t0": 806.84,
   "t1": 813.36,
   "text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。",
   "who": "ナレーション"
  },
  {
   "id": "27-06",
   "t0": 813.76,
   "t1": 820.98,
   "text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。",
   "who": "ナレーション"
  },
  {
   "id": "28-01",
   "t0": 821.78,
   "t1": 824.2,
   "text": "そこで、まるロボは考えました。",
   "who": "ナレーション"
  },
  {
   "id": "28-02",
   "t0": 824.6,
   "t1": 829.79,
   "text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。",
   "who": "ナレーション"
  },
  {
   "id": "28-03",
   "t0": 830.19,
   "t1": 836.41,
   "text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！",
