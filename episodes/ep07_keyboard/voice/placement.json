[
{
"no": 1,
"start": 0.5,
"end": 6.72,
"speed": 1.0,
"slot": [
0.5,
6.72
],
"text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。"
},
{
"no": 2,
"start": 7.12,
"end": 9.71,
"speed": 1.0,
"slot": [
7.12,
9.71
],
"text": "でも、まるロボには腕がありません。"
},
{
"no": 3,
"start": 10.11,
"end": 13.24,
"speed": 1.0,
"slot": [
10.11,
13.24
],
"text": "なので、キーボードは跳ねて乗って打つのです。"
},
{
"no": 4,
"start": 13.64,
"end": 17.84,
"speed": 1.0,
"slot": [
13.64,
17.84
],
"text": "ぴょん、カタッ。これで「A」の出来上がり。"
},
{
"no": 5,
"start": 18.64,
"end": 22.92,
"speed": 1.0,
"slot": [
18.64,
22.92
],
"text": "次は「B」。A の次ですから、すぐとなりに……。"
},
{
"no": 6,
"start": 23.52,
"end": 27.07,
"speed": 1.0,
"slot": [
23.52,
27.07
],
"text": "あれ？　となりにあるのは「S」です。"
},
{
"no": 7,
"start": 27.47,
"end": 30.04,
"speed": 1.0,
"slot": [
27.47,
30.04
],
"text": "反対側には、何もありません。"
},
{
"no": 8,
"start": 30.44,
"end": 35.22,
"speed": 1.0,
"slot": [
30.44,
35.22
],
"text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。"
},
{
"no": 9,
"start": 36.12,
"end": 43.97,
"speed": 1.0,
"slot": [
36.12,
43.97
],
"text": "上から見ると、左上は Q W E R T Y。"
},
{
"no": 10,
"start": 44.37,
"end": 50.08,
"speed": 1.0,
"slot": [
44.37,
50.08
],
"text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。"
},
{
"no": 11,
"start": 50.48,
"end": 54.8,
"speed": 1.0,
"slot": [
50.48,
54.8
],
"text": "毎日さわるキーボードは、ABC 順に並んでいません。"
},
{
"no": 12,
"start": 55.2,
"end": 60.1,
"speed": 1.0,
"slot": [
55.2,
60.1
],
"text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？"
},
{
"no": 13,
"start": 60.7,
"end": 65.19,
"speed": 1.0,
"slot": [
60.7,
65.19
],
"text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。"
},
{
"no": 14,
"start": 67.99,
"end": 71.07,
"speed": 1.0,
"slot": [
67.99,
71.07
],
"text": "まるロボにとって大事なのは、跳ねる距離です。"
},
{
"no": 15,
"start": 71.47,
"end": 75.757,
"speed": 1.0,
"slot": [
71.47,
75.757
],
"text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。"
},
{
"no": 16,
"start": 76.157,
"end": 82.547,
"speed": 1.0,
"slot": [
76.157,
82.547
],
"text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。"
},
{
"no": 17,
"start": 82.947,
"end": 87.957,
"speed": 1.0,
"slot": [
82.947,
87.957
],
"text": "キーの数も形も同じで、並びだけが ABC 順です。"
},
{
"no": 18,
"start": 88.757,
"end": 93.477,
"speed": 1.0,
"slot": [
88.757,
93.477
],
"text": "では、同じ言葉を、2つのキーボードで打ってみましょう。"
},
{
"no": 19,
"start": 93.877,
"end": 97.267,
"speed": 1.0,
"slot": [
93.877,
97.267
],
"text": "打つのは、自分の名前の「マルロボ」。"
},
{
"no": 20,
"start": 97.667,
"end": 104.811,
"speed": 1.0,
"slot": [
97.667,
104.811
],
"text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。"
},
{
"no": 21,
"start": 105.211,
"end": 112.001,
"speed": 1.0,
"slot": [
105.211,
112.001
],
"text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。"
},
{
"no": 22,
"start": 113.001,
"end": 119.871,
"speed": 1.0,
"slot": [
113.001,
119.871
],
"text": "次は、ABC 順の並びです。こちらは橙の線で残しました。"
},
{
"no": 23,
"start": 120.971,
"end": 124.621,
"speed": 1.0,
"slot": [
120.971,
124.621
],
"text": "跳ねた距離を、キーの数で測ってみると……。"
},
{
"no": 24,
"start": 125.221,
"end": 128.171,
"speed": 1.0,
"slot": [
125.221,
128.171
],
"text": "クワーティが、キー28個分。"
},
{
"no": 25,
"start": 128.571,
"end": 131.981,
"speed": 1.0,
"slot": [
128.571,
131.981
],
"text": "ABC 順が、キー31個分。"
},
{
"no": 26,
"start": 132.381,
"end": 135.271,
"speed": 1.0,
"slot": [
132.381,
135.271
],
"text": "あれ？　ほとんど、変わりません。"
},
{
"no": 27,
"start": 136.071,
"end": 141.171,
"speed": 1.0,
"slot": [
136.071,
141.171
],
"text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。"
},
{
"no": 28,
"start": 141.571,
"end": 145.241,
"speed": 1.0,
"slot": [
141.571,
145.241
],
"text": "打つのは、「いろはにほへと」で始まる、いろは歌。"
},
{
"no": 29,
"start": 145.641,
"end": 151.344,
"speed": 1.0,
"slot": [
145.641,
151.344
],
"text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。"
},
{
"no": 30,
"start": 152.244,
"end": 160.684,
"speed": 1.0,
"slot": [
152.244,
160.684
],
"text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。"
},
{
"no": 31,
"start": 161.084,
"end": 166.494,
"speed": 1.0,
"slot": [
161.084,
166.494
],
"text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。"
},
{
"no": 32,
"start": 166.894,
"end": 174.664,
"speed": 1.0,
"slot": [
166.894,
174.664
],
"text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。"
},
{
"no": 33,
"start": 175.064,
"end": 181.244,
"speed": 1.0,
"slot": [
175.064,
181.244
],
"text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。"
},
{
"no": 34,
"start": 181.644,
"end": 187.354,
"speed": 1.0,
"slot": [
181.644,
187.354
],
"text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。"
},
{
"no": 35,
"start": 187.754,
"end": 191.834,
"speed": 1.0,
"slot": [
187.754,
191.834
],
"text": "では、いったい何のために、この順番になったのか……。"
},
{
"no": 36,
"start": 192.434,
"end": 197.464,
"speed": 1.0,
"slot": [
192.434,
197.464
],
"text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。"
},
{
"no": 37,
"start": 198.364,
"end": 205.544,
"speed": 1.0,
"slot": [
198.364,
205.544
],
"text": "時は、1868年。今から150年ほど前の、アメリカです。"
},
{
"no": 38,
"start": 205.944,
"end": 212.464,
"speed": 1.0,
"slot": [
205.944,
212.464
],
"text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。"
},
{
"no": 39,
"start": 212.864,
"end": 218.584,
"speed": 1.0,
"slot": [
212.864,
218.584
],
"text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。"
},
{
"no": 40,
"start": 219.584,
"end": 222.511,
"speed": 1.0,
"slot": [
219.584,
222.511
],
"text": "おや？　このキー、よく見ると……。"
},
{
"no": 41,
"start": 223.111,
"end": 226.181,
"speed": 1.0,
"slot": [
223.111,
226.181
],
"text": "まるで、ピアノの鍵盤のような形をしています。"
},
{
"no": 42,
"start": 226.581,
"end": 230.821,
"speed": 1.0,
"slot": [
226.581,
230.821
],
"text": "そして並びは……なんと、ABC 順だったのです。"
},
{
"no": 43,
"start": 231.221,
"end": 235.351,
"speed": 1.0,
"slot": [
231.221,
235.351
],
"text": "手前の列は、A から N まで、左から右へ。"
},
{
"no": 44,
"start": 235.751,
"end": 241.181,
"speed": 1.0,
"slot": [
235.751,
241.181
],
"text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。"
},
{
"no": 45,
"start": 241.981,
"end": 246.341,
"speed": 1.0,
"slot": [
241.981,
246.341
],
"text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。"
},
{
"no": 46,
"start": 246.741,
"end": 251.561,
"speed": 1.0,
"slot": [
246.741,
251.561
],
"text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。"
},
{
"no": 47,
"start": 251.961,
"end": 256.661,
"speed": 1.0,
"slot": [
251.961,
256.661
],
"text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。"
},
{
"no": 48,
"start": 257.061,
"end": 264.621,
"speed": 1.0,
"slot": [
257.061,
264.621
],
"text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。"
},
{
"no": 49,
"start": 265.221,
"end": 274.131,
"speed": 1.0,
"slot": [
265.221,
274.131
],
"text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。"
},
{
"no": 50,
"start": 274.531,
"end": 281.017,
"speed": 1.0,
"slot": [
274.531,
281.017
],
"text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。"
},
{
"no": 51,
"start": 281.817,
"end": 290.467,
"speed": 1.0,
"slot": [
281.817,
290.467
],
"text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。"
},
{
"no": 52,
"start": 291.467,
"end": 296.617,
"speed": 1.0,
"slot": [
291.467,
296.617
],
"text": "その会社でピリオドが外され、そこに R が入りました。"
},
{
"no": 53,
"start": 297.017,
"end": 301.317,
"speed": 1.0,
"slot": [
297.017,
301.317
],
"text": "こうして、冒頭で見たクワーティの並びが、そろったのです。"
},
{
"no": 54,
"start": 302.117,
"end": 306.307,
"speed": 1.0,
"slot": [
302.117,
306.307
],
"text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？"
},
{
"no": 55,
"start": 306.907,
"end": 311.437,
"speed": 1.0,
"slot": [
306.907,
311.437
],
"text": "実は、作った人たちは、その理由を書き残していません。"
},
{
"no": 56,
"start": 311.837,
"end": 315.977,
"speed": 1.0,
"slot": [
311.837,
315.977
],
"text": "そこで、昔からよく言われてきた説があります。"
},
{
"no": 57,
"start": 316.977,
"end": 323.157,
"speed": 1.0,
"slot": [
316.977,
323.157
],
"text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。"
},
{
"no": 58,
"start": 323.557,
"end": 328.659,
"speed": 1.0,
"slot": [
323.557,
328.659
],
"text": "キーの奥には、細い棒がずらりと、円く並んでいます。"
},
{
"no": 59,
"start": 329.059,
"end": 334.049,
"speed": 1.0,
"slot": [
329.059,
334.049
],
"text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。"
},
{
"no": 60,
"start": 334.849,
"end": 339.139,
"speed": 1.0,
"slot": [
334.849,
339.139
],
"text": "もし、となり合う2本の棒が、続けて上がると……。"
},
{
"no": 61,
"start": 339.939,
"end": 343.139,
"speed": 1.0,
"slot": [
339.939,
343.139
],
"text": "途中でぶつかって、からまってしまいました。"
},
{
"no": 62,
"start": 343.539,
"end": 345.959,
"speed": 1.0,
"slot": [
343.539,
345.959
],
"text": "よく言われるのは、こんな説です。"
},
{
"no": 63,
"start": 346.759,
"end": 352.849,
"speed": 1.0,
"slot": [
346.759,
352.849
],
"text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。"
},
{
"no": 64,
"start": 353.249,
"end": 356.919,
"speed": 1.0,
"slot": [
353.249,
356.919
],
"text": "なるほど、と思いますよね。ところが……。"
},
{
"no": 65,
"start": 357.719,
"end": 360.899,
"speed": 1.0,
"slot": [
357.719,
360.899
],
"text": "この説には、はっきりした証拠がありません。"
},
{
"no": 66,
"start": 361.299,
"end": 366.189,
"speed": 1.0,
"slot": [
361.299,
366.189
],
"text": "まず、理由を書いた記録が、どこにも残っていないのです。"
},
{
"no": 67,
"start": 366.589,
"end": 370.999,
"speed": 1.0,
"slot": [
366.589,
370.999
],
"text": "それに、英語でとてもよく続く「E」と「R」。"
},
{
"no": 68,
"start": 371.399,
"end": 377.449,
"speed": 1.0,
"slot": [
371.399,
377.449
],
"text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。"
},
{
"no": 69,
"start": 377.849,
"end": 380.879,
"speed": 1.0,
"slot": [
377.849,
380.879
],
"text": "からまないように離したのなら、おかしいですね。"
},
{
"no": 70,
"start": 381.679,
"end": 384.129,
"speed": 1.0,
"slot": [
381.679,
384.129
],
"text": "また、こんな話もよく聞きます。"
},
{
"no": 71,
"start": 384.529,
"end": 390.919,
"speed": 1.0,
"slot": [
384.529,
390.919
],
"text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。"
},
{
"no": 72,
"start": 391.319,
"end": 397.039,
"speed": 1.0,
"slot": [
391.319,
397.039
],
"text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。"
},
{
"no": 73,
"start": 398.039,
"end": 403.799,
"speed": 1.0,
"slot": [
398.039,
403.799
],
"text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。"
},
{
"no": 74,
"start": 404.199,
"end": 409.169,
"speed": 1.0,
"slot": [
404.199,
409.169
],
"text": "この機械は、手で書くより速く打つために作られたはずですよね。"
},
{
"no": 75,
"start": 409.569,
"end": 414.419,
"speed": 1.0,
"slot": [
409.569,
414.419
],
"text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。"
},
{
"no": 76,
"start": 414.819,
"end": 420.019,
"speed": 1.0,
"slot": [
414.819,
420.019
],
"text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。"
},
{
"no": 77,
"start": 420.419,
"end": 425.619,
"speed": 1.0,
"slot": [
420.419,
425.619
],
"text": "この「わざと遅く」の話は、今では研究者に否定されています。"
},
{
"no": 78,
"start": 426.019,
"end": 429.489,
"speed": 1.0,
"slot": [
426.019,
429.489
],
"text": "からまない工夫が、少しはあったのかもしれません。"
},
{
"no": 79,
"start": 429.889,
"end": 433.999,
"speed": 1.0,
"slot": [
429.889,
433.999
],
"text": "でも、それだけでクワーティの並びになったとは、言えないのです。"
},
{
"no": 80,
"start": 434.799,
"end": 437.949,
"speed": 1.0,
"slot": [
434.799,
437.949
],
"text": "では、本当の理由は何だったのでしょうか？"
},
{
"no": 81,
"start": 438.549,
"end": 445.959,
"speed": 1.0,
"slot": [
438.549,
445.959
],
"text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。"
},
{
"no": 82,
"start": 446.359,
"end": 450.869,
"speed": 1.0,
"slot": [
446.359,
450.869
],
"text": "手がかりは、最初にこの機械を買った、お客さんです。"
},
{
"no": 83,
"start": 451.869,
"end": 455.669,
"speed": 1.0,
"slot": [
451.869,
455.669
],
"text": "それは、電信という仕事をしている人たちでした。"
},
{
"no": 84,
"start": 456.069,
"end": 461.639,
"speed": 1.0,
"slot": [
456.069,
461.639
],
"text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。"
},
{
"no": 85,
"start": 462.439,
"end": 468.629,
"speed": 1.0,
"slot": [
462.439,
468.629
],
"text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。"
},
{
"no": 86,
"start": 469.029,
"end": 475.741,
"speed": 1.0,
"slot": [
469.029,
475.741
],
"text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。"
},
{
"no": 87,
"start": 476.141,
"end": 482.177,
"speed": 1.0,
"slot": [
476.141,
482.177
],
"text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。"
},
{
"no": 88,
"start": 482.577,
"end": 489.637,
"speed": 1.0,
"slot": [
482.577,
489.637
],
"text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。"
},
{
"no": 89,
"start": 490.037,
"end": 496.717,
"speed": 1.0,
"slot": [
490.037,
496.717
],
"text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。"
},
{
"no": 90,
"start": 497.117,
"end": 500.787,
"speed": 1.0,
"slot": [
497.117,
500.787
],
"text": "先生は、なんと「もっと速く！」と声をかけたそうです。"
},
{
"no": 91,
"start": 501.187,
"end": 507.137,
"speed": 1.0,
"slot": [
501.187,
507.137
],
"text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。"
},
{
"no": 92,
"start": 507.937,
"end": 511.787,
"speed": 1.0,
"slot": [
507.937,
511.787
],
"text": "では、当時のアメリカのモールス信号を聞いてみましょう。"
},
{
"no": 93,
"start": 512.587,
"end": 518.517,
"speed": 1.0,
"slot": [
512.587,
518.517
],
"text": "まずは「Z」。トントントン、少しあけて、トン。"
},
{
"no": 94,
"start": 518.917,
"end": 522.727,
"speed": 1.0,
"slot": [
518.917,
522.727
],
"text": "そして次に、「S」と「E」を続けた音。"
},
{
"no": 95,
"start": 523.527,
"end": 531.167,
"speed": 1.0,
"slot": [
523.527,
531.167
],
"text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。"
},
{
"no": 96,
"start": 531.567,
"end": 536.747,
"speed": 1.0,
"slot": [
531.567,
536.747
],
"text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。"
},
{
"no": 97,
"start": 537.547,
"end": 544.343,
"speed": 1.0,
"slot": [
537.547,
544.343
],
"text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。"
},
{
"no": 98,
"start": 544.743,
"end": 551.723,
"speed": 1.0,
"slot": [
544.743,
551.723
],
"text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。"
},
{
"no": 99,
"start": 552.123,
"end": 555.633,
"speed": 1.0,
"slot": [
552.123,
555.633
],
"text": "今のキーボードで、この3つを光らせてみると……。"
},
{
"no": 100,
"start": 556.233,
"end": 563.403,
"speed": 1.0,
"slot": [
556.233,
563.403
],
"text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。"
},
{
"no": 101,
"start": 563.803,
"end": 570.603,
"speed": 1.0,
"slot": [
563.803,
570.603
],
"text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。"
},
{
"no": 102,
"start": 571.403,
"end": 576.603,
"speed": 1.0,
"slot": [
571.403,
576.603
],
"text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。"
},
{
"no": 103,
"start": 577.003,
"end": 583.843,
"speed": 1.0,
"slot": [
577.003,
583.843
],
"text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。"
},
{
"no": 104,
"start": 584.243,
"end": 587.363,
"speed": 1.0,
"slot": [
584.243,
587.363
],
"text": "しかも、ふしぎなことが、もう1つあります。"
},
{
"no": 105,
"start": 587.763,
"end": 595.353,
"speed": 1.0,
"slot": [
587.763,
595.353
],
"text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。"
},
{
"no": 106,
"start": 595.753,
"end": 605.323,
"speed": 1.0,
"slot": [
595.753,
605.323
],
"text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。"
},
{
"no": 107,
"start": 605.723,
"end": 610.863,
"speed": 1.0,
"slot": [
605.723,
610.863
],
"text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。"
},
{
"no": 108,
"start": 611.263,
"end": 618.623,
"speed": 1.0,
"slot": [
611.263,
618.623
],
"text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。"
},
{
"no": 109,
"start": 619.423,
"end": 620.953,
"speed": 1.0,
"slot": [
619.423,
620.953
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 110,
"start": 621.353,
"end": 626.613,
"speed": 1.0,
"slot": [
621.353,
626.613
],
"text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？"
},
{
"no": 111,
"start": 627.213,
"end": 632.923,
"speed": 1.0,
"slot": [
627.213,
632.923
],
"text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。"
},
{
"no": 112,
"start": 633.723,
"end": 640.153,
"speed": 1.0,
"slot": [
633.723,
640.153
],
"text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。"
},
{
"no": 113,
"start": 640.553,
"end": 647.493,
"speed": 1.0,
"slot": [
640.553,
647.493
],
"text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。"
},
{
"no": 114,
"start": 647.893,
"end": 655.203,
"speed": 1.0,
"slot": [
647.893,
655.203
],
"text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。"
},
{
"no": 115,
"start": 655.603,
"end": 663.133,
"speed": 1.0,
"slot": [
655.603,
663.133
],
"text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。"
},
{
"no": 116,
"start": 663.533,
"end": 671.543,
"speed": 1.0,
"slot": [
663.533,
671.543
],
"text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。"
},
{
"no": 117,
"start": 671.943,
"end": 681.023,
"speed": 1.0,
"slot": [
671.943,
681.023
],
"text": "そして1893年、アメリカの大きなタイプライターの会社が5つ、1つにまとまりました。"
},
{
"no": 118,
"start": 682.423,
"end": 687.803,
"speed": 1.0,
"slot": [
682.423,
687.803
],
"text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。"
},
{
"no": 119,
"start": 688.203,
"end": 694.083,
"speed": 1.0,
"slot": [
688.203,
694.083
],
"text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。"
},
{
"no": 120,
"start": 694.883,
"end": 698.943,
"speed": 1.0,
"slot": [
694.883,
698.943
],
"text": "では、もっと良い並びは、作られなかったのでしょうか？"
},
{
"no": 121,
"start": 699.543,
"end": 707.973,
"speed": 1.0,
"slot": [
699.543,
707.973
],
"text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。"
},
{
"no": 122,
"start": 708.373,
"end": 712.613,
"speed": 1.0,
"slot": [
708.373,
712.613
],
"text": "よく使う字を、指を置く真ん中の列に集めた並びです。"
},
{
"no": 123,
"start": 713.013,
"end": 717.803,
"speed": 1.0,
"slot": [
713.013,
717.803
],
"text": "「クワーティより、ずっと速く打てる」。そう言われていました。"
},
{
"no": 124,
"start": 718.203,
"end": 724.083,
"speed": 1.0,
"slot": [
718.203,
724.083
],
"text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。"
},
{
"no": 125,
"start": 724.483,
"end": 731.593,
"speed": 1.0,
"slot": [
724.483,
731.593
],
"text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。"
},
{
"no": 126,
"start": 731.993,
"end": 737.433,
"speed": 1.0,
"slot": [
731.993,
737.433
],
"text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。"
},
{
"no": 127,
"start": 738.233,
"end": 743.043,
"speed": 1.0,
"slot": [
738.233,
743.043
],
"text": "それに、もし本当に速かったとしても、問題があります。"
},
{
"no": 128,
"start": 743.443,
"end": 749.213,
"speed": 1.0,
"slot": [
743.443,
749.213
],
"text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。"
},
{
"no": 129,
"start": 749.613,
"end": 754.433,
"speed": 1.0,
"slot": [
749.613,
754.433
],
"text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。"
},
{
"no": 130,
"start": 754.833,
"end": 759.553,
"speed": 1.0,
"slot": [
754.833,
759.553
],
"text": "もし明日、全部の並びが変わったら、どうなるでしょう？"
},
{
"no": 131,
"start": 760.553,
"end": 764.803,
"speed": 1.0,
"slot": [
760.553,
764.803
],
"text": "打つたびにキーを探して、指が止まってしまいますね。"
},
{
"no": 132,
"start": 765.203,
"end": 771.723,
"speed": 1.0,
"slot": [
765.203,
771.723
],
"text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。"
},
{
"no": 133,
"start": 772.123,
"end": 777.393,
"speed": 1.0,
"slot": [
772.123,
777.393
],
"text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。"
},
{
"no": 134,
"start": 777.793,
"end": 782.973,
"speed": 1.0,
"slot": [
777.793,
782.973
],
"text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。"
},
{
"no": 135,
"start": 783.373,
"end": 788.613,
"speed": 1.0,
"slot": [
783.373,
788.613
],
"text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。"
},
{
"no": 136,
"start": 789.413,
"end": 792.033,
"speed": 1.0,
"slot": [
789.413,
792.033
],
"text": "では、最初の問いに戻ります。"
},
{
"no": 137,
"start": 792.433,
"end": 796.433,
"speed": 1.0,
"slot": [
792.433,
796.433
],
"text": "キーボードは、なぜ ABC 順に並んでいないのか。"
},
{
"no": 138,
"start": 796.833,
"end": 805.123,
"speed": 1.0,
"slot": [
796.833,
805.123
],
"text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。"
},
{
"no": 139,
"start": 805.523,
"end": 810.183,
"speed": 1.0,
"slot": [
805.523,
810.183
],
"text": "ただ、どんな都合だったのかは、今もはっきりしていません。"
},
{
"no": 140,
"start": 810.583,
"end": 817.103,
"speed": 1.0,
"slot": [
810.583,
817.103
],
"text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。"
},
{
"no": 141,
"start": 817.503,
"end": 824.723,
"speed": 1.0,
"slot": [
817.503,
824.723
],
"text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。"
},
{
"no": 142,
"start": 825.523,
"end": 827.943,
"speed": 1.0,
"slot": [
825.523,
827.943
],
"text": "そこで、まるロボは考えました。"
},
{
"no": 143,
"start": 828.343,
"end": 833.533,
"speed": 1.0,
"slot": [
828.343,
833.533
],
"text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。"
},
{
"no": 144,
"start": 833.933,
"end": 840.153,
"speed": 1.0,
"slot": [
833.933,
840.153
],
"text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！"
},
{
"no": 145,
"start": 840.553,
"end": 843.143,
"speed": 1.0,
"slot": [
840.553,
843.143
],
"text": "さっそく、いろは歌を打ってみると……。"
},
{
"no": 146,
"start": 845.743,
"end": 849.553,
"speed": 1.0,
"slot": [
845.743,
849.553
],
"text": "跳ねる距離は、クワーティの7分の1になりました。"
},
{
"no": 147,
"start": 849.953,
"end": 857.783,
"speed": 1.0,
"slot": [
849.953,
857.783
],
"text": "でも、カメラを引いてみると……横にとても長いキーボードで、キーは「い ろ は」の順に1列。"
},
{
"no": 148,
"start": 858.983,
"end": 864.923,
"speed": 1.0,
"slot": [
858.983,
864.923
],
"text": "これは、いろは歌を打つときだけ速い、いろは歌専用のキーボードだったのです。"
},
{
"no": 149,
"start": 865.823,
"end": 869.723,
"speed": 1.0,
"slot": [
865.823,
869.723
],
"text": "……まるロボの並びも、誰にも使ってもらえなかったようです。"
}
]