[
{
"no": 1,
"start": 0.5,
"end": 6.72,
"speed": 1.0,
"slot": [
0.5,
6.72
],
"text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。"
},
{
"no": 2,
"start": 7.12,
"end": 9.71,
"speed": 1.0,
"slot": [
7.12,
9.71
],
"text": "でも、まるロボには腕がありません。"
},
{
"no": 3,
"start": 10.11,
"end": 13.24,
"speed": 1.0,
"slot": [
10.11,
13.24
],
"text": "なので、キーボードは跳ねて乗って打つのです。"
},
{
"no": 4,
"start": 13.64,
"end": 17.84,
"speed": 1.0,
"slot": [
13.64,
17.84
],
"text": "ぴょん、カタッ。これで「A」の出来上がり。"
},
{
"no": 5,
"start": 18.64,
"end": 22.92,
"speed": 1.0,
"slot": [
18.64,
22.92
],
"text": "次は「B」。A の次ですから、すぐとなりに……。"
},
{
"no": 6,
"start": 23.52,
"end": 27.07,
"speed": 1.0,
"slot": [
23.52,
27.07
],
"text": "あれ？　となりにあるのは「S」です。"
},
{
"no": 7,
"start": 27.47,
"end": 30.04,
"speed": 1.0,
"slot": [
27.47,
30.04
],
"text": "反対側には、何もありません。"
},
{
"no": 8,
"start": 30.44,
"end": 35.22,
"speed": 1.0,
"slot": [
30.44,
35.22
],
"text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。"
},
{
"no": 9,
"start": 36.42,
"end": 44.27,
"speed": 1.0,
"slot": [
36.42,
44.27
],
"text": "上から見ると、左上は Q W E R T Y。"
},
{
"no": 10,
"start": 44.67,
"end": 50.38,
"speed": 1.0,
"slot": [
44.67,
50.38
],
"text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。"
},
{
"no": 11,
"start": 50.85,
"end": 55.17,
"speed": 1.0,
"slot": [
50.85,
55.17
],
"text": "毎日さわるキーボードは、ABC 順に並んでいません。"
},
{
"no": 12,
"start": 55.57,
"end": 60.47,
"speed": 1.0,
"slot": [
55.57,
60.47
],
"text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？"
},
{
"no": 13,
"start": 61.69,
"end": 66.18,
"speed": 1.0,
"slot": [
61.69,
66.18
],
"text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。"
},
{
"no": 14,
"start": 68.98,
"end": 72.06,
"speed": 1.0,
"slot": [
68.98,
72.06
],
"text": "まるロボにとって大事なのは、跳ねる距離です。"
},
{
"no": 15,
"start": 72.46,
"end": 76.862,
"speed": 1.0,
"slot": [
72.46,
76.862
],
"text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。"
},
{
"no": 16,
"start": 77.332,
"end": 82.758,
"speed": 1.0,
"slot": [
77.332,
82.758
],
"text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。"
},
{
"no": 17,
"start": 83.498,
"end": 88.508,
"speed": 1.0,
"slot": [
83.498,
88.508
],
"text": "キーの数も形も同じで、並びだけが ABC 順です。"
},
{
"no": 18,
"start": 89.308,
"end": 94.028,
"speed": 1.0,
"slot": [
89.308,
94.028
],
"text": "では、同じ言葉を、2つのキーボードで打ってみましょう。"
},
{
"no": 19,
"start": 94.428,
"end": 97.818,
"speed": 1.0,
"slot": [
94.428,
97.818
],
"text": "打つのは、自分の名前の「マルロボ」。"
},
{
"no": 20,
"start": 98.218,
"end": 105.739,
"speed": 1.0,
"slot": [
98.218,
105.739
],
"text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。"
},
{
"no": 21,
"start": 106.139,
"end": 112.929,
"speed": 1.0,
"slot": [
106.139,
112.929
],
"text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。"
},
{
"no": 22,
"start": 113.929,
"end": 120.799,
"speed": 1.0,
"slot": [
113.929,
120.799
],
"text": "次は、ABC 順の並びです。こちらは橙の線で残しました。"
},
{
"no": 150,
"start": 121.199,
"end": 131.973,
"speed": 1.0,
"slot": [
121.199,
131.973
],
"text": "M、A、R、U、R、O、B……最後の O まで、ぴょん。打てました。"
},
{
"no": 23,
"start": 133.073,
"end": 136.723,
"speed": 1.0,
"slot": [
133.073,
136.723
],
"text": "跳ねた距離を、キーの数で測ってみると……。"
},
{
"no": 24,
"start": 137.323,
"end": 140.273,
"speed": 1.0,
"slot": [
137.323,
140.273
],
"text": "クワーティが、キー28個分。"
},
{
"no": 25,
"start": 140.673,
"end": 144.083,
"speed": 1.0,
"slot": [
140.673,
144.083
],
"text": "ABC 順が、キー31個分。"
},
{
"no": 26,
"start": 144.483,
"end": 147.373,
"speed": 1.0,
"slot": [
144.483,
147.373
],
"text": "あれ？　ほとんど、変わりません。"
},
{
"no": 27,
"start": 148.173,
"end": 153.203,
"speed": 1.0,
"slot": [
148.173,
153.203
],
"text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。"
},
{
"no": 28,
"start": 153.603,
"end": 157.273,
"speed": 1.0,
"slot": [
153.603,
157.273
],
"text": "打つのは、「いろはにほへと」で始まる、いろは歌。"
},
{
"no": 29,
"start": 157.673,
"end": 163.376,
"speed": 1.0,
"slot": [
157.673,
163.376
],
"text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。"
},
{
"no": 30,
"start": 164.276,
"end": 172.716,
"speed": 1.0,
"slot": [
164.276,
172.716
],
"text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。"
},
{
"no": 31,
"start": 173.116,
"end": 178.008,
"speed": 1.0,
"slot": [
173.116,
178.008
],
"text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。"
},
{
"no": 32,
"start": 178.408,
"end": 186.018,
"speed": 1.0,
"slot": [
178.408,
186.018
],
"text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。"
},
{
"no": 33,
"start": 186.418,
"end": 192.598,
"speed": 1.0,
"slot": [
186.418,
192.598
],
"text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。"
},
{
"no": 34,
"start": 192.998,
"end": 198.448,
"speed": 1.0,
"slot": [
192.998,
198.448
],
"text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。"
},
{
"no": 35,
"start": 198.848,
"end": 202.928,
"speed": 1.0,
"slot": [
198.848,
202.928
],
"text": "では、いったい何のために、この順番になったのか……。"
},
{
"no": 36,
"start": 203.528,
"end": 208.227,
"speed": 1.0,
"slot": [
203.528,
208.227
],
"text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。"
},
{
"no": 37,
"start": 209.127,
"end": 216.307,
"speed": 1.0,
"slot": [
209.127,
216.307
],
"text": "時は、1868年。今から150年ほど前の、アメリカです。"
},
{
"no": 38,
"start": 217.547,
"end": 224.067,
"speed": 1.0,
"slot": [
217.547,
224.067
],
"text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。"
},
{
"no": 39,
"start": 224.467,
"end": 230.187,
"speed": 1.0,
"slot": [
224.467,
230.187
],
"text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。"
},
{
"no": 40,
"start": 231.187,
"end": 234.771,
"speed": 1.0,
"slot": [
231.187,
234.771
],
"text": "おや？　このキーボード、よく見ると……。"
},
{
"no": 41,
"start": 235.371,
"end": 238.441,
"speed": 1.0,
"slot": [
235.371,
238.441
],
"text": "まるで、ピアノの鍵盤のような形をしています。"
},
{
"no": 42,
"start": 238.841,
"end": 243.556,
"speed": 1.0,
"slot": [
238.841,
243.556
],
"text": "そして並びは……なんと、ABC 順だったのです。"
},
{
"no": 43,
"start": 243.956,
"end": 248.086,
"speed": 1.0,
"slot": [
243.956,
248.086
],
"text": "手前の列は、A から N まで、左から右へ。"
},
{
"no": 44,
"start": 248.486,
"end": 253.916,
"speed": 1.0,
"slot": [
248.486,
253.916
],
"text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。"
},
{
"no": 45,
"start": 254.716,
"end": 258.986,
"speed": 1.0,
"slot": [
254.716,
258.986
],
"text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。"
},
{
"no": 46,
"start": 259.386,
"end": 264.746,
"speed": 1.0,
"slot": [
259.386,
264.746
],
"text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。"
},
{
"no": 47,
"start": 265.146,
"end": 269.967,
"speed": 1.0,
"slot": [
265.146,
269.967
],
"text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。"
},
{
"no": 48,
"start": 270.367,
"end": 277.927,
"speed": 1.0,
"slot": [
270.367,
277.927
],
"text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。"
},
{
"no": 49,
"start": 278.527,
"end": 287.437,
"speed": 1.0,
"slot": [
278.527,
287.437
],
"text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。"
},
{
"no": 50,
"start": 287.837,
"end": 294.253,
"speed": 1.0,
"slot": [
287.837,
294.253
],
"text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。"
},
{
"no": 51,
"start": 295.053,
"end": 303.703,
"speed": 1.0,
"slot": [
295.053,
303.703
],
"text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。"
},
{
"no": 52,
"start": 304.703,
"end": 309.853,
"speed": 1.0,
"slot": [
304.703,
309.853
],
"text": "その会社でピリオドが外され、そこに R が入りました。"
},
{
"no": 53,
"start": 310.253,
"end": 314.553,
"speed": 1.0,
"slot": [
310.253,
314.553
],
"text": "こうして、冒頭で見たクワーティの並びが、そろったのです。"
},
{
"no": 54,
"start": 315.823,
"end": 320.013,
"speed": 1.0,
"slot": [
315.823,
320.013
],
"text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？"
},
{
"no": 55,
"start": 320.813,
"end": 325.343,
"speed": 1.0,
"slot": [
320.813,
325.343
],
"text": "実は、作った人たちは、その理由を書き残していません。"
},
{
"no": 56,
"start": 325.743,
"end": 329.883,
"speed": 1.0,
"slot": [
325.743,
329.883
],
"text": "そこで、昔からよく言われてきた説があります。"
},
{
"no": 57,
"start": 330.883,
"end": 337.063,
"speed": 1.0,
"slot": [
330.883,
337.063
],
"text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。"
},
{
"no": 58,
"start": 337.463,
"end": 342.565,
"speed": 1.0,
"slot": [
337.463,
342.565
],
"text": "キーの奥には、細い棒がずらりと、円く並んでいます。"
},
{
"no": 59,
"start": 342.965,
"end": 347.955,
"speed": 1.0,
"slot": [
342.965,
347.955
],
"text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。"
},
{
"no": 60,
"start": 348.755,
"end": 353.045,
"speed": 1.0,
"slot": [
348.755,
353.045
],
"text": "もし、となり合う2本の棒が、続けて上がると……。"
},
{
"no": 61,
"start": 353.845,
"end": 357.045,
"speed": 1.0,
"slot": [
353.845,
357.045
],
"text": "途中でぶつかって、からまってしまいました。"
},
{
"no": 62,
"start": 357.445,
"end": 359.865,
"speed": 1.0,
"slot": [
357.445,
359.865
],
"text": "よく言われるのは、こんな説です。"
},
{
"no": 63,
"start": 360.665,
"end": 365.691,
"speed": 1.0,
"slot": [
360.665,
365.691
],
"text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。"
},
{
"no": 64,
"start": 366.241,
"end": 369.911,
"speed": 1.0,
"slot": [
366.241,
369.911
],
"text": "なるほど、と思いますよね。ところが……。"
},
{
"no": 65,
"start": 371.211,
"end": 374.301,
"speed": 1.0,
"slot": [
371.211,
374.301
],
"text": "この説には、はっきりした証拠がありません。"
},
{
"no": 66,
"start": 374.701,
"end": 379.591,
"speed": 1.0,
"slot": [
374.701,
379.591
],
"text": "まず、理由を書いた記録が、どこにも残っていないのです。"
},
{
"no": 67,
"start": 379.991,
"end": 384.401,
"speed": 1.0,
"slot": [
379.991,
384.401
],
"text": "それに、英語でとてもよく続く「E」と「R」。"
},
{
"no": 68,
"start": 384.801,
"end": 390.771,
"speed": 1.0,
"slot": [
384.801,
390.771
],
"text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。"
},
{
"no": 69,
"start": 391.171,
"end": 394.201,
"speed": 1.0,
"slot": [
391.171,
394.201
],
"text": "からまないように離したのなら、おかしいですね。"
},
{
"no": 70,
"start": 395.001,
"end": 397.451,
"speed": 1.0,
"slot": [
395.001,
397.451
],
"text": "また、こんな話もよく聞きます。"
},
{
"no": 71,
"start": 397.851,
"end": 404.241,
"speed": 1.0,
"slot": [
397.851,
404.241
],
"text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。"
},
{
"no": 72,
"start": 404.641,
"end": 410.361,
"speed": 1.0,
"slot": [
404.641,
410.361
],
"text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。"
},
{
"no": 73,
"start": 411.361,
"end": 417.121,
"speed": 1.0,
"slot": [
411.361,
417.121
],
"text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。"
},
{
"no": 74,
"start": 417.521,
"end": 423.201,
"speed": 1.0,
"slot": [
417.521,
423.201
],
"text": "この機械は、手で書くより速く打つために作られたはずですよね。"
},
{
"no": 75,
"start": 423.601,
"end": 428.303,
"speed": 1.0,
"slot": [
423.601,
428.303
],
"text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。"
},
{
"no": 76,
"start": 428.893,
"end": 434.093,
"speed": 1.0,
"slot": [
428.893,
434.093
],
"text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。"
},
{
"no": 77,
"start": 434.493,
"end": 439.693,
"speed": 1.0,
"slot": [
434.493,
439.693
],
"text": "この「わざと遅く」の話は、今では研究者に否定されています。"
},
{
"no": 78,
"start": 440.093,
"end": 443.563,
"speed": 1.0,
"slot": [
440.093,
443.563
],
"text": "からまない工夫が、少しはあったのかもしれません。"
},
{
"no": 79,
"start": 443.963,
"end": 448.073,
"speed": 1.0,
"slot": [
443.963,
448.073
],
"text": "でも、それだけでクワーティの並びになったとは、言えないのです。"
},
{
"no": 80,
"start": 449.263,
"end": 452.413,
"speed": 1.0,
"slot": [
449.263,
452.413
],
"text": "では、本当の理由は何だったのでしょうか？"
},
{
"no": 81,
"start": 453.013,
"end": 460.423,
"speed": 1.0,
"slot": [
453.013,
460.423
],
"text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。"
},
{
"no": 82,
"start": 460.823,
"end": 465.333,
"speed": 1.0,
"slot": [
460.823,
465.333
],
"text": "手がかりは、最初にこの機械を買った、お客さんです。"
},
{
"no": 83,
"start": 466.333,
"end": 470.133,
"speed": 1.0,
"slot": [
466.333,
470.133
],
"text": "それは、電信という仕事をしている人たちでした。"
},
{
"no": 84,
"start": 470.533,
"end": 476.103,
"speed": 1.0,
"slot": [
470.533,
476.103
],
"text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。"
},
{
"no": 85,
"start": 477.333,
"end": 483.523,
"speed": 1.0,
"slot": [
477.333,
483.523
],
"text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。"
},
{
"no": 86,
"start": 483.923,
"end": 490.545,
"speed": 1.0,
"slot": [
483.923,
490.545
],
"text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。"
},
{
"no": 87,
"start": 490.945,
"end": 496.981,
"speed": 1.0,
"slot": [
490.945,
496.981
],
"text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。"
},
{
"no": 88,
"start": 497.381,
"end": 504.441,
"speed": 1.0,
"slot": [
497.381,
504.441
],
"text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。"
},
{
"no": 89,
"start": 504.841,
"end": 511.521,
"speed": 1.0,
"slot": [
504.841,
511.521
],
"text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。"
},
{
"no": 90,
"start": 512.161,
"end": 516.331,
"speed": 1.0,
"slot": [
512.161,
516.331
],
"text": "先生は、なんと「もっと速く！」と声をかけたそうです。"
},
{
"no": 91,
"start": 517.111,
"end": 523.711,
"speed": 1.0,
"slot": [
517.111,
523.711
],
"text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。"
},
{
"no": 92,
"start": 524.511,
"end": 528.731,
"speed": 1.0,
"slot": [
524.511,
528.731
],
"text": "では、当時のアメリカのモールス信号を聞いてみましょう。"
},
{
"no": 93,
"start": 529.631,
"end": 535.561,
"speed": 1.0,
"slot": [
529.631,
535.561
],
"text": "まずは「Z」。トントントン、少しあけて、トン。"
},
{
"no": 94,
"start": 535.961,
"end": 539.771,
"speed": 1.0,
"slot": [
535.961,
539.771
],
"text": "そして次に、「S」と「E」を続けた音。"
},
{
"no": 95,
"start": 540.571,
"end": 548.211,
"speed": 1.0,
"slot": [
540.571,
548.211
],
"text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。"
},
{
"no": 96,
"start": 548.611,
"end": 553.791,
"speed": 1.0,
"slot": [
548.611,
553.791
],
"text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。"
},
{
"no": 97,
"start": 554.591,
"end": 561.387,
"speed": 1.0,
"slot": [
554.591,
561.387
],
"text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。"
},
{
"no": 98,
"start": 562.057,
"end": 569.037,
"speed": 1.0,
"slot": [
562.057,
569.037
],
"text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。"
},
{
"no": 99,
"start": 569.437,
"end": 572.947,
"speed": 1.0,
"slot": [
569.437,
572.947
],
"text": "今のキーボードで、この3つを光らせてみると……。"
},
{
"no": 100,
"start": 573.547,
"end": 580.717,
"speed": 1.0,
"slot": [
573.547,
580.717
],
"text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。"
},
{
"no": 101,
"start": 581.117,
"end": 587.747,
"speed": 1.0,
"slot": [
581.117,
587.747
],
"text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。"
},
{
"no": 102,
"start": 588.547,
"end": 593.747,
"speed": 1.0,
"slot": [
588.547,
593.747
],
"text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。"
},
{
"no": 103,
"start": 594.417,
"end": 601.257,
"speed": 1.0,
"slot": [
594.417,
601.257
],
"text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。"
},
{
"no": 104,
"start": 601.727,
"end": 604.847,
"speed": 1.0,
"slot": [
601.727,
604.847
],
"text": "しかも、ふしぎなことが、もう1つあります。"
},
{
"no": 105,
"start": 605.247,
"end": 612.837,
"speed": 1.0,
"slot": [
605.247,
612.837
],
"text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。"
},
{
"no": 106,
"start": 613.437,
"end": 623.007,
"speed": 1.0,
"slot": [
613.437,
623.007
],
"text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。"
},
{
"no": 107,
"start": 623.407,
"end": 628.547,
"speed": 1.0,
"slot": [
623.407,
628.547
],
"text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。"
},
{
"no": 108,
"start": 628.947,
"end": 636.207,
"speed": 1.0,
"slot": [
628.947,
636.207
],
"text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。"
},
{
"no": 109,
"start": 637.007,
"end": 638.537,
"speed": 1.0,
"slot": [
637.007,
638.537
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 110,
"start": 639.087,
"end": 644.347,
"speed": 1.0,
"slot": [
639.087,
644.347
],
"text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？"
},
{
"no": 111,
"start": 644.947,
"end": 650.532,
"speed": 1.0,
"slot": [
644.947,
650.532
],
"text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。"
},
{
"no": 112,
"start": 651.332,
"end": 657.998,
"speed": 1.0,
"slot": [
651.332,
657.998
],
"text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。"
},
{
"no": 113,
"start": 658.398,
"end": 665.278,
"speed": 1.0,
"slot": [
658.398,
665.278
],
"text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。"
},
{
"no": 114,
"start": 665.678,
"end": 672.988,
"speed": 1.0,
"slot": [
665.678,
672.988
],
"text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。"
},
{
"no": 115,
"start": 673.388,
"end": 680.918,
"speed": 1.0,
"slot": [
673.388,
680.918
],
"text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。"
},
{
"no": 116,
"start": 681.448,
"end": 689.458,
"speed": 1.0,
"slot": [
681.448,
689.458
],
"text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。"
},
{
"no": 117,
"start": 689.858,
"end": 698.45,
"speed": 1.0,
"slot": [
689.858,
698.45
],
"text": "そして1893年、アメリカの大きなタイプライターの5つの会社が、1つにまとまりました。"
},
{
"no": 118,
"start": 699.85,
"end": 705.17,
"speed": 1.0,
"slot": [
699.85,
705.17
],
"text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。"
},
{
"no": 119,
"start": 705.57,
"end": 711.45,
"speed": 1.0,
"slot": [
705.57,
711.45
],
"text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。"
},
{
"no": 120,
"start": 712.44,
"end": 716.5,
"speed": 1.0,
"slot": [
712.44,
716.5
],
"text": "では、もっと良い並びは、作られなかったのでしょうか？"
},
{
"no": 121,
"start": 717.1,
"end": 725.53,
"speed": 1.0,
"slot": [
717.1,
725.53
],
"text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。"
},
{
"no": 122,
"start": 725.93,
"end": 730.17,
"speed": 1.0,
"slot": [
725.93,
730.17
],
"text": "よく使う字を、指を置く真ん中の列に集めた並びです。"
},
{
"no": 123,
"start": 730.57,
"end": 734.284,
"speed": 1.0,
"slot": [
730.57,
734.284
],
"text": "「クワーティより、ずっと速く打てる」。そう言われていました。"
},
{
"no": 124,
"start": 735.084,
"end": 740.884,
"speed": 1.0,
"slot": [
735.084,
740.884
],
"text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。"
},
{
"no": 125,
"start": 741.284,
"end": 748.394,
"speed": 1.0,
"slot": [
741.284,
748.394
],
"text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。"
},
{
"no": 126,
"start": 748.794,
"end": 754.234,
"speed": 1.0,
"slot": [
748.794,
754.234
],
"text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。"
},
{
"no": 127,
"start": 755.104,
"end": 759.914,
"speed": 1.0,
"slot": [
755.104,
759.914
],
"text": "それに、もし本当に速かったとしても、問題があります。"
},
{
"no": 128,
"start": 760.314,
"end": 766.084,
"speed": 1.0,
"slot": [
760.314,
766.084
],
"text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。"
},
{
"no": 129,
"start": 766.484,
"end": 771.304,
"speed": 1.0,
"slot": [
766.484,
771.304
],
"text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。"
},
{
"no": 130,
"start": 771.964,
"end": 776.684,
"speed": 1.0,
"slot": [
771.964,
776.684
],
"text": "もし明日、全部の並びが変わったら、どうなるでしょう？"
},
{
"no": 131,
"start": 777.684,
"end": 781.934,
"speed": 1.0,
"slot": [
777.684,
781.934
],
"text": "打つたびにキーを探して、指が止まってしまいますね。"
},
{
"no": 132,
"start": 782.334,
"end": 788.854,
"speed": 1.0,
"slot": [
782.334,
788.854
],
"text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。"
},
{
"no": 133,
"start": 789.344,
"end": 794.614,
"speed": 1.0,
"slot": [
789.344,
794.614
],
"text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。"
},
{
"no": 134,
"start": 795.014,
"end": 800.194,
"speed": 1.0,
"slot": [
795.014,
800.194
],
"text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。"
},
{
"no": 135,
"start": 800.594,
"end": 805.924,
"speed": 1.0,
"slot": [
800.594,
805.924
],
"text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。"
},
{
"no": 136,
"start": 806.724,
"end": 809.344,
"speed": 1.0,
"slot": [
806.724,
809.344
],
"text": "では、最初の問いに戻ります。"
},
{
"no": 137,
"start": 809.744,
"end": 813.744,
"speed": 1.0,
"slot": [
809.744,
813.744
],
"text": "キーボードは、なぜ ABC 順に並んでいないのか。"
},
{
"no": 138,
"start": 814.144,
"end": 822.434,
"speed": 1.0,
"slot": [
814.144,
822.434
],
"text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。"
},
{
"no": 139,
"start": 822.834,
"end": 827.394,
"speed": 1.0,
"slot": [
822.834,
827.394
],
"text": "ただ、どんな都合だったのかは、今もはっきりしていません。"
},
{
"no": 140,
"start": 827.794,
"end": 834.314,
"speed": 1.0,
"slot": [
827.794,
834.314
],
"text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。"
},
{
"no": 141,
"start": 834.714,
"end": 841.934,
"speed": 1.0,
"slot": [
834.714,
841.934
],
"text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。"
},
{
"no": 142,
"start": 842.734,
"end": 845.154,
"speed": 1.0,
"slot": [
842.734,
845.154
],
"text": "そこで、まるロボは考えました。"
},
{
"no": 143,
"start": 845.554,
"end": 850.744,
"speed": 1.0,
"slot": [
845.554,
850.744
],
"text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。"
},
{
"no": 144,
"start": 851.144,
"end": 857.364,
"speed": 1.0,
"slot": [
851.144,
857.364
],
"text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！"
},
{
"no": 145,
"start": 857.764,
"end": 860.354,
"speed": 1.0,
"slot": [
857.764,
860.354
],
"text": "さっそく、いろは歌を打ってみると……。"
},
{
"no": 146,
"start": 862.954,
"end": 866.574,
"speed": 1.0,
"slot": [
862.954,
866.574
],
"text": "跳ねる距離は、クワーティの7分の1になりました。"
},
{
"no": 147,
"start": 866.974,
"end": 874.804,
"speed": 1.0,
"slot": [
866.974,
874.804
],
"text": "でも、カメラを引いてみると……横にとても長いキーボードで、キーは「い ろ は」の順に1列。"
},
{
"no": 148,
"start": 876.004,
"end": 881.944,
"speed": 1.0,
"slot": [
876.004,
881.944
],
"text": "これは、いろは歌を打つときだけ速い、いろは歌専用のキーボードだったのです。"
},
{
"no": 149,
"start": 882.844,
"end": 887.134,
"speed": 1.0,
"slot": [
882.844,
887.134
],
"text": "……まるロボの並びも、誰にも使ってもらえなかったようです。"
}
]