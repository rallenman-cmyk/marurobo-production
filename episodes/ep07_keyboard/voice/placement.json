[
{
"no": 1,
"start": 0.5,
"end": 6.72,
"speed": 1.0,
"slot": [
0.5,
6.72
],
"text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。"
},
{
"no": 2,
"start": 7.12,
"end": 9.71,
"speed": 1.0,
"slot": [
7.12,
9.71
],
"text": "でも、まるロボには腕がありません。"
},
{
"no": 3,
"start": 10.11,
"end": 13.24,
"speed": 1.0,
"slot": [
10.11,
13.24
],
"text": "なので、キーボードは跳ねて乗って打つのです。"
},
{
"no": 4,
"start": 13.64,
"end": 17.84,
"speed": 1.0,
"slot": [
13.64,
17.84
],
"text": "ぴょん、カタッ。これで「A」の出来上がり。"
},
{
"no": 5,
"start": 18.64,
"end": 22.92,
"speed": 1.0,
"slot": [
18.64,
22.92
],
"text": "次は「B」。A の次ですから、すぐとなりに……。"
},
{
"no": 6,
"start": 23.52,
"end": 27.07,
"speed": 1.0,
"slot": [
23.52,
27.07
],
"text": "あれ？　となりにあるのは「S」です。"
},
{
"no": 7,
"start": 27.47,
"end": 30.04,
"speed": 1.0,
"slot": [
27.47,
30.04
],
"text": "反対側には、何もありません。"
},
{
"no": 8,
"start": 30.44,
"end": 35.22,
"speed": 1.0,
"slot": [
30.44,
35.22
],
"text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。"
},
{
"no": 9,
"start": 36.12,
"end": 43.97,
"speed": 1.0,
"slot": [
36.12,
43.97
],
"text": "上から見ると、左上は Q W E R T Y。"
},
{
"no": 10,
"start": 44.37,
"end": 50.08,
"speed": 1.0,
"slot": [
44.37,
50.08
],
"text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。"
},
{
"no": 11,
"start": 50.48,
"end": 54.8,
"speed": 1.0,
"slot": [
50.48,
54.8
],
"text": "毎日さわるキーボードは、ABC 順に並んでいません。"
},
{
"no": 12,
"start": 55.2,
"end": 60.1,
"speed": 1.0,
"slot": [
55.2,
60.1
],
"text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？"
},
{
"no": 13,
"start": 60.7,
"end": 65.19,
"speed": 1.0,
"slot": [
60.7,
65.19
],
"text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。"
},
{
"no": 14,
"start": 67.99,
"end": 71.07,
"speed": 1.0,
"slot": [
67.99,
71.07
],
"text": "まるロボにとって大事なのは、跳ねる距離です。"
},
{
"no": 15,
"start": 71.47,
"end": 75.872,
"speed": 1.0,
"slot": [
71.47,
75.872
],
"text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。"
},
{
"no": 16,
"start": 76.272,
"end": 81.698,
"speed": 1.0,
"slot": [
76.272,
81.698
],
"text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。"
},
{
"no": 17,
"start": 82.098,
"end": 87.108,
"speed": 1.0,
"slot": [
82.098,
87.108
],
"text": "キーの数も形も同じで、並びだけが ABC 順です。"
},
{
"no": 18,
"start": 87.908,
"end": 92.628,
"speed": 1.0,
"slot": [
87.908,
92.628
],
"text": "では、同じ言葉を、2つのキーボードで打ってみましょう。"
},
{
"no": 19,
"start": 93.028,
"end": 96.418,
"speed": 1.0,
"slot": [
93.028,
96.418
],
"text": "打つのは、自分の名前の「マルロボ」。"
},
{
"no": 20,
"start": 96.818,
"end": 104.339,
"speed": 1.0,
"slot": [
96.818,
104.339
],
"text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。"
},
{
"no": 21,
"start": 104.739,
"end": 111.529,
"speed": 1.0,
"slot": [
104.739,
111.529
],
"text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。"
},
{
"no": 22,
"start": 112.529,
"end": 119.399,
"speed": 1.0,
"slot": [
112.529,
119.399
],
"text": "次は、ABC 順の並びです。こちらは橙の線で残しました。"
},
{
"no": 150,
"start": 119.799,
"end": 130.573,
"speed": 1.0,
"slot": [
119.799,
130.573
],
"text": "M、A、R、U、R、O、B……最後の O まで、ぴょん。打てました。"
},
{
"no": 23,
"start": 131.673,
"end": 135.323,
"speed": 1.0,
"slot": [
131.673,
135.323
],
"text": "跳ねた距離を、キーの数で測ってみると……。"
},
{
"no": 24,
"start": 135.923,
"end": 138.873,
"speed": 1.0,
"slot": [
135.923,
138.873
],
"text": "クワーティが、キー28個分。"
},
{
"no": 25,
"start": 139.273,
"end": 142.683,
"speed": 1.0,
"slot": [
139.273,
142.683
],
"text": "ABC 順が、キー31個分。"
},
{
"no": 26,
"start": 143.083,
"end": 145.973,
"speed": 1.0,
"slot": [
143.083,
145.973
],
"text": "あれ？　ほとんど、変わりません。"
},
{
"no": 27,
"start": 146.773,
"end": 151.803,
"speed": 1.0,
"slot": [
146.773,
151.803
],
"text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。"
},
{
"no": 28,
"start": 152.203,
"end": 155.873,
"speed": 1.0,
"slot": [
152.203,
155.873
],
"text": "打つのは、「いろはにほへと」で始まる、いろは歌。"
},
{
"no": 29,
"start": 156.273,
"end": 161.976,
"speed": 1.0,
"slot": [
156.273,
161.976
],
"text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。"
},
{
"no": 30,
"start": 162.876,
"end": 171.316,
"speed": 1.0,
"slot": [
162.876,
171.316
],
"text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。"
},
{
"no": 31,
"start": 171.716,
"end": 176.608,
"speed": 1.0,
"slot": [
171.716,
176.608
],
"text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。"
},
{
"no": 32,
"start": 177.008,
"end": 184.618,
"speed": 1.0,
"slot": [
177.008,
184.618
],
"text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。"
},
{
"no": 33,
"start": 185.018,
"end": 191.198,
"speed": 1.0,
"slot": [
185.018,
191.198
],
"text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。"
},
{
"no": 34,
"start": 191.598,
"end": 197.048,
"speed": 1.0,
"slot": [
191.598,
197.048
],
"text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。"
},
{
"no": 35,
"start": 197.448,
"end": 201.528,
"speed": 1.0,
"slot": [
197.448,
201.528
],
"text": "では、いったい何のために、この順番になったのか……。"
},
{
"no": 36,
"start": 202.128,
"end": 206.827,
"speed": 1.0,
"slot": [
202.128,
206.827
],
"text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。"
},
{
"no": 37,
"start": 207.727,
"end": 214.907,
"speed": 1.0,
"slot": [
207.727,
214.907
],
"text": "時は、1868年。今から150年ほど前の、アメリカです。"
},
{
"no": 38,
"start": 215.307,
"end": 221.827,
"speed": 1.0,
"slot": [
215.307,
221.827
],
"text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。"
},
{
"no": 39,
"start": 222.227,
"end": 227.947,
"speed": 1.0,
"slot": [
222.227,
227.947
],
"text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。"
},
{
"no": 40,
"start": 228.947,
"end": 232.531,
"speed": 1.0,
"slot": [
228.947,
232.531
],
"text": "おや？　このキーボード、よく見ると……。"
},
{
"no": 41,
"start": 233.131,
"end": 236.201,
"speed": 1.0,
"slot": [
233.131,
236.201
],
"text": "まるで、ピアノの鍵盤のような形をしています。"
},
{
"no": 42,
"start": 236.601,
"end": 241.316,
"speed": 1.0,
"slot": [
236.601,
241.316
],
"text": "そして並びは……なんと、ABC 順だったのです。"
},
{
"no": 43,
"start": 241.716,
"end": 245.846,
"speed": 1.0,
"slot": [
241.716,
245.846
],
"text": "手前の列は、A から N まで、左から右へ。"
},
{
"no": 44,
"start": 246.246,
"end": 251.676,
"speed": 1.0,
"slot": [
246.246,
251.676
],
"text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。"
},
{
"no": 45,
"start": 252.476,
"end": 256.746,
"speed": 1.0,
"slot": [
252.476,
256.746
],
"text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。"
},
{
"no": 46,
"start": 257.146,
"end": 261.966,
"speed": 1.0,
"slot": [
257.146,
261.966
],
"text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。"
},
{
"no": 47,
"start": 262.366,
"end": 266.587,
"speed": 1.0,
"slot": [
262.366,
266.587
],
"text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。"
},
{
"no": 48,
"start": 266.987,
"end": 274.547,
"speed": 1.0,
"slot": [
266.987,
274.547
],
"text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。"
},
{
"no": 49,
"start": 275.147,
"end": 284.057,
"speed": 1.0,
"slot": [
275.147,
284.057
],
"text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。"
},
{
"no": 50,
"start": 284.457,
"end": 290.873,
"speed": 1.0,
"slot": [
284.457,
290.873
],
"text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。"
},
{
"no": 51,
"start": 291.673,
"end": 300.323,
"speed": 1.0,
"slot": [
291.673,
300.323
],
"text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。"
},
{
"no": 52,
"start": 301.323,
"end": 306.473,
"speed": 1.0,
"slot": [
301.323,
306.473
],
"text": "その会社でピリオドが外され、そこに R が入りました。"
},
{
"no": 53,
"start": 306.873,
"end": 311.173,
"speed": 1.0,
"slot": [
306.873,
311.173
],
"text": "こうして、冒頭で見たクワーティの並びが、そろったのです。"
},
{
"no": 54,
"start": 311.973,
"end": 316.163,
"speed": 1.0,
"slot": [
311.973,
316.163
],
"text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？"
},
{
"no": 55,
"start": 316.763,
"end": 321.293,
"speed": 1.0,
"slot": [
316.763,
321.293
],
"text": "実は、作った人たちは、その理由を書き残していません。"
},
{
"no": 56,
"start": 321.693,
"end": 325.833,
"speed": 1.0,
"slot": [
321.693,
325.833
],
"text": "そこで、昔からよく言われてきた説があります。"
},
{
"no": 57,
"start": 326.833,
"end": 333.013,
"speed": 1.0,
"slot": [
326.833,
333.013
],
"text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。"
},
{
"no": 58,
"start": 333.413,
"end": 338.515,
"speed": 1.0,
"slot": [
333.413,
338.515
],
"text": "キーの奥には、細い棒がずらりと、円く並んでいます。"
},
{
"no": 59,
"start": 338.915,
"end": 343.905,
"speed": 1.0,
"slot": [
338.915,
343.905
],
"text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。"
},
{
"no": 60,
"start": 344.705,
"end": 348.995,
"speed": 1.0,
"slot": [
344.705,
348.995
],
"text": "もし、となり合う2本の棒が、続けて上がると……。"
},
{
"no": 61,
"start": 349.795,
"end": 352.995,
"speed": 1.0,
"slot": [
349.795,
352.995
],
"text": "途中でぶつかって、からまってしまいました。"
},
{
"no": 62,
"start": 353.395,
"end": 355.815,
"speed": 1.0,
"slot": [
353.395,
355.815
],
"text": "よく言われるのは、こんな説です。"
},
{
"no": 63,
"start": 356.615,
"end": 361.641,
"speed": 1.0,
"slot": [
356.615,
361.641
],
"text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。"
},
{
"no": 64,
"start": 362.191,
"end": 365.861,
"speed": 1.0,
"slot": [
362.191,
365.861
],
"text": "なるほど、と思いますよね。ところが……。"
},
{
"no": 65,
"start": 367.161,
"end": 370.251,
"speed": 1.0,
"slot": [
367.161,
370.251
],
"text": "この説には、はっきりした証拠がありません。"
},
{
"no": 66,
"start": 370.651,
"end": 375.541,
"speed": 1.0,
"slot": [
370.651,
375.541
],
"text": "まず、理由を書いた記録が、どこにも残っていないのです。"
},
{
"no": 67,
"start": 375.941,
"end": 380.351,
"speed": 1.0,
"slot": [
375.941,
380.351
],
"text": "それに、英語でとてもよく続く「E」と「R」。"
},
{
"no": 68,
"start": 380.751,
"end": 386.721,
"speed": 1.0,
"slot": [
380.751,
386.721
],
"text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。"
},
{
"no": 69,
"start": 387.121,
"end": 390.151,
"speed": 1.0,
"slot": [
387.121,
390.151
],
"text": "からまないように離したのなら、おかしいですね。"
},
{
"no": 70,
"start": 390.951,
"end": 393.401,
"speed": 1.0,
"slot": [
390.951,
393.401
],
"text": "また、こんな話もよく聞きます。"
},
{
"no": 71,
"start": 393.801,
"end": 400.191,
"speed": 1.0,
"slot": [
393.801,
400.191
],
"text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。"
},
{
"no": 72,
"start": 400.591,
"end": 406.311,
"speed": 1.0,
"slot": [
400.591,
406.311
],
"text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。"
},
{
"no": 73,
"start": 407.311,
"end": 413.071,
"speed": 1.0,
"slot": [
407.311,
413.071
],
"text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。"
},
{
"no": 74,
"start": 413.471,
"end": 418.351,
"speed": 1.0,
"slot": [
413.471,
418.351
],
"text": "この機械は、手で書くより速く打つために作られたはずですよね。"
},
{
"no": 75,
"start": 418.751,
"end": 423.453,
"speed": 1.0,
"slot": [
418.751,
423.453
],
"text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。"
},
{
"no": 76,
"start": 423.853,
"end": 429.053,
"speed": 1.0,
"slot": [
423.853,
429.053
],
"text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。"
},
{
"no": 77,
"start": 429.453,
"end": 434.653,
"speed": 1.0,
"slot": [
429.453,
434.653
],
"text": "この「わざと遅く」の話は、今では研究者に否定されています。"
},
{
"no": 78,
"start": 435.053,
"end": 438.523,
"speed": 1.0,
"slot": [
435.053,
438.523
],
"text": "からまない工夫が、少しはあったのかもしれません。"
},
{
"no": 79,
"start": 438.923,
"end": 443.033,
"speed": 1.0,
"slot": [
438.923,
443.033
],
"text": "でも、それだけでクワーティの並びになったとは、言えないのです。"
},
{
"no": 80,
"start": 443.833,
"end": 446.983,
"speed": 1.0,
"slot": [
443.833,
446.983
],
"text": "では、本当の理由は何だったのでしょうか？"
},
{
"no": 81,
"start": 447.583,
"end": 454.993,
"speed": 1.0,
"slot": [
447.583,
454.993
],
"text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。"
},
{
"no": 82,
"start": 455.393,
"end": 459.903,
"speed": 1.0,
"slot": [
455.393,
459.903
],
"text": "手がかりは、最初にこの機械を買った、お客さんです。"
},
{
"no": 83,
"start": 460.903,
"end": 464.703,
"speed": 1.0,
"slot": [
460.903,
464.703
],
"text": "それは、電信という仕事をしている人たちでした。"
},
{
"no": 84,
"start": 465.103,
"end": 470.673,
"speed": 1.0,
"slot": [
465.103,
470.673
],
"text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。"
},
{
"no": 85,
"start": 471.473,
"end": 477.663,
"speed": 1.0,
"slot": [
471.473,
477.663
],
"text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。"
},
{
"no": 86,
"start": 478.063,
"end": 484.685,
"speed": 1.0,
"slot": [
478.063,
484.685
],
"text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。"
},
{
"no": 87,
"start": 485.085,
"end": 491.121,
"speed": 1.0,
"slot": [
485.085,
491.121
],
"text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。"
},
{
"no": 88,
"start": 491.521,
"end": 498.581,
"speed": 1.0,
"slot": [
491.521,
498.581
],
"text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。"
},
{
"no": 89,
"start": 498.981,
"end": 505.661,
"speed": 1.0,
"slot": [
498.981,
505.661
],
"text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。"
},
{
"no": 90,
"start": 506.061,
"end": 510.231,
"speed": 1.0,
"slot": [
506.061,
510.231
],
"text": "先生は、なんと「もっと速く！」と声をかけたそうです。"
},
{
"no": 91,
"start": 510.631,
"end": 517.231,
"speed": 1.0,
"slot": [
510.631,
517.231
],
"text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。"
},
{
"no": 92,
"start": 518.031,
"end": 521.881,
"speed": 1.0,
"slot": [
518.031,
521.881
],
"text": "では、当時のアメリカのモールス信号を聞いてみましょう。"
},
{
"no": 93,
"start": 522.781,
"end": 528.711,
"speed": 1.0,
"slot": [
522.781,
528.711
],
"text": "まずは「Z」。トントントン、少しあけて、トン。"
},
{
"no": 94,
"start": 529.111,
"end": 532.921,
"speed": 1.0,
"slot": [
529.111,
532.921
],
"text": "そして次に、「S」と「E」を続けた音。"
},
{
"no": 95,
"start": 533.721,
"end": 541.361,
"speed": 1.0,
"slot": [
533.721,
541.361
],
"text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。"
},
{
"no": 96,
"start": 541.761,
"end": 546.941,
"speed": 1.0,
"slot": [
541.761,
546.941
],
"text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。"
},
{
"no": 97,
"start": 547.741,
"end": 554.537,
"speed": 1.0,
"slot": [
547.741,
554.537
],
"text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。"
},
{
"no": 98,
"start": 554.937,
"end": 561.917,
"speed": 1.0,
"slot": [
554.937,
561.917
],
"text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。"
},
{
"no": 99,
"start": 562.317,
"end": 565.827,
"speed": 1.0,
"slot": [
562.317,
565.827
],
"text": "今のキーボードで、この3つを光らせてみると……。"
},
{
"no": 100,
"start": 566.427,
"end": 573.597,
"speed": 1.0,
"slot": [
566.427,
573.597
],
"text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。"
},
{
"no": 101,
"start": 573.997,
"end": 580.267,
"speed": 1.0,
"slot": [
573.997,
580.267
],
"text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。"
},
{
"no": 102,
"start": 581.067,
"end": 586.267,
"speed": 1.0,
"slot": [
581.067,
586.267
],
"text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。"
},
{
"no": 103,
"start": 586.667,
"end": 593.507,
"speed": 1.0,
"slot": [
586.667,
593.507
],
"text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。"
},
{
"no": 104,
"start": 593.907,
"end": 597.027,
"speed": 1.0,
"slot": [
593.907,
597.027
],
"text": "しかも、ふしぎなことが、もう1つあります。"
},
{
"no": 105,
"start": 597.427,
"end": 605.017,
"speed": 1.0,
"slot": [
597.427,
605.017
],
"text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。"
},
{
"no": 106,
"start": 605.417,
"end": 614.987,
"speed": 1.0,
"slot": [
605.417,
614.987
],
"text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。"
},
{
"no": 107,
"start": 615.387,
"end": 620.527,
"speed": 1.0,
"slot": [
615.387,
620.527
],
"text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。"
},
{
"no": 108,
"start": 620.927,
"end": 628.187,
"speed": 1.0,
"slot": [
620.927,
628.187
],
"text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。"
},
{
"no": 109,
"start": 628.987,
"end": 630.517,
"speed": 1.0,
"slot": [
628.987,
630.517
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 110,
"start": 631.067,
"end": 636.327,
"speed": 1.0,
"slot": [
631.067,
636.327
],
"text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？"
},
{
"no": 111,
"start": 636.927,
"end": 642.512,
"speed": 1.0,
"slot": [
636.927,
642.512
],
"text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。"
},
{
"no": 112,
"start": 643.312,
"end": 649.978,
"speed": 1.0,
"slot": [
643.312,
649.978
],
"text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。"
},
{
"no": 113,
"start": 650.378,
"end": 657.258,
"speed": 1.0,
"slot": [
650.378,
657.258
],
"text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。"
},
{
"no": 114,
"start": 657.658,
"end": 664.968,
"speed": 1.0,
"slot": [
657.658,
664.968
],
"text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。"
},
{
"no": 115,
"start": 665.368,
"end": 672.898,
"speed": 1.0,
"slot": [
665.368,
672.898
],
"text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。"
},
{
"no": 116,
"start": 673.298,
"end": 681.308,
"speed": 1.0,
"slot": [
673.298,
681.308
],
"text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。"
},
{
"no": 117,
"start": 681.708,
"end": 690.3,
"speed": 1.0,
"slot": [
681.708,
690.3
],
"text": "そして1893年、アメリカの大きなタイプライターの5つの会社が、1つにまとまりました。"
},
{
"no": 118,
"start": 691.7,
"end": 697.02,
"speed": 1.0,
"slot": [
691.7,
697.02
],
"text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。"
},
{
"no": 119,
"start": 697.42,
"end": 703.3,
"speed": 1.0,
"slot": [
697.42,
703.3
],
"text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。"
},
{
"no": 120,
"start": 704.1,
"end": 708.16,
"speed": 1.0,
"slot": [
704.1,
708.16
],
"text": "では、もっと良い並びは、作られなかったのでしょうか？"
},
{
"no": 121,
"start": 708.76,
"end": 717.19,
"speed": 1.0,
"slot": [
708.76,
717.19
],
"text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。"
},
{
"no": 122,
"start": 717.59,
"end": 721.83,
"speed": 1.0,
"slot": [
717.59,
721.83
],
"text": "よく使う字を、指を置く真ん中の列に集めた並びです。"
},
{
"no": 123,
"start": 722.23,
"end": 725.944,
"speed": 1.0,
"slot": [
722.23,
725.944
],
"text": "「クワーティより、ずっと速く打てる」。そう言われていました。"
},
{
"no": 124,
"start": 726.744,
"end": 732.544,
"speed": 1.0,
"slot": [
726.744,
732.544
],
"text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。"
},
{
"no": 125,
"start": 732.944,
"end": 740.054,
"speed": 1.0,
"slot": [
732.944,
740.054
],
"text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。"
},
{
"no": 126,
"start": 740.454,
"end": 745.894,
"speed": 1.0,
"slot": [
740.454,
745.894
],
"text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。"
},
{
"no": 127,
"start": 746.694,
"end": 751.504,
"speed": 1.0,
"slot": [
746.694,
751.504
],
"text": "それに、もし本当に速かったとしても、問題があります。"
},
{
"no": 128,
"start": 751.904,
"end": 757.674,
"speed": 1.0,
"slot": [
751.904,
757.674
],
"text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。"
},
{
"no": 129,
"start": 758.074,
"end": 762.894,
"speed": 1.0,
"slot": [
758.074,
762.894
],
"text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。"
},
{
"no": 130,
"start": 763.294,
"end": 768.014,
"speed": 1.0,
"slot": [
763.294,
768.014
],
"text": "もし明日、全部の並びが変わったら、どうなるでしょう？"
},
{
"no": 131,
"start": 769.014,
"end": 773.264,
"speed": 1.0,
"slot": [
769.014,
773.264
],
"text": "打つたびにキーを探して、指が止まってしまいますね。"
},
{
"no": 132,
"start": 773.664,
"end": 780.184,
"speed": 1.0,
"slot": [
773.664,
780.184
],
"text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。"
},
{
"no": 133,
"start": 780.584,
"end": 785.854,
"speed": 1.0,
"slot": [
780.584,
785.854
],
"text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。"
},
{
"no": 134,
"start": 786.254,
"end": 791.434,
"speed": 1.0,
"slot": [
786.254,
791.434
],
"text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。"
},
{
"no": 135,
"start": 791.834,
"end": 796.914,
"speed": 1.0,
"slot": [
791.834,
796.914
],
"text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。"
},
{
"no": 136,
"start": 797.714,
"end": 800.334,
"speed": 1.0,
"slot": [
797.714,
800.334
],
"text": "では、最初の問いに戻ります。"
},
{
"no": 137,
"start": 800.734,
"end": 804.734,
"speed": 1.0,
"slot": [
800.734,
804.734
],
"text": "キーボードは、なぜ ABC 順に並んでいないのか。"
},
{
"no": 138,
"start": 805.134,
"end": 813.424,
"speed": 1.0,
"slot": [
805.134,
813.424
],
"text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。"
},
{
"no": 139,
"start": 813.824,
"end": 818.384,
"speed": 1.0,
"slot": [
813.824,
818.384
],
"text": "ただ、どんな都合だったのかは、今もはっきりしていません。"
},
{
"no": 140,
"start": 818.784,
"end": 825.304,
"speed": 1.0,
"slot": [
818.784,
825.304
],
"text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。"
},
{
"no": 141,
"start": 825.704,
"end": 832.924,
"speed": 1.0,
"slot": [
825.704,
832.924
],
"text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。"
},
{
"no": 142,
"start": 833.724,
"end": 836.144,
"speed": 1.0,
"slot": [
833.724,
836.144
],
"text": "そこで、まるロボは考えました。"
},
{
"no": 143,
"start": 836.544,
"end": 841.734,
"speed": 1.0,
"slot": [
836.544,
841.734
],
"text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。"
},
{
"no": 144,
"start": 842.134,
"end": 848.354,
"speed": 1.0,
"slot": [
842.134,
848.354
],
"text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！"
},
{
"no": 145,
"start": 848.754,
"end": 851.344,
"speed": 1.0,
"slot": [
848.754,
851.344
],
"text": "さっそく、いろは歌を打ってみると……。"
},
{
"no": 146,
"start": 853.944,
"end": 857.564,
"speed": 1.0,
"slot": [
853.944,
857.564
],
"text": "跳ねる距離は、クワーティの7分の1になりました。"
},
{
"no": 147,
"start": 857.964,
"end": 865.794,
"speed": 1.0,
"slot": [
857.964,
865.794
],
"text": "でも、カメラを引いてみると……横にとても長いキーボードで、キーは「い ろ は」の順に1列。"
},
{
"no": 148,
"start": 866.994,
"end": 872.934,
"speed": 1.0,
"slot": [
866.994,
872.934
],
"text": "これは、いろは歌を打つときだけ速い、いろは歌専用のキーボードだったのです。"
},
{
"no": 149,
"start": 873.834,
"end": 878.124,
"speed": 1.0,
"slot": [
873.834,
878.124
],
"text": "……まるロボの並びも、誰にも使ってもらえなかったようです。"
}
]