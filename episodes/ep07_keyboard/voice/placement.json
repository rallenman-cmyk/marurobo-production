[
{
"no": 1,
"start": 0.5,
"end": 6.72,
"speed": 1.0,
"slot": [
0.5,
6.72
],
"text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。"
},
{
"no": 2,
"start": 7.12,
"end": 9.71,
"speed": 1.0,
"slot": [
7.12,
9.71
],
"text": "でも、まるロボには腕がありません。"
},
{
"no": 3,
"start": 10.11,
"end": 13.24,
"speed": 1.0,
"slot": [
10.11,
13.24
],
"text": "なので、キーボードは跳ねて乗って打つのです。"
},
{
"no": 4,
"start": 13.64,
"end": 17.84,
"speed": 1.0,
"slot": [
13.64,
17.84
],
"text": "ぴょん、カタッ。これで「A」の出来上がり。"
},
{
"no": 5,
"start": 18.64,
"end": 22.92,
"speed": 1.0,
"slot": [
18.64,
22.92
],
"text": "次は「B」。A の次ですから、すぐとなりに……。"
},
{
"no": 6,
"start": 23.52,
"end": 27.07,
"speed": 1.0,
"slot": [
23.52,
27.07
],
"text": "あれ？　となりにあるのは「S」です。"
},
{
"no": 7,
"start": 27.47,
"end": 30.04,
"speed": 1.0,
"slot": [
27.47,
30.04
],
"text": "反対側には、何もありません。"
},
{
"no": 8,
"start": 30.44,
"end": 35.22,
"speed": 1.0,
"slot": [
30.44,
35.22
],
"text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。"
},
{
"no": 9,
"start": 36.12,
"end": 43.97,
"speed": 1.0,
"slot": [
36.12,
43.97
],
"text": "上から見ると、左上は Q W E R T Y。"
},
{
"no": 10,
"start": 44.37,
"end": 50.08,
"speed": 1.0,
"slot": [
44.37,
50.08
],
"text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。"
},
{
"no": 11,
"start": 50.48,
"end": 54.8,
"speed": 1.0,
"slot": [
50.48,
54.8
],
"text": "毎日さわるキーボードは、ABC 順に並んでいません。"
},
{
"no": 12,
"start": 55.2,
"end": 60.1,
"speed": 1.0,
"slot": [
55.2,
60.1
],
"text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？"
},
{
"no": 13,
"start": 60.7,
"end": 65.19,
"speed": 1.0,
"slot": [
60.7,
65.19
],
"text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。"
},
{
"no": 14,
"start": 67.99,
"end": 71.07,
"speed": 1.0,
"slot": [
67.99,
71.07
],
"text": "まるロボにとって大事なのは、跳ねる距離です。"
},
{
"no": 15,
"start": 71.47,
"end": 76.196,
"speed": 1.0,
"slot": [
71.47,
76.196
],
"text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。"
},
{
"no": 16,
"start": 76.596,
"end": 82.022,
"speed": 1.0,
"slot": [
76.596,
82.022
],
"text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。"
},
{
"no": 17,
"start": 82.422,
"end": 87.432,
"speed": 1.0,
"slot": [
82.422,
87.432
],
"text": "キーの数も形も同じで、並びだけが ABC 順です。"
},
{
"no": 18,
"start": 88.232,
"end": 92.952,
"speed": 1.0,
"slot": [
88.232,
92.952
],
"text": "では、同じ言葉を、2つのキーボードで打ってみましょう。"
},
{
"no": 19,
"start": 93.352,
"end": 96.742,
"speed": 1.0,
"slot": [
93.352,
96.742
],
"text": "打つのは、自分の名前の「マルロボ」。"
},
{
"no": 20,
"start": 97.142,
"end": 104.663,
"speed": 1.0,
"slot": [
97.142,
104.663
],
"text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。"
},
{
"no": 21,
"start": 105.063,
"end": 111.853,
"speed": 1.0,
"slot": [
105.063,
111.853
],
"text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。"
},
{
"no": 22,
"start": 112.853,
"end": 119.723,
"speed": 1.0,
"slot": [
112.853,
119.723
],
"text": "次は、ABC 順の並びです。こちらは橙の線で残しました。"
},
{
"no": 23,
"start": 120.823,
"end": 124.473,
"speed": 1.0,
"slot": [
120.823,
124.473
],
"text": "跳ねた距離を、キーの数で測ってみると……。"
},
{
"no": 24,
"start": 125.073,
"end": 128.023,
"speed": 1.0,
"slot": [
125.073,
128.023
],
"text": "クワーティが、キー28個分。"
},
{
"no": 25,
"start": 128.423,
"end": 131.833,
"speed": 1.0,
"slot": [
128.423,
131.833
],
"text": "ABC 順が、キー31個分。"
},
{
"no": 26,
"start": 132.233,
"end": 135.123,
"speed": 1.0,
"slot": [
132.233,
135.123
],
"text": "あれ？　ほとんど、変わりません。"
},
{
"no": 27,
"start": 135.923,
"end": 141.023,
"speed": 1.0,
"slot": [
135.923,
141.023
],
"text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。"
},
{
"no": 28,
"start": 141.423,
"end": 145.093,
"speed": 1.0,
"slot": [
141.423,
145.093
],
"text": "打つのは、「いろはにほへと」で始まる、いろは歌。"
},
{
"no": 29,
"start": 145.493,
"end": 151.196,
"speed": 1.0,
"slot": [
145.493,
151.196
],
"text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。"
},
{
"no": 30,
"start": 152.096,
"end": 160.536,
"speed": 1.0,
"slot": [
152.096,
160.536
],
"text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。"
},
{
"no": 31,
"start": 160.936,
"end": 165.828,
"speed": 1.0,
"slot": [
160.936,
165.828
],
"text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。"
},
{
"no": 32,
"start": 166.228,
"end": 173.998,
"speed": 1.0,
"slot": [
166.228,
173.998
],
"text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。"
},
{
"no": 33,
"start": 174.398,
"end": 180.578,
"speed": 1.0,
"slot": [
174.398,
180.578
],
"text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。"
},
{
"no": 34,
"start": 180.978,
"end": 186.688,
"speed": 1.0,
"slot": [
180.978,
186.688
],
"text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。"
},
{
"no": 35,
"start": 187.088,
"end": 191.168,
"speed": 1.0,
"slot": [
187.088,
191.168
],
"text": "では、いったい何のために、この順番になったのか……。"
},
{
"no": 36,
"start": 191.768,
"end": 196.467,
"speed": 1.0,
"slot": [
191.768,
196.467
],
"text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。"
},
{
"no": 37,
"start": 197.367,
"end": 204.547,
"speed": 1.0,
"slot": [
197.367,
204.547
],
"text": "時は、1868年。今から150年ほど前の、アメリカです。"
},
{
"no": 38,
"start": 204.947,
"end": 211.467,
"speed": 1.0,
"slot": [
204.947,
211.467
],
"text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。"
},
{
"no": 39,
"start": 211.867,
"end": 217.587,
"speed": 1.0,
"slot": [
211.867,
217.587
],
"text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。"
},
{
"no": 40,
"start": 218.587,
"end": 221.97,
"speed": 1.0,
"slot": [
218.587,
221.97
],
"text": "おや？　このキーボード、よく見ると……。"
},
{
"no": 41,
"start": 222.57,
"end": 225.64,
"speed": 1.0,
"slot": [
222.57,
225.64
],
"text": "まるで、ピアノの鍵盤のような形をしています。"
},
{
"no": 42,
"start": 226.04,
"end": 230.755,
"speed": 1.0,
"slot": [
226.04,
230.755
],
"text": "そして並びは……なんと、ABC 順だったのです。"
},
{
"no": 43,
"start": 231.155,
"end": 235.285,
"speed": 1.0,
"slot": [
231.155,
235.285
],
"text": "手前の列は、A から N まで、左から右へ。"
},
{
"no": 44,
"start": 235.685,
"end": 241.115,
"speed": 1.0,
"slot": [
235.685,
241.115
],
"text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。"
},
{
"no": 45,
"start": 241.915,
"end": 246.275,
"speed": 1.0,
"slot": [
241.915,
246.275
],
"text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。"
},
{
"no": 46,
"start": 246.675,
"end": 251.495,
"speed": 1.0,
"slot": [
246.675,
251.495
],
"text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。"
},
{
"no": 47,
"start": 251.895,
"end": 256.116,
"speed": 1.0,
"slot": [
251.895,
256.116
],
"text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。"
},
{
"no": 48,
"start": 256.516,
"end": 264.076,
"speed": 1.0,
"slot": [
256.516,
264.076
],
"text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。"
},
{
"no": 49,
"start": 264.676,
"end": 273.586,
"speed": 1.0,
"slot": [
264.676,
273.586
],
"text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。"
},
{
"no": 50,
"start": 273.986,
"end": 280.472,
"speed": 1.0,
"slot": [
273.986,
280.472
],
"text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。"
},
{
"no": 51,
"start": 281.272,
"end": 289.922,
"speed": 1.0,
"slot": [
281.272,
289.922
],
"text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。"
},
{
"no": 52,
"start": 290.922,
"end": 296.072,
"speed": 1.0,
"slot": [
290.922,
296.072
],
"text": "その会社でピリオドが外され、そこに R が入りました。"
},
{
"no": 53,
"start": 296.472,
"end": 300.772,
"speed": 1.0,
"slot": [
296.472,
300.772
],
"text": "こうして、冒頭で見たクワーティの並びが、そろったのです。"
},
{
"no": 54,
"start": 301.572,
"end": 305.762,
"speed": 1.0,
"slot": [
301.572,
305.762
],
"text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？"
},
{
"no": 55,
"start": 306.362,
"end": 310.892,
"speed": 1.0,
"slot": [
306.362,
310.892
],
"text": "実は、作った人たちは、その理由を書き残していません。"
},
{
"no": 56,
"start": 311.292,
"end": 315.432,
"speed": 1.0,
"slot": [
311.292,
315.432
],
"text": "そこで、昔からよく言われてきた説があります。"
},
{
"no": 57,
"start": 316.432,
"end": 322.612,
"speed": 1.0,
"slot": [
316.432,
322.612
],
"text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。"
},
{
"no": 58,
"start": 323.012,
"end": 328.114,
"speed": 1.0,
"slot": [
323.012,
328.114
],
"text": "キーの奥には、細い棒がずらりと、円く並んでいます。"
},
{
"no": 59,
"start": 328.514,
"end": 333.504,
"speed": 1.0,
"slot": [
328.514,
333.504
],
"text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。"
},
{
"no": 60,
"start": 334.304,
"end": 338.594,
"speed": 1.0,
"slot": [
334.304,
338.594
],
"text": "もし、となり合う2本の棒が、続けて上がると……。"
},
{
"no": 61,
"start": 339.394,
"end": 342.594,
"speed": 1.0,
"slot": [
339.394,
342.594
],
"text": "途中でぶつかって、からまってしまいました。"
},
{
"no": 62,
"start": 342.994,
"end": 345.414,
"speed": 1.0,
"slot": [
342.994,
345.414
],
"text": "よく言われるのは、こんな説です。"
},
{
"no": 63,
"start": 346.214,
"end": 351.24,
"speed": 1.0,
"slot": [
346.214,
351.24
],
"text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。"
},
{
"no": 64,
"start": 351.64,
"end": 355.31,
"speed": 1.0,
"slot": [
351.64,
355.31
],
"text": "なるほど、と思いますよね。ところが……。"
},
{
"no": 65,
"start": 356.11,
"end": 359.29,
"speed": 1.0,
"slot": [
356.11,
359.29
],
"text": "この説には、はっきりした証拠がありません。"
},
{
"no": 66,
"start": 359.69,
"end": 364.58,
"speed": 1.0,
"slot": [
359.69,
364.58
],
"text": "まず、理由を書いた記録が、どこにも残っていないのです。"
},
{
"no": 67,
"start": 364.98,
"end": 369.39,
"speed": 1.0,
"slot": [
364.98,
369.39
],
"text": "それに、英語でとてもよく続く「E」と「R」。"
},
{
"no": 68,
"start": 369.79,
"end": 375.84,
"speed": 1.0,
"slot": [
369.79,
375.84
],
"text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。"
},
{
"no": 69,
"start": 376.24,
"end": 379.27,
"speed": 1.0,
"slot": [
376.24,
379.27
],
"text": "からまないように離したのなら、おかしいですね。"
},
{
"no": 70,
"start": 380.07,
"end": 382.52,
"speed": 1.0,
"slot": [
380.07,
382.52
],
"text": "また、こんな話もよく聞きます。"
},
{
"no": 71,
"start": 382.92,
"end": 389.31,
"speed": 1.0,
"slot": [
382.92,
389.31
],
"text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。"
},
{
"no": 72,
"start": 389.71,
"end": 395.43,
"speed": 1.0,
"slot": [
389.71,
395.43
],
"text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。"
},
{
"no": 73,
"start": 396.43,
"end": 402.19,
"speed": 1.0,
"slot": [
396.43,
402.19
],
"text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。"
},
{
"no": 74,
"start": 402.59,
"end": 407.56,
"speed": 1.0,
"slot": [
402.59,
407.56
],
"text": "この機械は、手で書くより速く打つために作られたはずですよね。"
},
{
"no": 75,
"start": 407.96,
"end": 412.662,
"speed": 1.0,
"slot": [
407.96,
412.662
],
"text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。"
},
{
"no": 76,
"start": 413.062,
"end": 418.262,
"speed": 1.0,
"slot": [
413.062,
418.262
],
"text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。"
},
{
"no": 77,
"start": 418.662,
"end": 423.862,
"speed": 1.0,
"slot": [
418.662,
423.862
],
"text": "この「わざと遅く」の話は、今では研究者に否定されています。"
},
{
"no": 78,
"start": 424.262,
"end": 427.732,
"speed": 1.0,
"slot": [
424.262,
427.732
],
"text": "からまない工夫が、少しはあったのかもしれません。"
},
{
"no": 79,
"start": 428.132,
"end": 432.242,
"speed": 1.0,
"slot": [
428.132,
432.242
],
"text": "でも、それだけでクワーティの並びになったとは、言えないのです。"
},
{
"no": 80,
"start": 433.042,
"end": 436.192,
"speed": 1.0,
"slot": [
433.042,
436.192
],
"text": "では、本当の理由は何だったのでしょうか？"
},
{
"no": 81,
"start": 436.792,
"end": 444.202,
"speed": 1.0,
"slot": [
436.792,
444.202
],
"text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。"
},
{
"no": 82,
"start": 444.602,
"end": 449.112,
"speed": 1.0,
"slot": [
444.602,
449.112
],
"text": "手がかりは、最初にこの機械を買った、お客さんです。"
},
{
"no": 83,
"start": 450.112,
"end": 453.912,
"speed": 1.0,
"slot": [
450.112,
453.912
],
"text": "それは、電信という仕事をしている人たちでした。"
},
{
"no": 84,
"start": 454.312,
"end": 459.882,
"speed": 1.0,
"slot": [
454.312,
459.882
],
"text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。"
},
{
"no": 85,
"start": 460.682,
"end": 466.872,
"speed": 1.0,
"slot": [
460.682,
466.872
],
"text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。"
},
{
"no": 86,
"start": 467.272,
"end": 473.984,
"speed": 1.0,
"slot": [
467.272,
473.984
],
"text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。"
},
{
"no": 87,
"start": 474.384,
"end": 480.42,
"speed": 1.0,
"slot": [
474.384,
480.42
],
"text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。"
},
{
"no": 88,
"start": 480.82,
"end": 487.88,
"speed": 1.0,
"slot": [
480.82,
487.88
],
"text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。"
},
{
"no": 89,
"start": 488.28,
"end": 494.96,
"speed": 1.0,
"slot": [
488.28,
494.96
],
"text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。"
},
{
"no": 90,
"start": 495.36,
"end": 499.03,
"speed": 1.0,
"slot": [
495.36,
499.03
],
"text": "先生は、なんと「もっと速く！」と声をかけたそうです。"
},
{
"no": 91,
"start": 499.43,
"end": 505.38,
"speed": 1.0,
"slot": [
499.43,
505.38
],
"text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。"
},
{
"no": 92,
"start": 506.18,
"end": 510.03,
"speed": 1.0,
"slot": [
506.18,
510.03
],
"text": "では、当時のアメリカのモールス信号を聞いてみましょう。"
},
{
"no": 93,
"start": 510.83,
"end": 516.76,
"speed": 1.0,
"slot": [
510.83,
516.76
],
"text": "まずは「Z」。トントントン、少しあけて、トン。"
},
{
"no": 94,
"start": 517.16,
"end": 520.97,
"speed": 1.0,
"slot": [
517.16,
520.97
],
"text": "そして次に、「S」と「E」を続けた音。"
},
{
"no": 95,
"start": 521.77,
"end": 529.41,
"speed": 1.0,
"slot": [
521.77,
529.41
],
"text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。"
},
{
"no": 96,
"start": 529.81,
"end": 534.99,
"speed": 1.0,
"slot": [
529.81,
534.99
],
"text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。"
},
{
"no": 97,
"start": 535.79,
"end": 542.586,
"speed": 1.0,
"slot": [
535.79,
542.586
],
"text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。"
},
{
"no": 98,
"start": 542.986,
"end": 549.966,
"speed": 1.0,
"slot": [
542.986,
549.966
],
"text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。"
},
{
"no": 99,
"start": 550.366,
"end": 553.876,
"speed": 1.0,
"slot": [
550.366,
553.876
],
"text": "今のキーボードで、この3つを光らせてみると……。"
},
{
"no": 100,
"start": 554.476,
"end": 561.646,
"speed": 1.0,
"slot": [
554.476,
561.646
],
"text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。"
},
{
"no": 101,
"start": 562.046,
"end": 568.316,
"speed": 1.0,
"slot": [
562.046,
568.316
],
"text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。"
},
{
"no": 102,
"start": 569.116,
"end": 574.316,
"speed": 1.0,
"slot": [
569.116,
574.316
],
"text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。"
},
{
"no": 103,
"start": 574.716,
"end": 581.556,
"speed": 1.0,
"slot": [
574.716,
581.556
],
"text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。"
},
{
"no": 104,
"start": 581.956,
"end": 585.076,
"speed": 1.0,
"slot": [
581.956,
585.076
],
"text": "しかも、ふしぎなことが、もう1つあります。"
},
{
"no": 105,
"start": 585.476,
"end": 593.066,
"speed": 1.0,
"slot": [
585.476,
593.066
],
"text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。"
},
{
"no": 106,
"start": 593.466,
"end": 603.036,
"speed": 1.0,
"slot": [
593.466,
603.036
],
"text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。"
},
{
"no": 107,
"start": 603.436,
"end": 608.576,
"speed": 1.0,
"slot": [
603.436,
608.576
],
"text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。"
},
{
"no": 108,
"start": 608.976,
"end": 616.336,
"speed": 1.0,
"slot": [
608.976,
616.336
],
"text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。"
},
{
"no": 109,
"start": 617.136,
"end": 618.666,
"speed": 1.0,
"slot": [
617.136,
618.666
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 110,
"start": 619.066,
"end": 624.326,
"speed": 1.0,
"slot": [
619.066,
624.326
],
"text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？"
},
{
"no": 111,
"start": 624.926,
"end": 630.511,
"speed": 1.0,
"slot": [
624.926,
630.511
],
"text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。"
},
{
"no": 112,
"start": 631.311,
"end": 637.977,
"speed": 1.0,
"slot": [
631.311,
637.977
],
"text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。"
},
{
"no": 113,
"start": 638.377,
"end": 645.317,
"speed": 1.0,
"slot": [
638.377,
645.317
],
"text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。"
},
{
"no": 114,
"start": 645.717,
"end": 653.027,
"speed": 1.0,
"slot": [
645.717,
653.027
],
"text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。"
},
{
"no": 115,
"start": 653.427,
"end": 660.957,
"speed": 1.0,
"slot": [
653.427,
660.957
],
"text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。"
},
{
"no": 116,
"start": 661.357,
"end": 669.367,
"speed": 1.0,
"slot": [
661.357,
669.367
],
"text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。"
},
{
"no": 117,
"start": 669.767,
"end": 678.359,
"speed": 1.0,
"slot": [
669.767,
678.359
],
"text": "そして1893年、アメリカの大きなタイプライターの5つの会社が、1つにまとまりました。"
},
{
"no": 118,
"start": 679.759,
"end": 685.139,
"speed": 1.0,
"slot": [
679.759,
685.139
],
"text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。"
},
{
"no": 119,
"start": 685.539,
"end": 691.419,
"speed": 1.0,
"slot": [
685.539,
691.419
],
"text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。"
},
{
"no": 120,
"start": 692.219,
"end": 696.279,
"speed": 1.0,
"slot": [
692.219,
696.279
],
"text": "では、もっと良い並びは、作られなかったのでしょうか？"
},
{
"no": 121,
"start": 696.879,
"end": 705.309,
"speed": 1.0,
"slot": [
696.879,
705.309
],
"text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。"
},
{
"no": 122,
"start": 705.709,
"end": 709.949,
"speed": 1.0,
"slot": [
705.709,
709.949
],
"text": "よく使う字を、指を置く真ん中の列に集めた並びです。"
},
{
"no": 123,
"start": 710.349,
"end": 714.063,
"speed": 1.0,
"slot": [
710.349,
714.063
],
"text": "「クワーティより、ずっと速く打てる」。そう言われていました。"
},
{
"no": 124,
"start": 714.463,
"end": 720.343,
"speed": 1.0,
"slot": [
714.463,
720.343
],
"text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。"
},
{
"no": 125,
"start": 720.743,
"end": 727.853,
"speed": 1.0,
"slot": [
720.743,
727.853
],
"text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。"
},
{
"no": 126,
"start": 728.253,
"end": 733.693,
"speed": 1.0,
"slot": [
728.253,
733.693
],
"text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。"
},
{
"no": 127,
"start": 734.493,
"end": 739.303,
"speed": 1.0,
"slot": [
734.493,
739.303
],
"text": "それに、もし本当に速かったとしても、問題があります。"
},
{
"no": 128,
"start": 739.703,
"end": 745.473,
"speed": 1.0,
"slot": [
739.703,
745.473
],
"text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。"
},
{
"no": 129,
"start": 745.873,
"end": 750.693,
"speed": 1.0,
"slot": [
745.873,
750.693
],
"text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。"
},
{
"no": 130,
"start": 751.093,
"end": 755.813,
"speed": 1.0,
"slot": [
751.093,
755.813
],
"text": "もし明日、全部の並びが変わったら、どうなるでしょう？"
},
{
"no": 131,
"start": 756.813,
"end": 761.063,
"speed": 1.0,
"slot": [
756.813,
761.063
],
"text": "打つたびにキーを探して、指が止まってしまいますね。"
},
{
"no": 132,
"start": 761.463,
"end": 767.983,
"speed": 1.0,
"slot": [
761.463,
767.983
],
"text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。"
},
{
"no": 133,
"start": 768.383,
"end": 773.653,
"speed": 1.0,
"slot": [
768.383,
773.653
],
"text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。"
},
{
"no": 134,
"start": 774.053,
"end": 779.233,
"speed": 1.0,
"slot": [
774.053,
779.233
],
"text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。"
},
{
"no": 135,
"start": 779.633,
"end": 784.873,
"speed": 1.0,
"slot": [
779.633,
784.873
],
"text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。"
},
{
"no": 136,
"start": 785.673,
"end": 788.293,
"speed": 1.0,
"slot": [
785.673,
788.293
],
"text": "では、最初の問いに戻ります。"
},
{
"no": 137,
"start": 788.693,
"end": 792.693,
"speed": 1.0,
"slot": [
788.693,
792.693
],
"text": "キーボードは、なぜ ABC 順に並んでいないのか。"
},
{
"no": 138,
"start": 793.093,
"end": 801.383,
"speed": 1.0,
"slot": [
793.093,
801.383
],
"text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。"
},
{
"no": 139,
"start": 801.783,
"end": 806.443,
"speed": 1.0,
"slot": [
801.783,
806.443
],
"text": "ただ、どんな都合だったのかは、今もはっきりしていません。"
},
{
"no": 140,
"start": 806.843,
"end": 813.363,
"speed": 1.0,
"slot": [
806.843,
813.363
],
"text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。"
},
{
"no": 141,
"start": 813.763,
"end": 820.983,
"speed": 1.0,
"slot": [
813.763,
820.983
],
"text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。"
},
{
"no": 142,
"start": 821.783,
"end": 824.203,
"speed": 1.0,
"slot": [
821.783,
824.203
],
"text": "そこで、まるロボは考えました。"
},
{
"no": 143,
"start": 824.603,
"end": 829.793,
"speed": 1.0,
"slot": [
824.603,
829.793
],
"text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。"
},
{
"no": 144,
"start": 830.193,
"end": 836.413,
"speed": 1.0,
"slot": [
830.193,
836.413
],
"text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！"
},
{
"no": 145,
"start": 836.813,
"end": 839.403,
"speed": 1.0,
"slot": [
836.813,
839.403
],
"text": "さっそく、いろは歌を打ってみると……。"
},
{
"no": 146,
"start": 842.003,
"end": 845.623,
"speed": 1.0,
"slot": [
842.003,
845.623
],
"text": "跳ねる距離は、クワーティの7分の1になりました。"
},
{
"no": 147,
"start": 846.023,
"end": 853.853,
"speed": 1.0,
"slot": [
846.023,
853.853
],
"text": "でも、カメラを引いてみると……横にとても長いキーボードで、キーは「い ろ は」の順に1列。"
},
{
"no": 148,
"start": 855.053,
"end": 860.993,
"speed": 1.0,
"slot": [
855.053,
860.993
],
"text": "これは、いろは歌を打つときだけ速い、いろは歌専用のキーボードだったのです。"
},
{
"no": 149,
"start": 861.893,
"end": 865.793,
"speed": 1.0,
"slot": [
861.893,
865.793
],
"text": "……まるロボの並びも、誰にも使ってもらえなかったようです。"
}
]