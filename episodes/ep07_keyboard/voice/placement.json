[
{
"no": 1,
"start": 0.5,
"end": 6.72,
"speed": 1.0,
"slot": [
0.5,
6.72
],
"text": "夜の机の上。まるロボが、大きなキーボードを打とうとしています。"
},
{
"no": 2,
"start": 7.12,
"end": 9.71,
"speed": 1.0,
"slot": [
7.12,
9.71
],
"text": "でも、まるロボには腕がありません。"
},
{
"no": 3,
"start": 10.11,
"end": 13.24,
"speed": 1.0,
"slot": [
10.11,
13.24
],
"text": "なので、キーボードは跳ねて乗って打つのです。"
},
{
"no": 4,
"start": 13.64,
"end": 17.84,
"speed": 1.0,
"slot": [
13.64,
17.84
],
"text": "ぴょん、カタッ。これで「A」の出来上がり。"
},
{
"no": 5,
"start": 18.64,
"end": 22.92,
"speed": 1.0,
"slot": [
18.64,
22.92
],
"text": "次は「B」。A の次ですから、すぐとなりに……。"
},
{
"no": 6,
"start": 23.52,
"end": 27.07,
"speed": 1.0,
"slot": [
23.52,
27.07
],
"text": "あれ？　となりにあるのは「S」です。"
},
{
"no": 7,
"start": 27.47,
"end": 30.04,
"speed": 1.0,
"slot": [
27.47,
30.04
],
"text": "反対側には、何もありません。"
},
{
"no": 8,
"start": 30.44,
"end": 35.22,
"speed": 1.0,
"slot": [
30.44,
35.22
],
"text": "どうやら、B がどこにあるのか、分からなくなってしまったみたいです。"
},
{
"no": 9,
"start": 36.12,
"end": 43.97,
"speed": 1.0,
"slot": [
36.12,
43.97
],
"text": "上から見ると、左上は Q W E R T Y。"
},
{
"no": 10,
"start": 44.37,
"end": 50.08,
"speed": 1.0,
"slot": [
44.37,
50.08
],
"text": "この並びは、左上の6文字をそのまま読んで、「クワーティ」と呼ばれています。"
},
{
"no": 11,
"start": 50.48,
"end": 54.8,
"speed": 1.0,
"slot": [
50.48,
54.8
],
"text": "毎日さわるキーボードは、ABC 順に並んでいません。"
},
{
"no": 12,
"start": 55.2,
"end": 60.1,
"speed": 1.0,
"slot": [
55.2,
60.1
],
"text": "ABC 順なら、ずっと探しやすいはずなのに……いったい、なぜ？"
},
{
"no": 13,
"start": 60.7,
"end": 65.19,
"speed": 1.0,
"slot": [
60.7,
65.19
],
"text": "まるロボと一緒に、このクワーティの並びのなぞを、確かめていきます。"
},
{
"no": 14,
"start": 67.99,
"end": 71.07,
"speed": 1.0,
"slot": [
67.99,
71.07
],
"text": "まるロボにとって大事なのは、跳ねる距離です。"
},
{
"no": 15,
"start": 71.47,
"end": 75.872,
"speed": 1.0,
"slot": [
71.47,
75.872
],
"text": "なぜなら、遠くのキーほど、たくさん跳ばないといけないので。"
},
{
"no": 16,
"start": 76.272,
"end": 81.698,
"speed": 1.0,
"slot": [
76.272,
81.698
],
"text": "そこで、ABC 順に並べ直したキーボードを、となりに用意しました。"
},
{
"no": 17,
"start": 82.098,
"end": 87.108,
"speed": 1.0,
"slot": [
82.098,
87.108
],
"text": "キーの数も形も同じで、並びだけが ABC 順です。"
},
{
"no": 18,
"start": 87.908,
"end": 92.628,
"speed": 1.0,
"slot": [
87.908,
92.628
],
"text": "では、同じ言葉を、2つのキーボードで打ってみましょう。"
},
{
"no": 19,
"start": 93.028,
"end": 96.418,
"speed": 1.0,
"slot": [
93.028,
96.418
],
"text": "打つのは、自分の名前の「マルロボ」。"
},
{
"no": 20,
"start": 96.818,
"end": 104.339,
"speed": 1.0,
"slot": [
96.818,
104.339
],
"text": "人は10本の指で打ちますが、まるロボは1字ずつ跳ねるので、跳ねた道のりで比べます。"
},
{
"no": 21,
"start": 104.739,
"end": 111.529,
"speed": 1.0,
"slot": [
104.739,
111.529
],
"text": "まずは、クワーティの並びから。道のりを、青い線で残していきます。"
},
{
"no": 22,
"start": 112.529,
"end": 119.399,
"speed": 1.0,
"slot": [
112.529,
119.399
],
"text": "次は、ABC 順の並びです。こちらは橙の線で残しました。"
},
{
"no": 150,
"start": 119.799,
"end": 130.573,
"speed": 1.0,
"slot": [
119.799,
130.573
],
"text": "M、A、R、U、R、O、B……最後の O まで、ぴょん。打てました。"
},
{
"no": 23,
"start": 131.673,
"end": 135.323,
"speed": 1.0,
"slot": [
131.673,
135.323
],
"text": "跳ねた距離を、キーの数で測ってみると……。"
},
{
"no": 24,
"start": 135.923,
"end": 138.873,
"speed": 1.0,
"slot": [
135.923,
138.873
],
"text": "クワーティが、キー28個分。"
},
{
"no": 25,
"start": 139.273,
"end": 142.683,
"speed": 1.0,
"slot": [
139.273,
142.683
],
"text": "ABC 順が、キー31個分。"
},
{
"no": 26,
"start": 143.083,
"end": 145.973,
"speed": 1.0,
"slot": [
143.083,
145.973
],
"text": "あれ？　ほとんど、変わりません。"
},
{
"no": 27,
"start": 146.773,
"end": 151.803,
"speed": 1.0,
"slot": [
146.773,
151.803
],
"text": "たまたまかもしれないので、今度は、もっと長い文でも比べてみます。"
},
{
"no": 28,
"start": 152.203,
"end": 155.873,
"speed": 1.0,
"slot": [
152.203,
155.873
],
"text": "打つのは、「いろはにほへと」で始まる、いろは歌。"
},
{
"no": 29,
"start": 156.273,
"end": 161.976,
"speed": 1.0,
"slot": [
156.273,
161.976
],
"text": "ひらがなを全部1回ずつ使った歌を、ローマ字で1字ずつ跳ねて打ちます。"
},
{
"no": 30,
"start": 162.876,
"end": 171.316,
"speed": 1.0,
"slot": [
162.876,
171.316
],
"text": "結果は……クワーティがキー316個分、ABC 順がキー302個分。"
},
{
"no": 31,
"start": 171.716,
"end": 176.608,
"speed": 1.0,
"slot": [
171.716,
176.608
],
"text": "なんと、クワーティのほうが、少しだけ長くなってしまいました。"
},
{
"no": 32,
"start": 177.008,
"end": 184.618,
"speed": 1.0,
"slot": [
177.008,
184.618
],
"text": "もし、打つ距離が短くなるように考えて並べたのなら、ABC 順よりずっと短くなるはずです。"
},
{
"no": 33,
"start": 185.018,
"end": 191.198,
"speed": 1.0,
"slot": [
185.018,
191.198
],
"text": "でも、名前ではほとんど同じ。いろは歌では、むしろ長いくらいでした。"
},
{
"no": 34,
"start": 191.598,
"end": 197.048,
"speed": 1.0,
"slot": [
191.598,
197.048
],
"text": "どうやらクワーティは、打つ距離を短くするために作られたわけではなさそうです。"
},
{
"no": 35,
"start": 197.448,
"end": 201.528,
"speed": 1.0,
"slot": [
197.448,
201.528
],
"text": "では、いったい何のために、この順番になったのか……。"
},
{
"no": 36,
"start": 202.128,
"end": 206.827,
"speed": 1.0,
"slot": [
202.128,
206.827
],
"text": "答えを探しに、キーボードが生まれたころへ、さかのぼってみましょう。"
},
{
"no": 37,
"start": 207.727,
"end": 214.907,
"speed": 1.0,
"slot": [
207.727,
214.907
],
"text": "時は、1868年。今から150年ほど前の、アメリカです。"
},
{
"no": 38,
"start": 215.307,
"end": 221.827,
"speed": 1.0,
"slot": [
215.307,
221.827
],
"text": "新聞の仕事をしていたショールズさんが、仲間と一緒に、字を打つ機械を作っていました。"
},
{
"no": 39,
"start": 222.227,
"end": 227.947,
"speed": 1.0,
"slot": [
222.227,
227.947
],
"text": "紙に、手で書くより速く、きれいな字を打てる機械。タイプライターです。"
},
{
"no": 40,
"start": 228.947,
"end": 232.531,
"speed": 1.0,
"slot": [
228.947,
232.531
],
"text": "おや？　このキーボード、よく見ると……。"
},
{
"no": 41,
"start": 233.131,
"end": 236.201,
"speed": 1.0,
"slot": [
233.131,
236.201
],
"text": "まるで、ピアノの鍵盤のような形をしています。"
},
{
"no": 42,
"start": 236.601,
"end": 241.316,
"speed": 1.0,
"slot": [
236.601,
241.316
],
"text": "そして並びは……なんと、ABC 順だったのです。"
},
{
"no": 43,
"start": 241.716,
"end": 245.846,
"speed": 1.0,
"slot": [
241.716,
245.846
],
"text": "手前の列は、A から N まで、左から右へ。"
},
{
"no": 44,
"start": 246.246,
"end": 251.676,
"speed": 1.0,
"slot": [
246.246,
251.676
],
"text": "奥の列は、O から Z まで、今度は右から左へ並んでいます。"
},
{
"no": 45,
"start": 252.476,
"end": 256.746,
"speed": 1.0,
"slot": [
252.476,
256.746
],
"text": "このころはまだ、クワーティの並びとは、まったく違っていたのです。"
},
{
"no": 46,
"start": 257.146,
"end": 261.966,
"speed": 1.0,
"slot": [
257.146,
261.966
],
"text": "ショールズさんたちは、そのあとも機械を何度も作り直していきます。"
},
{
"no": 47,
"start": 262.366,
"end": 266.587,
"speed": 1.0,
"slot": [
262.366,
266.587
],
"text": "作り直すたびに、キーの場所も少しずつ入れかわっていきました。"
},
{
"no": 48,
"start": 266.987,
"end": 274.547,
"speed": 1.0,
"slot": [
266.987,
274.547
],
"text": "そして4年後の1872年ごろ。上の列を、左から見てみると……。"
},
{
"no": 49,
"start": 275.147,
"end": 284.057,
"speed": 1.0,
"slot": [
275.147,
284.057
],
"text": "Q W E、ピリオド、T Y。クワーティとほとんど同じです。"
},
{
"no": 50,
"start": 284.457,
"end": 290.873,
"speed": 1.0,
"slot": [
284.457,
290.873
],
"text": "ただ、今 R がある所には、まだ文の終わりの点「ピリオド」がありました。"
},
{
"no": 51,
"start": 291.673,
"end": 300.323,
"speed": 1.0,
"slot": [
291.673,
300.323
],
"text": "1873年、銃やミシンを作っていた大きな会社が、この機械を作ることになります。"
},
{
"no": 52,
"start": 301.323,
"end": 306.473,
"speed": 1.0,
"slot": [
301.323,
306.473
],
"text": "その会社でピリオドが外され、そこに R が入りました。"
},
{
"no": 53,
"start": 306.873,
"end": 311.173,
"speed": 1.0,
"slot": [
306.873,
311.173
],
"text": "こうして、冒頭で見たクワーティの並びが、そろったのです。"
},
{
"no": 54,
"start": 311.973,
"end": 316.163,
"speed": 1.0,
"slot": [
311.973,
316.163
],
"text": "せっかくの ABC 順を、どうして変えてしまったのでしょう？"
},
{
"no": 55,
"start": 316.763,
"end": 321.293,
"speed": 1.0,
"slot": [
316.763,
321.293
],
"text": "実は、作った人たちは、その理由を書き残していません。"
},
{
"no": 56,
"start": 321.693,
"end": 325.833,
"speed": 1.0,
"slot": [
321.693,
325.833
],
"text": "そこで、昔からよく言われてきた説があります。"
},
{
"no": 57,
"start": 326.833,
"end": 333.013,
"speed": 1.0,
"slot": [
326.833,
333.013
],
"text": "その秘密を探るために、まるロボと一緒に、タイプライターの中へ入ってみましょう。"
},
{
"no": 58,
"start": 333.413,
"end": 338.515,
"speed": 1.0,
"slot": [
333.413,
338.515
],
"text": "キーの奥には、細い棒がずらりと、円く並んでいます。"
},
{
"no": 59,
"start": 338.915,
"end": 343.905,
"speed": 1.0,
"slot": [
338.915,
343.905
],
"text": "キーを押すと、その棒が跳ね上がって、紙に字を打つしくみです。"
},
{
"no": 60,
"start": 344.705,
"end": 348.995,
"speed": 1.0,
"slot": [
344.705,
348.995
],
"text": "もし、となり合う2本の棒が、続けて上がると……。"
},
{
"no": 61,
"start": 349.795,
"end": 352.995,
"speed": 1.0,
"slot": [
349.795,
352.995
],
"text": "途中でぶつかって、からまってしまいました。"
},
{
"no": 62,
"start": 353.395,
"end": 355.815,
"speed": 1.0,
"slot": [
353.395,
355.815
],
"text": "よく言われるのは、こんな説です。"
},
{
"no": 63,
"start": 356.615,
"end": 361.641,
"speed": 1.0,
"slot": [
356.615,
361.641
],
"text": "「よく続けて打つ字を、わざと離して並べた。だから、ばらばらに見える」。"
},
{
"no": 64,
"start": 362.041,
"end": 365.711,
"speed": 1.0,
"slot": [
362.041,
365.711
],
"text": "なるほど、と思いますよね。ところが……。"
},
{
"no": 65,
"start": 366.511,
"end": 369.601,
"speed": 1.0,
"slot": [
366.511,
369.601
],
"text": "この説には、はっきりした証拠がありません。"
},
{
"no": 66,
"start": 370.001,
"end": 374.891,
"speed": 1.0,
"slot": [
370.001,
374.891
],
"text": "まず、理由を書いた記録が、どこにも残っていないのです。"
},
{
"no": 67,
"start": 375.291,
"end": 379.701,
"speed": 1.0,
"slot": [
375.291,
379.701
],
"text": "それに、英語でとてもよく続く「E」と「R」。"
},
{
"no": 68,
"start": 380.101,
"end": 386.071,
"speed": 1.0,
"slot": [
380.101,
386.071
],
"text": "この2つの棒を探してみると……なんと、となり同士に並んでいました。"
},
{
"no": 69,
"start": 386.471,
"end": 389.501,
"speed": 1.0,
"slot": [
386.471,
389.501
],
"text": "からまないように離したのなら、おかしいですね。"
},
{
"no": 70,
"start": 390.301,
"end": 392.751,
"speed": 1.0,
"slot": [
390.301,
392.751
],
"text": "また、こんな話もよく聞きます。"
},
{
"no": 71,
"start": 393.151,
"end": 399.541,
"speed": 1.0,
"slot": [
393.151,
399.541
],
"text": "「速く打つと棒がからむので、わざと打ちにくい並びにして、ゆっくり打たせた」。"
},
{
"no": 72,
"start": 399.941,
"end": 405.661,
"speed": 1.0,
"slot": [
399.941,
405.661
],
"text": "まるロボも、わざとゆっくり跳ねてみます。……ぴょん。……ぴょん。"
},
{
"no": 73,
"start": 406.661,
"end": 412.421,
"speed": 1.0,
"slot": [
406.661,
412.421
],
"text": "たしかに、これなら棒はからみません。でも、ちょっと待ってください。"
},
{
"no": 74,
"start": 412.821,
"end": 417.701,
"speed": 1.0,
"slot": [
412.821,
417.701
],
"text": "この機械は、手で書くより速く打つために作られたはずですよね。"
},
{
"no": 75,
"start": 418.101,
"end": 422.803,
"speed": 1.0,
"slot": [
418.101,
422.803
],
"text": "わざと遅くしたら、高いお金を出して買う人は、いなくなってしまいます。"
},
{
"no": 76,
"start": 423.203,
"end": 428.403,
"speed": 1.0,
"slot": [
423.203,
428.403
],
"text": "しかも、最初のお客さんは、とにかく速く打たないと困る人たちでした。"
},
{
"no": 77,
"start": 428.803,
"end": 434.003,
"speed": 1.0,
"slot": [
428.803,
434.003
],
"text": "この「わざと遅く」の話は、今では研究者に否定されています。"
},
{
"no": 78,
"start": 434.403,
"end": 437.873,
"speed": 1.0,
"slot": [
434.403,
437.873
],
"text": "からまない工夫が、少しはあったのかもしれません。"
},
{
"no": 79,
"start": 438.273,
"end": 442.383,
"speed": 1.0,
"slot": [
438.273,
442.383
],
"text": "でも、それだけでクワーティの並びになったとは、言えないのです。"
},
{
"no": 80,
"start": 443.183,
"end": 446.333,
"speed": 1.0,
"slot": [
443.183,
446.333
],
"text": "では、本当の理由は何だったのでしょうか？"
},
{
"no": 81,
"start": 446.933,
"end": 454.343,
"speed": 1.0,
"slot": [
446.933,
454.343
],
"text": "京都大学の安岡孝一さんたちは、2011年に、昔の記録を調べ直しました。"
},
{
"no": 82,
"start": 454.743,
"end": 459.253,
"speed": 1.0,
"slot": [
454.743,
459.253
],
"text": "手がかりは、最初にこの機械を買った、お客さんです。"
},
{
"no": 83,
"start": 460.253,
"end": 464.053,
"speed": 1.0,
"slot": [
460.253,
464.053
],
"text": "それは、電信という仕事をしている人たちでした。"
},
{
"no": 84,
"start": 464.453,
"end": 470.023,
"speed": 1.0,
"slot": [
464.453,
470.023
],
"text": "遠くまで、電気の信号で文を送るしくみ。それが、電信です。"
},
{
"no": 85,
"start": 470.823,
"end": 477.013,
"speed": 1.0,
"slot": [
470.823,
477.013
],
"text": "届くのは「トン」と「ツー」の音だけ。これを、モールス信号と呼びます。"
},
{
"no": 86,
"start": 477.413,
"end": 484.035,
"speed": 1.0,
"slot": [
477.413,
484.035
],
"text": "電信の人たちは、この音を聞きながら、すぐに字に打ち直さなければなりません。"
},
{
"no": 87,
"start": 484.435,
"end": 490.471,
"speed": 1.0,
"slot": [
484.435,
490.471
],
"text": "最初に機械を買ったのも、シカゴにあった、電信の打ち方を教える学校でした。"
},
{
"no": 88,
"start": 490.871,
"end": 497.931,
"speed": 1.0,
"slot": [
490.871,
497.931
],
"text": "1872年には、大きな電信の会社のえらい人の前で、試し打ちも行われています。"
},
{
"no": 89,
"start": 498.331,
"end": 505.011,
"speed": 1.0,
"slot": [
498.331,
505.011
],
"text": "その人がモールス信号を送り、学校の先生が、それをタイプライターで打っていきます。"
},
{
"no": 90,
"start": 505.411,
"end": 509.081,
"speed": 1.0,
"slot": [
505.411,
509.081
],
"text": "先生は、なんと「もっと速く！」と声をかけたそうです。"
},
{
"no": 91,
"start": 509.481,
"end": 515.431,
"speed": 1.0,
"slot": [
509.481,
515.431
],
"text": "タイプライターは、まず電信の仕事のための道具として、売りこまれていたのですね。"
},
{
"no": 92,
"start": 516.231,
"end": 520.081,
"speed": 1.0,
"slot": [
516.231,
520.081
],
"text": "では、当時のアメリカのモールス信号を聞いてみましょう。"
},
{
"no": 93,
"start": 520.881,
"end": 526.811,
"speed": 1.0,
"slot": [
520.881,
526.811
],
"text": "まずは「Z」。トントントン、少しあけて、トン。"
},
{
"no": 94,
"start": 527.211,
"end": 531.021,
"speed": 1.0,
"slot": [
527.211,
531.021
],
"text": "そして次に、「S」と「E」を続けた音。"
},
{
"no": 95,
"start": 531.821,
"end": 539.461,
"speed": 1.0,
"slot": [
531.821,
539.461
],
"text": "S がトントントン、E がトン。……あれ？　ほとんど同じに聞こえます。"
},
{
"no": 96,
"start": 539.861,
"end": 545.041,
"speed": 1.0,
"slot": [
539.861,
545.041
],
"text": "聞いている人も、Z なのか SE なのか、すぐには分かりません。"
},
{
"no": 97,
"start": 545.841,
"end": 552.637,
"speed": 1.0,
"slot": [
545.841,
552.637
],
"text": "字を打つ人は、ここで迷ってしまいます。Z と打つか、S と E と打つか。"
},
{
"no": 98,
"start": 553.037,
"end": 560.017,
"speed": 1.0,
"slot": [
553.037,
560.017
],
"text": "安岡さんたちは、迷ってもすぐ打ち直せるように、この3つを近くに集めたと考えています。"
},
{
"no": 99,
"start": 560.417,
"end": 563.927,
"speed": 1.0,
"slot": [
560.417,
563.927
],
"text": "今のキーボードで、この3つを光らせてみると……。"
},
{
"no": 100,
"start": 564.527,
"end": 571.697,
"speed": 1.0,
"slot": [
564.527,
571.697
],
"text": "Z の右上に S、そのまた右上に E。3つが、ななめにつながっていますね。"
},
{
"no": 101,
"start": 572.097,
"end": 578.367,
"speed": 1.0,
"slot": [
572.097,
578.367
],
"text": "お客さんの使い方に合わせて少しずつ変えていった結果が、クワーティというわけです。"
},
{
"no": 102,
"start": 579.167,
"end": 584.367,
"speed": 1.0,
"slot": [
579.167,
584.367
],
"text": "ただし、これも記録に書いてあったわけではなく、研究者の予想です。"
},
{
"no": 103,
"start": 584.767,
"end": 591.607,
"speed": 1.0,
"slot": [
584.767,
591.607
],
"text": "「証拠が足りない」という反論もあり、やっぱり棒のからみが大事だった、と考える人もいます。"
},
{
"no": 104,
"start": 592.007,
"end": 595.127,
"speed": 1.0,
"slot": [
592.007,
595.127
],
"text": "しかも、ふしぎなことが、もう1つあります。"
},
{
"no": 105,
"start": 595.527,
"end": 603.117,
"speed": 1.0,
"slot": [
595.527,
603.117
],
"text": "なんと、ショールズさん本人が、あとでクワーティとは別の並びを考えて特許を申し込んでいたのです。"
},
{
"no": 106,
"start": 603.517,
"end": 613.087,
"speed": 1.0,
"slot": [
603.517,
613.087
],
"text": "その並びは、上から2段目が X P M C H で始まる、クワーティとはまるで違うものでした。"
},
{
"no": 107,
"start": 613.487,
"end": 618.627,
"speed": 1.0,
"slot": [
613.487,
618.627
],
"text": "作った本人も、クワーティがいちばんとは、思っていなかったのかもしれません。"
},
{
"no": 108,
"start": 619.027,
"end": 626.287,
"speed": 1.0,
"slot": [
619.027,
626.287
],
"text": "なぜ、クワーティの並びになったのか。答えは150年たった今も、なぞのままです。"
},
{
"no": 109,
"start": 627.087,
"end": 628.617,
"speed": 1.0,
"slot": [
627.087,
628.617
],
"text": "でも、ちょっと待ってください。"
},
{
"no": 110,
"start": 629.017,
"end": 634.277,
"speed": 1.0,
"slot": [
629.017,
634.277
],
"text": "理由がはっきりしないなら、もっと良い並びに変えればいいのでは？"
},
{
"no": 111,
"start": 634.877,
"end": 640.462,
"speed": 1.0,
"slot": [
634.877,
640.462
],
"text": "ところが、このクワーティの並びは、ここから世界中へ広がっていきます。"
},
{
"no": 112,
"start": 641.262,
"end": 647.928,
"speed": 1.0,
"slot": [
641.262,
647.928
],
"text": "作った会社は、機械を売るだけでなく打ち方も教えて、打つ人を育てていきました。"
},
{
"no": 113,
"start": 648.328,
"end": 655.208,
"speed": 1.0,
"slot": [
648.328,
655.208
],
"text": "習った人は、もちろんクワーティで覚えます。働く会社も、クワーティの機械を買います。"
},
{
"no": 114,
"start": 655.608,
"end": 662.918,
"speed": 1.0,
"slot": [
655.608,
662.918
],
"text": "1888年には、打つ速さを競う大会で、クワーティの機械を使った人が勝ちました。"
},
{
"no": 115,
"start": 663.318,
"end": 670.848,
"speed": 1.0,
"slot": [
663.318,
670.848
],
"text": "キーを見ないで、10本の指を全部使う打ち方。クワーティが広まるきっかけの1つと言われています。"
},
{
"no": 116,
"start": 671.248,
"end": 679.258,
"speed": 1.0,
"slot": [
671.248,
679.258
],
"text": "1891年ごろには、クワーティの機械が10万台をこえたと、作った会社は言っています。"
},
{
"no": 117,
"start": 679.658,
"end": 688.25,
"speed": 1.0,
"slot": [
679.658,
688.25
],
"text": "そして1893年、アメリカの大きなタイプライターの5つの会社が、1つにまとまりました。"
},
{
"no": 118,
"start": 689.65,
"end": 694.97,
"speed": 1.0,
"slot": [
689.65,
694.97
],
"text": "こうして、クワーティの並びが、みんなが使う決まりのようになっていきます。"
},
{
"no": 119,
"start": 695.37,
"end": 701.25,
"speed": 1.0,
"slot": [
695.37,
701.25
],
"text": "その後、電報の機械からコンピューターへと、クワーティはそのまま受けつがれました。"
},
{
"no": 120,
"start": 702.05,
"end": 706.11,
"speed": 1.0,
"slot": [
702.05,
706.11
],
"text": "では、もっと良い並びは、作られなかったのでしょうか？"
},
{
"no": 121,
"start": 706.71,
"end": 715.14,
"speed": 1.0,
"slot": [
706.71,
715.14
],
"text": "実は1936年に、アメリカの大学の先生が、新しい並びを考えています。"
},
{
"no": 122,
"start": 715.54,
"end": 719.78,
"speed": 1.0,
"slot": [
715.54,
719.78
],
"text": "よく使う字を、指を置く真ん中の列に集めた並びです。"
},
{
"no": 123,
"start": 720.18,
"end": 723.894,
"speed": 1.0,
"slot": [
720.18,
723.894
],
"text": "「クワーティより、ずっと速く打てる」。そう言われていました。"
},
{
"no": 124,
"start": 724.294,
"end": 730.094,
"speed": 1.0,
"slot": [
724.294,
730.094
],
"text": "ところが、その「速い」という実験には、考えた本人が関わっていたのです。"
},
{
"no": 125,
"start": 730.494,
"end": 737.604,
"speed": 1.0,
"slot": [
730.494,
737.604
],
"text": "あとで国の役所が、別の人たちで比べ直すと……はっきりした差は、出ませんでした。"
},
{
"no": 126,
"start": 738.004,
"end": 743.444,
"speed": 1.0,
"slot": [
738.004,
743.444
],
"text": "つまり、わざわざ替えるほどの違いは、見つからなかったということです。"
},
{
"no": 127,
"start": 744.244,
"end": 749.054,
"speed": 1.0,
"slot": [
744.244,
749.054
],
"text": "それに、もし本当に速かったとしても、問題があります。"
},
{
"no": 128,
"start": 749.454,
"end": 755.224,
"speed": 1.0,
"slot": [
749.454,
755.224
],
"text": "世界中の、とてもたくさんの人が、もうクワーティを指で覚えています。"
},
{
"no": 129,
"start": 755.624,
"end": 760.444,
"speed": 1.0,
"slot": [
755.624,
760.444
],
"text": "会社のパソコンも、学校のパソコンも、みんなクワーティです。"
},
{
"no": 130,
"start": 760.844,
"end": 765.564,
"speed": 1.0,
"slot": [
760.844,
765.564
],
"text": "もし明日、全部の並びが変わったら、どうなるでしょう？"
},
{
"no": 131,
"start": 766.564,
"end": 770.814,
"speed": 1.0,
"slot": [
766.564,
770.814
],
"text": "打つたびにキーを探して、指が止まってしまいますね。"
},
{
"no": 132,
"start": 771.214,
"end": 777.734,
"speed": 1.0,
"slot": [
771.214,
777.734
],
"text": "それに今のキーボードには、昔のタイプライターのような、からまる棒はありません。"
},
{
"no": 133,
"start": 778.134,
"end": 783.404,
"speed": 1.0,
"slot": [
778.134,
783.404
],
"text": "それなのに、スマホの画面のキーボードまで、クワーティになっています。"
},
{
"no": 134,
"start": 783.804,
"end": 788.984,
"speed": 1.0,
"slot": [
783.804,
788.984
],
"text": "みんなが覚えている。それが、いちばん強い理由なのかもしれません。"
},
{
"no": 135,
"start": 789.384,
"end": 794.464,
"speed": 1.0,
"slot": [
789.384,
794.464
],
"text": "こうしてクワーティは、150年近くほとんど変わらなかったのです。"
},
{
"no": 136,
"start": 795.264,
"end": 797.884,
"speed": 1.0,
"slot": [
795.264,
797.884
],
"text": "では、最初の問いに戻ります。"
},
{
"no": 137,
"start": 798.284,
"end": 802.284,
"speed": 1.0,
"slot": [
798.284,
802.284
],
"text": "キーボードは、なぜ ABC 順に並んでいないのか。"
},
{
"no": 138,
"start": 802.684,
"end": 810.974,
"speed": 1.0,
"slot": [
802.684,
810.974
],
"text": "それは、最初の ABC 順を使う人の都合に合わせて少しずつ変え、クワーティになったからです。"
},
{
"no": 139,
"start": 811.374,
"end": 815.934,
"speed": 1.0,
"slot": [
811.374,
815.934
],
"text": "ただ、どんな都合だったのかは、今もはっきりしていません。"
},
{
"no": 140,
"start": 816.334,
"end": 822.854,
"speed": 1.0,
"slot": [
816.334,
822.854
],
"text": "そして一度みんなが覚えると、もっと良い並びが出ても変わらなかったからです。"
},
{
"no": 141,
"start": 823.254,
"end": 830.474,
"speed": 1.0,
"slot": [
823.254,
830.474
],
"text": "毎日さわるキーボードには、150年分の、使った人たちの歴史がつまっていたのですね。"
},
{
"no": 142,
"start": 831.274,
"end": 833.694,
"speed": 1.0,
"slot": [
831.274,
833.694
],
"text": "そこで、まるロボは考えました。"
},
{
"no": 143,
"start": 834.094,
"end": 839.284,
"speed": 1.0,
"slot": [
834.094,
839.284
],
"text": "跳ねる距離がいちばん短くなる並びを、自分で作ってみることにしたのです。"
},
{
"no": 144,
"start": 839.684,
"end": 845.904,
"speed": 1.0,
"slot": [
839.684,
845.904
],
"text": "できあがったのは……なんと、いろは歌がものすごく速く打てるキーボード！"
},
{
"no": 145,
"start": 846.304,
"end": 848.894,
"speed": 1.0,
"slot": [
846.304,
848.894
],
"text": "さっそく、いろは歌を打ってみると……。"
},
{
"no": 146,
"start": 851.494,
"end": 855.114,
"speed": 1.0,
"slot": [
851.494,
855.114
],
"text": "跳ねる距離は、クワーティの7分の1になりました。"
},
{
"no": 147,
"start": 855.514,
"end": 863.344,
"speed": 1.0,
"slot": [
855.514,
863.344
],
"text": "でも、カメラを引いてみると……横にとても長いキーボードで、キーは「い ろ は」の順に1列。"
},
{
"no": 148,
"start": 864.544,
"end": 870.484,
"speed": 1.0,
"slot": [
864.544,
870.484
],
"text": "これは、いろは歌を打つときだけ速い、いろは歌専用のキーボードだったのです。"
},
{
"no": 149,
"start": 871.384,
"end": 875.124,
"speed": 1.0,
"slot": [
871.384,
875.124
],
"text": "……まるロボの並びも、誰にも使ってもらえなかったようです。"
}
]