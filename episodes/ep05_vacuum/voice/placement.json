{
"no": 15,
"start": 61.42,
"end": 65.79,
"speed": 1.0,
"slot": [
61.42,
65.79
],
"text": "あいさつをすると……短い音で、返事が返ってきました。"
},
{
"no": 16,
"start": 66.19,
"end": 71.59,
"speed": 1.0,
"slot": [
66.19,
71.59
