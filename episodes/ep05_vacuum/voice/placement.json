},
{
"no": 22,
"start": 90.46,
"end": 94.53,
"speed": 1.0,
"slot": [
90.46,
94.53
],
"text": "この3つがあとで大事になってくるので、覚えておいてください。"
},
{
"no": 23,
"start": 95.33,
"end": 99.14,
"speed": 1.0,
"slot": [
95.33,
99.14
],
"text": "その前に、ここで少し時間を巻き戻してみます。"
},
{
"no": 24,
"start": 99.54,
"end": 101.13,
"speed": 1.0,
"slot": [
99.54,
101.13
],
"text": "時は、2002年ごろ。"
},
{
"no": 25,
"start": 101.53,
"end": 105.13,
"speed": 1.0,
"slot": [
101.53,
105.13
],
"text": "家で使うロボット掃除機が、広まり始めたころです。"
