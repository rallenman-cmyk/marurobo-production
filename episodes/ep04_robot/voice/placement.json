"no": 62,
"start": 296.56,
"end": 300.07,
"speed": 1.0,
"slot": [
296.56,
300.07
],
"text": "ここで、さきほどの2回を、巻き戻してみましょう。"
},
{
"no": 63,
"start": 300.47,
"end": 307.38,
"speed": 1.0,
"slot": [
300.47,
307.38
