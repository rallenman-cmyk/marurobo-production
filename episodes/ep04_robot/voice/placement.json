"no": 79,
"start": 384.12,
"end": 389.3,
"speed": 1.0,
"slot": [
384.12,
389.3
],
"text": "門番は、こうした手がかりをいくつも合わせて、「人らしさ」の点をつけます。"
},
{
"no": 80,
"start": 389.7,
"end": 394.46,
"speed": 1.0,
"slot": [
389.7,
394.46
],
"text": "点が高い、つまり「人らしい」と判断したら、そのまま通します。"
},
