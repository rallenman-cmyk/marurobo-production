},
{
"no": 21,
"start": 80.94,
"end": 81.3,
"speed": 1.0,
"slot": [
80.94,
81.3
],
"text": "……カチッ。"
},
{
"no": 22,
"start": 82.1,
"end": 84.28,
"speed": 1.0,
"slot": [
82.1,
84.28
],
"text": "はい、すんなり通りました。"
