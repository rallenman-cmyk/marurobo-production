"no": 81,
"start": 394.86,
"end": 398.49,
"speed": 1.0,
"slot": [
394.86,
398.49
],
"text": "迷ったときだけ、もう1つのテストを出すのです。"
},
{
"no": 82,
"start": 398.89,
"end": 401.77,
"speed": 1.0,
"slot": [
398.89,
401.77
],
"text": "それが、さきほどの信号機の絵のテスト。"
},
{
"no": 83,
"start": 402.17,
"end": 408.92,
"speed": 1.0,
"slot": [
402.17,
408.92
],
"text": "ただ、どんな手がかりを、どれだけ見ているのか。細かいことは公開されていません。"
},
{
"no": 84,
"start": 409.32,
"end": 413.64,
"speed": 1.0,
"slot": [
409.32,
413.64
],
"text": "公開すると、それに合わせてまねをする人が出てしまうからです。"
},
{
"no": 85,
"start": 414.44,
"end": 418.83,
"speed": 1.0,
"slot": [
414.44,
418.83
],
"text": "ここからは、その信号機の絵のテストに、挑戦してみましょう。"
},
