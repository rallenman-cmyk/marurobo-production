"no": 86,
"start": 419.23,
"end": 422.29,
"speed": 1.0,
"slot": [
419.23,
422.29
],
"text": "床が、16のマスに分かれました。"
},
{
"no": 87,
"start": 422.69,
"end": 425.99,
"speed": 1.0,
"slot": [
422.69,
425.99
],
"text": "信号機が写っているマスを、全部選びます。"
},
{
"no": 88,
"start": 426.39,
"end": 430.85,
"speed": 1.0,
"slot": [
426.39,
430.85
],
"text": "まるロボ、慎重に、一つずつ……。"
},
{
"no": 89,
"start": 431.45,
"end": 434.11,
"speed": 1.0,
"slot": [
431.45,
