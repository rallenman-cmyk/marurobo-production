"no": 77,
"start": 375.67,
"end": 380.02,
"speed": 1.0,
"slot": [
375.67,
380.02
],
"text": "さきほどの実験は、同じパソコン。だから、記録も同じ。"
},
{
"no": 78,
"start": 380.42,
"end": 383.32,
"speed": 1.0,
"slot": [
380.42,
383.32
],
"text": "違ったのは、やはり動き方だったのです。"
},
