"no": 13,
"start": 44.63,
"end": 46.28,
"speed": 1.0,
"slot": [
44.63,
46.28
],
"text": "まるロボが、押してみます。"
},
{
"no": 14,
"start": 46.68,
"end": 51.09,
"speed": 1.0,
"slot": [
46.68,
51.09
