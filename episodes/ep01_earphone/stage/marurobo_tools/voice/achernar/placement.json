{
"no": 88,
"start": 509.53,
"end": 513.21,
"speed": 1.0,
"slot": [
509.53,
513.681
],
"text": "ここで、チャンネルを三つの窓で表してみます。"
},
{
"no": 89,
"start": 513.761,
"end": 518.461,
"speed": 1.0,
"slot": [
513.761,
519.61
],
"text": "同じ窓が光っているときは、二台が同じチャンネルを使っています。"
},
{
"no": 90,
"start": 519.59,
"end": 521.95,
"speed": 1.0,
"slot": [
519.99,
522.02
],
"text": "いまは、両方ともここ。"
},
{
"no": 91,
"start": 522.1,
"end": 527.76,
"speed": 1.0,
"slot": [
522.1,
529.269
],
"text": "では、スマホだけが次のチャンネルへ変えたら、イヤホンは受け取れるでしょうか？"
},
{
"no": 92,
"start": 533.649,
"end": 536.589,
"speed": 1.0,
"slot": [
533.649,
537.8
],
"text": "イヤホンは、元のチャンネルで待ったままです。"
},
{
"no": 93,
"start": 537.88,
"end": 539.75,
"speed": 1.0,
"slot": [
537.88,
540.861
],
"text": "これでは、うまく受け取れません。"
},
{
"no": 94,
"start": 541.241,
"end": 544.651,
"speed": 1.0,
"slot": [
541.241,
545.739
],
"text": "二台でそろえて変えれば、相手がついてこられます。"
},
{
"no": 95,
"start": 545.284,
"end": 546.814,
"speed": 1.0,
"slot": [
545.819,
546.884
],
"text": "次は、ここ。"
},
{
"no": 96,
"start": 546.964,
"end": 548.514,
"speed": 1.0,
"slot": [
546.964,
548.6
],
"text": "その次は、こちら。"
},
{
"no": 97,
"start": 548.68,
"end": 551.88,
"speed": 1.0,
"slot": [
548.68,
552.606
],
"text": "切り替える順番も、タイミングも合わせます。"
},
{
"no": 98,
"start": 552.856,
"end": 556.756,
"speed": 1.0,
"slot": [
552.856,
557.573
],
"text": "この順番は、つないだときに、二台でそろえています。"
},
{
"no": 99,
"start": 563.953,
"end": 567.723,
"speed": 1.0,
"slot": [
563.953,
567.916
],
"text": "このチャンネルの正体は、電波の周波数です。"
},
{
"no": 100,
"start": 567.873,
"end": 572.234,
"speed": 1.08,
"slot": [
567.996,
572.108
],
"text": "電波が一秒間に何回振動するかを表す言葉です。"
},
{
"no": 101,
"start": 572.384,
"end": 577.484,
"speed": 1.0,
"slot": [
572.188,
578.777
],
"text": "実際には、三つではなく、数十のチャンネルを使って切り替えています。"
},
{
"no": 102,
"start": 579.157,
"end": 586.187,
"speed": 1.0,
"slot": [
579.157,
587.293
],
"text": "一つの周波数を使い続けるのではなく、二台で足並みをそろえて、次々に変えていくわけです。"
},
{
"no": 103,
"start": 587.673,
"end": 590.223,
"speed": 1.0,
"slot": [
587.673,
590.65
],
"text": "では、隣の組も戻してみましょう。"
},
{
"no": 104,
"start": 590.73,
"end": 595.12,
"speed": 1.0,
"slot": [
590.73,
596.0
],
"text": "隣の二台も、その組の順番とタイミングで切り替えています。"
},
{
"no": 105,
"start": 600.329,
"end": 602.709,
"speed": 1.0,
"slot": [
600.38,
602.779
],
"text": "あ、ここでは重なりました。"
},
{
"no": 106,
"start": 602.859,
"end": 605.079,
"speed": 1.0,
"slot": [
602.859,
605.639
],
"text": "それでも、次へ切り替わります。"
},
{
"no": 107,
"start": 605.719,
"end": 610.849,
"speed": 1.0,
"slot": [
605.719,
612.314
],
"text": "重なることはあっても、ずっと同じところで邪魔され続けるのを減らせます。"
},
{
"no": 108,
"start": 615.694,
"end": 621.594,
"speed": 1.0,
"slot": [
615.694,
622.094
],
"text": "さらに、うまく通信できない周波数を、使う候補から外す工夫もあります。"
},
{
"no": 109,
"start": 622.174,
"end": 624.534,
"speed": 1.0,
"slot": [
622.174,
624.953
],
"text": "その変更も、二台で共有します。"
},
{
"no": 110,
"start": 625.033,
"end": 628.143,
"speed": 1.0,
"slot": [
625.033,
629.146
],
"text": "候補が変わっても、足並みはそろえたままです。"
},
{
"no": 111,
"start": 629.526,
"end": 638.856,
"speed": 1.0,
"slot": [
629.526,
639.148
],
"text": "周波数を次々に切り替え、うまく通信できない周波数は避ける。こうして、データを届きやすくしているんです。"
},
{
"no": 112,
"start": 639.228,
"end": 643.928,
"speed": 1.0,
"slot": [
639.228,
645.441
],
"text": "それでも、荷物がうまく届かないことは、ときどき起こります。"
},
{
"no": 113,
"start": 645.521,
"end": 653.401,
"speed": 1.0,
"slot": [
645.521,
654.578
],
"text": "では、届かなかった荷物は、どうなるのでしょう。そのまま、なかったことになってしまうのでしょうか？"
},
{
"no": 114,
"start": 654.958,
"end": 657.028,
"speed": 1.0,
"slot": [
654.958,
657.774
],
"text": "まるロボの配達に戻りましょう。"
},
{
"no": 115,
"start": 657.854,
"end": 660.994,
"speed": 1.0,
"slot": [
657.854,
661.443
],
"text": "今度は、この六番の荷物を追いかけます。"
},
{
"no": 116,
"start": 661.822,
"end": 666.052,
"speed": 1.0,
"slot": [
661.822,
666.366
],
"text": "受け取る側は、データに誤りがないかを確かめます。"
},
{
"no": 117,
"start": 666.446,
"end": 671.216,
"speed": 1.0,
"slot": [
666.446,
671.352
],
"text": "受け取れたら、スマホに「届いたよ」と返事を送ります。"
},
{
"no": 118,
"start": 671.732,
"end": 674.502,
"speed": 1.0,
"slot": [
671.732,
675.12
],
"text": "今回は、正しく受け取れませんでした。"
},
{
"no": 119,
"start": 675.2,
"end": 679.72,
"speed": 1.0,
"slot": [
675.2,
680.671
],
"text": "返事が来ないので、スマホも、届かなかったことに気づきます。"
},
{
"no": 120,
"start": 684.677,
"end": 687.797,
"speed": 1.0,
"slot": [
685.051,
687.867
],
"text": "そこで、同じ六番を、もう一度。"
},
{
"no": 121,
"start": 687.947,
"end": 691.177,
"speed": 1.0,
"slot": [
687.947,
691.727
],
"text": "スマホにある同じデータを、送り直します。"
},
{
"no": 122,
"start": 697.107,
"end": 698.817,
"speed": 1.0,
"slot": [
697.107,
699.38
],
"text": "今度は、受け取れました。"
},
{
"no": 123,
"start": 702.76,
"end": 705.66,
"speed": 1.0,
"slot": [
702.76,
705.761
],
"text": "この送り直しを、再送といいます。"
},
{
"no": 124,
"start": 705.841,
"end": 711.891,
"speed": 1.0,
"slot": [
705.841,
712.308
],
"text": "新しい曲を送るのではなく、受け取れなかった分を、もう一度送るんです。"
},
{
"no": 125,
"start": 712.688,
"end": 716.168,
"speed": 1.0,
"slot": [
712.688,
716.3
],
"text": "ところで、今の音楽、聞いていましたか？"
},
{
"no": 126,
"start": 720.681,
"end": 724.551,
"speed": 1.0,
"slot": [
720.681,
725.023
],
"text": "六番を送り直している間も、曲は続いていました。"
},
{
"no": 127,
"start": 725.103,
"end": 729.063,
"speed": 1.0,
"slot": [
725.103,
730.599
],
"text": "次がまだ届いていなかったのに、何を鳴らしていたのでしょう。"
},
{
"no": 128,
"start": 730.679,
"end": 734.059,
"speed": 1.0,
"slot": [
730.679,
735.396
],
"text": "それではここからは、イヤホンの中を見てみましょう。"
},
{
"no": 129,
"start": 735.776,
"end": 738.906,
"speed": 1.0,
"slot": [
735.776,
739.55
],
"text": "さきほど、外で六番を送り直していたとき。"
},
{
"no": 130,
"start": 739.63,
"end": 741.92,
"speed": 1.0,
"slot": [
739.63,
743.002
],
"text": "中では、こんなことが起きていました。"
},
{
"no": 131,
"start": 748.346,
"end": 750.726,
"speed": 1.0,
"slot": [
748.382,
750.796
],
"text": "四番が、いま鳴っている分。"
},
{
"no": 132,
"start": 750.876,
"end": 754.866,
"speed": 1.0,
"slot": [
750.876,
755.59
],
"text": "その次の五番も、すでに届いて、ここで待っています。"
},
{
"no": 133,
"start": 755.97,
"end": 761.7,
"speed": 1.0,
"slot": [
755.97,
762.581
],
"text": "イヤホンは、少し先の音のデータまで受け取り、順番を待たせているんです。"
},
{
"no": 134,
"start": 762.661,
"end": 767.281,
"speed": 1.0,
"slot": [
762.661,
768.89
],
"text": "今すぐ鳴らす分だけを、その瞬間に受け取っているわけではありません。"
},
{
"no": 135,
"start": 769.2,
"end": 771.81,
"speed": 1.0,
"slot": [
769.27,
771.88
],
"text": "四番が終わったら、次は五番。"
},
{
"no": 136,
"start": 771.96,
"end": 775.01,
"speed": 1.0,
"slot": [
771.96,
774.954
],
"text": "ほら、曲はそのまま続いています。"
},
{
"no": 137,
"start": 782.109,
"end": 785.059,
"speed": 1.0,
"slot": [
782.334,
785.129
],
"text": "その間に、六番が到着しました。"
},
{
"no": 138,
"start": 785.209,
"end": 789.719,
"speed": 1.0,
"slot": [
785.209,
790.304
],
"text": "五番が終わる前に間に合えば、その次も続けて鳴らせます。"
},
{
"no": 139,
"start": 795.684,
"end": 800.354,
"speed": 1.0,
"slot": [
795.684,
801.559
],
"text": "この、先に受け取ったデータを待たせておく場所が、バッファです。"
},
{
"no": 140,
"start": 804.83,
"end": 810.15,
"speed": 1.0,
"slot": [
804.939,
810.22
],
"text": "次の配達が少し遅れても、その間は先に届いた分を鳴らせる。"
},
{
"no": 141,
"start": 810.3,
"end": 813.54,
"speed": 1.0,
"slot": [
810.3,
814.241
],
"text": "バッファが、そのための余裕を作っています。"
},
{
"no": 142,
"start": 814.621,
"end": 817.871,
"speed": 1.0,
"slot": [
814.621,
818.177
],
"text": "送り直している間にも、音楽は進みます。"
},
{
"no": 143,
"start": 818.257,
"end": 824.197,
"speed": 1.0,
"slot": [
818.257,
824.875
],
"text": "でも、先に届いた分があれば、その遅れがすぐ音切れになるとは限りません。"
},
{
"no": 144,
"start": 825.255,
"end": 831.655,
"speed": 1.0,
"slot": [
825.255,
833.605
],
"text": "何も起きていないように聞こえる裏側で、こんなふうに、間に合わせていることがあるんですね。"
},
{
"no": 145,
"start": 833.985,
"end": 839.035,
"speed": 1.0,
"slot": [
833.985,
839.457
],
"text": "では、次の配達がもっと遅れたら、音楽はどうなるのでしょう？"
},
{
"no": 146,
"start": 839.537,
"end": 842.627,
"speed": 1.0,
"slot": [
839.537,
842.687
],
"text": "今度は、九番がなかなか届きません。"
},
{
"no": 147,
"start": 843.067,
"end": 846.577,
"speed": 1.0,
"slot": [
843.067,
846.971
],
"text": "送り直しを待っている間も、音楽は進みます。"
},
{
"no": 148,
"start": 847.051,
"end": 850.531,
"speed": 1.0,
"slot": [
847.051,
851.144
],
"text": "先に届いていた分は、少しずつ減っていきます。"
},
{
"no": 149,
"start": 856.524,
"end": 858.494,
"speed": 1.0,
"slot": [
856.524,
858.918
],
"text": "残っていた分が、あと一つ。"
},
{
"no": 150,
"start": 858.998,
"end": 861.558,
"speed": 1.0,
"slot": [
858.998,
861.962
],
"text": "その一つも、もうすぐ終わります。"
},
{
"no": 151,
"start": 866.342,
"end": 870.062,
"speed": 1.0,
"slot": [
866.342,
870.648
],
"text": "次の音を用意するのが、間に合わなくなると……。"
},
{
"no": 152,
"start": 873.028,
"end": 875.938,
"speed": 1.0,
"slot": [
873.028,
876.391
],
"text": "ここで、音が途切れることがあります。"
},
{
"no": 153,
"start": 879.513,
"end": 883.593,
"speed": 1.0,
"slot": [
879.771,
883.663
],
"text": "少し遅れたけれど、先に届いた分でつなげた。"
},
{
"no": 154,
"start": 883.743,
"end": 888.103,
"speed": 1.0,
"slot": [
883.743,
888.392
],
"text": "あるいは、つなげる分がなくなるまで、届かなかった。"
},
{
"no": 155,
"start": 888.472,
"end": 895.342,
"speed": 1.0,
"slot": [
888.472,
895.39
],
"text": "送り直した分が次の音に間に合うかどうかで、音楽を続けられるかが変わります。"
},
{
"no": 156,
"start": 895.77,
"end": 900.96,
"speed": 1.0,
"slot": [
895.77,
901.184
],
"text": "なお、届きにくくなる理由は、周りの通信だけではありません。"
},
{
"no": 157,
"start": 901.264,
"end": 905.794,
"speed": 1.0,
"slot": [
901.264,
906.109
],
"text": "人の体や物に遮られて、電波が弱くなることもあります。"
},
{
"no": 158,
"start": 906.489,
"end": 910.659,
"speed": 1.0,
"slot": [
906.489,
911.927
],
"text": "それなら、もっと先の分まで、ためておけばいいのでしょうか。"
},
{
"no": 159,
"start": 912.307,
"end": 916.517,
"speed": 1.0,
"slot": [
912.307,
917.575
],
"text": "たとえば、たくさん届くまで待ってから、音を鳴らし始める。"
},
{
"no": 160,
"start": 917.655,
"end": 922.335,
"speed": 1.0,
"slot": [
917.655,
923.305
],
"text": "そうすれば、途中で配達が遅れたときに備える余裕は増やせます。"
},
{
"no": 161,
"start": 927.685,
"end": 932.835,
"speed": 1.0,
"slot": [
927.685,
933.14
],
"text": "ただ、そのために長く待てば、音が聞こえるのも遅くなります。"
},
{
"no": 162,
"start": 933.22,
"end": 939.69,
"speed": 1.0,
"slot": [
933.22,
940.393
],
"text": "待つ余裕を増やすことと、すぐに音が出ることは、いつも両立するとは限りません。"
},
{
"no": 163,
"start": 940.773,
"end": 946.143,
"speed": 1.0,
"slot": [
940.773,
947.191
],
"text": "音楽の再生開始を少し待つだけなら、あまり気にならないかもしれません。"
},
{
"no": 164,
"start": 947.271,
"end": 952.481,
"speed": 1.0,
"slot": [
947.271,
953.308
],
"text": "では、ゲームのように、操作に合わせて音が鳴る場合はどうでしょう。"
},
{
"no": 165,
"start": 953.688,
"end": 957.198,
"speed": 1.0,
"slot": [
953.688,
957.463
],
"text": "まずは、パンチと音が、ぴったり合う場合。"
},
{
"no": 166,
"start": 961.843,
"end": 964.593,
"speed": 1.0,
"slot": [
961.843,
964.287
],
"text": "次は、音が遅れてくる場合。"
},
{
"no": 167,
"start": 968.667,
"end": 970.437,
"speed": 1.0,
"slot": [
968.667,
971.645
],
"text": "パンチは、もう当たっているのに。"
},
{
"no": 168,
"start": 971.725,
"end": 973.635,
"speed": 1.0,
"slot": [
971.725,
974.131
],
"text": "音だけ、今ごろ届きました。"
},
{
"no": 169,
"start": 974.211,
"end": 977.051,
"speed": 1.0,
"slot": [
974.211,
977.763
],
"text": "これでは、ちょっと調子が狂いますよね。"
},
{
"no": 170,
"start": 978.143,
"end": 981.773,
"speed": 1.0,
"slot": [
978.143,
982.645
],
"text": "ゲームでは、操作してから、必要な音が決まります。"
},
{
"no": 171,
"start": 982.725,
"end": 989.245,
"speed": 1.0,
"slot": [
982.725,
990.282
],
"text": "パンチの効果音そのものは用意できても、いつ鳴らすかは、操作するまで決まりません。"
},
{
"no": 172,
"start": 990.662,
"end": 996.832,
"speed": 1.0,
"slot": [
990.662,
997.452
],
"text": "その音を長く待たせれば、操作した瞬間と、聞こえる瞬間が離れてしまいます。"
},
{
"no": 173,
"start": 997.532,
"end": 1002.232,
"speed": 1.0,
"slot": [
997.532,
1003.94
],
"text": "まだしていない操作の音を、先に全部ためておくわけにはいかないんです。"
},
{
"no": 174,
"start": 1004.32,
"end": 1005.83,
"speed": 1.0,
"slot": [
1004.32,
1006.342
],
"text": "音が途切れにくいこと。"
},
{
"no": 175,
"start": 1006.422,
"end": 1009.612,
"speed": 1.0,
"slot": [
1006.422,
1010.162
],
"text": "操作に対して、音がすぐに返ってくること。"
