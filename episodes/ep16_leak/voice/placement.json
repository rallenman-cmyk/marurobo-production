{
"no": 213,
"start": 1166.717,
"end": 1169.827,
"speed": 1.0,
"slot": [
1166.717,
1169.827
],
"text": "ガチャッ。開いてしまいました！"
},
{
"no": 214,
"start": 1170.427,
"end": 1171.767,
"speed": 1.0,
"slot": [
1170.427,
1171.767
],
"text": "まるロボ、ぎょっ。"
},
{
"no": 215,
"start": 1172.527,
"end": 1176.687,
"speed": 1.0,
"slot": [
1172.527,
1176.687
],
"text": "そう、このドアには、お城と同じパスワードを使っていたのです。"
