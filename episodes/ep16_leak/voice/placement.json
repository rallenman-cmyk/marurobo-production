"no": 93,
"start": 506.535,
"end": 508.705,
"speed": 1.0,
"slot": [
506.535,
508.705
],
"text": "お城の予備も、これと同じ。"
},
{
"no": 94,
"start": 509.305,
"end": 514.225,
"speed": 1.0,
"slot": [
509.305,
514.225
],
"text": "名札の倉庫が使えなくなっても、予備があれば元に戻せるのです。"
},
