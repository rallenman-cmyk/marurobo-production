"no": 274,
"start": 1465.477,
"end": 1470.177,
"speed": 1.0,
"slot": [
1465.477,
1470.177
],
"text": "そして、予備の倉庫を、つながっていない場所にも置いておきます。"
},
{
"no": 275,
"start": 1470.777,
"end": 1475.447,
"speed": 1.0,
"slot": [
1470.777,
1475.447
],
"text": "これなら、影に錠をかけられても、予備から元に戻せますね。"
},
{
"no": 276,
"start": 1476.047,
"end": 1482.827,
"speed": 1.0,
"slot": [
1476.047,
1482.827
],
"text": "さらに、働く人が鍵を使い回さないことも、お城の裏口を守ることにつながります。"
},
{
"no": 277,
"start": 1483.427,
"end": 1486.877,
"speed": 1.0,
"slot": [
1483.427,
1486.877
],
"text": "輪を止めるのは、1人1人の鍵でもあるのです。"
},
{
"no": 278,
"start": 1487.777,
"end": 1493.457,
"speed": 1.0,
"slot": [
1487.777,
1493.457
],
"text": "それでは、まとめです。流出した情報は、どこから盗まれるのか。"
},
{
"no": 279,
"start": 1494.057,
"end": 1500.197,
"speed": 1.0,
"slot": [
1494.057,
1500.197
],
"text": "それは、固い正面ではなく、古いままの裏口や漏れた鍵からです。"
},
{
"no": 280,
"start": 1500.797,
"end": 1503.857,
"speed": 1.0,
"slot": [
1500.797,
1503.857
],
"text": "では、盗まれた情報は、どこへ行くのか。"
},
{
"no": 281,
"start": 1504.457,
"end": 1511.107,
"speed": 1.0,
"slot": [
1504.457,
1511.107
],
"text": "かくれた市場で売られ、写されて増え、ほかの情報と合わさっていきます。"
},
{
"no": 282,
"start": 1511.707,
"end": 1518.287,
"speed": 1.0,
"slot": [
1511.707,
1518.287
],
"text": "そして、ほかのドアの鍵や名前を呼ぶメールになって、戻ってくるのです。"
},
{
"no": 283,
"start": 1518.887,
"end": 1524.837,
"speed": 1.0,
"slot": [
1518.887,
1524.837
],
"text": "デジタルの情報は、盗まれてもなくならない。増えて、回る。"
},
{
"no": 284,
"start": 1525.437,
"end": 1531.777,
"speed": 1.0,
"slot": [
1525.437,
1531.777
],
"text": "だから、取り戻すのではなく、使えなくする。それがいちばんの守りです。"
},
{
"no": 285,
"start": 1532.677,
"end": 1538.147,
"speed": 1.0,
"slot": [
1532.677,
1538.147
],
"text": "さて、その夜。鍵を全部替えて、まるロボはひと休み。"
},
{
"no": 286,
"start": 1538.747,
"end": 1541.167,
"speed": 1.0,
"slot": [
1538.747,
1541.167
],
"text": "そこへ、またメールが届きました。"
},
{
"no": 287,
"start": 1541.767,
"end": 1545.667,
"speed": 1.0,
"slot": [
1541.767,
1545.667
],
"text": "「まるロボ様、おめでとうございます！　当選しました！」"
},
{
"no": 288,
"start": 1546.267,
"end": 1548.557,
"speed": 1.0,
"slot": [
1546.267,
1548.557
],
"text": "……まるロボは、何も応募していません。"
},
{
"no": 289,
"start": 1549.157,
"end": 1555.117,
"speed": 1.0,
"slot": [
1549.157,
1555.117
],
"text": "ぽいっ。迷わずごみ箱へ。どうやら、もうだまされないようです。"
}
]