"start": 1277.965,
"end": 1280.625,
"speed": 1.0,
"slot": [
1277.965,
1280.625
],
"text": "影の鍵束を、よく見てください。"
},
{
"no": 242,
"start": 1281.225,
"end": 1285.725,
"speed": 1.0,
"slot": [
1281.225,
1285.725
],
"text": "中には、どこかの会社で働く人の鍵も、まじっています。"
},
