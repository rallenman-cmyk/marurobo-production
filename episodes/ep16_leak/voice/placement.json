"no": 135,
"start": 770.767,
"end": 773.227,
"speed": 1.0,
"slot": [
770.767,
773.227
],
"text": "地図から、道が消えています。"
},
{
"no": 136,
"start": 773.827,
"end": 777.267,
"speed": 1.0,
"slot": [
773.827,
777.267
],
"text": "ここは、ふつうの地図には、のっていない道なのです。"
