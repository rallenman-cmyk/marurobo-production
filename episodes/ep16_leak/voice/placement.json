"no": 243,
"start": 1286.325,
"end": 1288.645,
"speed": 1.0,
"slot": [
1286.325,
1288.645
],
"text": "影は、その鍵を持って……"
},
{
"no": 244,
"start": 1289.245,
"end": 1291.165,
"speed": 1.0,
"slot": [
1289.245,
1291.165
],
"text": "別のお城の裏口へ。"
},
