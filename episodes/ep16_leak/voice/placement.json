"no": 200,
"start": 1103.037,
"end": 1106.707,
"speed": 1.0,
"slot": [
1103.037,
1106.707
],
"text": "使い道の1つ目は、ほかのドアを試すことです。"
},
{
"no": 201,
"start": 1107.307,
"end": 1111.797,
"speed": 1.0,
"slot": [
1107.307,
1111.797
],
"text": "ここは町の通り。家のドアが、ずらりと並んでいます。"
},
{
"no": 202,
"start": 1112.397,
"end": 1117.507,
"speed": 1.0,
"slot": [
1112.397,
1117.507
],
"text": "ドアの1つ1つは、買い物や動画など、ほかのサイトの入口です。"
},
