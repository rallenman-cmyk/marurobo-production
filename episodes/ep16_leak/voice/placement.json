"no": 250,
"start": 1318.435,
"end": 1319.705,
"speed": 1.0,
"slot": [
1318.435,
1319.705
],
"text": "上から、見てみます。"
},
{
"no": 251,
"start": 1320.305,
"end": 1326.425,
"speed": 1.0,
"slot": [
1320.305,
1326.425
],
"text": "お城から盗まれた名札は、市場へ。市場から、影の机の名簿へ。"
},
{
"no": 252,
"start": 1327.025,
"end": 1333.705,
"speed": 1.0,
"slot": [
1327.025,
1333.705
],
"text": "名簿から、町のドアとメールへ。そして鍵になって、また次のお城へ。"
},
{
"no": 253,
"start": 1334.305,
"end": 1338.525,
"speed": 1.0,
"slot": [
1334.305,
1338.525
],
"text": "盗まれた情報は、ぐるっと輪になって、回っていたのです。"
},
{
"no": 254,
"start": 1339.125,
"end": 1343.295,
"speed": 1.0,
"slot": [
1339.125,
1343.295
],
"text": "しかも、回るたびに、名札の数は増えていきます。"
},
