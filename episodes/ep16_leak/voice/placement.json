"no": 154,
"start": 854.967,
"end": 859.587,
"speed": 1.0,
"slot": [
854.967,
859.587
],
"text": "でも、たくさんの人の分があれば、まとめてメールを送れます。"
},
{
"no": 155,
"start": 860.187,
"end": 865.027,
"speed": 1.0,
"slot": [
860.187,
865.027
],
"text": "そのうち、ほんの少しでもだまされる人がいれば、もうけになります。"
},
{
"no": 156,
"start": 865.627,
"end": 872.647,
"speed": 1.0,
"slot": [
865.627,
872.647
],
"text": "このように、1枚は安くても、たくさん集まれば影にとってはお金になるわけです。"
},
{
"no": 157,
"start": 873.247,
"end": 877.797,
"speed": 1.0,
"slot": [
873.247,
877.797
],
"text": "そこへ、別の影がやって来て、箱ごと買っていきました。"
},
{
"no": 158,
"start": 878.397,
"end": 885.547,
"speed": 1.0,
"slot": [
878.397,
885.547
],
"text": "次の影も、その次の影も……。箱は、みるみるうちに売れていきます。"
},
{
"no": 159,
"start": 886.147,
"end": 890.567,
"speed": 1.0,
"slot": [
886.147,
890.567
],
"text": "まるロボの名札は、いったい、だれの手に渡ってしまったのでしょう？"
},
