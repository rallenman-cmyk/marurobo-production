"no": 216,
"start": 1177.287,
"end": 1178.637,
"speed": 1.0,
"slot": [
1177.287,
1178.637
],
"text": "2つ目のドアは……"
},
{
"no": 217,
"start": 1179.237,
"end": 1182.887,
"speed": 1.0,
"slot": [
1179.237,
1182.887
],
"text": "開きません。こちらは、別のパスワードでした。"
},
{
"no": 218,
"start": 1183.487,
"end": 1187.257,
"speed": 1.0,
"slot": [
1183.487,
1187.257
],
"text": "まるロボは、ほっとして、へなへなと座りこみました。"
},
{
"no": 219,
"start": 1188.157,
"end": 1194.697,
"speed": 1.0,
"slot": [
1188.157,
1194.697
],
"text": "このように、漏れたIDとパスワードを、機械がほかのサイトで次々に試します。"
},
{
"no": 220,
"start": 1195.297,
"end": 1199.717,
"speed": 1.0,
"slot": [
1195.297,
1199.717
],
"text": "同じパスワードを使い回していると、そこでも開いてしまうのです。"
},
