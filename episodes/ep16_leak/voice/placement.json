"no": 138,
"start": 783.027,
"end": 787.157,
"speed": 1.0,
"slot": [
783.027,
787.157
],
"text": "たどり着いたのは、うす暗い倉庫のような所でした。"
},
{
"no": 139,
"start": 787.757,
"end": 791.917,
"speed": 1.0,
"slot": [
787.757,
791.917
],
"text": "そっと中をのぞくと……棚に、箱がずらり。"
},
{
"no": 140,
"start": 792.517,
"end": 796.447,
"speed": 1.0,
"slot": [
792.517,
796.447
],
"text": "どの箱にも、いろいろなお城の印が付いています。"
},
{
"no": 141,
"start": 797.047,
"end": 801.517,
"speed": 1.0,
"slot": [
797.047,
801.517
],
"text": "ここは、ふつうの検索では出てこない、かくれた市場。"
},
{
"no": 142,
"start": 802.117,
"end": 805.537,
"speed": 1.0,
"slot": [
802.117,
805.537
],
"text": "盗まれた情報が、売り買いされることがある場所です。"
},
{
"no": 143,
"start": 806.137,
"end": 810.467,
"speed": 1.0,
"slot": [
806.137,
810.467
],
"text": "ほかのお城から盗まれた名札も、ここに集まっていたのですね。"
},
{
"no": 144,
"start": 811.367,
"end": 814.597,
"speed": 1.0,
"slot": [
811.367,
814.597
],
"text": "まるロボが、自分のお城の箱を見つけました。"
},
{
"no": 145,
"start": 815.197,
"end": 819.167,
"speed": 1.0,
"slot": [
815.197,
819.167
],
"text": "自分の名札には、いったい、どんな値段が付いているのか……。"
},
