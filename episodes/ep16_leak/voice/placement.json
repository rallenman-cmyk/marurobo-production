"no": 185,
"start": 1016.937,
"end": 1024.057,
"speed": 1.0,
"slot": [
1016.937,
1024.057
],
"text": "橙の札は、別のお城から漏れた物。メールと誕生日と、買った物の札です。"
},
{
"no": 186,
"start": 1024.657,
"end": 1030.697,
"speed": 1.0,
"slot": [
1024.657,
1030.697
],
"text": "緑の札は、また別のお城から。電話と、勤め先が書いてあります。"
},
{
"no": 187,
"start": 1031.297,
"end": 1035.537,
"speed": 1.0,
"slot": [
1031.297,
1035.537
],
"text": "どれも、まるロボが、別々のお店に預けていた情報です。"
},
{
"no": 188,
"start": 1036.137,
"end": 1040.107,
"speed": 1.0,
"slot": [
1036.137,
1040.107
],
"text": "でも、影は、なぜ3枚を並べているのでしょう？"
},
{
"no": 189,
"start": 1041.007,
"end": 1045.077,
"speed": 1.0,
"slot": [
1041.007,
1045.077
],
"text": "ここで、3枚の札の、メールの絵を見てください。"
},
{
"no": 190,
"start": 1045.677,
"end": 1050.047,
"speed": 1.0,
"slot": [
1045.677,
1050.047
],
"text": "……同時に光りました。3枚とも、同じメールアドレスです。"
},
{
"no": 191,
"start": 1050.647,
"end": 1054.907,
"speed": 1.0,
"slot": [
1050.647,
1054.907
],
"text": "同じメールなら、同じ人の札だと分かってしまいます。"
},
{
"no": 192,
"start": 1055.507,
"end": 1060.777,
"speed": 1.0,
"slot": [
1055.507,
1060.777
],
"text": "すると、3枚の札が重なって、1冊の名簿になりました。"
},
{
"no": 193,
"start": 1061.377,
"end": 1067.447,
"speed": 1.0,
"slot": [
1061.377,
1067.447
],
"text": "名前に住所に電話、誕生日に勤め先、買った物まで。"
},
{
"no": 194,
"start": 1068.047,
"end": 1073.447,
"speed": 1.0,
"slot": [
1068.047,
1073.447
],
"text": "最初のお店には、誕生日も勤め先も、教えていなかったはずなのに……。"
},
{
"no": 195,
"start": 1074.047,
"end": 1079.357,
"speed": 1.0,
"slot": [
1074.047,
1079.357
],
"text": "別々のお店の情報が合わさると、こんなにくわしくなってしまうのです。"
},
{
"no": 196,
"start": 1079.957,
"end": 1084.517,
"speed": 1.0,
"slot": [
1079.957,
1084.517
],
"text": "こうして、1人分の名簿が作られていくと考えられています。"
},
{
"no": 197,
"start": 1085.117,
"end": 1089.867,
"speed": 1.0,
"slot": [
1085.117,
1089.867
],
"text": "まるロボは、自分の名簿を見て、思わず一歩下がりました。"
},
{
"no": 198,
"start": 1090.467,
"end": 1094.567,
"speed": 1.0,
"slot": [
1090.467,
1094.567
],
"text": "見知らぬ影に、自分のことが、ここまで知られている……。"
},
{
"no": 199,
"start": 1095.167,
"end": 1102.137,
"speed": 1.0,
"slot": [
1095.167,
1102.137
],
"text": "では、この名簿は何に使われるのでしょう？　使い道は、大きく2つあります。"
},
