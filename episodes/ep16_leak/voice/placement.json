"no": 188,
"start": 1005.435,
"end": 1009.405,
"speed": 1.0,
"slot": [
1005.435,
1009.405
],
"text": "でも、影は、なぜ3枚を並べているのでしょう？"
},
{
"no": 189,
"start": 1010.305,
"end": 1014.375,
"speed": 1.0,
"slot": [
1010.305,
1014.375
],
"text": "ここで、3枚の札の、メールの絵を見てください。"
},
{
"no": 190,
"start": 1014.975,
"end": 1019.345,
"speed": 1.0,
"slot": [
1014.975,
1019.345
],
"text": "……同時に光りました。3枚とも、同じメールアドレスです。"
},
{
"no": 191,
"start": 1019.945,
"end": 1024.205,
"speed": 1.0,
"slot": [
1019.945,
1024.205
],
"text": "同じメールなら、同じ人の札だと分かってしまいます。"
},
