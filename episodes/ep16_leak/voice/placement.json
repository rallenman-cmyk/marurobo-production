"no": 160,
"start": 891.467,
"end": 894.027,
"speed": 1.0,
"slot": [
891.467,
894.027
],
"text": "まるロボは、もう、がまんできません。"
},
{
"no": 161,
"start": 894.627,
"end": 900.877,
"speed": 1.0,
"slot": [
894.627,
900.877
],
"text": "棚に残っていた箱にとびこむと、自分の名札を頭に載せて、走り出しました。"
},
{
"no": 162,
"start": 901.477,
"end": 907.397,
"speed": 1.0,
"slot": [
901.477,
907.397
],
"text": "家まで走って帰ると、名札を金庫にしまい、しっかり扉を閉めます。"
},
{
"no": 163,
"start": 907.997,
"end": 910.427,
"speed": 1.0,
"slot": [
907.997,
910.427
],
"text": "ぴょん、ぴょん。取り返しました！"
},
{
"no": 164,
"start": 911.207,
"end": 912.527,
"speed": 1.0,
"slot": [
911.207,
912.527
],
"text": "これで、ひと安心……。"
},
{
"no": 165,
"start": 913.377,
"end": 918.747,
"speed": 1.0,
"slot": [
913.377,
918.747
],
"text": "でも、何かがおかしいですね。だれも、追いかけてきません。"
},
{
"no": 166,
"start": 919.347,
"end": 922.487,
"speed": 1.0,
"slot": [
919.347,
922.487
],
"text": "まるロボの名札が、安いから……？"
},
{
"no": 167,
"start": 923.387,
"end": 927.987,
"speed": 1.0,
"slot": [
923.387,
927.987
],
"text": "それとも、取り返されても、影が困らない理由があるのでしょうか？"
},
{
"no": 168,
"start": 928.587,
"end": 932.367,
"speed": 1.0,
"slot": [
928.587,
932.367
],
"text": "気になったまるロボは、もう一度、市場へ戻ってみます。"
},
{
"no": 169,
"start": 932.967,
"end": 933.757,
"speed": 1.0,
"slot": [
932.967,
933.757
],
"text": "すると……"
},
{
"no": 170,
"start": 934.357,
"end": 939.027,
"speed": 1.0,
"slot": [
934.357,
939.027
],
"text": "棚には、まるロボの名札が、まだ何枚も並んでいます。"
},
{
"no": 171,
"start": 939.627,
"end": 944.297,
"speed": 1.0,
"slot": [
939.627,
944.297
],
"text": "さっき売れていった箱の中にも、同じ名札が入っていました。"
},
{
"no": 172,
"start": 944.897,
"end": 948.137,
"speed": 1.0,
"slot": [
944.897,
948.137
],
"text": "取り返したはずなのに、いったい、どういうこと？"
},
{
"no": 173,
"start": 949.037,
"end": 954.737,
"speed": 1.0,
"slot": [
949.037,
954.737
],
"text": "じつはここが、紙の名札とデジタルの情報の、大きなちがいです。"
},
{
"no": 174,
"start": 955.337,
"end": 959.817,
"speed": 1.0,
"slot": [
955.337,
959.817
],
"text": "紙の名札なら、1枚しかないので、取り返せばそれで終わり。"
},
{
"no": 175,
"start": 960.417,
"end": 964.727,
"speed": 1.0,
"slot": [
960.417,
964.727
],
"text": "でも、デジタルの情報は、写しても元が減りません。"
},
