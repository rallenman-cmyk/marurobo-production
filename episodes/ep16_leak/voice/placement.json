"no": 192,
"start": 1024.805,
"end": 1030.075,
"speed": 1.0,
"slot": [
1024.805,
1030.075
],
"text": "すると、3枚の札が重なって、1冊の名簿になりました。"
},
{
"no": 193,
"start": 1030.675,
"end": 1036.745,
"speed": 1.0,
"slot": [
1030.675,
1036.745
],
"text": "名前に住所に電話、誕生日に勤め先、買った物まで。"
},
{
"no": 194,
"start": 1037.345,
"end": 1042.745,
"speed": 1.0,
"slot": [
1037.345,
1042.745
],
"text": "最初のお店には、誕生日も勤め先も、教えていなかったはずなのに……。"
},
{
"no": 195,
"start": 1043.345,
"end": 1048.655,
"speed": 1.0,
"slot": [
1043.345,
1048.655
],
"text": "別々のお店の情報が合わさると、こんなにくわしくなってしまうのです。"
