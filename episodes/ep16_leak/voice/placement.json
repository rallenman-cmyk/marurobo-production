[
{
"no": 1,
"start": 0.5,
"end": 5.3,
"speed": 1.0,
"slot": [
0.5,
5.3
],
"text": "ある朝、まるロボのスマホに、1通のメールが届きました。"
},
{
"no": 2,
"start": 6.3,
"end": 9.69,
"speed": 1.0,
"slot": [
6.3,
9.69
],
"text": "いつも買い物をしている、ネットのお店からです。"
},
{
"no": 3,
"start": 10.29,
"end": 15.17,
"speed": 1.0,
"slot": [
10.29,
15.17
],
"text": "セールのお知らせかな？　まるロボは、わくわくしながら開きます。"
},
{
"no": 4,
"start": 16.07,
"end": 21.16,
"speed": 1.0,
"slot": [
16.07,
21.16
],
"text": "「お客さまの情報が、流出したおそれがあります」"
},
{
"no": 5,
"start": 22.06,
"end": 25.27,
"speed": 1.0,
"slot": [
22.06,
25.27
],
"text": "……え？　それは、お店からの、おわびのメールでした。"
},
{
"no": 6,
"start": 25.87,
"end": 31.83,
"speed": 1.0,
"slot": [
25.87,
31.83
],
"text": "流出とは、お店に預けていた情報が、外へ盗み出されてしまうこと。"
},
{
"no": 7,
"start": 32.43,
"end": 37.03,
"speed": 1.0,
"slot": [
32.43,
37.03
],
"text": "まるロボも、会員になるときに、自分の情報を預けていました。"
},
{
"no": 8,
"start": 37.63,
"end": 42.22,
"speed": 1.0,
"slot": [
37.63,
42.22
],
"text": "名前に住所、電話番号、そしてメールアドレスです。"
},
{
"no": 9,
"start": 42.82,
"end": 46.756,
"speed": 1.0,
"slot": [
42.82,
46.756
],
"text": "あの情報が、知らないだれかの手に渡ってしまった……？"
},
{
"no": 10,
"start": 47.556,
"end": 51.666,
"speed": 1.0,
"slot": [
47.556,
51.666
],
"text": "でも、このお店に預けたのは、この4つだけです。"
},
{
"no": 11,
"start": 52.266,
"end": 59.266,
"speed": 1.0,
"slot": [
52.266,
59.266
],
"text": "誕生日も勤め先も、教えていません。それなら、まだ安心……かな？"
},
{
"no": 12,
"start": 60.166,
"end": 63.316,
"speed": 1.0,
"slot": [
60.166,
63.316
],
"text": "まるロボは、あわてて部屋の中をきょろきょろ。"
},
{
"no": 13,
"start": 63.916,
"end": 68.116,
"speed": 1.0,
"slot": [
63.916,
68.116
],
"text": "どうやら、泥棒が部屋にいないか、探しているようです。"
},
{
"no": 14,
"start": 68.716,
"end": 73.366,
"speed": 1.0,
"slot": [
68.716,
73.366
],
"text": "でも、まるロボ。盗まれたのは、お店のほうですよ。"
},
{
"no": 15,
"start": 74.266,
"end": 80.576,
"speed": 1.0,
"slot": [
74.266,
80.576
],
"text": "2026年の秋、こうした流出の発表が、次々に続きました。"
},
{
"no": 16,
"start": 81.176,
"end": 84.856,
"speed": 1.0,
"slot": [
81.176,
84.856
],
"text": "でも、メールには、くわしいことは書いてありません。"
},
{
"no": 17,
"start": 85.456,
"end": 88.756,
"speed": 1.0,
"slot": [
85.456,
88.756
],
"text": "泥棒は、いったい、どこから入ったのでしょうか？"
},
{
"no": 18,
"start": 89.356,
"end": 93.076,
"speed": 1.0,
"slot": [
89.356,
93.076
],
"text": "そして、盗まれた情報は、いまどこにあるのか？"
},
{
"no": 19,
"start": 94.476,
"end": 98.716,
"speed": 1.0,
"slot": [
94.476,
98.716
],
"text": "盗まれてから、そのあとまで。一緒に、確かめてみます。"
},
{
"no": 20,
"start": 99.716,
"end": 103.836,
"speed": 1.0,
"slot": [
99.716,
103.836
],
"text": "ここからは分かりやすく、目に見える形にたとえてみましょう。"
},
{
"no": 21,
"start": 104.736,
"end": 108.916,
"speed": 1.0,
"slot": [
104.736,
108.916
],
"text": "情報が盗まれたお店の会社は、大きなお城。"
},
{
"no": 22,
"start": 109.816,
"end": 116.886,
"speed": 1.0,
"slot": [
109.816,
116.886
],
"text": "1人分の情報は、名前と住所と電話とメールの絵が付いた、1枚の名札です。"
},
{
"no": 23,
"start": 117.786,
"end": 123.456,
"speed": 1.0,
"slot": [
117.786,
123.456
],
"text": "そして、IDとパスワードは、扉を開ける鍵の形で表します。"
},
{
"no": 24,
"start": 124.256,
"end": 129.216,
"speed": 1.0,
"slot": [
124.256,
129.216
],
"text": "では、まるロボと一緒に、盗まれた名札を追いかけてみましょう。"
},
{
"no": 25,
"start": 130.116,
"end": 134.036,
"speed": 1.0,
"slot": [
130.116,
134.036
],
"text": "まずは、名札を預けていたお城へ、行ってみます。"
},
{
"no": 26,
"start": 134.636,
"end": 139.586,
"speed": 1.0,
"slot": [
134.636,
139.586
],
"text": "見てください。高いかべに、大きな正面の門。"
},
{
"no": 27,
"start": 140.186,
"end": 143.566,
"speed": 1.0,
"slot": [
140.186,
143.566
],
"text": "門の前では、門番さんが、じっと見張っています。"
},
{
"no": 28,
"start": 144.166,
"end": 148.926,
"speed": 1.0,
"slot": [
144.166,
148.926
],
"text": "こんなに固そうなお城に、泥棒は、どうやって入ったのでしょう？"
},
{
"no": 29,
"start": 149.926,
"end": 152.016,
"speed": 1.0,
"slot": [
149.926,
152.016
],
"text": "まるロボが門を押してみると……"
},
{
"no": 30,
"start": 152.616,
"end": 153.866,
"speed": 1.0,
"slot": [
152.616,
153.866
],
"text": "びくともしません。"
},
{
"no": 31,
"start": 154.866,
"end": 157.696,
"speed": 1.0,
"slot": [
154.866,
157.696
],
"text": "えいっ、と体当たりしても……"
},
{
"no": 32,
"start": 158.396,
"end": 159.536,
"speed": 1.0,
"slot": [
158.396,
159.536
],
"text": "やっぱり、だめ。"
},
{
"no": 33,
"start": 160.136,
"end": 163.176,
"speed": 1.0,
"slot": [
160.136,
163.176
],
"text": "正面からは、とても入れそうにありませんね。"
},
{
"no": 34,
"start": 164.176,
"end": 169.566,
"speed": 1.0,
"slot": [
164.176,
169.566
],
"text": "映画では、泥棒がキーボードをすばやく打って、正面の守りを破ります。"
},
{
"no": 35,
"start": 170.466,
"end": 175.256,
"speed": 1.0,
"slot": [
170.466,
175.256
],
"text": "でも、本当に多いのは、そういう派手な入り方ではありません。"
},
{
"no": 36,
"start": 175.856,
"end": 179.386,
"speed": 1.0,
"slot": [
175.856,
179.386
],
"text": "では、泥棒は、どこから入ったのか？"
},
{
"no": 37,
"start": 180.386,
"end": 183.566,
"speed": 1.0,
"slot": [
180.386,
183.566
],
"text": "お城のまわりを、ぐるっと回ってみます。"
},
{
"no": 38,
"start": 184.166,
"end": 189.636,
"speed": 1.0,
"slot": [
184.166,
189.636
],
"text": "すると、横のかべの低い所に、小さな扉がありました。"
},
{
"no": 39,
"start": 190.236,
"end": 195.516,
"speed": 1.0,
"slot": [
190.236,
195.516
],
"text": "まるロボは……まだ、正面の門を見ていますね。"
},
{
"no": 40,
"start": 196.416,
"end": 198.766,
"speed": 1.0,
"slot": [
196.416,
198.766
],
"text": "おーい、まるロボ。うしろです。"
},
{
"no": 41,
"start": 199.766,
"end": 203.576,
"speed": 1.0,
"slot": [
199.766,
203.576
],
"text": "この小さな扉は、お城の裏口です。"
},
{
"no": 42,
"start": 204.176,
"end": 208.586,
"speed": 1.0,
"slot": [
204.176,
208.586
],
"text": "でも、なぜお城に、こんな扉があるのでしょうか？"
},
{
"no": 43,
"start": 209.486,
"end": 217.136,
"speed": 1.0,
"slot": [
209.486,
217.136
],
"text": "たとえば、家で仕事をするとき。会社の中の書類やパソコンが、必要になりますね。"
},
{
"no": 44,
"start": 217.736,
"end": 223.966,
"speed": 1.0,
"slot": [
217.736,
223.966
],
"text": "そこで、外からでも会社の中に入れるように、こうした入口を作ってあるのです。"
},
{
"no": 45,
"start": 224.566,
"end": 230.486,
"speed": 1.0,
"slot": [
224.566,
230.486
],
"text": "本物の会社では、外から会社につなぐ、出入口の機械にあたります。"
},
{
"no": 46,
"start": 231.086,
"end": 237.386,
"speed": 1.0,
"slot": [
231.086,
237.386
],
"text": "とても便利な入口ですが、ここが、泥棒にねらわれやすい所でもあるのです。"
},
{
"no": 47,
"start": 238.286,
"end": 242.746,
"speed": 1.0,
"slot": [
238.286,
242.746
],
"text": "では、裏口のどこが、ねらわれるのか。近くで見てみます。"
},
{
"no": 48,
"start": 243.346,
"end": 246.926,
"speed": 1.0,
"slot": [
243.346,
246.926
],
"text": "見てください。この錠は、ずいぶん古いままです。"
},
{
"no": 49,
"start": 247.826,
"end": 253.576,
"speed": 1.0,
"slot": [
247.826,
253.576
],
"text": "錠を作った人は、弱い所が見つかると、直すための部品を届けてくれます。"
},
{
"no": 50,
"start": 254.176,
"end": 261.556,
"speed": 1.0,
"slot": [
254.176,
261.556
],
"text": "本物では、出入口の機械を作った会社が、弱い所を直す新しいプログラムを配っています。"
},
{
"no": 51,
"start": 262.156,
"end": 268.956,
"speed": 1.0,
"slot": [
262.156,
268.956
],
"text": "ところが、直さずに使い続けていると、その弱い所から開けられてしまうのです。"
},
{
"no": 52,
"start": 269.556,
"end": 275.116,
"speed": 1.0,
"slot": [
269.556,
275.116
],
"text": "このように、見つかった弱い所が、直されないまま残っていることがあります。"
},
{
"no": 53,
"start": 276.116,
"end": 281.946,
"speed": 1.0,
"slot": [
276.116,
281.946
],
"text": "また、鍵はかかっていても、かんたんな形の鍵で開いてしまう裏口もあります。"
},
{
"no": 54,
"start": 282.546,
"end": 290.846,
"speed": 1.0,
"slot": [
282.546,
290.846
],
"text": "ここでいう弱い鍵とは、誕生日や「1234」のように、すぐに当てられるパスワードのこと。"
},
{
"no": 55,
"start": 291.746,
"end": 296.236,
"speed": 1.0,
"slot": [
291.746,
296.236
],
"text": "では、本当に、裏口から入られることは多いのでしょうか？"
},
{
"no": 56,
"start": 297.036,
"end": 301.776,
"speed": 1.0,
"slot": [
297.036,
301.776
],
"text": "2025年の1年間の、警察のまとめを見てみます。"
},
{
"no": 57,
"start": 302.376,
"end": 308.436,
"speed": 1.0,
"slot": [
302.376,
308.436
],
"text": "泥棒に入られた会社に聞いて、どこから入られたかが分かったのは92件。"
},
{
"no": 58,
"start": 309.036,
"end": 313.946,
"speed": 1.0,
"slot": [
309.036,
313.946
],
"text": "そのうち61件が、この出入口の機械から入られていました。"
},
{
"no": 59,
"start": 314.546,
"end": 318.376,
"speed": 1.0,
"slot": [
314.546,
318.376
],
"text": "そして、裏口には、もう1つ種類があります。"
},
{
"no": 60,
"start": 318.976,
"end": 324.306,
"speed": 1.0,
"slot": [
318.976,
324.306
],
"text": "家にいながら、会社の机のパソコンを、画面ごと動かせるしくみです。"
},
{
"no": 61,
"start": 324.906,
"end": 329.546,
"speed": 1.0,
"slot": [
324.906,
329.546
],
"text": "まるで、遠くから会社の机に座っているように使えるのですね。"
},
{
"no": 62,
"start": 330.146,
"end": 332.956,
"speed": 1.0,
"slot": [
330.146,
332.956
],
"text": "ここから入られたのが、19件。"
},
{
"no": 63,
"start": 333.556,
"end": 340.146,
"speed": 1.0,
"slot": [
333.556,
340.146
],
"text": "2つを合わせると80件。92件のうち、ほとんどが裏口からだったのです。"
},
{
"no": 64,
"start": 341.146,
"end": 344.406,
"speed": 1.0,
"slot": [
341.146,
344.406
],
"text": "正面の門を破られたのでは、なかったのですね。"
},
{
"no": 65,
"start": 345.806,
"end": 350.426,
"speed": 1.0,
"slot": [
345.806,
350.426
],
"text": "ここで、流出が起きる前の夜に、時間を巻きもどしてみます。"
},
{
"no": 66,
"start": 351.026,
"end": 357.646,
"speed": 1.0,
"slot": [
351.026,
357.646
],
"text": "泥棒を黒い影で表すと……夜の裏口に、影がやって来ました。"
},
{
"no": 67,
"start": 358.546,
"end": 360.106,
"speed": 1.0,
"slot": [
358.546,
360.106
],
"text": "影が取り出したのは……"
},
{
"no": 68,
"start": 360.906,
"end": 362.826,
"speed": 1.0,
"slot": [
360.906,
362.826
],
"text": "なんと、本物の鍵。"
},
{
"no": 69,
"start": 363.426,
"end": 368.116,
"speed": 1.0,
"slot": [
363.426,
368.116
],
"text": "どこかで漏れていた、お城で働く人のIDとパスワードです。"
},
{
"no": 70,
"start": 368.716,
"end": 372.586,
"speed": 1.0,
"slot": [
368.716,
372.586
],
"text": "本物の鍵なので、門番さんも、なかなか気づけません。"
},
{
"no": 71,
"start": 373.186,
"end": 377.015,
"speed": 1.0,
"slot": [
373.186,
377.015
],
"text": "この鍵が、どこから来たのか。それは、あとで分かります。"
},
{
"no": 72,
"start": 377.915,
"end": 382.765,
"speed": 1.0,
"slot": [
377.915,
382.765
],
"text": "古いままの錠、かんたんな鍵、そして漏れた鍵。"
},
{
"no": 73,
"start": 383.665,
"end": 388.645,
"speed": 1.0,
"slot": [
383.665,
388.645
],
"text": "泥棒は、こうした弱い所を探して、そこから入っていたのです。"
},
{
"no": 74,
"start": 389.545,
"end": 397.165,
"speed": 1.0,
"slot": [
389.545,
397.165
],
"text": "先ほど裏口から入った影は、すぐに名札、つまりお客さんの情報を持ち出したのでしょうか？"
},
{
"no": 75,
"start": 397.765,
"end": 403.525,
"speed": 1.0,
"slot": [
397.765,
403.525
],
"text": "……いいえ。影は、足音を立てずに、お城の中を歩きはじめました。"
},
{
"no": 76,
"start": 404.125,
"end": 408.995,
"speed": 1.0,
"slot": [
404.125,
408.995
],
"text": "部屋を1つずつのぞいては、何があるかを調べていきます。"
},
{
"no": 77,
"start": 409.595,
"end": 417.525,
"speed": 1.0,
"slot": [
409.595,
417.525
],
"text": "次の夜も、また次の夜も。カレンダーが1枚、また1枚とめくれていきます。"
},
{
"no": 78,
"start": 418.125,
"end": 424.845,
"speed": 1.0,
"slot": [
418.125,
424.845
],
"text": "その間、昼のお城はいつもどおり。働く人は、だれも気づきません。"
},
{
"no": 79,
"start": 425.445,
"end": 429.755,
"speed": 1.0,
"slot": [
425.445,
429.755
],
"text": "まるロボは、柱のかげで、ずっと影を見張っています。"
},
{
"no": 80,
"start": 430.355,
"end": 434.355,
"speed": 1.0,
"slot": [
430.355,
434.355
],
"text": "それにしても、なぜ、こんなに時間をかけるのでしょう？"
},
{
"no": 81,
"start": 434.955,
"end": 441.185,
"speed": 1.0,
"slot": [
434.955,
441.185
],
"text": "それは、盗む前に、お城の中のことをすみずみまで知っておくためです。"
},
{
"no": 82,
"start": 442.085,
"end": 446.715,
"speed": 1.0,
"slot": [
442.085,
446.715
],
"text": "やがて影は、お城を管理する人の鍵束を手に入れました。"
},
{
"no": 83,
"start": 447.315,
"end": 451.255,
"speed": 1.0,
"slot": [
447.315,
451.255
],
"text": "これがあれば、中のどの部屋の扉も開けられます。"
},
{
"no": 84,
"start": 451.855,
"end": 458.745,
"speed": 1.0,
"slot": [
451.855,
458.745
],
"text": "本物の会社では、中のパソコンを全部動かせる、管理する人のIDにあたります。"
},
{
"no": 85,
"start": 459.345,
"end": 464.095,
"speed": 1.0,
"slot": [
459.345,
464.095
],
"text": "そして、2つの部屋の扉に、こっそり印を付けました。"
},
{
"no": 86,
"start": 464.695,
"end": 470.635,
"speed": 1.0,
"slot": [
464.695,
470.635
],
"text": "1つ目は、ここ。お客さんの名札がしまってある、名札の倉庫です。"
},
{
"no": 87,
"start": 471.235,
"end": 478.465,
"speed": 1.0,
"slot": [
471.235,
478.465
],
"text": "名札は、影にとってお金になる物。あとで運び出すために、場所を覚えておくのです。"
},
{
"no": 88,
"start": 479.065,
"end": 483.975,
"speed": 1.0,
"slot": [
479.065,
483.975
],
