"no": 68,
"start": 361.366,
"end": 363.286,
"speed": 1.0,
"slot": [
361.366,
363.286
],
"text": "なんと、本物の鍵。"
},
{
"no": 69,
"start": 363.886,
"end": 368.576,
"speed": 1.0,
"slot": [
363.886,
368.576
],
"text": "どこかで漏れていた、お城で働く人のIDとパスワードです。"
},
{
"no": 70,
"start": 369.176,
"end": 373.046,
"speed": 1.0,
"slot": [
369.176,
373.046
],
"text": "本物の鍵なので、門番さんも、なかなか気づけません。"
},
{
"no": 71,
"start": 373.646,
"end": 377.475,
"speed": 1.0,
"slot": [
373.646,
377.475
],
"text": "この鍵が、どこから来たのか。それは、あとで分かります。"
},
{
"no": 72,
"start": 378.375,
"end": 383.225,
"speed": 1.0,
"slot": [
378.375,
383.225
],
"text": "古いままの錠、かんたんな鍵、そして漏れた鍵。"
},
