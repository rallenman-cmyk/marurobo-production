"no": 211,
"start": 1129.105,
"end": 1132.465,
"speed": 1.0,
"slot": [
1129.105,
1132.465
],
"text": "まるロボは、ドキドキして、思わず息をのみました。"
},
{
"no": 212,
"start": 1133.065,
"end": 1135.415,
"speed": 1.0,
"slot": [
1133.065,
1135.415
],
"text": "1つ目のドアに、鍵を差しこむと……"
