"no": 160,
"start": 891.467,
"end": 894.027,
"speed": 1.0,
"slot": [
891.467,
894.027
],
"text": "まるロボは、もう、がまんできません。"
},
{
"no": 161,
"start": 894.627,
"end": 900.877,
"speed": 1.0,
"slot": [
894.627,
900.877
],
"text": "棚に残っていた箱にとびこむと、自分の名札を頭に載せて、走り出しました。"
},
