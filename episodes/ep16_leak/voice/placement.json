"no": 56,
"start": 297.496,
"end": 302.236,
"speed": 1.0,
"slot": [
297.496,
302.236
],
"text": "2025年の1年間の、警察のまとめを見てみます。"
},
{
"no": 57,
"start": 302.836,
"end": 308.896,
"speed": 1.0,
"slot": [
302.836,
308.896
],
"text": "泥棒に入られた会社に聞いて、どこから入られたかが分かったのは92件。"
