{
"no": 262,
"start": 1408.037,
"end": 1412.827,
"speed": 1.0,
"slot": [
1408.037,
1412.827
],
"text": "ドアごとにちがう鍵なら、1つ漏れても、ほかのドアは開きません。"
},
{
"no": 263,
"start": 1413.427,
"end": 1417.387,
"speed": 1.0,
"slot": [
1413.427,
1417.387
],
"text": "さっき開いてしまったドアも、新しい鍵に替えておきます。"
