"no": 247,
"start": 1303.215,
"end": 1306.815,
"speed": 1.0,
"slot": [
1303.215,
1306.815
],
"text": "お城で働く人の、IDとパスワードでした。"
},
{
"no": 248,
"start": 1307.415,
"end": 1311.475,
"speed": 1.0,
"slot": [
1307.415,
1311.475
],
"text": "あのときは、その鍵がどこから来たのか、分かりませんでしたね。"
},
{
"no": 249,
"start": 1312.075,
"end": 1317.535,
"speed": 1.0,
"slot": [
1312.075,
1317.535
],
"text": "もしかすると、あの鍵も、こうしてだれかがだまし取られた物だったのかもしれません。"
},
