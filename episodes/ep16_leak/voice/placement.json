"no": 245,
"start": 1292.065,
"end": 1295.305,
"speed": 1.0,
"slot": [
1292.065,
1295.305
],
"text": "あれ？　この場面、どこかで見ましたね。"
},
{
"no": 246,
"start": 1295.905,
"end": 1302.615,
"speed": 1.0,
"slot": [
1295.905,
1302.615
],
"text": "思い出してください。最初のお城で、影が裏口を開けた、あの本物の鍵。"
},
