"no": 68,
"start": 361.366,
"end": 363.286,
"speed": 1.0,
"slot": [
361.366,
363.286
],
"text": "なんと、本物の鍵。"
},
{
"no": 69,
"start": 363.886,
"end": 368.576,
"speed": 1.0,
"slot": [
363.886,
368.576
],
"text": "どこかで漏れていた、お城で働く人のIDとパスワードです。"
},
