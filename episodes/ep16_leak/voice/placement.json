"start": 783.027,
"end": 787.157,
"speed": 1.0,
"slot": [
783.027,
787.157
],
"text": "たどり着いたのは、うす暗い倉庫のような所でした。"
},
{
"no": 139,
"start": 787.757,
"end": 791.917,
"speed": 1.0,
"slot": [
787.757,
791.917
],
"text": "そっと中をのぞくと……棚に、箱がずらり。"
},
{
"no": 140,
"start": 792.517,
"end": 796.447,
"speed": 1.0,
"slot": [
792.517,
796.447
],
"text": "どの箱にも、いろいろなお城の印が付いています。"
},
{
"no": 141,
"start": 797.047,
"end": 801.517,
"speed": 1.0,
"slot": [
797.047,
801.517
],
"text": "ここは、ふつうの検索では出てこない、かくれた市場。"
},
