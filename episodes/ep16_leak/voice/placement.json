{
"no": 205,
"start": 1097.415,
"end": 1102.335,
"speed": 1.0,
"slot": [
1097.415,
1102.335
],
"text": "漏れた情報の中には、IDとパスワードが入っていることもあるのです。"
},
{
"no": 206,
"start": 1102.935,
"end": 1107.765,
"speed": 1.0,
"slot": [
1102.935,
1107.765
],
"text": "その鍵で、ほかのドアも開かないか、試してみようというのです。"
},
{
"no": 207,
"start": 1108.665,
"end": 1112.015,
"speed": 1.0,
"slot": [
1108.665,
1112.015
],
"text": "機械は、ドアに鍵を次々に差しこんでいきます。"
},
{
"no": 208,
"start": 1112.615,
"end": 1117.225,
"speed": 1.0,
"slot": [
1112.615,
1117.225
],
"text": "ガチャ、ガチャ……。ほとんどのドアは、開きません。"
},
{
"no": 209,
"start": 1117.825,
"end": 1122.295,
"speed": 1.0,
"slot": [
1117.825,
1122.295
],
"text": "それでも機械は、休まずに、たくさんのドアを試していきます。"
