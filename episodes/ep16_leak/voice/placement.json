"no": 162,
"start": 901.477,
"end": 907.397,
"speed": 1.0,
"slot": [
901.477,
907.397
],
"text": "家まで走って帰ると、名札を金庫にしまい、しっかり扉を閉めます。"
},
{
"no": 163,
"start": 907.997,
"end": 910.427,
"speed": 1.0,
"slot": [
907.997,
910.427
],
"text": "ぴょん、ぴょん。取り返しました！"
},
{
"no": 164,
"start": 911.207,
"end": 912.527,
"speed": 1.0,
"slot": [
911.207,
912.527
],
"text": "これで、ひと安心……。"
},
{
"no": 165,
"start": 914.077,
"end": 919.447,
"speed": 1.0,
"slot": [
914.077,
919.447
],
"text": "でも、何かがおかしいですね。だれも、追いかけてきません。"
},
{
"no": 166,
"start": 920.047,
"end": 923.187,
"speed": 1.0,
"slot": [
920.047,
923.187
],
"text": "まるロボの名札が、安いから……？"
},
{
"no": 167,
"start": 924.087,
"end": 928.687,
"speed": 1.0,
"slot": [
924.087,
928.687
],
"text": "それとも、取り返されても、影が困らない理由があるのでしょうか？"
},
{
"no": 168,
"start": 929.287,
"end": 933.067,
"speed": 1.0,
"slot": [
929.287,
933.067
],
"text": "気になったまるロボは、もう一度、市場へ戻ってみます。"
