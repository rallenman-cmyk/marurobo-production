"no": 211,
"start": 1159.807,
"end": 1163.167,
"speed": 1.0,
"slot": [
1159.807,
1163.167
],
"text": "まるロボは、ドキドキして、思わず息をのみました。"
},
{
"no": 212,
"start": 1163.767,
"end": 1166.117,
"speed": 1.0,
"slot": [
1163.767,
1166.117
],
"text": "1つ目のドアに、鍵を差しこむと……"
