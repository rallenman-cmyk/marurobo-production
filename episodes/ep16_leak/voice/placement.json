[
{
"no": 1,
"start": 0.5,
"end": 5.3,
"speed": 1.0,
"slot": [
0.5,
5.3
],
"text": "ある朝、まるロボのスマホに、1通のメールが届きました。"
},
{
"no": 2,
"start": 6.3,
"end": 9.69,
"speed": 1.0,
"slot": [
6.3,
9.69
],
"text": "いつも買い物をしている、ネットのお店からです。"
},
{
"no": 3,
"start": 10.29,
"end": 15.17,
"speed": 1.0,
"slot": [
10.29,
15.17
],
"text": "セールのお知らせかな？　まるロボは、わくわくしながら開きます。"
},
{
"no": 4,
"start": 16.07,
"end": 20.25,
"speed": 1.0,
"slot": [
16.07,
20.25
],
"text": "「お客さまの情報が、流出したおそれがあります」"
},
{
"no": 5,
"start": 21.15,
"end": 25.73,
"speed": 1.0,
"slot": [
21.15,
25.73
],
"text": "……え？　それは、お店からの、おわびのメールでした。"
},
{
"no": 6,
"start": 26.33,
"end": 32.29,
"speed": 1.0,
"slot": [
26.33,
32.29
],
"text": "流出とは、お店に預けていた情報が、外へ盗み出されてしまうこと。"
},
{
"no": 7,
"start": 32.89,
"end": 37.49,
"speed": 1.0,
"slot": [
32.89,
37.49
],
"text": "まるロボも、会員になるときに、自分の情報を預けていました。"
},
{
"no": 8,
"start": 38.09,
"end": 42.68,
"speed": 1.0,
"slot": [
38.09,
42.68
],
"text": "名前に住所、電話番号、そしてメールアドレスです。"
},
{
"no": 9,
"start": 43.28,
"end": 47.216,
"speed": 1.0,
"slot": [
43.28,
47.216
],
"text": "あの情報が、知らないだれかの手に渡ってしまった……？"
},
{
"no": 10,
"start": 48.016,
"end": 52.126,
"speed": 1.0,
"slot": [
48.016,
52.126
],
"text": "でも、このお店に預けたのは、この4つだけです。"
},
{
"no": 11,
"start": 52.726,
"end": 59.726,
"speed": 1.0,
"slot": [
52.726,
59.726
],
"text": "誕生日も勤め先も、教えていません。それなら、まだ安心……かな？"
},
{
"no": 12,
"start": 60.626,
"end": 63.776,
"speed": 1.0,
"slot": [
60.626,
63.776
],
"text": "まるロボは、あわてて部屋の中をきょろきょろ。"
},
{
"no": 13,
"start": 64.376,
"end": 68.576,
"speed": 1.0,
"slot": [
64.376,
68.576
],
"text": "どうやら、泥棒が部屋にいないか、探しているようです。"
},
{
"no": 14,
"start": 69.176,
"end": 73.826,
"speed": 1.0,
"slot": [
69.176,
73.826
],
"text": "でも、まるロボ。盗まれたのは、お店のほうですよ。"
},
{
"no": 15,
"start": 74.726,
"end": 81.036,
"speed": 1.0,
"slot": [
74.726,
81.036
],
"text": "2026年の秋、こうした流出の発表が、次々に続きました。"
},
{
"no": 16,
"start": 81.636,
"end": 85.316,
"speed": 1.0,
"slot": [
81.636,
85.316
],
"text": "でも、メールには、くわしいことは書いてありません。"
},
{
"no": 17,
"start": 85.916,
"end": 89.216,
"speed": 1.0,
"slot": [
85.916,
89.216
],
"text": "泥棒は、いったい、どこから入ったのでしょうか？"
},
{
"no": 18,
"start": 89.816,
"end": 93.536,
"speed": 1.0,
"slot": [
89.816,
93.536
],
"text": "そして、盗まれた情報は、いまどこにあるのか？"
},
{
"no": 19,
"start": 94.936,
"end": 99.012,
"speed": 1.0,
"slot": [
94.936,
99.176
],
"text": "盗まれてから、そのあとまで。一緒に、見ていきます。"
},
{
"no": 20,
"start": 100.176,
"end": 104.296,
"speed": 1.0,
"slot": [
100.176,
104.296
],
"text": "ここからは分かりやすく、目に見える形にたとえてみましょう。"
},
{
"no": 21,
"start": 105.196,
"end": 109.376,
"speed": 1.0,
"slot": [
105.196,
109.376
],
"text": "情報が盗まれたお店の会社は、大きなお城。"
},
{
"no": 22,
"start": 110.276,
"end": 117.346,
"speed": 1.0,
"slot": [
110.276,
117.346
],
"text": "1人分の情報は、名前と住所と電話とメールの絵が付いた、1枚の名札です。"
},
{
"no": 23,
"start": 118.246,
"end": 123.916,
"speed": 1.0,
"slot": [
118.246,
123.916
],
"text": "そして、IDとパスワードは、扉を開ける鍵の形で表します。"
},
{
"no": 24,
"start": 124.716,
"end": 129.676,
"speed": 1.0,
"slot": [
124.716,
129.676
],
"text": "では、まるロボと一緒に、盗まれた名札を追いかけてみましょう。"
},
{
"no": 25,
"start": 130.576,
"end": 134.496,
"speed": 1.0,
"slot": [
130.576,
134.496
],
"text": "まずは、名札を預けていたお城へ、行ってみます。"
},
{
"no": 26,
"start": 135.096,
"end": 140.046,
"speed": 1.0,
"slot": [
135.096,
140.046
],
"text": "見てください。高いかべに、大きな正面の門。"
},
{
"no": 27,
"start": 140.646,
"end": 144.026,
"speed": 1.0,
"slot": [
140.646,
144.026
],
"text": "門の前では、門番さんが、じっと見張っています。"
},
{
"no": 28,
"start": 144.626,
"end": 149.386,
"speed": 1.0,
"slot": [
144.626,
149.386
],
"text": "こんなに固そうなお城に、泥棒は、どうやって入ったのでしょう？"
},
{
"no": 29,
"start": 150.386,
"end": 152.476,
"speed": 1.0,
"slot": [
150.386,
152.476
],
"text": "まるロボが門を押してみると……"
},
{
"no": 30,
"start": 153.076,
"end": 154.326,
"speed": 1.0,
"slot": [
153.076,
154.326
],
"text": "びくともしません。"
},
{
"no": 31,
"start": 155.326,
"end": 158.156,
"speed": 1.0,
"slot": [
155.326,
158.156
],
"text": "えいっ、と体当たりしても……"
},
{
"no": 32,
"start": 158.856,
"end": 159.996,
"speed": 1.0,
"slot": [
158.856,
159.996
],
"text": "やっぱり、だめ。"
},
{
"no": 33,
"start": 160.596,
"end": 163.636,
"speed": 1.0,
"slot": [
160.596,
163.636
],
"text": "正面からは、とても入れそうにありませんね。"
},
{
"no": 34,
"start": 164.636,
"end": 170.026,
"speed": 1.0,
"slot": [
164.636,
170.026
],
"text": "映画では、泥棒がキーボードをすばやく打って、正面の守りを破ります。"
},
{
"no": 35,
"start": 170.926,
"end": 175.716,
"speed": 1.0,
"slot": [
170.926,
175.716
],
"text": "でも、本当に多いのは、そういう派手な入り方ではありません。"
},
{
"no": 36,
"start": 176.316,
"end": 179.846,
"speed": 1.0,
"slot": [
176.316,
179.846
],
"text": "では、泥棒は、どこから入ったのか？"
},
{
"no": 37,
"start": 180.846,
"end": 184.026,
"speed": 1.0,
"slot": [
180.846,
184.026
],
"text": "お城のまわりを、ぐるっと回ってみます。"
},
{
"no": 38,
"start": 184.626,
"end": 190.096,
"speed": 1.0,
"slot": [
184.626,
190.096
],
"text": "すると、横のかべの低い所に、小さな扉がありました。"
},
{
"no": 39,
"start": 190.696,
"end": 195.976,
"speed": 1.0,
"slot": [
190.696,
195.976
],
"text": "まるロボは……まだ、正面の門を見ていますね。"
},
{
"no": 40,
"start": 196.876,
"end": 199.226,
"speed": 1.0,
"slot": [
196.876,
199.226
],
"text": "おーい、まるロボ。うしろです。"
},
{
"no": 41,
"start": 200.226,
"end": 204.036,
"speed": 1.0,
"slot": [
200.226,
204.036
],
"text": "この小さな扉は、お城の裏口です。"
},
{
"no": 42,
"start": 204.636,
"end": 209.046,
"speed": 1.0,
"slot": [
204.636,
209.046
],
"text": "でも、なぜお城に、こんな扉があるのでしょうか？"
},
{
"no": 43,
"start": 209.946,
"end": 217.596,
"speed": 1.0,
"slot": [
209.946,
217.596
],
"text": "たとえば、家で仕事をするとき。会社の中の書類やパソコンが、必要になりますね。"
},
{
"no": 44,
"start": 218.196,
"end": 224.426,
"speed": 1.0,
"slot": [
218.196,
224.426
],
"text": "そこで、外からでも会社の中に入れるように、こうした入口を作ってあるのです。"
},
{
"no": 45,
"start": 225.026,
"end": 230.946,
"speed": 1.0,
"slot": [
225.026,
230.946
],
"text": "本物の会社では、外から会社につなぐ、出入口の機械にあたります。"
},
{
"no": 46,
"start": 231.546,
"end": 237.846,
"speed": 1.0,
"slot": [
231.546,
237.846
],
"text": "とても便利な入口ですが、ここが、泥棒にねらわれやすい所でもあるのです。"
},
{
"no": 47,
"start": 238.746,
"end": 243.206,
"speed": 1.0,
"slot": [
238.746,
243.206
],
"text": "では、裏口のどこが、ねらわれるのか。近くで見てみます。"
},
{
"no": 48,
"start": 243.806,
"end": 247.386,
"speed": 1.0,
"slot": [
243.806,
247.386
],
"text": "見てください。この錠は、ずいぶん古いままです。"
},
{
"no": 49,
"start": 248.286,
"end": 254.036,
"speed": 1.0,
"slot": [
248.286,
254.036
],
"text": "錠を作った人は、弱い所が見つかると、直すための部品を届けてくれます。"
},
{
"no": 50,
"start": 254.636,
"end": 262.016,
"speed": 1.0,
"slot": [
254.636,
262.016
],
"text": "本物では、出入口の機械を作った会社が、弱い所を直す新しいプログラムを配っています。"
},
{
"no": 51,
"start": 262.616,
"end": 269.416,
"speed": 1.0,
"slot": [
262.616,
269.416
],
"text": "ところが、直さずに使い続けていると、その弱い所から開けられてしまうのです。"
},
{
"no": 52,
"start": 270.016,
"end": 275.576,
"speed": 1.0,
"slot": [
270.016,
275.576
],
"text": "このように、見つかった弱い所が、直されないまま残っていることがあります。"
},
{
"no": 53,
"start": 276.576,
"end": 282.406,
"speed": 1.0,
"slot": [
276.576,
282.406
],
"text": "また、鍵はかかっていても、かんたんな形の鍵で開いてしまう裏口もあります。"
},
{
"no": 54,
"start": 283.006,
"end": 291.306,
"speed": 1.0,
"slot": [
283.006,
291.306
],
"text": "ここでいう弱い鍵とは、誕生日や「1234」のように、すぐに当てられるパスワードのこと。"
},
{
"no": 55,
"start": 292.206,
"end": 296.696,
"speed": 1.0,
"slot": [
292.206,
296.696
],
"text": "では、本当に、裏口から入られることは多いのでしょうか？"
