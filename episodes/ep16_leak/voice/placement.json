"no": 201,
"start": 1076.605,
"end": 1081.095,
"speed": 1.0,
"slot": [
1076.605,
1081.095
],
"text": "ここは町の通り。家のドアが、ずらりと並んでいます。"
},
{
"no": 202,
"start": 1081.695,
"end": 1086.805,
"speed": 1.0,
"slot": [
1081.695,
1086.805
],
"text": "ドアの1つ1つは、買い物や動画など、ほかのサイトの入口です。"
},
