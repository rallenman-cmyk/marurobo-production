 "subs": [
  {
   "id": "01-01",
   "t0": 0.5,
   "t1": 5.14,
   "text": "ある朝、まるロボのスマホに、1通のメールが届きました。",
   "who": "ナレーション"
  },
  {
   "id": "01-02",
   "t0": 6.14,
   "t1": 9.38,
   "text": "いつも買い物をしている、ネットのお店からです。",
   "who": "ナレーション"
  },
  {
   "id": "01-03",
   "t0": 9.78,
   "t1": 14.56,
   "text": "セールのお知らせかな？　まるロボは、わくわくしながら開きます。",
   "who": "ナレーション"
  },
  {
   "id": "02-01",
   "t0": 15.36,
   "t1": 20.34,
   "text": "「お客さまの情報が、流出したおそれがあります」",
   "who": "ナレーション"
  },
  {
   "id": "02-02",
   "t0": 21.24,
   "t1": 24.26,
   "text": "……え？　それは、お店からの、おわびのメールでした。",
   "who": "ナレーション"
  },
  {
   "id": "02-03",
   "t0": 24.66,
   "t1": 30.52,
   "text": "流出とは、お店に預けていた情報が、外へ盗み出されてしまうこと。",
   "who": "ナレーション"
  },
  {
   "id": "02-04",
   "t0": 30.92,
   "t1": 35.42,
   "text": "まるロボも、会員になるときに、自分の情報を預けていました。",
   "who": "ナレーション"
  },
  {
   "id": "02-05",
   "t0": 35.82,
   "t1": 40.31,
   "text": "名前に住所、電話番号、そしてメールアドレスです。",
   "who": "ナレーション"
  },
  {
   "id": "02-06",
   "t0": 40.71,
   "t1": 44.55,
   "text": "あの情報が、知らないだれかの手に渡ってしまった……？",
   "who": "ナレーション"
  },
  {
   "id": "02-07",
   "t0": 45.35,
   "t1": 49.36,
   "text": "でも、このお店に預けたのは、この4つだけです。",
   "who": "ナレーション"
  },
  {
   "id": "02-08",
   "t0": 49.76,
   "t1": 56.66,
   "text": "誕生日も勤め先も、教えていません。それなら、まだ安心……かな？",
   "who": "ナレーション"
  },
  {
   "id": "03-01",
   "t0": 57.56,
   "t1": 60.61,
   "text": "まるロボは、あわてて部屋の中をきょろきょろ。",
   "who": "ナレーション"
  },
  {
   "id": "03-02",
   "t0": 61.01,
   "t1": 65.11,
   "text": "どうやら、どろぼうが部屋にいないか、探しているようです。",
   "who": "ナレーション"
  },
  {
   "id": "03-03",
   "t0": 65.51,
   "t1": 69.93,
   "text": "でも、まるロボ。盗まれたのは、お店のほうですよ。",
   "who": "ナレーション"
  },
  {
   "id": "04-01",
   "t0": 70.83,
   "t1": 77.04,
   "text": "2026年の秋、こうした流出の発表が、次々に続きました。",
   "who": "ナレーション"
  },
  {
   "id": "04-02",
   "t0": 77.44,
   "t1": 81.02,
   "text": "でも、メールには、くわしいことは書いてありません。",
   "who": "ナレーション"
  },
  {
   "id": "04-03",
   "t0": 81.42,
   "t1": 84.58,
   "text": "泥棒は、いったい、どこから入ったのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "04-04",
   "t0": 85.18,
   "t1": 88.8,
   "text": "そして、盗まれた情報は、いまどこにあるのか？",
   "who": "ナレーション"
  },
  {
   "id": "04-05",
   "t0": 90.2,
   "t1": 94.34,
   "text": "盗まれてから、そのあとまで。一緒に、確かめてみます。",
   "who": "ナレーション"
  },
  {
   "id": "05-01",
   "t0": 95.34,
   "t1": 99.46,
   "text": "ここからは分かりやすく、目に見える形にたとえてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "05-02",
   "t0": 100.36,
   "t1": 104.44,
   "text": "情報が盗まれたお店の会社は、大きなお城。",
   "who": "ナレーション"
  },
  {
   "id": "05-03",
   "t0": 105.34,
   "t1": 112.3,
   "text": "1人分の情報は、名前と住所と電話とメールの絵が付いた、1枚の名札です。",
   "who": "ナレーション"
  },
  {
   "id": "05-04",
   "t0": 113.2,
   "t1": 118.77,
   "text": "そして、IDとパスワードは、扉を開ける鍵の形で表します。",
   "who": "ナレーション"
  },
  {
   "id": "05-05",
   "t0": 119.57,
   "t1": 124.43,
   "text": "では、まるロボと一緒に、盗まれた名札を追いかけてみましょう。",
   "who": "ナレーション"
  },
  {
   "id": "06-01",
   "t0": 125.33,
   "t1": 129.15,
   "text": "まずは、名札を預けていたお城へ、行ってみます。",
   "who": "ナレーション"
  },
  {
   "id": "06-02",
   "t0": 129.55,
   "t1": 134.4,
   "text": "見てください。高いかべに、大きな正面の門。",
   "who": "ナレーション"
  },
  {
   "id": "06-03",
   "t0": 134.8,
   "t1": 138.08,
   "text": "門の前では、門番さんが、じっと見張っています。",
   "who": "ナレーション"
  },
  {
   "id": "06-04",
   "t0": 138.48,
   "t1": 143.11,
   "text": "こんなに固そうなお城に、泥棒は、どうやって入ったのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "06-05",
   "t0": 144.11,
   "t1": 145.99,
   "text": "まるロボが門を押してみると……",
   "who": "ナレーション"
  },
  {
   "id": "06-06",
   "t0": 146.59,
   "t1": 147.74,
   "text": "びくともしません。",
   "who": "ナレーション"
  },
  {
   "id": "06-07",
   "t0": 148.74,
   "t1": 151.57,
   "text": "えいっ、と体当たりしても……",
   "who": "ナレーション"
  },
  {
   "id": "06-08",
   "t0": 152.27,
   "t1": 153.31,
   "text": "やっぱり、だめ。",
   "who": "ナレーション"
  },
  {
   "id": "06-09",
   "t0": 153.71,
   "t1": 156.65,
   "text": "正面からは、とても入れそうにありませんね。",
   "who": "ナレーション"
  },
  {
   "id": "07-01",
   "t0": 157.65,
   "t1": 162.91,
   "text": "映画では、泥棒がキーボードをすばやく打って、正面の守りを破ります。",
   "who": "ナレーション"
  },
  {
   "id": "07-02",
   "t0": 163.81,
   "t1": 168.5,
   "text": "でも、本当に多いのは、そういう派手な入り方ではありません。",
   "who": "ナレーション"
  },
  {
   "id": "07-03",
   "t0": 168.9,
   "t1": 172.33,
   "text": "では、泥棒は、どこから入ったのか？",
   "who": "ナレーション"
  },
  {
   "id": "08-01",
   "t0": 173.33,
   "t1": 176.41,
   "text": "お城のまわりを、ぐるっと回ってみます。",
   "who": "ナレーション"
  },
  {
   "id": "08-02",
   "t0": 176.81,
   "t1": 182.18,
   "text": "すると、横のかべの低い所に、小さな扉がありました。",
   "who": "ナレーション"
  },
  {
   "id": "08-03",
   "t0": 182.58,
   "t1": 187.58,
   "text": "まるロボは……まだ、正面の門を見ていますね。",
   "who": "ナレーション"
  },
  {
   "id": "08-04",
   "t0": 188.48,
   "t1": 190.68,
   "text": "おーい、まるロボ。うしろです。",
   "who": "ナレーション"
  },
  {
   "id": "09-01",
   "t0": 191.68,
   "t1": 195.39,
   "text": "この小さな扉は、お城の裏口です。",
   "who": "ナレーション"
  },
  {
   "id": "09-02",
   "t0": 195.79,
   "t1": 200.1,
   "text": "でも、なぜお城に、こんな扉があるのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "09-03",
   "t0": 201.0,
   "t1": 208.55,
   "text": "たとえば、家で仕事をするとき。会社の中の書類やパソコンが、必要になりますね。",
   "who": "ナレーション"
  },
  {
   "id": "09-04",
   "t0": 208.95,
   "t1": 215.08,
   "text": "そこで、外からでも会社の中に入れるように、こうした入口を作ってあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "09-05",
   "t0": 215.48,
   "t1": 221.3,
   "text": "本物の会社では、外から会社につなぐ、出入口の機械にあたります。",
   "who": "ナレーション"
  },
  {
   "id": "09-06",
   "t0": 221.7,
   "t1": 228.0,
   "text": "とても便利な入口ですが、ここが、泥棒にねらわれやすい所でもあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "10-01",
   "t0": 228.71,
   "t1": 232.99,
   "text": "では、裏口のどこが、ねらわれるのか。近くで見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "10-02",
   "t0": 233.39,
   "t1": 236.87,
   "text": "見てください。この錠は、ずいぶん古いままです。",
   "who": "ナレーション"
  },
  {
   "id": "10-03",
   "t0": 237.77,
   "t1": 243.42,
   "text": "錠を作った人は、弱い所が見つかると、直すための部品を届けてくれます。",
   "who": "ナレーション"
  },
  {
   "id": "10-04",
   "t0": 243.82,
   "t1": 251.1,
   "text": "本物では、出入口の機械を作った会社が、弱い所を直す新しいプログラムを配っています。",
   "who": "ナレーション"
  },
  {
   "id": "10-05",
   "t0": 251.5,
   "t1": 258.2,
   "text": "ところが、直さずに使い続けていると、その弱い所から開けられてしまうのです。",
   "who": "ナレーション"
  },
  {
   "id": "10-06",
   "t0": 258.6,
   "t1": 264.06,
   "text": "このように、見つかった弱い所が、直されないまま残っていることがあります。",
   "who": "ナレーション"
  },
  {
   "id": "10-07",
   "t0": 265.06,
   "t1": 270.74,
   "text": "また、鍵はかかっていても、かんたんな形の鍵で開いてしまう裏口もあります。",
   "who": "ナレーション"
  },
  {
   "id": "10-08",
   "t0": 271.14,
   "t1": 279.34,
   "text": "ここでいう弱い鍵とは、誕生日や「1234」のように、すぐに当てられるパスワードのこと。",
   "who": "ナレーション"
  },
  {
   "id": "11-01",
   "t0": 280.24,
   "t1": 284.59,
   "text": "では、本当に、裏口から入られることは多いのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "11-02",
   "t0": 285.39,
   "t1": 290.03,
   "text": "2025年の1年間の、警察のまとめを見てみます。",
   "who": "ナレーション"
  },
  {
   "id": "11-03",
   "t0": 290.43,
   "t1": 296.39,
   "text": "泥棒に入られた会社に聞いて、どこから入られたかが分かったのは92件。",
   "who": "ナレーション"
  },
  {
   "id": "11-04",
   "t0": 296.79,
   "t1": 301.6,
   "text": "そのうち61件が、この出入口の機械から入られていました。",
   "who": "ナレーション"
  },
  {
   "id": "11-05",
   "t0": 302.0,
   "t1": 305.71,
   "text": "そして、裏口には、もう1つ種類があります。",
   "who": "ナレーション"
  },
  {
   "id": "11-06",
   "t0": 306.11,
   "t1": 311.34,
   "text": "家にいながら、会社の机のパソコンを、画面ごと動かせるしくみです。",
   "who": "ナレーション"
  },
  {
   "id": "11-07",
   "t0": 311.74,
   "t1": 316.28,
   "text": "まるで、遠くから会社の机に座っているように使えるのですね。",
   "who": "ナレーション"
  },
  {
   "id": "11-08",
   "t0": 316.68,
   "t1": 319.38,
   "text": "ここから入られたのが、19件。",
   "who": "ナレーション"
  },
  {
   "id": "11-09",
   "t0": 319.78,
   "t1": 326.27,
   "text": "2つを合わせると80件。92件のうち、ほとんどが裏口からだったのです。",
   "who": "ナレーション"
  },
  {
   "id": "11-10",
   "t0": 327.27,
   "t1": 330.43,
   "text": "正面の門を破られたのでは、なかったのですね。",
   "who": "ナレーション"
  },
  {
   "id": "12-01",
   "t0": 331.83,
   "t1": 336.35,
   "text": "ここで、流出が起きる前の夜に、時間を巻きもどしてみます。",
   "who": "ナレーション"
  },
  {
