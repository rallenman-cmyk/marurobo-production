 "subs": [
  {
   "id": "27-01",
   "t0": 0.05,
   "t1": 3.72,
   "text": "使い道の1つ目は、ほかのドアを試すことです。",
   "who": "ナレーション"
  },
  {
   "id": "27-02",
   "t0": 4.32,
   "t1": 8.81,
   "text": "ここは町の通り。家のドアが、ずらりと並んでいます。",
   "who": "ナレーション"
  },
  {
   "id": "27-03",
   "t0": 9.41,
   "t1": 14.52,
   "text": "ドアの1つ1つは、買い物や動画など、ほかのサイトの入口です。",
   "who": "ナレーション"
  },
  {
   "id": "27-04",
   "t0": 15.12,
   "t1": 19.17,
   "text": "そこへ、鍵束を持った機械の腕が、やって来ました。",
   "who": "ナレーション"
  },
  {
   "id": "27-05",
   "t0": 19.77,
   "t1": 24.53,
   "text": "本物では、自動で次々に試すプログラムが、この役目をします。",
   "who": "ナレーション"
  },
  {
   "id": "27-06",
   "t0": 25.13,
   "t1": 30.05,
   "text": "漏れた情報の中には、IDとパスワードが入っていることもあるのです。",
   "who": "ナレーション"
  },
  {
   "id": "27-07",
   "t0": 30.65,
   "t1": 35.48,
   "text": "その鍵で、ほかのドアも開かないか、試してみようというのです。",
   "who": "ナレーション"
  },
  {
   "id": "28-01",
   "t0": 36.38,
   "t1": 39.73,
   "text": "機械は、ドアに鍵を次々に差しこんでいきます。",
   "who": "ナレーション"
  },
  {
   "id": "28-02",
   "t0": 40.33,
   "t1": 44.94,
   "text": "ガチャ、ガチャ……。ほとんどのドアは、開きません。",
   "who": "ナレーション"
  },
  {
   "id": "28-03",
   "t0": 45.54,
   "t1": 50.01,
   "text": "それでも機械は、休まずに、たくさんのドアを試していきます。",
   "who": "ナレーション"
  },
  {
   "id": "28-04",
   "t0": 50.61,
   "t1": 56.22,
   "text": "そして、まるロボの家の前へ。ドアが2つ並んでいます。",
   "who": "ナレーション"
  },
  {
   "id": "28-05",
   "t0": 56.82,
   "t1": 60.18,
   "text": "まるロボは、ドキドキして、思わず息をのみました。",
   "who": "ナレーション"
  },
  {
   "id": "28-06",
   "t0": 60.78,
   "t1": 63.13,
   "text": "1つ目のドアに、鍵を差しこむと……",
   "who": "ナレーション"
  },
  {
   "id": "28-07",
   "t0": 63.73,
   "t1": 66.84,
   "text": "ガチャッ。開いてしまいました！",
   "who": "ナレーション"
  },
  {
   "id": "28-08",
   "t0": 67.44,
   "t1": 68.78,
   "text": "まるロボ、ぎょっ。",
   "who": "ナレーション"
  },
  {
   "id": "28-09",
   "t0": 69.54,
   "t1": 73.7,
   "text": "そう、このドアには、お城と同じパスワードを使っていたのです。",
   "who": "ナレーション"
  },
  {
   "id": "28-10",
   "t0": 74.3,
   "t1": 75.65,
   "text": "2つ目のドアは……",
   "who": "ナレーション"
  },
  {
   "id": "28-11",
   "t0": 76.25,
   "t1": 79.9,
   "text": "開きません。こちらは、別のパスワードでした。",
   "who": "ナレーション"
  },
  {
   "id": "28-12",
   "t0": 80.5,
   "t1": 84.27,
   "text": "まるロボは、ほっとして、へなへなと座りこみました。",
   "who": "ナレーション"
  },
  {
   "id": "29-01",
   "t0": 85.17,
   "t1": 91.71,
   "text": "このように、漏れたIDとパスワードを、機械がほかのサイトで次々に試します。",
   "who": "ナレーション"
  },
  {
   "id": "29-02",
   "t0": 92.31,
   "t1": 96.73,
   "text": "同じパスワードを使い回していると、そこでも開いてしまうのです。",
   "who": "ナレーション"
  },
  {
   "id": "29-03",
   "t0": 97.33,
   "t1": 103.7,
   "text": "鍵は、形が合えば開く。だれが差しこんでも、同じことなのですね。",
   "who": "ナレーション"
  }
 ],
 "notes": "6章（18:23〜20:07）の v18 です。v17 のコメント 4 件を直しました：28-02 の声を作り直して「ほとんど」を続けて読む・ドアを部屋の側へ開いて機械の腕を突き抜けないように・へなへなと座りこむ動きを新しく作った・29-02 で開くドアのあいだの 9 枚目も試す（カメラも機械について横へ）。"
}