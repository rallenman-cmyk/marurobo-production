 "subs": [
  {
   "id": "13-01",
   "t0": 0.11,
   "t1": 7.73,
   "text": "先ほど裏口から入った影は、すぐに名札、つまりお客さんの情報を持ち出したのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "13-02",
   "t0": 8.33,
   "t1": 14.09,
   "text": "……いいえ。影は、足音を立てずに、お城の中を歩きはじめました。",
   "who": "ナレーション"
  },
  {
   "id": "13-03",
   "t0": 14.69,
   "t1": 19.56,
   "text": "部屋を1つずつのぞいては、何があるかを調べていきます。",
   "who": "ナレーション"
  },
  {
   "id": "13-04",
   "t0": 20.16,
   "t1": 28.09,
   "text": "次の夜も、また次の夜も。カレンダーが1枚、また1枚とめくれていきます。",
   "who": "ナレーション"
  },
  {
   "id": "13-05",
   "t0": 28.69,
   "t1": 35.41,
   "text": "その間、昼のお城はいつもどおり。働く人は、だれも気づきません。",
   "who": "ナレーション"
  },
  {
   "id": "13-06",
   "t0": 36.0,
   "t1": 40.31,
   "text": "まるロボは、柱のかげで、ずっと影を見張っています。",
   "who": "ナレーション"
  },
  {
   "id": "13-07",
   "t0": 40.92,
   "t1": 44.92,
   "text": "それにしても、なぜ、こんなに時間をかけるのでしょう？",
   "who": "ナレーション"
  },
  {
   "id": "13-08",
   "t0": 45.52,
   "t1": 51.75,
   "text": "それは、盗む前に、お城の中のことをすみずみまで知っておくためです。",
   "who": "ナレーション"
  },
  {
   "id": "14-01",
   "t0": 52.65,
   "t1": 57.28,
   "text": "やがて影は、お城を管理する人の鍵束を手に入れました。",
   "who": "ナレーション"
  },
  {
   "id": "14-02",
   "t0": 57.88,
   "t1": 61.81,
   "text": "これがあれば、中のどの部屋の扉も開けられます。",
   "who": "ナレーション"
  },
  {
   "id": "14-03",
   "t0": 62.42,
   "t1": 69.31,
   "text": "本物の会社では、中のパソコンを全部動かせる、管理する人のIDにあたります。",
   "who": "ナレーション"
  },
  {
   "id": "14-04",
   "t0": 69.91,
   "t1": 74.66,
   "text": "そして、2つの部屋の扉に、こっそり印を付けました。",
   "who": "ナレーション"
  },
  {
   "id": "14-05",
   "t0": 75.25,
   "t1": 81.2,
   "text": "1つ目は、ここ。お客さんの名札がしまってある、名札の倉庫です。",
   "who": "ナレーション"
  },
  {
   "id": "14-06",
   "t0": 81.8,
   "t1": 89.03,
   "text": "名札は、影にとってお金になる物。あとで運び出すために、場所を覚えておくのです。",
   "who": "ナレーション"
  },
  {
   "id": "14-07",
   "t0": 89.62,
   "t1": 94.54,
   "text": "2つ目は、ここ。名札の写しをしまった、予備の倉庫。",
   "who": "ナレーション"
  },
  {
   "id": "14-08",
   "t0": 95.14,
   "t1": 99.91,
   "text": "予備とは、もしものときのために取っておく、データの写しのことです。",
   "who": "ナレーション"
  },
  {
   "id": "14-09",
   "t0": 100.5,
   "t1": 104.03,
   "text": "でも、影は、なぜ予備の場所まで調べたのでしょうか？",
   "who": "ナレーション"
  },
  {
   "id": "14-10",
   "t0": 104.62,
   "t1": 110.23,
   "text": "たとえば、スマホの写真を、別の所にも預けておいたとします。",
   "who": "ナレーション"
  },
  {
   "id": "14-11",
   "t0": 110.83,
   "t1": 116.04,
   "text": "スマホが壊れても、預けておいた写真から、元どおりにできますね。",
   "who": "ナレーション"
  },
  {
   "id": "14-12",
   "t0": 116.64,
   "t1": 118.81,
   "text": "お城の予備も、これと同じ。",
   "who": "ナレーション"
  },
  {
   "id": "14-13",
   "t0": 119.41,
   "t1": 124.33,
   "text": "名札の倉庫が使えなくなっても、予備があれば元に戻せるのです。",
   "who": "ナレーション"
  },
  {
   "id": "14-14",
   "t0": 124.93,
   "t1": 131.62,
   "text": "それが、影にはじゃま。あとで予備も使えなくするために、探していたのです。",
   "who": "ナレーション"
  },
  {
   "id": "15-01",
   "t0": 132.52,
   "t1": 137.89,
   "text": "次に影は、名札の倉庫の扉を、あの鍵束で開けました。",
   "who": "ナレーション"
  },
  {
   "id": "15-02",
   "t0": 138.5,
   "t1": 141.34,
   "text": "そして、名札を箱につめはじめます。",
   "who": "ナレーション"
  },
  {
   "id": "15-03",
   "t0": 141.94,
   "t1": 146.33,
   "text": "見てください。箱の中に、青緑の名札が1枚。",
   "who": "ナレーション"
  },
  {
   "id": "15-04",
   "t0": 146.93,
   "t1": 148.32,
   "text": "まるロボの名札です！",
   "who": "ナレーション"
  },
  {
   "id": "15-05",
   "t0": 148.92,
   "t1": 154.11,
   "text": "影は箱をかかえて、入ってきたときと同じ、あの裏口へ向かいます。",
   "who": "ナレーション"
  },
  {
   "id": "15-06",
   "t0": 154.71,
   "t1": 159.34,
   "text": "正面を見ている門番さんからは、横の裏口は見えません。",
   "who": "ナレーション"
  },
  {
   "id": "15-07",
   "t0": 159.94,
   "t1": 165.45,
   "text": "箱は、だれにも気づかれないまま、お城の外へ運び出されてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "16-01",
   "t0": 166.35,
   "t1": 170.36,
   "text": "でも、影の仕事は、まだ終わりではありませんでした。",
   "who": "ナレーション"
  },
  {
   "id": "16-02",
   "t0": 170.96,
   "t1": 176.85,
   "text": "なんと影は、鍵束を持って、もう一度お城の中へ逆戻り。",
   "who": "ナレーション"
  },
  {
   "id": "16-03",
   "t0": 177.45,
   "t1": 179.55,
   "text": "いったい、何のために？",
   "who": "ナレーション"
  },
  {
   "id": "16-04",
   "t0": 180.14,
   "t1": 184.61,
   "text": "ガチャン。まずは、名札の倉庫に、赤い錠。",
   "who": "ナレーション"
  },
  {
   "id": "16-05",
   "t0": 185.21,
   "t1": 190.63,
   "text": "ガチャン、ガチャン。廊下の扉にも、働く人の部屋にも。",
   "who": "ナレーション"
  },
  {
   "id": "16-06",
   "t0": 191.24,
   "t1": 195.89,
   "text": "……ガチャン！　あの予備の倉庫にまで、赤い錠がかかりました。",
   "who": "ナレーション"
  },
  {
   "id": "16-07",
   "t0": 196.6,
   "t1": 200.83,
   "text": "まるロボは、止めようと走り回りますが、とても追いつけません。",
   "who": "ナレーション"
  },
  {
   "id": "16-08",
   "t0": 201.43,
   "t1": 206.62,
   "text": "お城じゅうの扉が、ひと晩のうちに、全部閉ざされてしまいました。",
   "who": "ナレーション"
  },
  {
   "id": "16-09",
   "t0": 207.23,
   "t1": 213.71,
   "text": "影の錠は、本物では、中のデータを読めない形に変えてしまうことにあたります。",
   "who": "ナレーション"
  },
  {
   "id": "16-10",
   "t0": 214.31,
   "t1": 219.38,
   "text": "次の朝。いつものように、働く人たちがお城にやって来ました。",
   "who": "ナレーション"
  },
  {
   "id": "16-11",
   "t0": 219.99,
   "t1": 220.72,
   "text": "ところが……",
   "who": "ナレーション"
  },
  {
   "id": "16-12",
   "t0": 221.32,
   "t1": 226.75,
   "text": "扉が開きません。この扉も、あの扉も、どの扉もです。",
   "who": "ナレーション"
  },
  {
   "id": "16-13",
   "t0": 227.36,
   "t1": 233.37,
   "text": "このように本物の会社では、ある日突然、パソコンが開かなくなってしまうのです。",
   "who": "ナレーション"
  },
  {
   "id": "16-14",
   "t0": 233.97,
   "t1": 239.32,
   "text": "その結果、注文を受けることも、荷物を送ることもできません。",
   "who": "ナレーション"
  },
  {
   "id": "16-15",
   "t0": 239.92,
   "t1": 243.0,
   "text": "こうして、会社ごと止まってしまうわけです。",
   "who": "ナレーション"
  },
  {
   "id": "17-01",
   "t0": 243.89,
   "t1": 249.59,
   "text": "そこへ、お城の持ち主にあてて、影から2通の手紙が届きました。",
   "who": "ナレーション"
  },
  {
   "id": "17-02",
   "t0": 250.19,
   "t1": 256.65,
   "text": "1通目には、こう書いてあります。「元に戻してほしければ、お金を払え」。",
   "who": "ナレーション"
  },
  {
   "id": "17-03",
   "t0": 257.25,
   "t1": 261.74,
   "text": "扉を開けたければ、お金を払うしかない、というのです。",
   "who": "ナレーション"
  },
  {
   "id": "17-04",
   "t0": 262.34,
   "t1": 269.18,
   "text": "でも、お城には予備の倉庫がありましたね。予備を使えば、元に戻せるかも……？",
   "who": "ナレーション"
  },
  {
   "id": "17-05",
   "t0": 269.77,
   "t1": 274.37,
   "text": "ところが、その予備の倉庫にも、影の錠がかかっています。",
   "who": "ナレーション"
  },
  {
   "id": "17-06",
   "t0": 274.97,
   "t1": 280.08,
   "text": "そう、影が予備の場所まで調べていたのは、このためだったのです。",
   "who": "ナレーション"
  },
  {
   "id": "17-07",
   "t0": 280.68,
   "t1": 287.26,
   "text": "さらに、2通目の手紙。「払わなければ、盗んだ名札をみんなに見せるぞ」。",
   "who": "ナレーション"
  },
  {
   "id": "17-08",
   "t0": 287.87,
   "t1": 293.62,
   "text": "たとえ扉を開けられても、お客さんの名札がばらまかれたら、大変なことになります。",
   "who": "ナレーション"
  },
  {
   "id": "17-09",
   "t0": 294.22,
   "t1": 302.17,
   "text": "錠をかけて脅し、盗んだ名札でもう一度脅す。逃げ道を、両方ふさいでくるのです。",
   "who": "ナレーション"
  },
  {
   "id": "17-10",
   "t0": 302.76,
   "t1": 310.65,
   "text": "2025年の1年間に、お金を求められたと警察がまとめた被害は、153件。",
   "who": "ナレーション"
  },
  {
   "id": "17-11",
   "t0": 311.28,
   "t1": 315.97,
   "text": "そのうち136件が、この2回脅す形でした。",
   "who": "ナレーション"
  },
  {
   "id": "17-12",
   "t0": 316.57,
   "t1": 323.48,
   "text": "でも、お金を払ったとしても、元に戻る約束も見せないでくれる約束もありません。",
   "who": "ナレーション"
  },
  {
   "id": "17-13",
   "t0": 324.08,
   "t1": 329.81,
   "text": "そのため、このような脅しが来ても、払わないようにと国も呼びかけています。",
   "who": "ナレーション"
  }
 ],
 "notes": "2章（6:30〜12:00、本編の「すぐには盗まない」）の動く下書きです。動画の 0:00 は本編の 6:30 です。見せる前に確認役を 2 回まわして、予想された直しを全部直しました。台本の「確かめ」は言い換えました（17-10「警察がまとめた被害は」）。"
}